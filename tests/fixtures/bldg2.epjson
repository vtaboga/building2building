    "EnergyManagementSystem:Program": {
        "central_ac_and_furnace_supply_fan_disaggregate_program": {
            "lines": [
                {
                    "program_line": "Set central_ac_and_furnace_supply_fan_clg = 0"
                },
                {
                    "program_line": "If central_ac_and_furnace_clg_coil_s > 0"
                },
                {
                    "program_line": "Set central_ac_and_furnace_supply_fan_clg = central_ac_and_furnace_supply_fan_s"
                },
                {
                    "program_line": "EndIf"
                }
            ]
        },
        "central_ac_and_furnace_supply_fan_disaggregate_program_1": {
            "lines": [
                {
                    "program_line": "Set central_ac_and_furnace_supply_fan_primary_htg = 0"
                },
                {
                    "program_line": "If central_ac_and_furnace_htg_coil_s > 0"
                },
                {
                    "program_line": "Set central_ac_and_furnace_supply_fan_primary_htg = central_ac_and_furnace_supply_fan_s_1"
                },
                {
                    "program_line": "EndIf"
                }
            ]
        },

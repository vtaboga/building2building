  59144 Humidifier:Steam:Electric,
  59145       \memo Electrically heated steam humidifier with fan.
  59146   A1, \field Name
  59147       \required-field
  59148       \reference-class-name validBranchEquipmentTypes
  59149       \reference validBranchEquipmentNames
  59150       \reference-class-name validOASysEquipmentTypes
  59151       \reference validOASysEquipmentNames
  59152   A2, \field Availability Schedule Name
  59153       \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  59154       \note If this field is blank, the system is always available.
  59155       \type object-list
  59156       \object-list ScheduleNames
  59157   N1, \field Rated Capacity
  59158       \note Capacity is m3/s of water at 5.05 C
  59159       \type real
  59160       \units m3/s
  59161       \minimum 0.0
  59162       \ip-units gal/min
  59163       \autosizable
  59164   N2, \field Rated Power
  59165       \type real
  59166       \units W
  59167       \minimum 0.0
  59168       \ip-units W
  59169       \autosizable
  59170       \note if autosized the rated power is calculated from the rated capacity
  59171       \note and enthalpy rise of water from 20.0C to 100.0C steam and assumes
  59172       \note electric to thermal energy conversion efficiency of 100.0%
  59173   N3, \field Rated Fan Power
  59174       \type real
  59175       \units W
  59176       \minimum 0.0
  59177       \ip-units W
  59178   N4, \field Standby Power
  59179       \type real
  59180       \units W
  59181       \minimum 0.0
  59182       \ip-units W
  59183   A3, \field Air Inlet Node Name
  59184        \type node
  59185   A4, \field Air Outlet Node Name

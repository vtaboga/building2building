   8780 Construction:CfactorUndergroundWall,
   8781        \memo Alternate method of describing underground wall constructions
   8782   A1 , \field Name
   8783        \required-field
   8784        \type alpha
   8785        \reference ConstructionNames
   8786   N1 , \field C-Factor
   8787        \required-field
   8788        \units W/m2-K
   8789        \type real
   8790        \minimum> 0.0
   8791        \note Enter C-Factor without film coefficients or soil
   8792   N2 ; \field Height
   8793        \required-field
   8794        \units m
   8795        \type real
   8796        \minimum> 0.0
   8797        \note Enter height of the underground wall
   8798 
   8799 Construction:FfactorGroundFloor,
   8800        \memo Alternate method of describing slab-on-grade or underground floor constructions
   8801   A1 , \field Name
   8802        \required-field
   8803        \type alpha
   8804        \reference ConstructionNames
   8805   N1 , \field F-Factor
   8806        \required-field
   8807        \units W/m-K
   8808        \ip-units Btu/h-ft-F
   8809        \type real
   8810        \minimum> 0.0
   8811   N2 , \field Area
   8812        \required-field
   8813        \units m2
   8814        \type real
   8815        \minimum> 0.0
   8816        \note Enter area of the floor
   8817   N3 ; \field PerimeterExposed
   8818        \required-field
   8819        \units m
   8820        \type real
   8821        \minimum 0.0
   8822        \note Enter exposed perimeter of the floor
   8823 
   8824 Construction:InternalSource,
   8825        \memo Start with outside layer and work your way to the inside Layer
   8826        \memo Up to 10 layers total
   8827        \memo Enter the material name for each layer
   8828        \min-fields 7
   8829   A1 , \field Name
   8830        \required-field
   8831        \type alpha
   8832        \reference ConstructionNames
   8833   N1 , \field Source Present After Layer Number
   8834        \required-field
   8835        \type integer
   8836        \minimum 1
   8837        \maximum 10
   8838        \note refers to the list of materials which follows
   8839   N2 , \field Temperature Calculation Requested After Layer Number
   8840        \required-field
   8841        \type integer
   8842        \minimum 1
   8843        \maximum 10
   8844        \note refers to the list of materials which follows
   8845   N3 , \field Dimensions for the CTF Calculation
   8846        \required-field
   8847        \type integer
   8848        \minimum 1
   8849        \maximum 2
   8850        \note 1 = 1-dimensional calculation, 2 = 2-dimensional calculation
   8851   N4 , \field Tube Spacing
   8852        \required-field
   8853        \type real
   8854        \units m
   8855        \minimum 0.0
   8856        \maximum< 1.0
   8857        \note uniform spacing between tubes or resistance wires in direction
   8858        \note perpendicular to main intended direction of heat transfer
   8859   N5 , \field Two-Dimensional Temperature Calculation Position
   8860        \required-field
   8861        \minimum 0.0
   8862        \maximum 1.0
   8863        \default 0.0
   8864        \units dimensionless
   8865        \note used in conjunction with field Temperature Calculation Requested After Layer Number
   8866        \note this field is the location perpendicular to the main direction of heat transfer
   8867        \note 0.0 means in line with the tubing, 1.0 means at the midpoint between two adjacent pipes
   8868        \note this field is ignored for 1-D calculations
   8869   A2 , \field Outside Layer
   8870        \required-field
   8871        \type object-list
   8872        \object-list MaterialName
   8873   A3 , \field Layer 2
   8874        \type object-list
   8875        \object-list MaterialName
   8876   A4 , \field Layer 3
   8877        \type object-list
   8878        \object-list MaterialName
   8879   A5 , \field Layer 4
   8880        \type object-list
   8881        \object-list MaterialName
   8882   A6 , \field Layer 5
   8883        \type object-list
   8884        \object-list MaterialName
   8885   A7 , \field Layer 6
   8886        \type object-list
   8887        \object-list MaterialName
   8888   A8 , \field Layer 7
   8889        \type object-list
   8890        \object-list MaterialName
   8891   A9 , \field Layer 8
   8892        \type object-list
   8893        \object-list MaterialName
   8894   A10, \field Layer 9
   8895        \type object-list
   8896        \object-list MaterialName
   8897   A11; \field Layer 10
   8898        \type object-list
   8899        \object-list MaterialName
   8900 
   8901 Construction:AirBoundary,
   8902        \memo Indicates an open boundary between two zones. It may be used for base surfaces and fenestration surfaces.
   8903        \memo When this construction type is used, the Outside Boundary Condition of the surface
   8904        \memo (or the base surface of a fenestration surface) must be either Surface or Zone.
   8905        \memo A base surface with Construction:AirBoundary cannot hold any fenestration surfaces.
   8906   A1,  \field Name
   8907        \required-field
   8908        \type alpha
   8909        \reference ConstructionNames
   8910   A2,  \field Solar and Daylighting Method
   8911        \note This field controls how the surface is modeled for solar distribution and daylighting calculations.
   8912        \type choice
   8913        \key GroupedZones
   8914        \key InteriorWindow
   8915        \default GroupedZones
   8916   A3,  \field Radiant Exchange Method
   8917        \note This field controls how the surface is modeled for radiant exchange calculations.
   8918        \type choice
   8919        \key GroupedZones
   8920        \key IRTSurface
   8921        \default GroupedZones
   8922   A4,  \field Air Exchange Method
   8923        \note This field controls how air exchange is modeled across this boundary.
   8924        \type choice
   8925        \key None
   8926        \key SimpleMixing
   8927        \default None
   8928   N1,  \field Simple Mixing Air Changes per Hour
   8929        \note If the Air Exchange Method is SimpleMixing then this field specifies the air changes per hour
   8930        \note using the volume of the smaller zone as the basis.
   8931        \note If an AirflowNetwork simulation is active this field is ignored.
   8932        \units 1/hr
   8933        \type real
   8934        \minimum 0
   8935        \default 0.5
   8936   A5;  \field Simple Mixing Schedule Name
   8937        \note If the Air Exchange Method is SimpleMixing then this field specifies the air exchange schedule.
   8938        \note If this field is blank, the schedule is always 1.0.
   8939        \note If an AirflowNetwork simulation is active this field is ignored.
   8940        \type object-list
   8941        \object-list ScheduleNames
   8942 
   8943 WindowThermalModel:Params,
   8944        \memo object is used to select which thermal model should be used in tarcog simulations
   8945   A1 , \field Name
   8946        \required-field
   8947        \type alpha
   8948        \reference WindowThermalModelParameters
   8949   A2 , \field standard
   8950        \type choice
   8951        \key ISO15099
   8952        \key EN673Declared
   8953        \key EN673Design
   8954        \default ISO15099
   8955   A3 , \field Thermal Model
   8956        \type choice
   8957        \key ISO15099
   8958        \key ScaledCavityWidth
   8959        \key ConvectiveScalarModel_NoSDThickness
   8960        \key ConvectiveScalarModel_withSDThickness
   8961        \default ISO15099
   8962   N1 , \field SDScalar
   8963        \type real
   8964        \minimum  0.0
   8965        \maximum 1.0
   8966        \default 1
   8967   A4 , \field Deflection Model
   8968        \type choice
   8969        \key NoDeflection
   8970        \key TemperatureAndPressureInput
   8971        \key MeasuredDeflection
   8972        \default NoDeflection
   8973   N2 , \field Vacuum Pressure Limit
   8974        \type real
   8975        \units Pa
   8976        \minimum> 0
   8977        \default 13.238
   8978   N3 , \field Initial temperature
   8979        \note This is temperature in time of window fabrication
   8980        \type real
   8981        \units C
   8982        \minimum> 0
   8983        \default 25
   8984   N4 ; \field Initial pressure
   8985        \note This is pressure in time of window fabrication
   8986        \type real
   8987        \units Pa
   8988        \minimum> 0
   8989        \default 101325
   8990 
   8991 WindowsCalculationEngine,
   8992        \memo Describes which window model will be used in calculations. Built in windows model will use algorithms that are part of EnergyPlus,
   8993        \memo while ExternalWindowsModel will use Windows-CalcEngine library to perform optical and thermal performances of windows and doors.
   8994   A1;  \field Windows engine
   8995        \type choice
   8996        \key BuiltInWindowsModel
   8997        \key ExternalWindowsModel
   8998        \default BuiltInWindowsModel
   8999 

   1229        \minimum 1
   1230        \maximum 12
   1231        \type integer
   1232   N2 , \field Begin Day of Month
   1233        \required-field
   1234        \minimum 1
   1235        \maximum 31
   1236        \type integer
   1237   N3 , \field End Month
   1238        \required-field
   1239        \minimum 1
   1240        \maximum 12
   1241        \type integer
   1242   N4 , \field End Day of Month
   1243        \required-field
   1244        \minimum 1
   1245        \maximum 31
   1246        \type integer
   1247   A2 , \field Day of Week for Start Day

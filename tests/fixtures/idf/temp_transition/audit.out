  49666 Coil:Cooling:DX:CurveFit:Speed,
  49667        \memo DX cooling coil performance for a single speed within a single operating mode.
  49668        \min-fields 15
  49669    A1, \field Name
  49670        \required-field
  49671        \type alpha
  49672        \reference DXCoolingSpeedNames
  49673    N1, \field Gross Total Cooling Capacity Fraction
  49674        \note Ratio of capacity at this speed to the
  49675        \note operating mode Rated Gross Total Cooling Capacity
  49676        \required-field
  49677        \type real
  49678        \minimum> 0.0
  49679    N2, \field Evaporator Air Flow Rate Fraction
  49680        \note Ratio of capacity at this speed to the
  49681        \note operating mode Rated Evaporator Air Flow Rate
  49682        \required-field
  49683        \type real
  49684        \minimum> 0.0
  49685    N3, \field Condenser Air Flow Rate Fraction
  49686        \note Ratio of condenser air flow at this speed to the
  49687        \note operating mode Rated Condenser Air Flow Rate
  49688        \type real
  49689        \minimum> 0.0
  49690    N4, \field Gross Sensible Heat Ratio
  49691        \note Rated sensible heat ratio (gross sensible capacity/gross total capacity)
  49692        \note sensible and total capacities do not include supply fan heat
  49693        \type real
  49694        \minimum 0.1
  49695        \maximum 1.0
  49696        \autosizable
  49697        \default autosize
  49698    N5, \field Gross Cooling COP
  49699        \note Gross cooling capacity divided by power input to the compressor and condenser fan.
  49700        \note Does not include supply fan heat or supply fan electrical energy input.
  49701        \type real
  49702        \units W/W
  49703        \minimum> 0.0
  49704        \default 3.0
  49705    N6, \field Active Fraction of Coil Face Area
  49706        \note The fraction of the cooling coil face which is actively cooled at this speed.
  49707        \note For non-split-face coils, this should be 1.0.
  49708        \type real
  49709        \minimum> 0.0
  49710        \maximum 1.0
  49711        \default 1.0
  49712    N7, \field Rated Evaporator Fan Power Per Volume Flow Rate
  49713        \note Enter the evaporator fan power per air volume flow rate at the rated test conditions.
  49714        \note The test conditions vary external static pressure based on total cooling capacity.
  49715        \note This value is only used to calculate Seasonal Energy Efficiency Ratio (SEER), and the
  49716        \note Standard Rating (Net) Cooling Capacity which will be outputs in the EnergyPlus eio file.
  49717        \note This value is not used for modeling the evaporator fan during simulations.
  49718        \type real
  49719        \units W/(m3/s)
  49720        \minimum 0.0
  49721        \maximum 1250.0
  49722        \default 773.3
  49723    N8, \field Evaporative Condenser Pump Power Fraction
  49724        \note Ratio of evaporative condenser pump power at this speed to the
  49725        \note operating mode Nominal Evaporative Condenser Pump Power
  49726        \type real
  49727        \minimum> 0.0
  49728        \default 1.0
  49729    N9, \field Evaporative Condenser Effectiveness
  49730        \type real
  49731        \units dimensionless
  49732        \minimum 0.0
  49733        \maximum 1.0
  49734        \default 0.9
  49735    A2, \field Total Cooling Capacity Modifier Function of Temperature Curve Name
  49736        \note biquadratic curve = a + b*wb + c*wb**2 + d*edb + e*edb**2 + f*wb*edb
  49737        \note quadratic curve = a + b*edb + c*edb**2
  49738        \note wb = entering wet-bulb temperature (C)
  49739        \note edb = dry-bulb temperature seen by the condenser (C)
  49740        \type object-list
  49741        \object-list UnivariateFunctions
  49742        \object-list BivariateFunctions
  49743    A3, \field Total Cooling Capacity Modifier Function of Air Flow Fraction Curve Name
  49744        \note quadratic curve = a + b*ff + c*ff**2
  49745        \note cubic curve = a + b*ff + c*ff**2 + d*ff**3
  49746        \note ff = Fraction of the full load flow
  49747        \type object-list
  49748        \object-list UnivariateFunctions
  49749    A4, \field Energy Input Ratio Modifier Function of Temperature Curve Name
  49750        \note curve = a + b*wb + c*wb**2 + d*edb + e*edb**2 + f*wb*edb
  49751        \note wb = entering wet-bulb temperature (C)
  49752        \note edb = dry-bulb temperature seen by the condenser (C)
  49753        \type object-list
  49754        \object-list UnivariateFunctions
  49755        \object-list BivariateFunctions
  49756    A5, \field Energy Input Ratio Modifier Function of Air Flow Fraction Curve Name
  49757        \note quadratic curve = a + b*ff + c*ff**2
  49758        \note cubic curve = a + b*ff + c*ff**2 + d*ff**3
  49759        \note ff = Fraction of the full load flow
  49760        \type object-list
  49761        \object-list UnivariateFunctions
  49762    A6, \field Part Load Fraction Correlation Curve Name
  49763        \note quadratic curve = a + b*PLR + c*PLR**2
  49764        \note cubic curve = a + b*PLR + c*PLR**2 + d*PLR**3
  49765        \note PLR = part load ratio (cooling load/steady state capacity)
  49766        \type object-list
  49767        \object-list UnivariateFunctions
  49768    N10,\field Rated Waste Heat Fraction of Power Input
  49769        \note Recoverable waste heat at full load and rated conditions
  49770        \type real
  49771        \units dimensionless
  49772        \minimum> 0.0
  49773        \maximum 1.0
  49774        \default 0.2
  49775    A7, \field Waste Heat Modifier Function of Temperature Curve Name
  49776        \note curve = a + b*cdb + c*cdb**2 + d*edb + e*edb**2 + f*cdb*edb
  49777        \note cdb = entering condenser dry-bulb temperature (C)
  49778        \note edb = entering coil dry-bulb temperature (C)
  49779        \type object-list
  49780        \object-list BivariateFunctions
  49781    A8, \field Sensible Heat Ratio Modifier Function of Temperature Curve Name
  49782        \note curve = a + b*wb + c*wb**2 + d*db + e*db**2 + f*wb*db
  49783        \note wb = entering wet-bulb temperature seen by the DX cooling coil (C)
  49784        \note db = entering dry-bulb temperature seen by the DX cooling coil (C)
  49785        \note entering temperature can be outside air or pretreated air.
  49786        \note If this curve is used and the Sensible Heat Ratio Modifier Function of Flow Fraction (SHRFFF)
  49787        \note Curve Name is blank, the SHRFFF is assumed to be a constant value of 1.0.
  49788        \type object-list
  49789        \object-list BivariateFunctions
  49790   A9;  \field Sensible Heat Ratio Modifier Function of Flow Fraction Curve Name
  49791        \note quadratic curve = a + b*ff + c*ff**2
  49792        \note cubic curve = a + b*ff + c*ff**2 + d*ff**3
  49793        \note ff = fraction of the full load flow
  49794        \note If this curve is used and the Sensible Heat Ratio Modifier Function of Temperature Curve Name (SHRFT)
  49795        \note Curve Name is blank, the SHRFT is assumed to be a constant value of 1.0.
  49796        \type object-list
  49797        \object-list UnivariateFunctions

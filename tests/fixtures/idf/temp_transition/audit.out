  12571 WindowProperty:FrameAndDivider,
  12572          \memo Specifies the dimensions of a window frame, dividers, and inside reveal surfaces.
  12573          \memo Referenced by the surface objects for exterior windows and glass doors
  12574          \memo (ref: FenestrationSurface:Detailed, Window, and GlazedDoor).
  12575       \min-fields 20
  12576     A1 , \field Name
  12577          \required-field
  12578          \type alpha
  12579          \reference WindowFrameAndDividerNames
  12580          \note Referenced by surfaces that are exterior windows
  12581          \note Not used by interzone windows
  12582     N1 , \field Frame Width
  12583          \units m
  12584          \type real
  12585          \minimum 0.0
  12586          \maximum 1.0
  12587          \default 0.0
  12588          \note Width of frame in plane of window
  12589          \note Frame width assumed the same on all sides of window
  12590     N2 , \field Frame Outside Projection
  12591          \units m
  12592          \type real
  12593          \minimum 0.0
  12594          \maximum 0.5
  12595          \default 0.0
  12596          \note Amount that frame projects outward from the outside face of the glazing
  12597     N3 , \field Frame Inside Projection
  12598          \units m
  12599          \type real
  12600          \minimum 0.0
  12601          \maximum 0.5
  12602          \default 0.0
  12603          \note Amount that frame projects inward from the inside face of the glazing
  12604     N4 , \field Frame Conductance
  12605          \units W/m2-K
  12606          \type real
  12607          \minimum 0.0
  12608          \note Effective conductance of frame
  12609          \note Excludes air films
  12610          \note Obtained from WINDOW 5 or other 2-D calculation
  12611     N5 , \field Ratio of Frame-Edge Glass Conductance to Center-Of-Glass Conductance
  12612          \type real
  12613          \minimum> 0.0
  12614          \maximum 4.0
  12615          \default 1.0
  12616          \note Excludes air films; applies only to multipane windows
  12617          \note Obtained from WINDOW 5 or other 2-D calculation
  12618     N6 , \field Frame Solar Absorptance
  12619          \type real
  12620          \minimum 0.0
  12621          \maximum 1.0
  12622          \default 0.7
  12623          \note Assumed same on outside and inside of frame
  12624     N7 , \field Frame Visible Absorptance
  12625          \type real
  12626          \minimum 0.0
  12627          \maximum 1.0
  12628          \default 0.7
  12629          \note Assumed same on outside and inside of frame
  12630     N8 , \field Frame Thermal Hemispherical Emissivity
  12631          \type real
  12632          \minimum> 0.0
  12633          \default 0.9
  12634          \note Assumed same on outside and inside of frame
  12635     A2 , \field Divider Type
  12636          \type choice
  12637          \key DividedLite
  12638          \key Suspended
  12639          \default DividedLite
  12640     N9 , \field Divider Width
  12641          \units m
  12642          \type real
  12643          \minimum 0.0
  12644          \maximum 0.5
  12645          \default 0.0
  12646          \note Width of dividers in plane of window
  12647          \note Width assumed the same for all dividers
  12648     N10, \field Number of Horizontal Dividers
  12649          \type real
  12650          \minimum 0
  12651          \default 0
  12652          \note "Horizontal" means parallel to local window X-axis
  12653     N11, \field Number of Vertical Dividers
  12654          \type real
  12655          \minimum 0
  12656          \default 0
  12657          \note "Vertical" means parallel to local window Y-axis
  12658     N12, \field Divider Outside Projection
  12659          \units m
  12660          \type real
  12661          \minimum 0.0
  12662          \maximum 0.5
  12663          \default 0.0
  12664          \note Amount that divider projects outward from the outside face of the glazing
  12665          \note Outside projection assumed the same for all divider elements
  12666     N13, \field Divider Inside Projection
  12667          \units m
  12668          \type real
  12669          \minimum 0.0
  12670          \maximum 0.5
  12671          \default 0.0
  12672          \note Amount that divider projects inward from the inside face of the glazing
  12673          \note Inside projection assumed the same for all divider elements
  12674     N14, \field Divider Conductance
  12675          \units W/m2-K
  12676          \type real
  12677          \minimum 0.0
  12678          \default 0.0
  12679          \note Effective conductance of divider
  12680          \note Excludes air films
  12681          \note Obtained from WINDOW 5 or other 2-D calculation
  12682     N15, \field Ratio of Divider-Edge Glass Conductance to Center-Of-Glass Conductance
  12683          \type real
  12684          \minimum> 0.0
  12685          \maximum 4.0
  12686          \default 1.0
  12687          \note Excludes air films
  12688          \note Obtained from WINDOW 5 or other 2-D calculation
  12689     N16, \field Divider Solar Absorptance
  12690          \type real
  12691          \minimum 0.0
  12692          \maximum 1.0
  12693          \default 0.0
  12694          \note Assumed same on outside and inside of divider

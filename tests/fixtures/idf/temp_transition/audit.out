  51725        \type object-list
  51726        \object-list WaterStorageTankNames
  51727   A14, \field Condensate Collection Water Storage Tank Name
  51728        \type object-list
  51729        \object-list WaterStorageTankNames
  51730   N5,  \field Minimum Outdoor Dry-Bulb Temperature for Compressor Operation
  51731        \type real
  51732        \default -25.0
  51733        \units C
  51734   N6,  \field Basin Heater Capacity
  51735        \type real
  51736        \units W/K
  51737        \minimum 0.0
  51738        \default 0.0
  51739        \note This field is only used for Condenser Type = EvaporativelyCooled and for periods
  51740        \note when the basin heater is available (field Basin Heater Operating Schedule Name).
  51741        \note For this situation, the heater maintains the basin water temperature at the basin heater
  51742        \note setpoint temperature when the outdoor air temperature falls below the setpoint temperature.
  51743        \note The basin heater only operates when the DX coil is off.
  51744   N7,  \field Basin Heater Setpoint Temperature
  51745        \type real
  51746        \units C
  51747        \minimum 2.0
  51748        \default 2.0
  51749        \note This field is only used for Condenser Type = EvaporativelyCooled.
  51750        \note Enter the outdoor dry-bulb temperature when the basin heater turns on.
  51751   A15; \field Basin Heater Operating Schedule Name
  51752        \type object-list
  51753        \object-list ScheduleNames
  51754        \note This field is only used for Condenser Type = EvaporativelyCooled.
  51755        \note Schedule values greater than 0 allow the basin heater to operate whenever the outdoor
  51756        \note air dry-bulb temperature is below the basin heater setpoint temperature.
  51757        \note If a schedule name is not entered, the basin heater is allowed to operate
  51758        \note throughout the entire simulation.

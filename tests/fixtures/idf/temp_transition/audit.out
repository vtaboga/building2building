  75651 GroundHeatExchanger:Pond,
  75652         \memo A model of a shallow pond with immersed pipe loops.
  75653         \memo Typically used in hybrid geothermal systems and included in the condenser loop.
  75654         \memo This component may also be used as a simple solar collector.
  75655    A1 , \field Name
  75656         \required-field
  75657         \reference-class-name validPlantEquipmentTypes
  75658         \reference validPlantEquipmentNames
  75659         \reference-class-name validCondenserEquipmentTypes
  75660         \reference validCondenserEquipmentNames
  75661         \reference-class-name validBranchEquipmentTypes
  75662         \reference validBranchEquipmentNames
  75663    A2 , \field Fluid Inlet Node Name
  75664         \type node
  75665         \required-field
  75666    A3 , \field Fluid Outlet Node Name
  75667         \required-field
  75668         \type node
  75669    N1 , \field Pond Depth
  75670         \required-field
  75671         \type real
  75672         \units m
  75673         \minimum> 0
  75674    N2 , \field Pond Area
  75675         \required-field
  75676         \type real
  75677         \units m2
  75678         \minimum> 0
  75679    N3 , \field Hydronic Tubing Inside Diameter
  75680         \required-field
  75681         \type real
  75682         \units m
  75683         \minimum> 0
  75684         \ip-units in
  75685    N4 , \field Hydronic Tubing Outside Diameter
  75686         \required-field
  75687         \type real
  75688         \units m
  75689         \minimum> 0
  75690         \ip-units in
  75691    N5 , \field Hydronic Tubing Thermal Conductivity
  75692         \required-field
  75693         \type real
  75694         \units W/m-K
  75695         \minimum> 0
  75696    N6 , \field Ground Thermal Conductivity
  75697         \required-field
  75698         \type real
  75699         \units W/m2-K
  75700         \minimum> 0
  75701    N7 , \field Number of Tubing Circuits
  75702         \required-field
  75703         \type integer
  75704         \minimum 1
  75705    N8 ; \field Length of Each Tubing Circuit
  75706         \required-field
  75707         \type real
  75708         \units m
  75709         \minimum 0
  75710 
  75711 GroundHeatExchanger:Surface,
  75712         \memo A hydronic surface/panel consisting of a multi-layer construction with embedded rows of tubes.
  75713         \memo Typically used in hybrid geothermal systems and included in the condenser loop.
  75714         \memo This component may also be used as a simple solar collector.
  75715         \memo The bottom surface may be defined as ground-coupled or exposed to wind (eg. bridge deck).
  75716    A1 , \field Name
  75717         \required-field
  75718         \reference-class-name validPlantEquipmentTypes
  75719         \reference validPlantEquipmentNames
  75720         \reference-class-name validCondenserEquipmentTypes
  75721         \reference validCondenserEquipmentNames
  75722         \reference-class-name validBranchEquipmentTypes
  75723         \reference validBranchEquipmentNames
  75724    A2 , \field Construction Name
  75725         \required-field
  75726         \type object-list
  75727         \object-list ConstructionNames
  75728    A3 , \field Fluid Inlet Node Name
  75729         \type node
  75730         \required-field
  75731    A4 , \field Fluid Outlet Node Name
  75732         \required-field
  75733         \type node
  75734    N1 , \field Hydronic Tubing Inside Diameter
  75735         \type real
  75736         \units m
  75737         \minimum> 0
  75738         \ip-units in
  75739    N2 , \field Number of Tubing Circuits
  75740         \type integer
  75741         \minimum 1
  75742    N3 , \field Hydronic Tube Spacing
  75743         \type real
  75744         \units m
  75745         \minimum> 0.0
  75746    N4 , \field Surface Length
  75747         \type real
  75748         \units m
  75749         \minimum> 0.0
  75750    N5 , \field Surface Width
  75751         \type real
  75752         \units m
  75753         \minimum> 0.0
  75754    A5 ; \field Lower Surface Environment
  75755         \type choice
  75756         \key Ground
  75757         \key Exposed
  75758         \default Ground
  75759 
  75760 GroundHeatExchanger:HorizontalTrench,
  75761         \memo This models a horizontal heat exchanger placed in a series of trenches
  75762         \memo The model uses the PipingSystem:Underground underlying algorithms,
  75763         \memo but provides a more usable input interface.
  75764         \min-fields 20
  75765    A1 , \field Name
  75766         \required-field
  75767         \reference-class-name validPlantEquipmentTypes
  75768         \reference validPlantEquipmentNames
  75769         \reference-class-name validCondenserEquipmentTypes
  75770         \reference validCondenserEquipmentNames
  75771         \reference-class-name validBranchEquipmentTypes
  75772         \reference validBranchEquipmentNames
  75773    A2 , \field Inlet Node Name
  75774         \type node
  75775         \required-field
  75776    A3 , \field Outlet Node Name
  75777         \type node
  75778         \required-field
  75779    N1 , \field Design Flow Rate
  75780         \required-field
  75781         \type real
  75782         \units m3/s
  75783         \ip-units gal/min
  75784         \minimum> 0
  75785    N2 , \field Trench Length in Pipe Axial Direction
  75786         \note This is the total pipe axial length of the heat exchanger
  75787         \note If all pipe trenches are parallel, this is the length of a
  75788         \note single trench.  If a single, long run of pipe is used with one
  75789         \note trench, this is the full length of the pipe run.
  75790         \type real
  75791         \units m
  75792         \minimum> 0
  75793         \ip-units ft
  75794         \default 50
  75795    N3 , \field Number of Trenches
  75796         \note This is the number of horizontal legs that will be used
  75797         \note in the entire heat exchanger, one pipe per trench
  75798         \type integer
  75799         \minimum 1
  75800         \default 1
  75801    N4 , \field Horizontal Spacing Between Pipes
  75802         \note This represents the average horizontal spacing between any two
  75803         \note trenches for heat exchangers that have multiple trenches
  75804         \type real
  75805         \units m
  75806         \minimum> 0
  75807         \default 1.0
  75808    N5 , \field Pipe Inner Diameter
  75809         \type real
  75810         \units m
  75811         \minimum> 0
  75812         \ip-units in
  75813         \default 0.016
  75814    N6 , \field Pipe Outer Diameter
  75815         \type real
  75816         \units m
  75817         \minimum> 0
  75818         \ip-units in
  75819         \default 0.026
  75820    N7 , \field Burial Depth
  75821         \note This is the burial depth of the pipes, or the trenches
  75822         \note containing the pipes
  75823         \type real
  75824         \units m
  75825         \minimum> 0
  75826         \ip-units ft
  75827         \default 1.5
  75828    N8 , \field Soil Thermal Conductivity
  75829         \type real
  75830         \units W/m-K
  75831         \minimum> 0
  75832         \default 1.08
  75833    N9 , \field Soil Density
  75834         \type real
  75835         \units kg/m3
  75836         \minimum> 0
  75837         \default 962
  75838    N10, \field Soil Specific Heat
  75839         \type real
  75840         \units J/kg-K
  75841         \minimum> 0
  75842         \default 2576
  75843    N11, \field Pipe Thermal Conductivity
  75844         \type real
  75845         \units W/m-K
  75846         \minimum> 0
  75847         \default 0.3895
  75848    N12, \field Pipe Density
  75849         \type real
  75850         \units kg/m3
  75851         \minimum> 0
  75852         \default 641
  75853    N13, \field Pipe Specific Heat
  75854         \type real
  75855         \units J/kg-K
  75856         \minimum> 0
  75857         \default 2405
  75858    N14, \field Soil Moisture Content Percent
  75859         \type real
  75860         \units percent
  75861         \minimum 0
  75862         \maximum 100
  75863         \default 30
  75864    N15, \field Soil Moisture Content Percent at Saturation
  75865         \type real
  75866         \units percent
  75867         \minimum 0
  75868         \maximum 100
  75869         \default 50
  75870    A4,  \field Undisturbed Ground Temperature Model Type
  75871         \required-field
  75872         \type choice
  75873         \key Site:GroundTemperature:Undisturbed:FiniteDifference
  75874         \key Site:GroundTemperature:Undisturbed:KusudaAchenbach
  75875         \key Site:GroundTemperature:Undisturbed:Xing
  75876    A5,  \field Undisturbed Ground Temperature Model Name
  75877         \required-field
  75878         \type object-list
  75879         \object-list UndisturbedGroundTempModels
  75880    N16; \field Evapotranspiration Ground Cover Parameter
  75881         \type real
  75882         \minimum 0
  75883         \maximum 1.5
  75884         \default 0.4
  75885         \note This specifies the ground cover effects during evapotranspiration
  75886         \note  calculations.  The value roughly represents the following cases:
  75887         \note  = 0   : concrete or other solid, non-permeable ground surface material
  75888         \note  = 0.5 : short grass, much like a manicured lawn
  75889         \note  = 1   : standard reference state (12 cm grass)
  75890         \note  = 1.5 : wild growth
  75891 
  75892 GroundHeatExchanger:Slinky,
  75893         \memo This models a slinky horizontal heat exchanger
  75894         \memo placed in a series of trenches
  75895         \memo The model uses the model developed by:
  75896         \memo Xiong, Z., D.E. Fisher, and J.D. Spitler. 2015.
  75897         \memo Development and Validation of a Slinky Ground Heat
  75898         \memo Exchanger Model. Applied Energy 141: 57-69.
  75899         \min-fields 21
  75900    A1 , \field Name
  75901         \required-field
  75902         \reference-class-name validPlantEquipmentTypes
  75903         \reference validPlantEquipmentNames
  75904         \reference-class-name validCondenserEquipmentTypes
  75905         \reference validCondenserEquipmentNames
  75906         \reference-class-name validBranchEquipmentTypes
  75907         \reference validBranchEquipmentNames
  75908    A2 , \field Inlet Node Name
  75909         \type node
  75910         \required-field

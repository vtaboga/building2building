  61468         \type real
  61469         \maximum 21.0
  61470         \default 21.0
  61471         \units C
  61472    A14, \field Outdoor Dry-Bulb Temperature Sensor Node Name
  61473         \type node
  61474    A15, \field Fan Placement
  61475         \type choice
  61476         \key BlowThrough
  61477         \key DrawThrough
  61478         \default BlowThrough
  61479    A16, \field Supply Air Fan Operating Mode Schedule Name
  61480         \type object-list
  61481         \object-list ScheduleNames
  61482         \note Enter the name of a schedule that controls fan operation. Schedule values of 0 denote
  61483         \note cycling fan operation (fan cycles with cooling or heating coil). Schedule values greater
  61484         \note than 0 denote constant fan operation (fan runs continually regardless of coil operation).
  61485         \note The fan operating mode defaults to cycling fan operation if this field is left blank.
  61486    A17, \field Dehumidification Control Type
  61487         \type choice
  61488         \key None
  61489         \key CoolReheat
  61490         \default None
  61491         \note None = meet sensible load only
  61492         \note CoolReheat = cool beyond the dry-bulb setpoint.
  61493         \note as required to meet the humidity setpoint.  Valid only with
  61494         \note Coil:Cooling:WaterToAirHeatPump:EquationFit or
  61495         \note Coil:Cooling:WaterToAirHeatPump:VariableSpeedEquationFit
  61496    A18; \field Heat Pump Coil Water Flow Mode
  61497         \type choice
  61498         \key Constant
  61499         \key Cycling
  61500         \key ConstantOnDemand
  61501         \default Cycling
  61502         \note used only when the heat pump coils are of the type WaterToAirHeatPump:EquationFit
  61503         \note Constant results in 100% water flow regardless of compressor PLR
  61504         \note Cycling results in water flow that matches compressor PLR
  61505         \note ConstantOnDemand results in 100% water flow whenever the coil is on, but is 0% whenever the coil has no load
  61506 
  61507 AirLoopHVAC:UnitaryHeatCool:VAVChangeoverBypass,
  61508         \memo Unitary system, heating and cooling with constant volume supply fan (continuous or
  61509         \memo cycling), direct expansion (DX) cooling coil, heating coil (gas, electric,
  61510         \memo hot water, steam, or DX air-to-air heat pump) and bypass damper for variable volume
  61511         \memo flow to terminal units. Used with AirTerminal:SingleDuct:VAV:HeatAndCool:Reheat
  61512         \memo or AirTerminal:SingleDuct:VAV:HeatAndCool:NoReheat.
  61513         \min-fields 23
  61514    A1,  \field Name
  61515         \required-field
  61516         \type alpha
  61517         \note Enter a unique name for this unitary system.
  61518         \reference-class-name validBranchEquipmentTypes
  61519         \reference validBranchEquipmentNames
  61520    A2 , \field Availability Schedule Name
  61521         \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  61522         \note If this field is blank, the system is always available.
  61523         \type object-list
  61524         \object-list ScheduleNames
  61525         \note Enter the availability schedule name. Schedule values of zero denote system
  61526         \note is Off. Non-zero schedule values denote system is available to operate.
  61527    N1 , \field Cooling Supply Air Flow Rate
  61528         \required-field
  61529         \type real
  61530         \units m3/s
  61531         \autosizable
  61532         \minimum> 0.0
  61533         \note Enter the system air flow rate during cooling
  61534         \note operation or specify autosize.
  61535    N2 , \field Heating Supply Air Flow Rate
  61536         \required-field
  61537         \type real
  61538         \units m3/s
  61539         \autosizable
  61540         \minimum> 0.0
  61541         \note Enter the system air flow rate during heating
  61542         \note operation or specify autosize.
  61543    N3 , \field No Load Supply Air Flow Rate
  61544         \type real
  61545         \units m3/s
  61546         \minimum 0.0
  61547         \autosizable
  61548         \note Only used when the supply air fan operating mode is continuous (see field
  61549         \note Supply air fan operating mode schedule name). This system air flow rate
  61550         \note is used when no heating or cooling is required and the coils are off.
  61551         \note If this field is left blank or zero, the system air flow rate from the
  61552         \note previous on cycle (either cooling or heating) is used.
  61553    N4 , \field Cooling Outdoor Air Flow Rate
  61554         \required-field
  61555         \type real
  61556         \units m3/s
  61557         \autosizable
  61558         \minimum 0.0
  61559         \note Enter the outdoor air flow rate during
  61560         \note cooling operation or specify autosize.
  61561    N5 , \field Heating Outdoor Air Flow Rate
  61562         \required-field
  61563         \type real
  61564         \units m3/s
  61565         \autosizable
  61566         \minimum 0.0
  61567         \note Enter the outdoor air flow rate during
  61568         \note heating operation or specify autosize.
  61569    N6 , \field No Load Outdoor Air Flow Rate
  61570         \type real
  61571         \units m3/s
  61572         \minimum 0.0
  61573         \autosizable
  61574         \note Only used when the supply air fan operating mode is continuous (see field
  61575         \note Supply air fan operating mode schedule name). This outdoor air flow rate
  61576         \note is used when no heating or cooling is required and the coils are off.
  61577         \note If this field is left blank or zero, the outdoor air flow rate from the previous on cycle
  61578         \note (either cooling or heating) is used.
  61579    A3 , \field Outdoor Air Flow Rate Multiplier Schedule Name
  61580         \type object-list
  61581         \object-list ScheduleNames
  61582         \note Enter the name of a schedule that contains multipliers for the outdoor air
  61583         \note flow rates. Schedule values must be from 0 to 1.
  61584         \note If field is left blank, model assumes multiplier is 1 for the entire simulation period.
  61585    A4 , \field Air Inlet Node Name
  61586         \required-field
  61587         \type node
  61588         \note Enter the name of the unitary system's air inlet node.
  61589    A5 , \field Bypass Duct Mixer Node Name
  61590         \required-field
  61591         \type node
  61592         \note Enter the name of the bypass duct mixer node. This name should be the name
  61593         \note of the return air node for the outdoor air mixer associated with this system.
  61594         \note This node name must be different from the air inlet node name.
  61595    A6 , \field Bypass Duct Splitter Node Name
  61596         \required-field
  61597         \type node
  61598         \note Enter the name of the bypass duct splitter node.
  61599         \note This splitter air node is the outlet node of the last component in this unitary
  61600         \note system. For blow through fan placement, the splitter air node is the outlet
  61601         \note node of the heating coil. For draw through fan placement, the splitter node
  61602         \note is the outlet node of the supply air fan.
  61603    A7 , \field Air Outlet Node Name
  61604         \required-field
  61605         \type node
  61606         \note Enter the name of the unitary system's air outlet node.
  61607    A8,  \field Outdoor Air Mixer Object Type
  61608         \required-field
  61609         \type choice
  61610         \key OutdoorAir:Mixer
  61611         \note currently only one type OutdoorAir:Mixer object is available.
  61612    A9 , \field Outdoor Air Mixer Name
  61613         \required-field
  61614         \type object-list
  61615         \object-list OutdoorAirMixers
  61616         \note Enter the name of the outdoor air mixer used with this unitary system.
  61617    A10, \field Supply Air Fan Object Type
  61618         \required-field
  61619         \type choice
  61620         \key Fan:SystemModel
  61621         \key Fan:OnOff
  61622         \key Fan:ConstantVolume
  61623         \note Specify the type of supply air fan used in this unitary system.
  61624    A11, \field Supply Air Fan Name
  61625         \required-field
  61626         \type object-list
  61627         \object-list FansCVandOnOff
  61628         \object-list FansSystemModel
  61629         \note Enter the name of the supply air fan used in this unitary system.
  61630    A12, \field Supply Air Fan Placement
  61631         \required-field
  61632         \type choice
  61633         \key BlowThrough
  61634         \key DrawThrough
  61635         \note Specify supply air fan placement as either blow through or draw through.
  61636         \note BlowThrough means the supply air fan is located before the cooling
  61637         \note coil. DrawThrough means the supply air fan is located after the heating coil.
  61638    A13, \field Supply Air Fan Operating Mode Schedule Name
  61639         \type object-list
  61640         \object-list ScheduleNames
  61641         \note Enter the name of a schedule to control the supply air fan. Schedule Name values of zero
  61642         \note mean that the supply air fan will cycle off if there is no cooling or heating load
  61643         \note in any of the zones being served by this system. Non-zero schedule values mean
  61644         \note that the supply air fan will operate continuously even if there is no cooling or
  61645         \note heating load in any of the zones being served. If this field is left blank,
  61646         \note the supply air fan will operate continuously for the entire simulation period.
  61647    A14, \field Cooling Coil Object Type
  61648         \required-field
  61649         \type choice
  61650         \key Coil:Cooling:DX:SingleSpeed
  61651         \key Coil:Cooling:DX:VariableSpeed
  61652         \key CoilSystem:Cooling:DX:HeatExchangerAssisted
  61653         \key Coil:Cooling:DX:TwoStageWithHumidityControlMode
  61654         \note Specify the type of cooling coil used in this unitary system.
  61655    A15, \field Cooling Coil Name
  61656         \required-field
  61657         \type object-list
  61658         \object-list CoolingCoilsDXMultiModeOrSingleSpeed
  61659         \object-list CoolingCoilsDXVariableSpeed
  61660         \note Enter the name of the cooling coil used in this unitary system.
  61661    A16, \field Heating Coil Object Type
  61662         \required-field
  61663         \type choice
  61664         \key Coil:Heating:DX:SingleSpeed
  61665         \key Coil:Heating:DX:VariableSpeed
  61666         \key Coil:Heating:Fuel
  61667         \key Coil:Heating:Electric
  61668         \key Coil:Heating:Water
  61669         \key Coil:Heating:Steam
  61670         \note works with DX, gas, electric, hot water and steam heating coils
  61671         \note Specify the type of heating coil used in this unitary system.
  61672    A17, \field Heating Coil Name
  61673         \required-field
  61674         \type object-list
  61675         \object-list HeatingCoilName
  61676         \object-list HeatingCoilsDXVariableSpeed
  61677         \note Enter the name of the heating coil used in this unitary system.
  61678    A18, \field Priority Control Mode
  61679         \type choice
  61680         \key CoolingPriority
  61681         \key HeatingPriority
  61682         \key ZonePriority
  61683         \key LoadPriority
  61684         \default ZonePriority
  61685         \note CoolingPriority = system provides cooling if any zone requires cooling.
  61686         \note HeatingPriority = system provides heating if any zone requires heating.
  61687         \note ZonePriority = system controlled based on the total number of zones
  61688         \note requiring cooling or heating (highest number of zones
  61689         \note in cooling or heating determines the system's operating mode).
  61690         \note LoadPriority = system provides cooling or heating based on total zone loads.
  61691    N7 , \field Minimum Outlet Air Temperature During Cooling Operation
  61692         \type real
  61693         \units C
  61694         \minimum> 0.0
  61695         \default 8.0
  61696         \note Specify the minimum outlet air temperature allowed for this unitary system
  61697         \note during cooling operation. This value should be less than the maximum outlet
  61698         \note air temperature during heating operation.
  61699    N8 , \field Maximum Outlet Air Temperature During Heating Operation
  61700         \type real
  61701         \units C
  61702         \minimum> 0.0
  61703         \default 50.0
  61704         \note Specify the maximum outlet air temperature allowed for this unitary system
  61705         \note during heating operation. This value should be greater than the minimum outlet
  61706         \note air temperature during cooling operation.
  61707    A19, \field Dehumidification Control Type
  61708         \type choice
  61709         \key None
  61710         \key Multimode
  61711         \key CoolReheat
  61712         \default None
  61713         \note None = meet sensible load only.
  61714         \note Multimode = activate enhanced dehumidification mode
  61715         \note as needed and meet sensible load.  Valid only with
  61716         \note Coil:Cooling:DX:TwoStageWithHumidityControlMode.
  61717         \note CoolReheat = cool beyond the Dry-Bulb temperature setpoint
  61718         \note as required to meet the humidity setpoint.  Valid only with
  61719         \note Coil:Cooling:DX:TwoStageWithHumidityControlMode.
  61720         \note For all dehumidification controls, the max humidity setpoint
  61721         \note on this unitary system's air outlet node is used.
  61722         \note This must be set using ZoneControl:Humidistat and
  61723         \note SetpointManager:SingleZone:Humidity:Maximum,
  61724         \note SetpointManager:MultiZone:Humidity:Maximum or
  61725         \note SetpointManager:MultiZone:MaximumHumidity:Average objects.
  61726    A20, \field Plenum or Mixer Inlet Node Name
  61727         \type node
  61728         \note Enter the name of the bypass duct node connected to a plenum or mixer.
  61729         \note This field is required when this HVAC System is connected to a plenum or mixer.
  61730         \note This is a different node name than that entered in the Bypass Duct Splitter Node Name field.
  61731    N9 ; \field Minimum Runtime Before Operating Mode Change
  61732         \type real
  61733         \units hr
  61734         \minimum 0.0
  61735         \default 0.25
  61736         \note This is the minimum amount of time the unit operates in cooling or heating mode before changing modes.

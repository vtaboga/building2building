  51058         \required-field
  51059         \type object-list
  51060         \object-list UnivariateFunctions
  51061         \note quadratic curve = a + b*PLR + c*PLR**2
  51062         \note cubic curve = a + b*PLR + c*PLR**2 + d*PLR**3
  51063         \note PLR = part load ratio (cooling load/steady state capacity)
  51064    A5,  \field Condenser Air Inlet Node Name

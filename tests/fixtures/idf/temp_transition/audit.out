  34838 ZoneHVAC:Dehumidifier:DX,
  34839         \memo This object calculates the performance of zone (room) air dehumidifiers.
  34840         \memo Meant to model conventional direct expansion (DX) cooling-based room air
  34841         \memo dehumidifiers (reject 100% of condenser heat to the zone air), but this
  34842         \memo object might be able to be used to model other room air dehumidifier types.
  34843         \min-fields 13
  34844    A1,  \field Name
  34845         \required-field
  34846         \type alpha
  34847         \reference ZoneEquipmentNames
  34848         \note Unique name for this direct expansion (DX) zone dehumidifier object.
  34849    A2,  \field Availability Schedule Name
  34850         \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  34851         \note If this field is blank, the system is always available.
  34852         \type object-list
  34853         \object-list ScheduleNames
  34854         \note Schedule values of 0 denote the unit is off.
  34855         \note Schedule values >0.0 (usually 1.0) indicate that the dehumidifier is available to operate.
  34856    A3 , \field Air Inlet Node Name
  34857         \required-field
  34858         \type node
  34859         \note Air inlet node for the dehumidifier must be a zone air exhaust node.
  34860    A4 , \field Air Outlet Node Name
  34861         \required-field
  34862         \type node
  34863         \note Air outlet node for the dehumidifier must be a zone air inlet node.
  34864    N1,  \field Rated Water Removal
  34865         \required-field
  34866         \type real
  34867         \units L/day
  34868         \minimum> 0.0
  34869         \note Rating point: air entering dehumidifier at 26.7 C (80 F) dry-bulb and 60% relative humidity.
  34870    N2,  \field Rated Energy Factor
  34871         \required-field
  34872         \type real
  34873         \units L/kWh
  34874         \minimum> 0.0
  34875         \note Rating point: air entering dehumidifier at 26.7 C (80 F) dry-bulb and 60% relative humidity.
  34876    N3,  \field Rated Air Flow Rate
  34877         \required-field
  34878         \type real
  34879         \units m3/s
  34880         \minimum> 0.0
  34881    A5,  \field Water Removal Curve Name
  34882         \required-field
  34883         \type object-list
  34884         \object-list BivariateFunctions
  34885         \note Name of a curve that describes the water removal rate (normalized to rated conditions)
  34886         \note as a function of the dry-bulb temperature and relative humidity of the air
  34887         \note entering the dehumidifier.
  34888         \note Curve output = (actual water removal/rated water removal) = a + b*T + c*T**2 + d*RH +
  34889         \note                                                             e*RH**2 + f*T*RH
  34890         \note T = inlet air dry-bulb temperature (C)
  34891         \note RH = inlet air RH (%)
  34892    A6,  \field Energy Factor Curve Name
  34893         \required-field
  34894         \type object-list
  34895         \object-list BivariateFunctions
  34896         \note Name of a curve that describes the energy factor (normalized to rated conditions)
  34897         \note as a function of the dry-bulb temperature and relative humidity of the air
  34898         \note entering the dehumidifier.
  34899         \note Curve output = (actual energy factor/rated energy factor) = a + b*T + c*T**2 + d*RH +
  34900         \note                                                             e*RH**2 + f*T*RH
  34901         \note T = inlet air dry-bulb temperature (C)
  34902         \note RH = inlet air RH (%)
  34903    A7,  \field Part Load Fraction Correlation Curve Name
  34904         \required-field
  34905         \type object-list
  34906         \object-list UnivariateFunctions
  34907         \note Name of a curve that describes the part load fraction (PLF) of the system as
  34908         \note a function of the part load ratio. Used to calculate dehumidifier run time fraction
  34909         \note and electric power.
  34910         \note quadratic curve = a + b*PLR + c*PLR**2
  34911         \note cubic curve = a + b*PLR + c*PLR**2 + d*PLR**3
  34912         \note PLR = part load ratio (dehumidification load/steady state water removal capacity)
  34913    N4,  \field Minimum Dry-Bulb Temperature for Dehumidifier Operation
  34914         \type real
  34915         \units C
  34916         \default 10.0
  34917         \note Dehumidifier shut off if inlet air (zone) temperature is below this value.
  34918         \note This value must be less than the Maximum Dry-Bulb Temperature for Dehumidifier Operation.
  34919    N5,  \field Maximum Dry-Bulb Temperature for Dehumidifier Operation
  34920         \type real
  34921         \units C
  34922         \default 35.0
  34923         \note Dehumidifier shut off if inlet air (zone) temperature is above this value.
  34924         \note This value must be greater than the Minimum Dry-Bulb Temperature for Dehumidifier Operation.
  34925    N6,  \field Off-Cycle Parasitic Electric Load
  34926         \type real
  34927         \units W
  34928         \minimum 0.0
  34929         \default 0.0
  34930         \note Parasitic electric power consumed when the dehumidifier is available to operate, but
  34931         \note does not operate (i.e., no high humidity load to be met).
  34932         \note Off cycle parasitic power is 0 when the availability schedule is 0.
  34933         \note This electric load is considered as a heat gain to the zone air.
  34934    A8;  \field Condensate Collection Water Storage Tank Name
  34935         \type object-list
  34936         \object-list WaterStorageTankNames
  34937         \note Name of storage tank used to collect water removed by the dehumidifier.
  34938 
  34939 ZoneHVAC:EnergyRecoveryVentilator,
  34940         \memo This compound component models a stand-alone energy recovery ventilator (ERV)
  34941         \memo that conditions outdoor ventilation air and supplies that air directly to a zone.
  34942         \memo The ERV unit is modeled as a collection of components: air-to-air heat exchanger,
  34943         \memo supply air fan, exhaust air fan and an optional controller to avoid overheating
  34944         \memo of the supply air (economizer or free cooling operation).
  34945         \min-fields 7
  34946   A1,  \field Name
  34947         \required-field
  34948         \type alpha
  34949         \reference ZoneEquipmentNames
  34950   A2 ,  \field Availability Schedule Name
  34951         \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  34952         \note If this field is blank, the system is always available.
  34953         \type object-list
  34954         \object-list ScheduleNames
  34955   A3 ,  \field Heat Exchanger Name
  34956         \required-field
  34957         \note Heat exchanger type must be HeatExchanger:AirToAir:SensibleAndLatent
  34958         \type object-list
  34959         \object-list HXAirToAirSensibleAndLatentNames
  34960   N1 ,  \field Supply Air Flow Rate
  34961         \required-field
  34962         \autosizable
  34963         \type real
  34964         \minimum> 0.0
  34965         \units m3/s
  34966         \note This flow rate must match the supply fan's air flow rate.
  34967   N2 ,  \field Exhaust Air Flow Rate
  34968         \required-field
  34969         \autosizable
  34970         \type real
  34971         \minimum> 0.0
  34972         \units m3/s
  34973         \note This flow rate must match the supply fan air flow rate.
  34974   A4 ,  \field Supply Air Fan Name
  34975         \required-field
  34976         \note Fan type must be Fan:OnOff or Fan:SystemModel
  34977         \type object-list
  34978         \object-list FansOnOff
  34979         \object-list FansSystemModel
  34980   A5 ,  \field Exhaust Air Fan Name
  34981         \required-field
  34982         \note Fan type must be Fan:OnOff or Fan:SystemModel
  34983         \type object-list
  34984         \object-list FansOnOff
  34985         \object-list FansSystemModel
  34986   A6 ,  \field Controller Name
  34987         \note Enter the name of a ZoneHVAC:EnergyRecoveryVentilator:Controller object.
  34988         \type object-list
  34989         \object-list ControllerStandAloneEnergyRecoveryVentilator
  34990   N3 ,  \field Ventilation Rate per Unit Floor Area
  34991         \type real
  34992         \units m3/s-m2
  34993         \minimum 0.0
  34994         \note 0.000508 m3/s-m2 corresponds to 0.1 ft3/min-ft2
  34995         \note Used only when supply and exhaust air flow rates are autosized.
  34996   N4 ,  \field Ventilation Rate per Occupant
  34997         \type real
  34998         \units m3/s-person
  34999         \minimum 0.0
  35000         \note 0.00236 m3/s-person corresponds to 5 ft3/min-person
  35001         \note Used only when supply and exhaust air flow rates are autosized.
  35002   A7;   \field Availability Manager List Name
  35003         \note Enter the name of an AvailabilityManagerAssignmentList object.
  35004         \type object-list
  35005         \object-list SystemAvailabilityManagerLists
  35006 
  35007 ZoneHVAC:EnergyRecoveryVentilator:Controller,
  35008        \memo This controller is used exclusively by the ZoneHVAC:EnergyRecoveryVentilator object
  35009        \memo to allow economizer (free cooling) operation when possible.
  35010        \min-fields 3
  35011   A1 , \field Name
  35012        \required-field
  35013        \type alpha
  35014        \reference ControllerStandAloneEnergyRecoveryVentilator
  35015   N1 , \field Temperature High Limit
  35016        \type real
  35017        \units C
  35018        \note Enter the maximum outdoor dry-bulb temperature limit for economizer operation.
  35019        \note No input or blank input means this limit is not operative
  35020   N2 , \field Temperature Low Limit
  35021        \type real
  35022        \units C
  35023        \note Enter the minimum outdoor dry-bulb temperature limit for economizer operation.
  35024        \note No input or blank input means this limit is not operative
  35025   N3 , \field Enthalpy High Limit
  35026        \type real
  35027        \units J/kg
  35028        \note Enter the maximum outdoor enthalpy limit for economizer operation.
  35029        \note No input or blank input means this limit is not operative
  35030   N4 , \field Dewpoint Temperature Limit
  35031        \type real
  35032        \units C
  35033        \note Enter the maximum outdoor dew point temperature limit for economizer operation.
  35034        \note No input or blank input means this limit is not operative
  35035   A2 , \field Electronic Enthalpy Limit Curve Name
  35036        \type object-list
  35037        \object-list UnivariateFunctions
  35038        \note Enter the name of a quadratic or cubic curve which defines the maximum outdoor
  35039        \note humidity ratio (function of outdoor dry-bulb temperature) for economizer operation.
  35040        \note No input or blank input means this limit is not operative
  35041   A3 , \field Exhaust Air Temperature Limit
  35042        \type choice
  35043        \key ExhaustAirTemperatureLimit
  35044        \key NoExhaustAirTemperatureLimit
  35045        \default NoExhaustAirTemperatureLimit
  35046   A4 , \field Exhaust Air Enthalpy Limit
  35047        \type choice
  35048        \key ExhaustAirEnthalpyLimit
  35049        \key NoExhaustAirEnthalpyLimit
  35050        \default NoExhaustAirEnthalpyLimit
  35051   A5 , \field Time of Day Economizer Flow Control Schedule Name
  35052        \type object-list
  35053        \object-list ScheduleNames
  35054        \note Schedule values greater than 0 indicate economizer operation is active. This
  35055        \note schedule may be used with or without the High Humidity Control option.
  35056        \note When used together, high humidity control has priority over economizer control.
  35057   A6 , \field High Humidity Control Flag
  35058        \type choice
  35059        \key Yes
  35060        \key No
  35061        \default No
  35062        \note Select Yes to modify air flow rates based on a zone humidistat.
  35063        \note Select No to disable this feature.
  35064   A7 , \field Humidistat Control Zone Name
  35065        \type object-list
  35066        \object-list ZoneNames
  35067        \note Enter the name of the zone where the humidistat is located.
  35068   N5 , \field High Humidity Outdoor Air Flow Ratio
  35069        \type real
  35070        \minimum> 0.0
  35071        \default 1.0
  35072        \note Enter the ratio of supply (outdoor) air to the maximum supply air flow rate when modified
  35073        \note air flow rates are active based on high indoor humidity.
  35074   A8 ; \field Control High Indoor Humidity Based on Outdoor Humidity Ratio
  35075        \type choice
  35076        \key Yes
  35077        \key No
  35078        \default Yes
  35079        \note If NO is selected, the air flow rate is modified any time indoor relative
  35080        \note humidity is above humidistat setpoint. If YES is selected, outdoor air flow
  35081        \note rate is modified any time indoor relative humidity is above the humidistat
  35082        \note setpoint AND the outdoor humidity ratio is less than the indoor humidity ratio.
  35083 

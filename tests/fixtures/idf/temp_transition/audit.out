  71069   N23, \field Coefficient 3 of Fuel Input Curve
  71070   N24, \field Coefficient 1 of Temperature Based Fuel Input Curve
  71071   N25, \field Coefficient 2 of Temperature Based Fuel Input Curve
  71072   N26, \field Coefficient 3 of Temperature Based Fuel Input Curve
  71073   N27, \field Coefficient 1 of Exhaust Flow Curve
  71074   N28, \field Coefficient 2 of Exhaust Flow Curve
  71075   N29, \field Coefficient 3 of Exhaust Flow Curve
  71076   N30, \field Coefficient 1 of Exhaust Gas Temperature Curve
  71077   N31, \field Coefficient 2 of Exhaust Gas Temperature Curve
  71078   N32, \field Coefficient 3 of Exhaust Gas Temperature Curve
  71079   N33, \field Coefficient 1 of Temperature Based Exhaust Gas Temperature Curve
  71080   N34, \field Coefficient 2 of Temperature Based Exhaust Gas Temperature Curve
  71081   N35, \field Coefficient 3 of Temperature Based Exhaust Gas Temperature Curve
  71082   N36, \field Coefficient 1 of Recovery Lube Heat Curve
  71083   N37, \field Coefficient 2 of Recovery Lube Heat Curve
  71084   N38, \field Coefficient 3 of Recovery Lube Heat Curve
  71085   N39, \field Coefficient 1 of U-Factor Times Area Curve
  71086   N40, \field Coefficient 2 of U-Factor Times Area Curve
  71087        \note typical value .9
  71088        \maximum 2
  71089   N41, \field Gas Turbine Engine Capacity
  71090        \autosizable
  71091        \units W
  71092        \minimum> 0.0
  71093   N42, \field Maximum Exhaust Flow per Unit of Power Output
  71094        \units (kg/s)/W
  71095   N43, \field Design Steam Saturation Temperature
  71096        \units C
  71097   N44, \field Fuel Higher Heating Value
  71098        \units kJ/kg
  71099   N45, \field Design Heat Recovery Water Flow Rate
  71100        \units m3/s
  71101        \minimum 0.0
  71102        \default 0.0
  71103        \note If non-zero, then the heat recovery inlet and outlet node names must be entered.
  71104        \ip-units gal/min
  71105        \autosizable
  71106   A7 , \field Heat Recovery Inlet Node Name
  71107        \type node
  71108   A8 , \field Heat Recovery Outlet Node Name
  71109        \type node
  71110   A9 , \field Chiller Flow Mode
  71111        \note Select operating mode for fluid flow through the chiller. "NotModulated" is for
  71112        \note either variable or constant pumping with flow controlled by the external plant system.
  71113        \note "ConstantFlow" is for constant pumping with flow controlled by chiller to operate at
  71114        \note full design flow rate.  "LeavingSetpointModulated" is for variable pumping with flow
  71115        \note controlled by chiller to vary flow to target a leaving temperature setpoint.
  71116        \type choice
  71117        \key ConstantFlow
  71118        \key LeavingSetpointModulated
  71119        \key NotModulated
  71120        \default NotModulated
  71121   A10, \field Fuel Type
  71122        \type choice
  71123        \key NaturalGas
  71124        \key Propane
  71125        \key Diesel
  71126        \key Gasoline
  71127        \key FuelOilNo1
  71128        \key FuelOilNo2
  71129        \key OtherFuel1
  71130        \key OtherFuel2
  71131        \default NaturalGas
  71132   N46, \field Heat Recovery Maximum Temperature
  71133        \units C
  71134        \maximum 100.0
  71135        \minimum 0.0
  71136        \default 80.0
  71137   N47, \field Sizing Factor
  71138        \note Multiplies the autosized capacity and flow rates
  71139        \type real
  71140        \minimum> 0.0
  71141        \default 1.0
  71142   N48, \field Basin Heater Capacity
  71143        \type real
  71144        \units W/K
  71145        \minimum 0.0
  71146        \default 0.0
  71147        \note This field is only used for Condenser Type = EvaporativelyCooled and for periods
  71148        \note when the basin heater is available (field Basin Heater Operating Schedule Name).
  71149        \note For this situation, The heater maintains the basin water temperature at the basin heater
  71150        \note setpoint temperature when the outdoor air temperature falls below the setpoint temperature.
  71151        \note The basin heater only operates when the chiller is not operating.
  71152   N49, \field Basin Heater Setpoint Temperature
  71153        \type real
  71154        \units C
  71155        \minimum 2.0
  71156        \default 2.0
  71157        \note This field is only used for Condenser Type = EvaporativelyCooled.
  71158        \note Enter the outdoor dry-bulb temperature when the basin heater turns on.
  71159   A11, \field Basin Heater Operating Schedule Name
  71160        \type object-list
  71161        \object-list ScheduleNames
  71162        \note This field is only used for Condenser Type = EvaporativelyCooled.
  71163        \note Schedule values greater than 0 allow the basin heater to operate whenever the outdoor
  71164        \note air dry-bulb temperature is below the basin heater setpoint temperature.
  71165        \note If a schedule name is not entered, the basin heater is allowed to operate
  71166        \note throughout the entire simulation.
  71167   N50, \field Condenser Heat Recovery Relative Capacity Fraction
  71168        \note This optional field is the fraction of total rejected heat that can be recovered at full load.
  71169        \note Also used to autosize Design Heat Recovery Water Flow Rate as a fraction of Design Condenser Water Flow Rate.
  71170        \type real
  71171        \minimum 0.0
  71172        \maximum 1.0
  71173   N51; \field Turbine Engine Efficiency
  71174        \note This optional field is the nominal turbine engine efficiency and is used when Gas Turbine Engine Capacity is set to Autosize
  71175        \default 0.35
  71176        \type real
  71177 
  71178 ChillerHeater:Absorption:DirectFired,
  71179   \min-fields 34
  71180   \memo Direct fired gas absorption chiller-heater using performance curves similar to DOE-2
  71181   A1,  \field Name
  71182        \required-field
  71183        \reference-class-name validPlantEquipmentTypes
  71184        \reference validPlantEquipmentNames
  71185        \reference-class-name validBranchEquipmentTypes
  71186        \reference validBranchEquipmentNames
  71187   N1 , \field Nominal Cooling Capacity
  71188        \autosizable
  71189        \default autosize
  71190        \units W
  71191   N2 , \field Heating to Cooling Capacity Ratio
  71192        \note A positive fraction that represents the ratio of the
  71193        \note heating capacity divided by the cooling capacity at rated conditions.
  71194        \minimum  0
  71195        \default  0.8
  71196   N3 , \field Fuel Input to Cooling Output Ratio
  71197             \note The positive fraction that represents the ratio of the
  71198             \note instantaneous fuel used divided by the cooling capacity at rated conditions.
  71199             \minimum> 0
  71200             \default  0.97
  71201   N4   ,  \field Fuel Input to Heating Output Ratio
  71202             \note The positive fraction that represents the ratio of the
  71203             \note instantaneous fuel used divided by the nominal heating capacity.
  71204             \minimum  0
  71205             \default  1.25
  71206   N5   ,  \field Electric Input to Cooling Output Ratio
  71207             \note The positive fraction that represents the ratio of the
  71208             \note instantaneous electricity used divided by the cooling capacity at rated conditions.
  71209             \note If the chiller is both heating and cooling only the cooling electricity is used.
  71210             \minimum  0
  71211             \default  0.01
  71212   N6   ,  \field Electric Input to Heating Output Ratio
  71213             \note The positive fraction that represents the ratio of the
  71214             \note instantaneous electricity used divided by the nominal heating capacity.
  71215             \note If the chiller is both heating and cooling only the cooling electricity is used.
  71216             \minimum  0
  71217             \default  0
  71218   A2   ,  \field Chilled Water Inlet Node Name
  71219           \required-field
  71220           \type node
  71221   A3   ,  \field Chilled Water Outlet Node Name
  71222           \required-field
  71223           \type node
  71224   A4   ,  \field Condenser Inlet Node Name
  71225           \required-field
  71226           \type node
  71227   A5   ,  \field Condenser Outlet Node Name
  71228           \note Not required if air-cooled
  71229           \type node
  71230   A6   ,  \field Hot Water Inlet Node Name
  71231           \required-field
  71232           \type node
  71233   A7   ,  \field Hot Water Outlet Node Name
  71234           \required-field
  71235           \type node
  71236   N7   ,  \field Minimum Part Load Ratio
  71237             \note The positive fraction that represents the minimum cooling output possible when
  71238             \note operated continually at rated temperature conditions divided by the nominal
  71239             \note cooling capacity at those same conditions.  If the load on the chiller is below
  71240             \note this fraction the chiller will cycle.
  71241             \minimum> 0
  71242             \default  0.1
  71243   N8   ,  \field Maximum Part Load Ratio
  71244             \note The positive fraction that represents the maximum cooling output possible at
  71245             \note rated temperature conditions divided by the nominal cooling capacity at those
  71246             \note same conditions.  If greater than 1.0, the chiller is typically thought of as
  71247             \note capable of being overloaded.
  71248             \minimum  0.5
  71249             \default  1.0
  71250   N9   ,  \field Optimum Part Load Ratio
  71251             \note The positive fraction that represents the optimal cooling output at rated
  71252             \note temperature conditions divided by the nominal cooling capacity at those same
  71253             \note conditions.  It represents the most desirable operating point for the chiller.
  71254             \minimum> 0
  71255             \default  1.0
  71256   N10  ,  \field Design Entering Condenser Water Temperature
  71257             \note The temperature of the water entering the condenser of the chiller when
  71258             \note operating at design conditions.  This is usually based on the temperature
  71259             \note delivered by the cooling tower in a water cooled application.
  71260             \default 29
  71261             \units C
  71262   N11  ,  \field Design Leaving Chilled Water Temperature
  71263             \note The temperature of the water leaving the evaporator of the chiller when
  71264             \note operating at design conditions also called the chilled water supply temperature
  71265             \note or leaving chilled water temperature.
  71266             \default 7
  71267             \units C
  71268   N12 ,   \field Design Chilled Water Flow Rate
  71269             \note  For variable volume this is the max flow & for constant flow this is the flow.
  71270             \autosizable
  71271             \default autosize
  71272             \units m3/s
  71273             \ip-units gal/min
  71274   N13  ,  \field Design Condenser Water Flow Rate
  71275             \note The water flow rate at design conditions through the condenser.
  71276             \autosizable
  71277             \default autosize
  71278             \units m3/s
  71279             \ip-units gal/min
  71280             \note This field is not used for Condenser Type = AirCooled
  71281   N14  ,  \field Design Hot Water Flow Rate
  71282             \note The water flow rate at design conditions through the heater side.
  71283             \autosizable
  71284             \default autosize
  71285             \units m3/s
  71286             \ip-units gal/min
  71287   A8   ,  \field Cooling Capacity Function of Temperature Curve Name
  71288             \note The CoolCapFT curve represents the fraction of the cooling capacity of the chiller as it
  71289             \note varies by temperature.  The curve is normalized so that at design conditions the
  71290             \note value of the curve should be 1.0.  This is a biquadratic curve with the
  71291             \note input variables being the leaving chilled water temperature and either
  71292             \note the entering or leaving condenser water temperature.
  71293             \type object-list
  71294             \object-list BivariateFunctions
  71295   A9   ,  \field Fuel Input to Cooling Output Ratio Function of Temperature Curve Name
  71296             \note The curve represents the fraction of the fuel input to the chiller at full load as
  71297             \note it varies by temperature.  The curve is normalized so that at design conditions the
  71298             \note value of the curve should be 1.0.  This is a biquadratic curve with the
  71299             \note input variables being the leaving chilled water temperature and either
  71300             \note the entering or leaving condenser water temperature.
  71301             \type object-list
  71302             \object-list BivariateFunctions
  71303   A10  ,  \field Fuel Input to Cooling Output Ratio Function of Part Load Ratio Curve Name
  71304             \note The curve represents the fraction of the fuel input to the chiller as the load on
  71305             \note the chiller varies but the operating temperatures remain at the design values.
  71306             \note The curve is normalized so that at full load the value of the curve should be 1.0.
  71307             \note The curve is usually linear or quadratic.
  71308             \type object-list
  71309             \object-list UnivariateFunctions
  71310   A11  ,  \field Electric Input to Cooling Output Ratio Function of Temperature Curve Name
  71311             \note The curve represents the fraction of the electricity to the chiller at full load as
  71312             \note it varies by temperature.  The curve is normalized so that at design conditions the
  71313             \note value of the curve should be 1.0.  This is a biquadratic curve with the
  71314             \note input variables being the leaving chilled water temperature and either
  71315             \note the entering or leaving condenser water temperature.
  71316             \type object-list
  71317             \object-list BivariateFunctions
  71318   A12  ,  \field Electric Input to Cooling Output Ratio Function of Part Load Ratio Curve Name
  71319             \note The curve represents the fraction of the electricity to the chiller as the load on
  71320             \note the chiller varies but the operating temperatures remain at the design values.
  71321             \note The curve is normalized so that at full load the value of the curve should be 1.0.
  71322             \note The curve is usually linear or quadratic.
  71323             \type object-list
  71324             \object-list UnivariateFunctions
  71325   A13  ,  \field Heating Capacity Function of Cooling Capacity Curve Name
  71326             \note The curve represents how the heating capacity of the chiller varies with cooling
  71327             \note capacity when the chiller is simultaneous heating and cooling.  The curve is normalized
  71328             \note so an input of 1.0 represents the nominal cooling capacity and an output of 1.0
  71329             \note represents the full heating capacity (see the Heating to cooling capacity ratio input)
  71330             \note The curve is usually linear or quadratic.
  71331             \type object-list
  71332             \object-list UnivariateFunctions
  71333   A14  ,  \field Fuel Input to Heat Output Ratio During Heating Only Operation Curve Name
  71334             \note When the chiller is operating as only a heater, this curve is used to represent the
  71335             \note fraction of fuel used as the heating load varies.  It is normalized so that a value
  71336             \note of 1.0 is the full heating capacity.  The curve is usually linear or quadratic and
  71337             \note will probably be similar to a boiler curve for most chillers.
  71338             \type object-list
  71339             \object-list UnivariateFunctions
  71340   A15  ,  \field Temperature Curve Input Variable
  71341             \type choice
  71342             \key LeavingCondenser
  71343             \key EnteringCondenser
  71344             \default EnteringCondenser
  71345             \note Sets the second independent variable in the three temperature dependent performance
  71346             \note curves to either the leaving or entering condenser water temperature.  Manufacturers
  71347             \note express the performance of their chillers using either the leaving condenser water
  71348             \note temperature (to the tower) or the entering condenser water temperature (from the tower).
  71349   A16  ,  \field Condenser Type
  71350             \note The condenser can either be air cooled or connected to a cooling tower.
  71351             \type choice
  71352             \key AirCooled
  71353             \key WaterCooled
  71354             \default WaterCooled
  71355   N15  ,  \field Chilled Water Temperature Lower Limit
  71356             \note The chilled water supply temperature below which the chiller
  71357             \note will shut off.
  71358             \units C
  71359             \default 2.0
  71360   N16  ,  \field Fuel Higher Heating Value
  71361             \note Not currently used.
  71362             \units kJ/kg
  71363             \default 0.0
  71364   A17  ,  \field Fuel Type
  71365             \type choice
  71366             \key NaturalGas
  71367             \key Propane
  71368             \key Diesel
  71369             \key Gasoline
  71370             \key FuelOilNo1
  71371             \key FuelOilNo2
  71372             \key OtherFuel1
  71373             \key OtherFuel2
  71374             \default NaturalGas
  71375   N17  ;  \field Sizing Factor
  71376             \note Multiplies the autosized capacity and flow rates
  71377             \type real
  71378             \minimum> 0.0
  71379             \default 1.0

   8753        \type object-list
   8754        \object-list MaterialName
   8755   A4 , \field Layer 3
   8756        \type object-list
   8757        \object-list MaterialName
   8758   A5 , \field Layer 4
   8759        \type object-list
   8760        \object-list MaterialName

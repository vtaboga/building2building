   2530 \group Schedules
   2531 
   2532 ScheduleTypeLimits,
   2533        \memo ScheduleTypeLimits specifies the data types and limits for the values contained in schedules
   2534   A1,  \field Name
   2535        \required-field
   2536        \reference ScheduleTypeLimitsNames
   2537        \note used to validate schedule types in various schedule objects
   2538   N1,  \field Lower Limit Value
   2539        \note lower limit (real or integer) for the Schedule Type.  e.g. if fraction, this is 0.0
   2540        \unitsBasedOnField A3
   2541   N2,  \field Upper Limit Value
   2542        \note upper limit (real or integer) for the Schedule Type.  e.g. if fraction, this is 1.0
   2543        \unitsBasedOnField A3
   2544   A2,  \field Numeric Type
   2545        \note Numeric type is either Continuous (all numbers within the min and
   2546        \note max are valid or Discrete (only integer numbers between min and
   2547        \note max are valid.  (Could also allow REAL and INTEGER to mean the
   2548        \note same things)
   2549        \type choice
   2550        \key Continuous
   2551        \key Discrete
   2552   A3;  \field Unit Type
   2553        \note Temperature (C or F)
   2554        \note DeltaTemperature (C or F)
   2555        \note PrecipitationRate (m/hr or ft/hr)
   2556        \note Angle (degrees)
   2557        \note Convection Coefficient (W/m2-K or Btu/sqft-hr-F)
   2558        \note Activity Level (W/person)
   2559        \note Velocity (m/s or ft/min)
   2560        \note Capacity (W or Btu/h)
   2561        \note Power (W)
   2562        \type choice
   2563        \key Dimensionless
   2564        \key Temperature
   2565        \key DeltaTemperature
   2566        \key PrecipitationRate
   2567        \key Angle
   2568        \key ConvectionCoefficient
   2569        \key ActivityLevel
   2570        \key Velocity
   2571        \key Capacity
   2572        \key Power
   2573        \key Availability
   2574        \key Percent
   2575        \key Control
   2576        \key Mode
   2577        \default Dimensionless
   2578 
   2579 Schedule:Day:Hourly,
   2580        \min-fields 26
   2581        \memo A Schedule:Day:Hourly contains 24 values for each hour of the day.

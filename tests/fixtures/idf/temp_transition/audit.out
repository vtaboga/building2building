  51101    N11, \field Basin Heater Capacity
  51102         \type real
  51103         \units W/K
  51104         \minimum 0.0
  51105         \default 0.0
  51106         \note This field is only used for Condenser Type = EvaporativelyCooled and for periods
  51107         \note when the basin heater is available (field Basin Heater Operating Schedule Name).
  51108         \note For this situation, the heater maintains the basin water temperature at the basin heater
  51109         \note setpoint temperature when the outdoor air temperature falls below the setpoint temperature.
  51110         \note The basin heater only operates when the DX coil is off.
  51111    N12, \field Basin Heater Setpoint Temperature
  51112         \type real
  51113         \units C
  51114         \minimum 2.0
  51115         \default 2.0
  51116         \note This field is only used for Condenser Type = EvaporativelyCooled.
  51117         \note Enter the outdoor dry-bulb temperature when the basin heater turns on.
  51118    A9,  \field Basin Heater Operating Schedule Name
  51119         \type object-list
  51120         \object-list ScheduleNames
  51121         \note This field is only used for Condenser Type = EvaporativelyCooled.
  51122         \note Schedule values greater than 0 allow the basin heater to operate whenever the outdoor
  51123         \note air dry-bulb temperature is below the basin heater setpoint temperature.
  51124         \note If a schedule name is not entered, the basin heater is allowed to operate
  51125         \note throughout the entire simulation.

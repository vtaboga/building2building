  24164       \default .65
  24165       \minimum 0.5
  24166       \maximum 1.0
  24167       \note Enter the exponent used in the air mass flow equation.
  24168 
  24169 AirflowNetwork:MultiZone:Component:DetailedOpening,
  24170       \min-fields 16
  24171       \memo This object specifies the properties of airflow through windows and doors (window, door and
  24172       \memo glass door heat transfer subsurfaces) when they are closed or open.
  24173  A1 , \field Name
  24174       \required-field
  24175       \type alpha
  24176       \reference SurfaceAirflowLeakageNames
  24177       \note Enter a unique name for this object.
  24178  N1 , \field Air Mass Flow Coefficient When Opening is Closed
  24179       \required-field
  24180       \type real
  24181       \units kg/s-m
  24182       \minimum> 0
  24183       \note Defined at 1 Pa per meter of crack length. Enter the coefficient used in the following
  24184       \note equation:
  24185       \note Mass Flow Rate = Air Mass Flow Coefficient * (dP)^Air Mass Flow Exponent.
  24186       \note Used only when opening (window or door) is closed.
  24187  N2 , \field Air Mass Flow Exponent When Opening is Closed
  24188       \units dimensionless
  24189       \type real
  24190       \minimum 0.5
  24191       \maximum 1.0
  24192       \default 0.65
  24193       \note Enter the exponent used in the following equation:
  24194       \note Mass Flow Rate = Air Mass Flow Coefficient * (dP)^Air Mass Flow Exponent.
  24195       \note Used only when opening (window or door) is closed.
  24196  A2 , \field Type of Rectangular Large Vertical Opening (LVO)
  24197       \type choice
  24198       \key NonPivoted
  24199       \key HorizontallyPivoted
  24200       \note Select the type of vertical opening: Non-pivoted opening or Horizontally pivoted opening.
  24201       \default NonPivoted
  24202  N3 , \field Extra Crack Length or Height of Pivoting Axis
  24203       \type real
  24204       \units m
  24205       \minimum 0
  24206       \default 0
  24207       \note Extra crack length is used for LVO Non-pivoted type with multiple openable parts.
  24208       \note Height of pivoting axis is used for LVO Horizontally pivoted type.
  24209       \note Specifies window or door characteristics that depend on the LVO type.
  24210       \note For Non-pivoted Type (rectangular windows and doors), this field is the extra crack length
  24211       \note in meters due to multiple openable parts, if present.  Extra here means in addition
  24212       \note to the length of the cracks on the top, bottom and sides of the window/door.
  24213       \note For Horizontally pivoted Type, this field gives the height of the
  24214       \note pivoting axis measured from the bottom of the glazed part of the window (m).
  24215  N4 , \field Number of Sets of Opening Factor Data
  24216       \required-field
  24217       \type integer
  24218       \minimum 2
  24219       \maximum 4
  24220       \note Enter the number of the following sets of data for opening factor,
  24221       \note discharge coefficient, width factor, height factor, and start height factor.
  24222  N5 , \field Opening Factor 1
  24223       \type real
  24224       \units dimensionless
  24225       \minimum 0
  24226       \maximum 0
  24227       \default 0
  24228       \note This value must be specified as 0.
  24229  N6 , \field Discharge Coefficient for Opening Factor 1
  24230       \type real
  24231       \units dimensionless
  24232       \minimum> 0
  24233       \maximum 1
  24234       \default 0.001
  24235       \note The Discharge Coefficient indicates the fractional effectiveness
  24236       \note for air flow through a window or door at that Opening Factor.
  24237  N7 , \field Width Factor for Opening Factor 1
  24238       \type real
  24239       \units dimensionless
  24240       \minimum 0
  24241       \maximum 1
  24242       \default 0
  24243       \note The Width Factor is the opening width divided by the window or door width.
  24244  N8 , \field Height Factor for Opening Factor 1
  24245       \type real
  24246       \units dimensionless
  24247       \minimum 0
  24248       \maximum 1
  24249       \default 0
  24250       \note The Height Factor is the opening height divided by the window or door height.
  24251  N9 , \field Start Height Factor for Opening Factor 1
  24252       \type real
  24253       \units dimensionless
  24254       \minimum 0
  24255       \maximum 1
  24256       \default 0
  24257       \note The Start Height Factor is the Start Height divided by the window or door height.
  24258       \note Start Height is the distance between the bottom of the window or door and the
  24259       \note bottom of the window or door opening. The sum of the Height Factor and the Start Height
  24260       \note Factor must be less than 1.0 in order to have the opening within the window or door
  24261       \note dimensions.
  24262  N10, \field Opening Factor 2
  24263       \required-field
  24264       \type real
  24265       \units dimensionless
  24266       \minimum> 0
  24267       \maximum 1
  24268       \note If Number of Sets of Opening Factor Data = 2, this value must be 1.0.
  24269       \note If Number of Sets of Opening Factor Data = 3, this value must be less than 1.0.
  24270       \note If Number of Sets of Opening Factor Data = 4, this value must be less than the
  24271       \note value entered for Opening factor 3 and greater than the value entered
  24272       \note for Opening factor 1.
  24273  N11, \field Discharge Coefficient for Opening Factor 2
  24274       \type real
  24275       \units dimensionless
  24276       \minimum> 0
  24277       \maximum 1
  24278       \default 1
  24279       \note The Discharge Coefficient indicates the fractional effectiveness
  24280       \note for air flow through a window or door at that Opening Factor.
  24281  N12, \field Width Factor for Opening Factor 2
  24282       \type real
  24283       \units dimensionless
  24284       \minimum> 0
  24285       \maximum 1
  24286       \default 1
  24287       \note The Width Factor is the opening width divided by the window or door width.
  24288  N13, \field Height Factor for Opening Factor 2
  24289       \type real
  24290       \units dimensionless
  24291       \minimum> 0
  24292       \maximum 1
  24293       \default 1
  24294       \note The Height Factor is the opening height divided by the window or door height.
  24295  N14, \field Start Height Factor for Opening Factor 2
  24296       \type real
  24297       \units dimensionless
  24298       \minimum 0
  24299       \maximum< 1
  24300       \default 0
  24301       \note The Start Height Factor is the Start Height divided by the window or door height.
  24302       \note Start Height is the distance between the bottom of the window or door and the
  24303       \note bottom of the window or door opening. The sum of the Height Factor and the Start Height
  24304       \note Factor must be less than 1.0 in order to have the opening within the window or door
  24305       \note dimensions.
  24306  N15, \field Opening Factor 3
  24307       \type real
  24308       \units dimensionless
  24309       \minimum 0
  24310       \maximum 1
  24311       \note If Number of Sets of Opening Factor Data = 3, this value must be 1.0.
  24312       \note If Number of Sets of Opening Factor Data = 4, this value must be less than 1.0,
  24313       \note and greater than value entered for Opening factor 2.
  24314  N16, \field Discharge Coefficient for Opening Factor 3
  24315       \type real
  24316       \units dimensionless
  24317       \minimum 0
  24318       \maximum 1
  24319       \default 0
  24320       \note The Discharge Coefficient indicates the fractional effectiveness
  24321       \note for air flow through a window or door at that Opening Factor.
  24322  N17, \field Width Factor for Opening Factor 3
  24323       \type real
  24324       \units dimensionless
  24325       \minimum 0
  24326       \maximum 1
  24327       \default 0
  24328       \note The Width Factor is the opening width divided by the window or door width.
  24329  N18, \field Height Factor for Opening Factor 3
  24330       \type real
  24331       \units dimensionless
  24332       \minimum 0
  24333       \maximum 1
  24334       \default 0
  24335       \note The Height Factor is the opening height divided by the window or door height.
  24336  N19, \field Start Height Factor for Opening Factor 3
  24337       \type real
  24338       \units dimensionless
  24339       \minimum 0
  24340       \maximum 1
  24341       \default 0
  24342       \note The Start Height Factor is the Start Height divided by the window or door height.
  24343       \note Start Height is the distance between the bottom of the window or door and the
  24344       \note bottom of the window or door opening. The sum of the Height Factor and the Start Height
  24345       \note Factor must be less than 1.0 in order to have the opening within the window or door
  24346       \note dimensions.
  24347  N20, \field Opening Factor 4
  24348       \type real
  24349       \units dimensionless
  24350       \minimum 0
  24351       \maximum 1
  24352       \note If Number of Sets of Opening Factor Data = 4, this value must be 1.0
  24353  N21, \field Discharge Coefficient for Opening Factor 4
  24354       \type real
  24355       \units dimensionless
  24356       \minimum 0
  24357       \maximum 1
  24358       \default 0
  24359       \note The Discharge Coefficient indicates the fractional effectiveness
  24360       \note for air flow through a window or door at that Opening Factor.
  24361  N22, \field Width Factor for Opening Factor 4
  24362       \type real
  24363       \units dimensionless
  24364       \minimum 0
  24365       \maximum 1
  24366       \default 0
  24367       \note The Width Factor is the opening width divided by the window or door width.
  24368  N23, \field Height Factor for Opening Factor 4
  24369       \type real
  24370       \units dimensionless
  24371       \minimum 0
  24372       \maximum 1
  24373       \default 0
  24374       \note The Height Factor is the opening height divided by the window or door height.
  24375  N24; \field Start Height Factor for Opening Factor 4
  24376       \type real
  24377       \units dimensionless
  24378       \minimum 0
  24379       \maximum 1
  24380       \default 0
  24381       \note The Start Height Factor is the Start Height divided by the window or door height.
  24382       \note Start Height is the distance between the bottom of the window or door and the
  24383       \note bottom of the window or door opening. The sum of the Height Factor and the Start Height
  24384       \note Factor must be less than 1.0 in order to have the opening within the window or door
  24385       \note dimensions.
  24386 
  24387 AirflowNetwork:MultiZone:Component:SimpleOpening,
  24388       \min-fields 5
  24389       \memo This object specifies the properties of air flow through windows and doors (window, door and
  24390       \memo glass door heat transfer subsurfaces) when they are closed or open.
  24391  A1 , \field Name
  24392       \required-field
  24393       \type alpha
  24394       \reference SurfaceAirflowLeakageNames
  24395       \note Enter a unique name for this object.
  24396  N1 , \field Air Mass Flow Coefficient When Opening is Closed
  24397       \required-field
  24398       \type real
  24399       \minimum> 0
  24400       \units kg/s-m
  24401       \note Defined at 1 Pa pressure difference. Enter the coefficient used in the following equation:
  24402       \note Mass Flow Rate = Air Mass Flow Coefficient * (dP)^Air Mass Flow Exponent.
  24403       \note Used only when opening (window or door) is closed.

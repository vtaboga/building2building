  34358         \type object-list
  34359         \object-list HeatingCoilName
  34360         \note Needs to match in the heating coil object.
  34361    A11, \field Cooling Coil Object Type
  34362         \required-field
  34363         \type choice
  34364         \key Coil:Cooling:DX:SingleSpeed
  34365         \key Coil:Cooling:DX:VariableSpeed
  34366         \key CoilSystem:Cooling:DX:HeatExchangerAssisted
  34367         \note Select the type of Cooling Coil.
  34368         \note Only works with Coil:Cooling:DX:SingleSpeed or
  34369         \note CoilSystem:Cooling:DX:HeatExchangerAssisted or
  34370         \note Coil:Cooling:DX:VariableSpeed.
  34371    A12, \field Cooling Coil Name
  34372         \required-field
  34373         \type object-list
  34374         \object-list CoolingCoilsDXSingleSpeed
  34375         \object-list CoolingCoilsDXVariableSpeed
  34376         \note Needs to match a DX cooling coil object.
  34377    A13, \field Fan Placement
  34378         \type choice
  34379         \key BlowThrough
  34380         \key DrawThrough
  34381         \default DrawThrough
  34382         \note Select fan placement as either blow through or draw through.
  34383    A14, \field Supply Air Fan Operating Mode Schedule Name
  34384         \type object-list
  34385         \object-list ScheduleNames
  34386         \note Enter the name of a schedule that controls fan operation. Schedule Name values of 0 denote
  34387         \note cycling fan operation (fan cycles with cooling or heating coil). Schedule Name values greater
  34388         \note than 0 denote constant fan operation (fan runs continually regardless of coil operation).

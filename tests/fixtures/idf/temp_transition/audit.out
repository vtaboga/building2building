  68494 Pump:VariableSpeed,
  68495        \memo This pump model is described in the ASHRAE secondary HVAC toolkit.
  68496        \min-fields 14
  68497   A1 , \field Name
  68498        \required-field
  68499        \reference-class-name validBranchEquipmentTypes
  68500        \reference validBranchEquipmentNames
  68501   A2 , \field Inlet Node Name
  68502        \required-field
  68503        \type node
  68504   A3 , \field Outlet Node Name
  68505        \required-field
  68506        \type node
  68507   N1 , \field Design Maximum Flow Rate
  68508        \units m3/s
  68509        \autosizable
  68510        \ip-units gal/min
  68511        \minimum> 0
  68512   N2 , \field Design Pump Head
  68513        \units Pa
  68514        \default 179352
  68515        \note default head is 60 feet
  68516        \ip-units ftH2O
  68517   N3 , \field Design Power Consumption
  68518        \note When autosized the type of scaling factor is chosen in the input field Design Power Sizing Method
  68519        \units W
  68520        \autosizable
  68521        \ip-units W
  68522   N4 , \field Motor Efficiency
  68523        \note This is the motor efficiency only. When the Design Power Consumption is autosized using PowerPerFlowPerPressure,
  68524        \note the Design Shaft Power per Unit Flow Rate per Unit Head is used in addition to the motor efficiency.
  68525        \type real
  68526        \minimum> 0.0
  68527        \maximum 1.0
  68528        \default 0.9
  68529   N5 , \field Fraction of Motor Inefficiencies to Fluid Stream
  68530        \minimum 0.0
  68531        \maximum 1.0
  68532        \default 0.0
  68533   N6 , \field Coefficient 1 of the Part Load Performance Curve
  68534        \default 0.0
  68535   N7 , \field Coefficient 2 of the Part Load Performance Curve
  68536        \default 1.0
  68537   N8 , \field Coefficient 3 of the Part Load Performance Curve
  68538        \default 0.0
  68539   N9 , \field Coefficient 4 of the Part Load Performance Curve
  68540        \default 0.0
  68541   N10, \field Design Minimum Flow Rate
  68542         \note When autosized the scaling factor is the input field Design Minimum Flow Rate Fraction
  68543         \units m3/s
  68544         \autosizable
  68545         \default autosize
  68546         \ip-units gal/min
  68547   A4 , \field Pump Control Type
  68548         \type choice
  68549         \key Continuous
  68550         \key Intermittent
  68551         \default Continuous
  68552   A5 , \field Pump Flow Rate Schedule Name
  68553         \note Modifies the rated flow rate of the pump on a time basis. Default is
  68554         \note that the pump is on and runs according to its other operational requirements
  68555         \note specified above.  The schedule is for special pump operations.
  68556         \type object-list
  68557         \object-list ScheduleNames
  68558   A6 , \field Pump Curve Name
  68559         \type object-list
  68560         \object-list UnivariateFunctions
  68561         \note This references any single independent variable polynomial curve in order to
  68562         \note  do pressure vs. flow calculations for this pump.  The available types are then:
  68563         \note  Linear, Quadratic, Cubic, and Quartic
  68564         \note The non-dimensional pump pressure relationship is of the following form:
  68565         \note  (psi = C4*phi^4 + C3*phi^3 + C2*phi^2 + C1*phi + C0)
  68566         \note Where the non-dimensional variables are defined as:
  68567         \note  delP = rho * ((N/60)^2) * (D^2) * psi
  68568         \note  mdot = rho * (N/60) * (D^3) * phi
  68569   N11 , \field Impeller Diameter
  68570         \units m
  68571         \type real
  68572         \note "D" in above expression in field A6
  68573   A7 ,  \field VFD Control Type
  68574         \type choice
  68575         \key ManualControl
  68576         \key PressureSetpointControl
  68577   A8 ,  \field Pump RPM Schedule Name
  68578         \note Modifies the rpm of the pump on a time basis. Default is
  68579         \note that the pump is on and runs according to its other operational requirements
  68580         \note specified above.  The schedule is for special pump operations.
  68581         \type object-list
  68582         \object-list ScheduleNames
  68583   A9 ,  \field Minimum Pressure Schedule
  68584         \units Pa
  68585         \type object-list
  68586         \object-list ScheduleNames
  68587   A10,  \field Maximum Pressure Schedule
  68588         \units Pa
  68589         \type object-list
  68590         \object-list ScheduleNames
  68591   A11,  \field Minimum RPM Schedule
  68592         \units rev/min
  68593         \type object-list
  68594         \object-list ScheduleNames
  68595   A12,  \field Maximum RPM Schedule
  68596         \units rev/min
  68597         \type object-list
  68598         \object-list ScheduleNames
  68599   A13,  \field Zone Name
  68600         \note optional, if used pump losses transfered to zone as internal gains
  68601         \type object-list
  68602         \object-list ZoneNames
  68603   N12,  \field Skin Loss Radiative Fraction
  68604         \note optional. If zone identified in previous field then this determines
  68605         \note the split between convection and radiation for the skin losses
  68606         \type real
  68607         \minimum 0.0
  68608         \maximum 1.0
  68609   A14,  \field Design Power Sizing Method
  68610         \note Used to indicate which sizing factor is used to calculate Design Power Consumption.
  68611         \type choice
  68612         \key PowerPerFlow
  68613         \note PowerPerFlow indicates that Design Electric Power per Unit Flow Rate is used as scaling factor.
  68614         \note Design Power Consumption = Design Maximum Flow Rate * scaling factor
  68615         \key PowerPerFlowPerPressure
  68616         \note PowerPerFlowPerPressure indicates that Design Shaft Power per Unit Flow Rate per Unit Head is used as scaling factor.
  68617         \note Design Power Consumption = Design Maximum Flow Rate * Design Pump Head * scaling factor / Motor Efficiency
  68618         \default PowerPerFlowPerPressure
  68619   N13,  \field Design Electric Power per Unit Flow Rate
  68620         \type real
  68621         \note Used to size Design Power Consumption from design flow rate
  68622         \default 348701.1
  68623         \units W/(m3/s)
  68624         \ip-units W/(gal/min)
  68625         \minimum> 0
  68626   N14,  \field Design Shaft Power per Unit Flow Rate per Unit Head
  68627         \type real
  68628         \note Used to size Design Power Consumption from design flow rate for head and motor efficiency
  68629         \default 1.282051282
  68630         \units W/((m3/s)-Pa)
  68631         \ip-units W/((gal/min)-ftH20)
  68632         \minimum> 0
  68633   N15,  \field Design Minimum Flow Rate Fraction
  68634         \type real
  68635         \note Used to size Design Minimum Flow Rate
  68636         \default 0.0
  68637         \minimum 0
  68638         \maximum 1.0
  68639   A15; \field End-Use Subcategory
  68640        \note Any text may be used here to categorize the end-uses in the ABUPS End Uses by Subcategory table.
  68641        \type alpha
  68642        \retaincase
  68643        \default General

   6844        \note Spectral is not currently supported and SpectralAverage is the default.
   6845   A3 , \field Window Glass Spectral Data Set Name
   6846        \note Spectral data is not currently supported.
   6847        \note Used only when Optical Data Type = Spectral
   6848        \type object-list
   6849        \object-list SpectralDataSets
   6850   N1 , \field Front Side Beam-Beam Solar Transmittance
   6851        \note Used only when Optical Data Type = SpectralAverage
   6852        \required-field
   6853        \type real
   6854        \units dimensionless
   6855        \minimum 0.0
   6856        \maximum 1.0
   6857   N2 , \field Back Side Beam-Beam Solar Transmittance
   6858        \note Used only when Optical Data Type = SpectralAverage
   6859        \required-field
   6860        \type real
   6861        \units dimensionless
   6862        \minimum 0.0
   6863        \maximum 1.0
   6864   N3 , \field Front Side Beam-Beam Solar Reflectance
   6865        \note Used only when Optical Data Type = SpectralAverage
   6866        \note Front Side is side closest to outdoor air
   6867        \required-field
   6868        \type real
   6869        \units dimensionless

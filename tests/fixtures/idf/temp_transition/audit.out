  16745        \units m
  16746        \type real
  16747        \minimum> 0.0
  16748   A4,  \field Exterior Horizontal Insulation Material Name
  16749        \type object-list
  16750        \object-list MaterialName
  16751   N5,  \field Exterior Horizontal Insulation Depth
  16752        \note Distance from the exterior grade to the top of exterior horizontal
  16753        \note insulation
  16754        \units m
  16755        \type real
  16756        \minimum 0.0
  16757   N6,  \field Exterior Horizontal Insulation Width
  16758        \note Extent of insulation as measured from the wall exterior

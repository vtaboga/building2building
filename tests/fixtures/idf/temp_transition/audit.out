  19499 \group Room Air Models
  19500 
  19501 RoomAirModelType,
  19502       \memo Selects the type of room air model to be used in a given zone. If no RoomAirModelType
  19503       \memo object is specified then the default Mixing model (all zone air at the same
  19504       \memo temperature) will be used.
  19505       \min-fields 4
  19506   A1, \field Name
  19507       \required-field
  19508       \type alpha
  19509   A2, \field Zone Name
  19510       \required-field
  19511       \type object-list
  19512       \object-list ZoneNames
  19513   A3, \field Room-Air Modeling Type
  19514       \type choice
  19515       \key Mixing
  19516       \key UserDefined
  19517       \key OneNodeDisplacementVentilation
  19518       \key ThreeNodeDisplacementVentilation
  19519       \key CrossVentilation
  19520       \key UnderFloorAirDistributionInterior
  19521       \key UnderFloorAirDistributionExterior
  19522       \key AirflowNetwork
  19523       \default Mixing
  19524       \note Mixing = Complete mixing air model
  19525       \note UserDefined = UserDefined Room Air Temperature Patterns
  19526       \note needs RoomAir:TemperaturePattern:UserDefined object referencing this Zone
  19527       \note OneNodeDisplacementVentilation = Mundt roomair model for displacement ventilation with single floor air node
  19528       \note needs RoomAirSettings:OneNodeDisplacementVentilation object referencing this Zone
  19529       \note ThreeNodeDisplacementVentilation = RoomAir modeling using UCSD three-node displacement ventilation model
  19530       \note needs RoomAirSettings:ThreeNodeDisplacementVentilation object referencing this Zone
  19531       \note CrossVentilation = RoomAir modeling using UCSD two-zone cross ventilation model
  19532       \note needs RoomAirSettings:CrossVentilation object referencing this Zone
  19533       \note UnderFloorAirDistributionInterior = 2-Node UFAD model for interior zones
  19534       \note needs RoomAirSettings:UnderFloorAirDistributionInterior object referencing this Zone
  19535       \note UnderFloorAirDistributionExterior = RoomAir modeling using 2-Node UFAD model for exterior zones
  19536       \note needs RoomAirSettings:UnderFloorAirDistributionExterior object referencing this Zone
  19537       \note AirflowNetwork = RoomAir modeling using AirflowNetwork
  19538       \note needs RoomAirSettings:AirflowNetwork object referencing this Zone
  19539   A4; \field Air Temperature Coupling Strategy
  19540       \type choice
  19541       \key Direct
  19542       \key Indirect
  19543       \default Direct
  19544 
  19545 RoomAir:TemperaturePattern:UserDefined,
  19546        \memo Used to explicitly define temperature patterns that are to be applied to the mean air
  19547        \memo temperature within a thermal zone.  Used with RoomAirModelType = UserDefined.
  19548   A1 , \field Name
  19549        \required-field
  19550        \type alpha
  19551   A2 , \field Zone Name
  19552        \required-field
  19553        \type object-list
  19554        \object-list ZoneNames
  19555   A3 , \field Availability Schedule Name
  19556        \note Availability schedule name for this model. Schedule value > 0 means the model is
  19557        \note active. Schedule value = 0 means the model is inactive and the zone will be modeled
  19558        \note as fully mixed (Mixing). If this field is blank, the model is always active.
  19559        \type object-list
  19560        \object-list ScheduleNames
  19561   A4 ; \field Pattern Control Schedule Name
  19562        \required-field
  19563        \type object-list
  19564        \object-list ScheduleNames
  19565        \note The schedule should contain integer values that
  19566        \note correspond to unique Control Integer fields in
  19567        \note one of the RoomAir:TemperaturePattern:* objects.
  19568 
  19569 RoomAir:TemperaturePattern:ConstantGradient,
  19570       \memo Used to model room air with a fixed temperature gradient in the vertical direction.
  19571       \memo Used in combination with RoomAir:TemperaturePattern:UserDefined.
  19572   A1, \field Room Air Temperature Pattern Constant Gradient Name
  19573       \required-field
  19574       \type alpha
  19575   N1, \field Control Integer for Pattern Control Schedule Name
  19576       \note reference this entry in Schedule Name
  19577       \type integer
  19578       \required-field
  19579   N2, \field Thermostat Offset
  19580       \note = (Temp at thermostat- Mean Air Temp)
  19581       \units deltaC
  19582       \type real
  19583   N3, \field Return Air Offset
  19584       \note = (Tleaving - Mean Air Temp )
  19585       \units deltaC
  19586       \type real
  19587   N4, \field Exhaust Air Offset
  19588       \note = (Texhaust - Mean Air Temp) deg C
  19589       \units deltaC
  19590       \type real
  19591   N5; \field Temperature Gradient
  19592       \note Slope of temperature change in vertical direction
  19593       \units K/m
  19594       \type real
  19595 
  19596 RoomAir:TemperaturePattern:TwoGradient,
  19597       \memo Used to model room air with two temperature gradients in the vertical direction.
  19598       \memo Used in combination with RoomAir:TemperaturePattern:UserDefined.
  19599   A1, \field Room Air Temperature Pattern Two Gradient Name
  19600       \required-field
  19601       \type alpha
  19602   N1, \field Control Integer for Pattern Control Schedule Name
  19603       \note reference this entry in Schedule Name
  19604       \type integer
  19605       \required-field
  19606   N2, \field Thermostat Height
  19607       \note = Distance from floor of zone
  19608       \units m
  19609       \type real
  19610   N3, \field Return Air Height
  19611       \note = Distance from floor of zone
  19612       \units m
  19613       \type real
  19614   N4, \field Exhaust Air Height
  19615       \note = Distance from floor of zone
  19616       \units m
  19617       \type real
  19618   N5, \field Temperature Gradient Lower Bound
  19619       \note Slope of temperature change in vertical direction
  19620       \units K/m
  19621       \type real
  19622   N6, \field Temperature Gradient Upper  Bound
  19623       \note Slope of temperature change in vertical direction
  19624       \units K/m
  19625       \type real
  19626   A2, \field Gradient Interpolation Mode
  19627       \type choice
  19628       \key OutdoorDryBulbTemperature
  19629       \key ZoneDryBulbTemperature
  19630       \key ZoneAndOutdoorTemperatureDifference
  19631       \key SensibleCoolingLoad
  19632       \key SensibleHeatingLoad
  19633   N7, \field Upper Temperature Bound
  19634       \units C
  19635       \type real
  19636   N8, \field Lower Temperature Bound
  19637       \units C
  19638       \type real
  19639   N9, \field Upper Heat Rate Bound
  19640       \units W
  19641       \type real
  19642   N10; \field Lower Heat Rate Bound
  19643       \units W
  19644       \type real
  19645 
  19646 RoomAir:TemperaturePattern:NondimensionalHeight,
  19647       \memo Defines a distribution pattern for air temperatures relative to the current mean air
  19648       \memo temperature as a function of height. The height, referred to as Zeta, is nondimensional
  19649       \memo by normalizing with the zone ceiling height.
  19650       \memo Used in combination with RoomAir:TemperaturePattern:UserDefined.
  19651       \extensible:2 - repeat last two fields remembering to remove ; from "inner" fields.
  19652   A1, \field Name
  19653       \required-field
  19654       \type alpha
  19655   N1, \field Control Integer for Pattern Control Schedule Name
  19656       \note this value should appear in as a schedule value

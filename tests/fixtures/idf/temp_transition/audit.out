  82414        \key Temperature
  82415   A3 , \field HVAC Air Loop Name
  82416        \note Enter the name of an AirLoopHVAC object.
  82417        \required-field
  82418        \type object-list
  82419        \object-list AirPrimaryLoops
  82420   N1 , \field Minimum Setpoint Temperature
  82421        \units C
  82422        \type real
  82423        \minimum> 0.0
  82424        \default 12.
  82425   N2 , \field Maximum Setpoint Temperature
  82426        \units C
  82427        \type real
  82428        \minimum> 0.0
  82429        \default 18.
  82430   A4 , \field Strategy
  82431        \note For TemperatureFirst the manager tries to find the highest setpoint temperature
  82432        \note that will satisfy all the zone cooling loads at minimum supply air flow rate.
  82433        \note If this setpoint temperature is less than the minimum, the setpoint temperature is set
  82434        \note to the minimum, and the supply air flow rate is increased to meet the loads.
  82435        \note For FlowFirst the manager tries to find the lowest supply air flow rate
  82436        \note that will satisfy all the zone cooling loads at the maximum setpoint temperature.
  82437        \note If this flow is greater than the maximum, the flow is set to the maximum and the
  82438        \note setpoint temperature is reduced to satisfy the cooling loads.
  82439        \type choice
  82440        \key TemperatureFirst
  82441        \key FlowFirst
  82442        \default TemperatureFirst

   1258        \key Wednesday
   1259        \key Thursday
   1260        \key Friday
   1261        \key Saturday
   1262        \key SummerDesignDay
   1263        \key WinterDesignDay
   1264        \key CustomDay1
   1265        \key CustomDay2
   1266   A3,  \field Use Weather File Daylight Saving Period
   1267        \note If yes or blank, use daylight saving period as specified on Weatherfile.

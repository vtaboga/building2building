  56062         \type object-list
  56063         \object-list BivariateFunctions
  56064         \note curve = a + b*db + c*db**2 + d*ewt + e*ewt**2 + f*db*ewt
  56065         \note db = entering air dry-bulb temperature (C)
  56066         \note ewt = water entering temperature seen by the evaporator (C)
  56067    N51, \field Speed 10 Reference Unit Gross Rated Heating Capacity
  56068         \note Heating capacity not accounting for the effect of supply air fan heat
  56069         \units W
  56070         \type real
  56071         \minimum 0
  56072    N52, \field Speed 10 Reference Unit Gross Rated Heating COP
  56073         \type real
  56074         \units W/W
  56075         \minimum> 0.0
  56076    N53, \field Speed 10 Reference Unit Rated Air Flow Rate
  56077         \units m3/s
  56078         \type real
  56079         \minimum 0
  56080    N54, \field Speed 10 Reference Unit Rated Water Flow Rate
  56081         \units m3/s
  56082         \ip-units gal/min
  56083         \type real
  56084         \minimum 0
  56085    A70, \field Speed 10 Heating Capacity Function of Temperature Curve Name
  56086         \note optional
  56087         \type object-list
  56088         \object-list BivariateFunctions
  56089         \note curve = a + b*db + c*db**2 + d*ewt + e*ewt**2 + f*db*ewt
  56090         \note db = entering air dry-bulb temperature (C)
  56091         \note ewt = water entering temperature seen by the evaporator (C)
  56092    A71, \field Speed 10 Total  Heating Capacity Function of Air Flow Fraction Curve Name
  56093         \note optional
  56094         \type object-list
  56095         \object-list UnivariateFunctions
  56096         \note quadratic curve = a + b*ffa + c*ffa**2
  56097         \note cubic curve = a + b*ffa + c*ffa**2 + d*ffa**3
  56098         \note ffa = Fraction of the full load Air Flow
  56099    A72, \field Speed 10 Heating Capacity Function of Water Flow Fraction Curve Name
  56100         \note optional
  56101         \type object-list
  56102         \object-list UnivariateFunctions
  56103         \note quadratic curve = a + b*ffw + c*ffw**2
  56104         \note cubic curve = a + b*ffw + c*ffw**2 + d*ffw**3
  56105         \note ffw = Fraction of the full load Water Flow
  56106    A73, \field Speed 10 Energy Input Ratio Function of Temperature Curve Name
  56107         \note optional
  56108         \type object-list
  56109         \object-list BivariateFunctions
  56110         \note curve = a + b*db + c*db**2 + d*ewt + e*ewt**2 + f*db*ewt
  56111         \note db = entering air dry-bulb temperature (C)
  56112         \note ewt = water entering temperature seen by the evaporator (C)
  56113    A74, \field Speed 10 Energy Input Ratio Function of Air Flow Fraction Curve Name
  56114         \note optional
  56115         \type object-list
  56116         \object-list UnivariateFunctions
  56117         \note quadratic curve = a + b*ffa + c*ffa**2
  56118         \note cubic curve = a + b*ffa + c*ffa**2 + d*ffa**3
  56119         \note ffa = Fraction of the full load Air Flow
  56120    A75, \field Speed 10 Energy Input Ratio Function of Water Flow Fraction Curve Name
  56121         \note optional
  56122         \type object-list
  56123         \object-list UnivariateFunctions
  56124         \note quadratic curve = a + b*ffw + c*ffw**2
  56125         \note cubic curve = a + b*ffw + c*ffw**2 + d*ffw**3
  56126         \note ffw = Fraction of the full load Water Flow
  56127    N55, \field Speed 10 Reference Unit Waste Heat Fraction of Input Power At Rated Conditions
  56128         \units dimensionless
  56129         \type real
  56130         \minimum 0
  56131    A76; \field Speed 10 Waste Heat Function of Temperature Curve Name
  56132         \note optional
  56133         \type object-list
  56134         \object-list BivariateFunctions
  56135         \note curve = a + b*db + c*db**2 + d*ewt + e*ewt**2 + f*db*ewt

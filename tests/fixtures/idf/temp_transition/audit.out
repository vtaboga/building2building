   9181 Construction:WindowDataFile,
   9182        \memo Initiates search of the Window data file for a window called Name.
   9183   A1 , \field Name
   9184        \required-field
   9185        \type alpha
   9186        \reference ConstructionNames
   9187   A2 ; \field File Name
   9188        \retaincase
   9189        \note default file name is "Window5DataFile.dat"
   9190        \note limit on this field is 100 characters.
   9191 
   9192 \group Thermal Zones and Surfaces
   9193 
   9194 GlobalGeometryRules,
   9195       \memo Specifies the geometric rules used to describe the input of surface vertices and
   9196       \memo daylighting reference points.
   9197       \required-object
   9198       \unique-object
   9199   A1, \field Starting Vertex Position
   9200       \required-field
   9201       \note Specified as entry for a 4 sided surface/rectangle
   9202       \note Surfaces are specified as viewed from outside the surface
   9203       \note Shading surfaces as viewed from behind.  (towards what they are shading)
   9204       \type choice
   9205       \key UpperLeftCorner
   9206       \key LowerLeftCorner
   9207       \key UpperRightCorner
   9208       \key LowerRightCorner
   9209   A2, \field Vertex Entry Direction
   9210       \required-field
   9211       \type choice
   9212       \key Counterclockwise
   9213       \key Clockwise
   9214   A3, \field Coordinate System
   9215       \required-field
   9216       \note Relative -- coordinates are entered relative to zone origin
   9217       \note World -- all coordinates entered are "absolute" for this facility
   9218       \type choice
   9219       \key Relative
   9220       \key World
   9221   A4, \field Daylighting Reference Point Coordinate System
   9222       \type choice
   9223       \key Relative
   9224       \default Relative
   9225       \note Relative -- coordinates are entered relative to zone origin
   9226       \key World
   9227       \note World -- all coordinates entered are "absolute" for this facility
   9228   A5; \field Rectangular Surface Coordinate System
   9229       \type choice
   9230       \key Relative
   9231       \default Relative
   9232       \note Relative -- Starting corner is entered relative to zone origin
   9233       \key World
   9234       \note World -- Starting corner is entered in "absolute"
   9235 
   9236 GeometryTransform,
   9237       \memo Provides a simple method of altering the footprint geometry of a model. The intent
   9238       \memo is to provide a single parameter that can be used to reshape the building description
   9239       \memo contained in the rest of the input file.
   9240      \unique-object
   9241      \min-fields 3
   9242   A1, \field Plane of Transform
   9243       \type choice
   9244       \key XY
   9245       \default XY
   9246       \note only current allowed value is "XY"
   9247   N1, \field Current Aspect Ratio
   9248       \required-field
   9249       \minimum> 0
   9250       \note Aspect ratio of building as described in idf
   9251   N2; \field New Aspect Ratio
   9252       \required-field
   9253       \minimum> 0
   9254       \note Aspect ratio to transform to during run
   9255 
   9256 Zone,
   9257        \memo Defines a thermal zone of the building.
   9258   \format vertices
   9259   A1 , \field Name
   9260        \required-field
   9261        \type alpha
   9262        \reference ZoneNames
   9263        \reference OutFaceEnvNames
   9264        \reference ZoneAndZoneListNames
   9265        \reference AirflowNetworkNodeAndZoneNames
   9266   N1 , \field Direction of Relative North
   9267        \units deg
   9268        \type real
   9269        \default 0
   9270   N2 , \field X Origin
   9271        \units m
   9272        \type real
   9273        \default 0
   9274   N3 , \field Y Origin
   9275        \units m
   9276        \type real
   9277        \default 0
   9278   N4 , \field Z Origin
   9279        \units m
   9280        \type real
   9281        \default 0
   9282   N5 , \field Type
   9283        \type integer
   9284        \maximum 1
   9285        \minimum 1
   9286        \default 1
   9287   N6 , \field Multiplier
   9288        \type integer
   9289        \minimum 1
   9290        \default 1
   9291   N7 , \field Ceiling Height
   9292        \note If this field is 0.0, negative or autocalculate, then the average height
   9293        \note of the zone is automatically calculated and used in subsequent calculations.
   9294        \note If this field is positive, then the number entered here will be used.
   9295        \note Note that the Zone Ceiling Height is the distance from the Floor to
   9296        \note the Ceiling in the Zone, not an absolute height from the ground.
   9297        \units m
   9298        \type real
   9299        \autocalculatable
   9300        \default autocalculate
   9301   N8 , \field Volume
   9302        \note If this field is 0.0, negative or autocalculate, then the volume of the zone
   9303        \note is automatically calculated and used in subsequent calculations.
   9304        \note If this field is positive, then the number entered here will be used.
   9305        \units m3
   9306        \type real
   9307        \autocalculatable
   9308        \default autocalculate
   9309   N9 , \field Floor Area
   9310        \note If this field is 0.0, negative or autocalculate, then the floor area of the zone
   9311        \note is automatically calculated and used in subsequent calculations.
   9312        \note If this field is positive, then the number entered here will be used.
   9313        \units m2
   9314        \type real
   9315        \autocalculatable
   9316        \default autocalculate
   9317   A2 , \field Zone Inside Convection Algorithm
   9318        \type choice
   9319        \key Simple
   9320        \key TARP
   9321        \key CeilingDiffuser
   9322        \key AdaptiveConvectionAlgorithm
   9323        \key TrombeWall
   9324        \note Will default to same value as SurfaceConvectionAlgorithm:Inside object
   9325        \note setting this field overrides the default SurfaceConvectionAlgorithm:Inside for this zone
   9326        \note Simple = constant natural convection (ASHRAE)
   9327        \note TARP = variable natural convection based on temperature difference (ASHRAE)
   9328        \note CeilingDiffuser = ACH based forced and mixed convection correlations
   9329        \note  for ceiling diffuser configuration with simple natural convection limit
   9330        \note AdaptiveConvectionAlgorithm = dynamic selection of convection models based on conditions
   9331        \note TrombeWall = variable natural convection in an enclosed rectangular cavity
   9332   A3,  \field Zone Outside Convection Algorithm
   9333        \note Will default to same value as SurfaceConvectionAlgorithm:Outside object
   9334        \note setting this field overrides the default SurfaceConvectionAlgorithm:Outside for this zone
   9335        \type choice
   9336        \key SimpleCombined
   9337        \key TARP
   9338        \key DOE-2
   9339        \key MoWiTT
   9340        \key AdaptiveConvectionAlgorithm
   9341        \note SimpleCombined = Combined radiation and convection coefficient using simple ASHRAE model
   9342        \note TARP = correlation from models developed by ASHRAE, Walton, and Sparrow et. al.
   9343        \note MoWiTT = correlation from measurements by Klems and Yazdanian for smooth surfaces
   9344        \note DOE-2 = correlation from measurements by Klems and Yazdanian for rough surfaces
   9345        \note AdaptiveConvectionAlgorithm = dynamic selection of correlations based on conditions
   9346   A4;  \field Part of Total Floor Area
   9347        \type choice
   9348        \key Yes
   9349        \key No
   9350        \default Yes
   9351 
   9352 ZoneList,
   9353        \memo Defines a list of thermal zones which can be referenced as a group. The ZoneList name
   9354        \memo may be used elsewhere in the input to apply a parameter to all zones in the list.
   9355        \memo ZoneLists can be used effectively with the following objects: People, Lights,
   9356        \memo ElectricEquipment, GasEquipment, HotWaterEquipment, ZoneInfiltration:DesignFlowRate,
   9357        \memo ZoneVentilation:DesignFlowRate, Sizing:Zone, ZoneControl:Thermostat, and others.
   9358        \min-fields 2
   9359        \extensible:1 - repeat last field, remembering to remove ; from "inner" fields.
   9360   A1 , \field Name
   9361        \note Name of the Zone List
   9362        \required-field
   9363        \type alpha
   9364        \reference ZoneListNames
   9365        \reference ZoneAndZoneListNames

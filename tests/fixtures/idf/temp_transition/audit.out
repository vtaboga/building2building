  33003       \key Yes
  33004       \key No
  33005       \default No
  33006   A5, \field 100% Outdoor Air in Heating
  33007       \type choice
  33008       \key Yes
  33009       \key No
  33010       \default No
  33011   N9, \field Central Cooling Design Supply Air Humidity Ratio
  33012       \type real
  33013       \default 0.008
  33014       \units kgWater/kgDryAir
  33015  N10, \field Central Heating Design Supply Air Humidity Ratio
  33016       \type real
  33017       \default 0.008
  33018       \units kgWater/kgDryAir
  33019   A6, \field Cooling Supply Air Flow Rate Method
  33020       \type choice
  33021       \key Flow/System
  33022       \key DesignDay
  33023       \key FlowPerFloorArea
  33024       \key FractionOfAutosizedCoolingAirflow
  33025       \key FlowPerCoolingCapacity
  33026       \default DesignDay
  33027  N11, \field Cooling Supply Air Flow Rate
  33028       \note This input is used if Cooling Supply Air Flow Rate Method is Flow/System
  33029       \note This value will *not* be multiplied by any sizing factor or by zone multipliers.
  33030       \note If using zone multipliers, this value must be large enough to serve the multiplied zones.

  17721        \note The SurfaceConvectionAlgorithm:Outside:UserCurve named in this field is used when the previous field is set to UserCurve
  17722        \type object-list
  17723        \object-list UserConvectionOutsideModels
  17724   A4 , \field Wind Convection Leeward Vertical Wall Equation Source
  17725        \type choice
  17726        \default TARPLeeward
  17727        \key SimpleCombined
  17728        \key TARPLeeward

  76849 WaterHeater:HeatPump:PumpedCondenser,
  76850        \min-fields 32
  76851        \memo This object models an air-source heat pump for water heating where the water is pumped out of the tank,
  76852        \memo through a heating coil and returned to the tank.
  76853        \memo For wrapped condenser HPWHs, see WaterHeater:HeatPump:WrappedCondenser.
  76854        \memo WaterHeater:HeatPump:PumpedCondenser is a compound object that references other component objects -
  76855        \memo Coil:WaterHeating:AirToWaterHeatPump:*, Fan:OnOff, WaterHeater:Mixed or WaterHeater:Stratified
  76856   A1 , \field Name
  76857        \required-field
  76858        \type alpha
  76859        \reference-class-name validPlantEquipmentTypes
  76860        \reference validPlantEquipmentNames
  76861        \reference-class-name validBranchEquipmentTypes
  76862        \reference validBranchEquipmentNames
  76863        \reference ZoneEquipmentNames
  76864        \note Unique name for this instance of a heat pump water heater.
  76865   A2 , \field Availability Schedule Name
  76866        \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  76867        \note If this field is blank, the system is always available.
  76868        \type object-list
  76869        \object-list ScheduleNames
  76870        \note Schedule values of 0 denote the heat pump compressor is off and the parasitic electric
  76871        \note energy is also off.
  76872   A3,  \field Compressor Setpoint Temperature Schedule Name
  76873        \required-field
  76874        \type object-list
  76875        \object-list ScheduleNames
  76876        \note Defines the cut-out temperature where the heat pump compressor turns off.
  76877        \note The heat pump compressor setpoint temperature should always be greater
  76878        \note than the water tank's heater (element or burner) setpoint temperature.
  76879   N1 , \field Dead Band Temperature Difference
  76880        \type real
  76881        \units deltaC
  76882        \minimum> 0.0
  76883        \maximum 20
  76884        \default 5.0
  76885        \note Setpoint temperature minus the dead band temperature difference defines
  76886        \note the cut-in temperature where the heat pump compressor turns on.
  76887        \note The water tank's heater (element or burner) setpoint temperature
  76888        \note should always be less than the heat pump compressor cut-in temperature.
  76889   A4 , \field Condenser Water Inlet Node Name
  76890        \required-field
  76891        \type node
  76892        \note Should match the field Source Outlet Node Name in the water heater tank object.
  76893        \note Should also match the Condenser Water Inlet Node Name in the associated
  76894        \note DX coil object.
  76895   A5 , \field Condenser Water Outlet Node Name
  76896        \required-field
  76897        \type node
  76898        \note Should match the field Source Inlet Node Name in water heater tank object.
  76899        \note Should also match the Condenser Water Outlet Node Name in the associated
  76900        \note DX Coil object.
  76901   N2 , \field Condenser Water Flow Rate
  76902        \type real
  76903        \units m3/s
  76904        \ip-units gal/min
  76905        \minimum> 0
  76906        \autocalculatable
  76907        \note Actual water flow rate through the heat pump's water coil (condenser).
  76908        \note If autocalculated, the water flow rate is set equal to 4.487E-8 m3/s/W times
  76909        \note the rated heating capacity of the heat pump's DX coil.
  76910   N3 , \field Evaporator Air Flow Rate
  76911        \type real
  76912        \units m3/s
  76913        \minimum> 0
  76914        \autocalculatable
  76915        \note Actual air flow rate across the heat pump's air coil (evaporator).
  76916        \note If autocalculated, the air flow rate is set equal to 5.035E-5 m3/s/W times
  76917        \note the rated heating capacity of the heat pump's DX coil.
  76918   A6 , \field Inlet Air Configuration
  76919        \required-field
  76920        \type choice
  76921        \key Schedule
  76922        \key ZoneAirOnly
  76923        \key OutdoorAirOnly
  76924        \key ZoneAndOutdoorAir
  76925        \note Defines the configuration of the airflow path through the air coil and fan section.
  76926   A7 , \field Air Inlet Node Name
  76927        \type node
  76928        \note Zone air exhaust node name if Inlet Air Configuration is ZoneAirOnly or
  76929        \note ZoneAndOutdoorAir.
  76930        \note Simply a unique Node Name if Inlet Air Configuration is Schedule.
  76931        \note Otherwise, leave field blank.
  76932   A8 , \field Air Outlet Node Name
  76933        \type node
  76934        \note Zone Air Inlet Node Name if Inlet Air Configuration is ZoneAirOnly or
  76935        \note ZoneAndOutdoorAir.
  76936        \note Simply a unique Node Name if Inlet Air Configuration is Schedule.
  76937        \note Otherwise, leave field blank.
  76938   A9 , \field Outdoor Air Node Name
  76939        \type node
  76940        \note Outdoor air node name if inlet air configuration is ZoneAndOutdoorAir
  76941        \note or OutdoorAirOnly, otherwise leave field blank.
  76942   A10, \field Exhaust Air Node Name
  76943        \type node
  76944        \note Simply a unique Node Name if Inlet Air Configuration is ZoneAndOutdoorAir
  76945        \note or OutdoorAirOnly, otherwise leave field blank.
  76946   A11, \field Inlet Air Temperature Schedule Name
  76947        \type object-list
  76948        \object-list ScheduleNames
  76949        \note Used only if Inlet Air Configuration is Schedule, otherwise leave blank.
  76950        \note Schedule values should be degrees C.
  76951   A12, \field Inlet Air Humidity Schedule Name
  76952        \type object-list
  76953        \object-list ScheduleNames
  76954        \note Used only if Inlet Air Configuration is Schedule, otherwise leave blank.
  76955        \note Schedule values are entered as a fraction (e.g. 0.5 is equal to 50%RH)
  76956   A13, \field Inlet Air Zone Name
  76957        \type object-list
  76958        \object-list ZoneNames
  76959        \note Used only if Inlet Air Configuration is ZoneAirOnly or ZoneAndOutdoorAir.
  76960        \note Otherwise, leave field blank.
  76961   A14, \field Tank Object Type
  76962        \type choice
  76963        \key WaterHeater:Mixed
  76964        \key WaterHeater:Stratified
  76965        \default WaterHeater:Mixed
  76966        \note Specify the type of water heater tank used by this heat pump water heater.
  76967   A15, \field Tank Name
  76968        \required-field
  76969        \type object-list
  76970        \object-list WaterHeaterNames
  76971        \note Needs to match the name used in the corresponding Water Heater object.
  76972   A16, \field Tank Use Side Inlet Node Name
  76973        \type node
  76974        \note Used only when the heat pump water heater is connected to a plant loop,
  76975        \note otherwise leave blank. Needs to match the name used in the corresponding
  76976        \note Water Heater object when connected to a plant loop.
  76977   A17, \field Tank Use Side Outlet Node Name
  76978        \type node
  76979        \note Used only when the heat pump water heater is connected to a plant loop,
  76980        \note otherwise leave blank. Needs to match the name used in the corresponding
  76981        \note Water Heater object when connected to a plant loop.
  76982   A18, \field DX Coil Object Type
  76983        \type choice
  76984        \key Coil:WaterHeating:AirToWaterHeatPump:Pumped
  76985        \key Coil:WaterHeating:AirToWaterHeatPump:VariableSpeed
  76986        \key CoilSystem:IntegratedHeatPump:AirSource
  76987        \default Coil:WaterHeating:AirToWaterHeatPump:Pumped
  76988        \note Specify the type of DX coil used by this heat pump water heater. The only
  76989        \note valid choice is Coil:WaterHeating:AirToWaterHeatPump:Pumped and Coil:WaterHeating:AirToWaterHeatPump:VariableSpeed, and CoilSystem:IntegratedHeatPump:AirSource
  76990   A19, \field DX Coil Name
  76991        \required-field
  76992        \type object-list
  76993        \object-list HeatPumpWaterHeaterDXCoilsPumped
  76994        \object-list HeatPumpWaterHeaterDXCoilsVariableSpeed
  76995        \object-list IntegratedHeatPumps
  76996        \note Must match the name used in the corresponding Coil:WaterHeating:AirToWaterHeatPump:* object, or CoilSystem:IntegratedHeatPump:AirSource
  76997   N4 , \field Minimum Inlet Air Temperature for Compressor Operation
  76998        \type real
  76999        \units C
  77000        \default 10
  77001        \note Heat pump compressor will not operate when the inlet air dry-bulb temperature
  77002        \note is below this value.
  77003   N5 , \field Maximum Inlet Air Temperature for Compressor Operation
  77004        \type real
  77005        \units C
  77006        \default 48.88888888889
  77007        \minimum 26
  77008        \maximum 94
  77009        \note Heat pump compressor will not operate when the inlet air dry-bulb temperature
  77010        \note is above this value.
  77011   A20, \field Compressor Location
  77012        \required-field
  77013        \type choice
  77014        \key Schedule
  77015        \key Zone
  77016        \key Outdoors
  77017        \note If Zone is selected, Inlet Air Configuration must be ZoneAirOnly or
  77018        \note ZoneAndOutdoorAir. If Schedule is selected, then you must provide a
  77019        \note Compressor Ambient Temperature Schedule Name below.
  77020   A21, \field Compressor Ambient Temperature Schedule Name
  77021        \type object-list
  77022        \object-list ScheduleNames
  77023        \note Used only if Compressor Location is Schedule, otherwise leave field blank.
  77024   A22, \field Fan Object Type
  77025        \type choice
  77026        \key Fan:SystemModel
  77027        \key Fan:OnOff
  77028        \default Fan:OnOff
  77029        \note Specify the type of fan used by this heat pump water heater. The only
  77030        \note valid choices are Fan:SystemModel or Fan:OnOff.
  77031   A23, \field Fan Name
  77032        \required-field
  77033        \type object-list
  77034        \object-list FansOnOff
  77035        \object-list FansSystemModel
  77036        \note Needs to match the name used in the corresponding Fan:SystemModel or Fan:OnOff object.
  77037   A24, \field Fan Placement
  77038        \type choice
  77039        \key BlowThrough
  77040        \key DrawThrough
  77041        \default DrawThrough
  77042        \note BlowThrough means the fan is located before the air coil (upstream).
  77043        \note DrawThrough means the fan is located after the air coil (downstream).
  77044   N6 , \field On Cycle Parasitic Electric Load
  77045        \type real
  77046        \units W
  77047        \minimum 0.0
  77048        \default 0.0
  77049        \note Parasitic electric power consumed when the heat pump compressor operates.
  77050        \note Does not contribute to water heating but can impact the zone air heat balance.
  77051   N7 , \field Off Cycle Parasitic Electric Load
  77052        \type real
  77053        \units W
  77054        \minimum 0.0
  77055        \default 0.0
  77056        \note Parasitic electric power consumed when the heat pump compressor is off.
  77057        \note Does not contribute to water heating but can impact the zone air heat balance.
  77058        \note Off-cycle parasitic power is 0 when the availability schedule is 0.
  77059   A25, \field Parasitic Heat Rejection Location
  77060        \type choice
  77061        \key Zone
  77062        \key Outdoors
  77063        \default Outdoors
  77064        \note This field determines if the parasitic electric load impacts the zone air
  77065        \note heat balance. If Zone is selected, Inlet Air Configuration must be
  77066        \note ZoneAirOnly or ZoneAndOutdoorAir.
  77067   A26, \field Inlet Air Mixer Node Name
  77068        \type node
  77069        \note Required only if Inlet Air Configuration is ZoneAndOutdoorAir, otherwise
  77070        \note leave field blank.
  77071   A27, \field Outlet Air Splitter Node Name
  77072        \type node
  77073        \note Required only if Inlet Air Configuration is ZoneAndOutdoorAir, otherwise
  77074        \note leave field blank.
  77075   A28, \field Inlet Air Mixer Schedule Name
  77076        \type object-list
  77077        \object-list ScheduleNames
  77078        \note Required only if Inlet Air Configuration is ZoneAndOutdoorAir, otherwise
  77079        \note leave field blank. Schedule values define whether the heat pump draws its
  77080        \note inlet air from the zone, outdoors or a combination of zone and outdoor air.
  77081        \note A schedule value of 0 denotes inlet air is drawn only from the zone.
  77082        \note A schedule value of 1 denotes inlet air is drawn only from outdoors.
  77083        \note Schedule values between 0 and 1 denote a mixture of zone and outdoor air
  77084        \note proportional to the schedule value (i.e. 0.4 = 40% outdoor air, 60% zone air).
  77085   A29, \field Tank Element Control Logic
  77086        \type choice
  77087        \key MutuallyExclusive
  77088        \key Simultaneous
  77089        \default Simultaneous
  77090        \note MutuallyExclusive means that once the tank heating element is active the
  77091        \note heat pump is shut down until setpoint is reached.
  77092        \note Simultaneous (default) means that both the tank heating element and
  77093        \note heat pump are used at the same time recover the tank temperature.
  77094   N8,  \field Control Sensor 1 Height In Stratified Tank
  77095        \note Used to indicate height of control sensor for Tank Object Type = WaterHeater:Stratified
  77096        \note If left blank, it will default to the height of Heater1
  77097        \type real
  77098        \units m
  77099        \minimum 0.0
  77100   N9,  \field Control Sensor 1 Weight
  77101        \note Weight to give Control Sensor 1 temperature
  77102        \note The weight of Control Sensor 2 will be 1 - (wt. of control sensor 1)
  77103        \units dimensionless
  77104        \minimum 0.0
  77105        \maximum 1.0
  77106        \default 1.0
  77107   N10; \field Control Sensor 2 Height In Stratified Tank
  77108        \note Used to indicate height of control sensor for Tank Object Type = WaterHeater:Stratified
  77109        \note If left blank, it will default to the height of Heater2
  77110        \type real
  77111        \units m
  77112        \minimum 0.0
  77113 
  77114 WaterHeater:HeatPump:WrappedCondenser,
  77115        \min-fields 31
  77116        \memo This object models an air-source heat pump for water heating where the heating coil is wrapped around
  77117        \memo the tank, which is typical of residential HPWHs.
  77118        \memo For pumped condenser HPWHs, see WaterHeater:HeatPump:PumpedCondenser.
  77119        \memo WaterHeater:HeatPump:WrappedCondenser is a compound object that references other component objects -
  77120        \memo Coil:WaterHeating:AirToWaterHeatPump:Pumped, Fan:OnOff, WaterHeater:Mixed
  77121   A1 , \field Name
  77122        \required-field
  77123        \type alpha
  77124        \reference-class-name validPlantEquipmentTypes
  77125        \reference validPlantEquipmentNames
  77126        \reference-class-name validBranchEquipmentTypes
  77127        \reference validBranchEquipmentNames
  77128        \reference ZoneEquipmentNames
  77129        \note Unique name for this instance of a heat pump water heater.
  77130   A2 , \field Availability Schedule Name
  77131        \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  77132        \note If this field is blank, the system is always available.
  77133        \type object-list
  77134        \object-list ScheduleNames
  77135        \note Schedule values of 0 denote the heat pump compressor is off and the parasitic electric
  77136        \note energy is also off.
  77137   A3,  \field Compressor Setpoint Temperature Schedule Name
  77138        \required-field
  77139        \type object-list
  77140        \object-list ScheduleNames
  77141        \note Defines the cut-out temperature where the heat pump compressor turns off.
  77142        \note The heat pump compressor setpoint temperature should always be greater
  77143        \note than the water tank's heater (element or burner) setpoint temperature.
  77144   N1 , \field Dead Band Temperature Difference
  77145        \type real
  77146        \units deltaC
  77147        \minimum> 0.0
  77148        \maximum 20
  77149        \default 5.0
  77150        \note Setpoint temperature minus the dead band temperature difference defines
  77151        \note the cut-in temperature where the heat pump compressor turns on.
  77152        \note The water tank's heater (element or burner) setpoint temperature
  77153        \note should always be less than the heat pump compressor cut-in temperature.
  77154   N2,  \field Condenser Bottom Location
  77155        \type real
  77156        \units m
  77157        \minimum 0
  77158        \default 0
  77159        \note Distance from the bottom of the tank to the bottom of the wrapped condenser.
  77160   N3,  \field Condenser Top Location
  77161        \required-field
  77162        \type real
  77163        \units m
  77164        \minimum 0
  77165        \note Distance from the bottom of the tank to the top of the wrapped condenser.
  77166   N4 , \field Evaporator Air Flow Rate
  77167        \type real
  77168        \units m3/s
  77169        \minimum> 0
  77170        \autocalculatable
  77171        \note Actual air flow rate across the heat pump's air coil (evaporator).
  77172        \note If autocalculated, the air flow rate is set equal to 5.035E-5 m3/s/W times
  77173        \note the rated heating capacity of the heat pump's DX coil.
  77174   A4 , \field Inlet Air Configuration
  77175        \required-field
  77176        \type choice
  77177        \key Schedule
  77178        \key ZoneAirOnly
  77179        \key OutdoorAirOnly
  77180        \key ZoneAndOutdoorAir
  77181        \note Defines the configuration of the airflow path through the air coil and fan section.
  77182   A5 , \field Air Inlet Node Name
  77183        \type node
  77184        \note Zone air exhaust node name if Inlet Air Configuration is ZoneAirOnly or
  77185        \note ZoneAndOutdoorAir.
  77186        \note Simply a unique Node Name if Inlet Air Configuration is Schedule.
  77187        \note Otherwise, leave field blank.
  77188   A6 , \field Air Outlet Node Name
  77189        \type node
  77190        \note Zone Air Inlet Node Name if Inlet Air Configuration is ZoneAirOnly or
  77191        \note ZoneAndOutdoorAir.
  77192        \note Simply a unique Node Name if Inlet Air Configuration is Schedule.
  77193        \note Otherwise, leave field blank.
  77194   A7 , \field Outdoor Air Node Name
  77195        \type node
  77196        \note Outdoor air node name if inlet air configuration is ZoneAndOutdoorAir
  77197        \note or OutdoorAirOnly, otherwise leave field blank.
  77198   A8 , \field Exhaust Air Node Name
  77199        \type node
  77200        \note Simply a unique Node Name if Inlet Air Configuration is ZoneAndOutdoorAir
  77201        \note or OutdoorAirOnly, otherwise leave field blank.
  77202   A9 , \field Inlet Air Temperature Schedule Name
  77203        \type object-list
  77204        \object-list ScheduleNames
  77205        \note Used only if Inlet Air Configuration is Schedule, otherwise leave blank.
  77206        \note Schedule values should be degrees C.
  77207   A10, \field Inlet Air Humidity Schedule Name
  77208        \type object-list
  77209        \object-list ScheduleNames
  77210        \note Used only if Inlet Air Configuration is Schedule, otherwise leave blank.
  77211        \note Schedule values are entered as a fraction (e.g. 0.5 is equal to 50%RH)
  77212   A11, \field Inlet Air Zone Name
  77213        \type object-list
  77214        \object-list ZoneNames
  77215        \note Used only if Inlet Air Configuration is ZoneAirOnly or ZoneAndOutdoorAir.
  77216        \note Otherwise, leave field blank.
  77217   A12, \field Tank Object Type
  77218        \type choice
  77219        \key WaterHeater:Stratified
  77220        \default WaterHeater:Stratified
  77221        \note Specify the type of water heater tank used by this heat pump water heater.
  77222   A13, \field Tank Name
  77223        \required-field
  77224        \type object-list
  77225        \object-list WaterHeaterStratifiedNames
  77226        \note Needs to match the name used in the corresponding Water Heater object.
  77227        \note Must be a WaterHeater:Stratified tank.
  77228   A14, \field Tank Use Side Inlet Node Name
  77229        \type node
  77230        \note Used only when the heat pump water heater is connected to a plant loop,
  77231        \note otherwise leave blank. Needs to match the name used in the corresponding
  77232        \note Water Heater object when connected to a plant loop.
  77233   A15, \field Tank Use Side Outlet Node Name
  77234        \type node
  77235        \note Used only when the heat pump water heater is connected to a plant loop,
  77236        \note otherwise leave blank. Needs to match the name used in the corresponding
  77237        \note Water Heater object when connected to a plant loop.
  77238   A16, \field DX Coil Object Type
  77239        \type choice
  77240        \key Coil:WaterHeating:AirToWaterHeatPump:Wrapped
  77241        \default Coil:WaterHeating:AirToWaterHeatPump:Wrapped
  77242        \note Specify the type of DX coil used by this heat pump water heater. The only
  77243        \note valid choice is Coil:WaterHeating:AirToWaterHeatPump:Wrapped
  77244   A17, \field DX Coil Name
  77245        \required-field
  77246        \type object-list
  77247        \object-list HeatPumpWaterHeaterDXCoilsWrapped
  77248        \note Must match the name used in the corresponding Coil:WaterHeating:AirToWaterHeatPump:Wrapped object.
  77249   N5 , \field Minimum Inlet Air Temperature for Compressor Operation
  77250        \type real
  77251        \units C
  77252        \default 10
  77253        \note Heat pump compressor will not operate when the inlet air dry-bulb temperature
  77254        \note is below this value.
  77255   N6 , \field Maximum Inlet Air Temperature for Compressor Operation
  77256        \type real
  77257        \units C
  77258        \default 48.88888888889
  77259        \minimum 26
  77260        \maximum 94
  77261        \note Heat pump compressor will not operate when the inlet air dry-bulb temperature
  77262        \note is above this value.
  77263   A18, \field Compressor Location
  77264        \required-field
  77265        \type choice
  77266        \key Schedule
  77267        \key Zone
  77268        \key Outdoors
  77269        \note If Zone is selected, Inlet Air Configuration must be ZoneAirOnly or
  77270        \note ZoneAndOutdoorAir. If Schedule is selected, then you must provide a
  77271        \note Compressor Ambient Temperature Schedule Name below.
  77272   A19, \field Compressor Ambient Temperature Schedule Name
  77273        \type object-list
  77274        \object-list ScheduleNames
  77275        \note Used only if Compressor Location is Schedule, otherwise leave field blank.
  77276   A20, \field Fan Object Type
  77277        \type choice
  77278        \key Fan:OnOff
  77279        \key Fan:SystemModel
  77280        \default Fan:OnOff
  77281        \note Specify the type of fan used by this heat pump water heater. The only
  77282        \note valid choices are Fan:SystemModel or Fan:OnOff.
  77283   A21, \field Fan Name
  77284        \required-field
  77285        \type object-list
  77286        \object-list FansOnOff
  77287        \object-list FansSystemModel
  77288        \note Needs to match the name used in the corresponding Fan:SystemModel or Fan:OnOff object.
  77289   A22, \field Fan Placement
  77290        \type choice
  77291        \key BlowThrough
  77292        \key DrawThrough
  77293        \default DrawThrough
  77294        \note BlowThrough means the fan is located before the air coil (upstream).
  77295        \note DrawThrough means the fan is located after the air coil (downstream).
  77296   N7 , \field On Cycle Parasitic Electric Load
  77297        \type real
  77298        \units W
  77299        \minimum 0.0
  77300        \default 0.0
  77301        \note Parasitic electric power consumed when the heat pump compressor operates.
  77302        \note Does not contribute to water heating but can impact the zone air heat balance.
  77303   N8 , \field Off Cycle Parasitic Electric Load
  77304        \type real
  77305        \units W
  77306        \minimum 0.0
  77307        \default 0.0
  77308        \note Parasitic electric power consumed when the heat pump compressor is off.
  77309        \note Does not contribute to water heating but can impact the zone air heat balance.
  77310        \note Off-cycle parasitic power is 0 when the availability schedule is 0.
  77311   A23, \field Parasitic Heat Rejection Location
  77312        \type choice
  77313        \key Zone
  77314        \key Outdoors
  77315        \default Outdoors
  77316        \note This field determines if the parasitic electric load impacts the zone air
  77317        \note heat balance. If Zone is selected, Inlet Air Configuration must be
  77318        \note ZoneAirOnly or ZoneAndOutdoorAir.
  77319   A24, \field Inlet Air Mixer Node Name
  77320        \type node
  77321        \note Required only if Inlet Air Configuration is ZoneAndOutdoorAir, otherwise
  77322        \note leave field blank.
  77323   A25, \field Outlet Air Splitter Node Name
  77324        \type node
  77325        \note Required only if Inlet Air Configuration is ZoneAndOutdoorAir, otherwise
  77326        \note leave field blank.
  77327   A26, \field Inlet Air Mixer Schedule Name
  77328        \type object-list
  77329        \object-list ScheduleNames
  77330        \note Required only if Inlet Air Configuration is ZoneAndOutdoorAir, otherwise
  77331        \note leave field blank. Schedule values define whether the heat pump draws its
  77332        \note inlet air from the zone, outdoors or a combination of zone and outdoor air.
  77333        \note A schedule value of 0 denotes inlet air is drawn only from the zone.
  77334        \note A schedule value of 1 denotes inlet air is drawn only from outdoors.
  77335        \note Schedule values between 0 and 1 denote a mixture of zone and outdoor air
  77336        \note proportional to the schedule value.
  77337   A27, \field Tank Element Control Logic
  77338        \type choice
  77339        \key MutuallyExclusive
  77340        \key Simultaneous
  77341        \default Simultaneous
  77342        \note MutuallyExclusive means that once the tank heating element is active the
  77343        \note heat pump is shut down until setpoint is reached.
  77344        \note Simultaneous (default) means that both the tank heating element and
  77345        \note heat pump are used at the same time recover the tank temperature.
  77346   N9,  \field Control Sensor 1 Height In Stratified Tank
  77347        \note Used to indicate height of control sensor if Tank Object Type is WaterHeater:Stratified
  77348        \note If left blank, it will default to the height of Heater1
  77349        \type real
  77350        \units m
  77351        \minimum 0.0
  77352   N10, \field Control Sensor 1 Weight
  77353        \note Weight to give Control Sensor 1 temperature
  77354        \units dimensionless
  77355        \minimum 0.0
  77356        \maximum 1.0
  77357        \default 1.0
  77358   N11; \field Control Sensor 2 Height In Stratified Tank
  77359        \note Used to indicate height of control sensor if Tank Object Type is WaterHeater:Stratified
  77360        \note If left blank, it will default to the height of Heater2
  77361        \note The weight of this control sensor will be 1 - (wt. of control sensor 1)
  77362        \type real
  77363        \units m
  77364        \minimum 0.0
  77365 
  77366 ThermalStorage:Ice:Simple,
  77367       \min-fields 5
  77368       \memo This ice storage model is a simplified model
  77369       \memo It requires a setpoint placed on the Chilled Water Side Outlet Node
  77370       \memo It should be placed in the chilled water supply side outlet branch
  77371       \memo followed by a pipe.
  77372       \memo Use the PlantEquipmentOperation:ComponentSetpoint plant operation scheme.
  77373   A1, \field Name
  77374       \type alpha
  77375       \required-field
  77376       \reference IceThermalStorageEquipment
  77377       \reference-class-name validBranchEquipmentTypes
  77378       \reference validBranchEquipmentNames
  77379   A2, \field Ice Storage Type
  77380       \note IceOnCoilInternal = Ice-on-Coil, internal melt
  77381       \note IceOnCoilExternal = Ice-on-Coil, external melt
  77382       \type choice
  77383       \required-field
  77384       \key IceOnCoilInternal
  77385       \key IceOnCoilExternal
  77386   N1, \field Capacity
  77387       \required-field
  77388       \type real
  77389       \units GJ
  77390       \ip-units ton-hrs
  77391   A3, \field Inlet Node Name
  77392       \type node
  77393       \required-field
  77394   A4; \field Outlet Node Name
  77395       \type node
  77396       \required-field
  77397 
  77398 ThermalStorage:Ice:Detailed,
  77399     \min-fields 14
  77400        \memo This input syntax is intended to describe a thermal storage system that
  77401        \memo includes smaller containers filled with water that are placed in a larger
  77402        \memo tank or series of tanks.
  77403        \memo The model uses polynomial equations to describe the system performance.
  77404   A1 , \field Name
  77405        \required-field
  77406        \reference IceThermalStorageEquipment
  77407        \reference-class-name validBranchEquipmentTypes
  77408        \reference validBranchEquipmentNames
  77409        \reference-class-name validPlantEquipmentTypes
  77410        \reference validPlantEquipmentNames
  77411   A2 , \field Availability Schedule Name
  77412        \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  77413        \note If this field is blank, the system is always available.
  77414        \type object-list
  77415        \object-list ScheduleNames
  77416   N1 , \field Capacity
  77417        \note This includes only the latent storage capacity
  77418        \units GJ
  77419        \required-field
  77420   A3 , \field Inlet Node Name
  77421        \required-field
  77422        \type node
  77423   A4 , \field Outlet Node Name
  77424        \required-field
  77425        \type node
  77426   A5 , \field Discharging Curve Variable Specifications
  77427        \required-field
  77428        \type choice
  77429        \key FractionChargedLMTD
  77430        \key FractionDischargedLMTD
  77431        \key LMTDMassFlow
  77432        \key LMTDFractionCharged
  77433   A6 , \field Discharging Curve Name
  77434        \required-field
  77435        \type object-list
  77436        \object-list BivariateFunctions
  77437   A7 , \field Charging Curve Variable Specifications
  77438        \required-field
  77439        \type choice
  77440        \key FractionChargedLMTD
  77441        \key FractionDischargedLMTD
  77442        \key LMTDMassFlow
  77443        \key LMTDFractionCharged
  77444   A8 , \field Charging Curve Name
  77445        \required-field
  77446        \type object-list
  77447        \object-list BivariateFunctions
  77448   N2 , \field Timestep of the Curve Data
  77449        \units hr
  77450   N3 , \field Parasitic Electric Load During Discharging
  77451        \units dimensionless
  77452   N4 , \field Parasitic Electric Load During Charging
  77453        \units dimensionless
  77454   N5 , \field Tank Loss Coefficient
  77455        \note This is the fraction the total storage capacity that is lost or melts
  77456        \note each hour
  77457        \units dimensionless
  77458   N6 , \field Freezing Temperature of Storage Medium
  77459        \note This temperature is typically 0C for water.
  77460        \note Simply changing this temperature without adjusting the performance
  77461        \note parameters input above is inappropriate and not advised.
  77462        \units C
  77463        \default 0.0
  77464   A9 ; \field Thaw Process Indicator
  77465        \note This field determines whether the system uses internal or external melt
  77466        \note during discharging.  This will then have an impact on charging performance.
  77467        \type choice
  77468        \key InsideMelt
  77469        \key OutsideMelt
  77470        \default OutsideMelt
  77471 
  77472 ThermalStorage:ChilledWater:Mixed,

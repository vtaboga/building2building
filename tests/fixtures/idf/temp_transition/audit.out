  59824       \default HeatExchanger:Desiccant:BalancedFlow:PerformanceDataType1
  59825   A8, \field Heat Exchanger Performance Name
  59826       \required-field
  59827       \type object-list
  59828       \object-list DesiccantHXPerfData
  59829   A9; \field Economizer Lockout
  59830       \type choice
  59831       \key Yes
  59832       \key No
  59833       \default No
  59834       \note Yes means that the heat exchanger will be locked out (off)
  59835       \note when the economizer is operating or high humidity control is active
  59836 
  59837 HeatExchanger:Desiccant:BalancedFlow:PerformanceDataType1,
  59838        \memo RTO = B1 + B2*RWI + B3*RTI + B4*(RWI/RTI) + B5*PWI + B6*PTI + B7*(PWI/PTI)
  59839        \memo       + B8*RFV
  59840        \memo RWO = C1 + C2*RWI + C3*RTI + C4*(RWI/RTI) + C5*PWI + C6*PTI + C7*(PWI/PTI)
  59841        \memo       + C8*RFV
  59842        \memo where,
  59843        \memo RTO = Dry-bulb temperature of the regeneration outlet air (C)
  59844        \memo RWO = Humidity ratio of the regeneration outlet air (kgWater/kgDryAir)
  59845        \memo RWI = Humidity ratio of the regeneration inlet air (kgWater/kgDryAir)
  59846        \memo RTI = Dry-bulb temperature of the regeneration inlet air (C)
  59847        \memo PWI = Humidity ratio of the process inlet air (kgWater/kgDryAir)
  59848        \memo PTI = Dry-bulb temperature of the process inlet air (C)
  59849        \memo RFV = Regeneration Face Velocity (m/s)
  59850        \min-fields 52
  59851   A1 , \field Name
  59852        \required-field
  59853        \type alpha
  59854        \reference DesiccantHXPerfData
  59855   N1,  \field Nominal Air Flow Rate
  59856        \note Air flow rate at nominal conditions (assumed to be the same for both sides
  59857        \note of the heat exchanger).
  59858        \type real
  59859        \units m3/s
  59860        \minimum> 0.0
  59861        \autosizable
  59862   N2 , \field Nominal Air Face Velocity
  59863        \required-field
  59864        \type real
  59865        \units m/s
  59866        \minimum> 0.0
  59867        \maximum 6.0
  59868        \autosizable
  59869   N3 , \field Nominal Electric Power
  59870        \note Parasitic electric power (e.g., desiccant wheel motor)
  59871        \type real

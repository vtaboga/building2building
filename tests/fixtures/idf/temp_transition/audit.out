  56514        \note Part Load Fraction Correlation (function of part load ratio) should be quadratic or cubic.
  56515        \note Quadratic curve = a + b(PLR) + c(PLR)^2.
  56516        \note Cubic curve = a + b(PLR) + c(PLR)^2 + d(PLR)^3.
  56517        \note PLR = part load ratio (heating delivered/steady state heating capacity).
  56518        \note Use curve coefficients of 1,0,0 or leave this field blank when neglecting performance impacts
  56519        \note due to variations in part load ratio.
  56520 
  56521 Coil:WaterHeating:AirToWaterHeatPump:VariableSpeed,
  56522        \memo vairlable-speed Heat pump water heater (VSHPWH) heating coil, air-to-water direct-expansion (DX)
  56523        \memo system which includes a variable-speed water heating coil, evaporator air coil, evaporator
  56524        \memo fan, electric compressor, and water pump. Part of a WaterHeater:HeatPump system.
  56525        \min-fields 33
  56526   A1 , \field Name
  56527        \required-field
  56528        \type alpha
  56529        \reference HeatPumpWaterHeaterDXCoilsVariableSpeed
  56530        \note Unique name for this instance of a variable-speed heat pump water heater DX coil.
  56531   N1,  \field Number of Speeds
  56532        \units dimensionless
  56533        \type integer
  56534        \minimum 1
  56535        \maximum 10
  56536        \default 1
  56537   N2 , \field Nominal Speed Level
  56538        \units dimensionless
  56539        \type integer
  56540        \default 1
  56541        \note must be lower than or equal to the highest speed number
  56542   N3 , \field Rated Water Heating Capacity
  56543        \required-field
  56544        \type real
  56545        \units W
  56546        \minimum> 0
  56547        \note Water Heating capacity at the rated inlet air temperatures, rated condenser inlet
  56548        \note water temperature, rated air flow rate, and rated water flow rate.
  56549        \note Can optionally include condenser pump heat.
  56550   N4 , \field Rated Evaporator Inlet Air Dry-Bulb Temperature
  56551        \type real
  56552        \units C
  56553        \minimum> 5
  56554        \default 19.7
  56555        \note Evaporator inlet air dry-bulb temperature corresponding to rated coil performance
  56556        \note (heating capacity, COP and SHR).
  56557   N5 , \field Rated Evaporator Inlet Air Wet-Bulb Temperature
  56558        \type real
  56559        \units C
  56560        \minimum> 5
  56561        \default 13.5
  56562        \note Evaporator inlet air wet-bulb temperature corresponding to rated coil performance
  56563        \note (heating capacity, COP and SHR).
  56564   N6 , \field Rated Condenser Inlet Water Temperature
  56565        \type real
  56566        \units C
  56567        \minimum> 25
  56568        \default 57.5
  56569        \note Condenser inlet water temperature corresponding to rated coil performance
  56570        \note (heating capacity, COP and SHR).
  56571   N7 , \field Rated Evaporator Air Flow Rate
  56572        \type real
  56573        \units m3/s
  56574        \minimum> 0
  56575        \autocalculatable
  56576        \note Evaporator air flow rate corresponding to rated coil performance
  56577        \note (heating capacity, COP and SHR).
  56578        \note Default is 5.035E-5 m3/s/W (31.25 cfm/MBH) of rated heating capacity when autocalculated.
  56579   N8 , \field Rated Condenser Water Flow Rate
  56580        \type real
  56581        \units m3/s
  56582        \ip-units gal/min
  56583        \minimum> 0
  56584        \autocalculatable
  56585        \note Condenser water flow rate corresponding to rated coil performance
  56586        \note (heating capacity, COP and SHR).
  56587        \note Default is 4.487E-8 m3/s/W (0.208 gpm/MBH) of rated heating capacity when autocalculated.
  56588        \note A warning message will be issued if the ratio of Rated Condenser Water Flow Rate
  56589        \note to Heating Capacity is less than 1.79405E-8 m3/s/W (0.083 gpm/MBH)
  56590        \note or greater than 8.97024E-8 m3/s/W (0.417 gpm/MBH), but the simulation will continue.
  56591   A2 , \field Evaporator Fan Power Included in Rated COP
  56592        \type choice
  56593        \key Yes
  56594        \key No
  56595        \default Yes
  56596        \note Select Yes if the evaporator fan power is included in the rated COP. This choice field
  56597        \note impacts the calculation of compressor electric power.
  56598   A3 , \field Condenser Pump Power Included in Rated COP
  56599        \type choice
  56600        \key Yes
  56601        \key No
  56602        \default No
  56603        \note Select Yes if the condenser pump power is included in the rated COP. This choice field
  56604        \note impacts the calculation of compressor electric power.
  56605   A4 , \field Condenser Pump Heat Included in Rated Heating Capacity and Rated COP
  56606        \type choice
  56607        \key Yes
  56608        \key No
  56609        \default No
  56610        \note Select Yes if the condenser pump heat is included in the rated heating capacity and
  56611        \note rated COP. This choice field impacts the calculation of water heating capacity.
  56612   N9 , \field Fraction of Condenser Pump Heat to Water
  56613        \type real
  56614        \minimum 0
  56615        \maximum 1
  56616        \default 0.2
  56617        \note Fraction of pump heat transferred to the condenser water. The pump is assumed
  56618        \note to be located downstream of the condenser.
  56619   A5 , \field Evaporator Air Inlet Node Name
  56620        \required-field
  56621        \type node
  56622        \note The node from which the DX coil draws its inlet air.
  56623   A6 , \field Evaporator Air Outlet Node Name
  56624        \required-field
  56625        \type node
  56626        \note The node to which the DX coil sends its outlet air.
  56627   A7 , \field Condenser Water Inlet Node Name
  56628        \required-field
  56629        \type node
  56630        \note The node from which the DX coil condenser draws its inlet water.
  56631        \note This name should match the source side outlet node name in the associated
  56632        \note water heater tank object.
  56633   A8 , \field Condenser Water Outlet Node Name
  56634        \required-field
  56635        \type node
  56636        \note The node to which the DX coil condenser sends its outlet water.
  56637        \note This name should match the source side inlet node name in the associated
  56638        \note water heater tank object.
  56639   N10, \field Crankcase Heater Capacity
  56640        \type real
  56641        \minimum 0
  56642        \default 0
  56643        \units W
  56644        \note The compressor crankcase heater only operates when the dry-bulb temperature of air
  56645        \note surrounding the compressor is below the Maximum Ambient Temperature for Crankcase
  56646        \note Heater Operation and the DX coil is off.  The ambient temperature surrounding the
  56647        \note compressor is set by the WaterHeater:HeatPump parent object (field Compressor Location).
  56648   N11, \field Maximum Ambient Temperature for Crankcase Heater Operation
  56649        \type real
  56650        \minimum 0
  56651        \default 10
  56652        \units C
  56653        \note The compressor crankcase heater only operates when the dry-bulb temperature of air
  56654        \note surrounding the compressor is below the Maximum Outdoor Temperature for Crankcase
  56655        \note Heater Operation and the unit is off. The ambient temperature surrounding the
  56656        \note compressor is set by the WaterHeater:HeatPump parent object (field Compressor Location).
  56657   A9 , \field Evaporator Air Temperature Type for Curve Objects
  56658        \type choice
  56659        \key DryBulbTemperature
  56660        \key WetBulbTemperature
  56661        \default WetBulbTemperature
  56662        \note Determines temperature type for heating capacity curves and
  56663        \note heating COP curves. This input determines whether
  56664        \note the inlet air dry-bulb or wet-bulb temperature is used to evaluate these curves.
  56665   A10, \field Part Load Fraction Correlation Curve Name
  56666        \type object-list
  56667        \object-list UnivariateFunctions
  56668        \note Table:Lookup object can also be used
  56669        \note Part Load Fraction Correlation (function of part load ratio) should be quadratic or cubic.
  56670        \note Quadratic curve = a + b(PLR) + c(PLR)^2.
  56671        \note Cubic curve = a + b(PLR) + c(PLR)^2 + d(PLR)^3.
  56672        \note PLR = part load ratio (heating delivered/steady state heating capacity).
  56673        \note Use curve coefficients of 1,0,0 or leave this field blank when neglecting performance impacts
  56674        \note due to variations in part load ratio.
  56675   N12, \field Rated Water Heating Capacity at Speed 1
  56676        \required-field
  56677        \type real
  56678        \units W
  56679        \minimum> 0
  56680        \note Heating capacity at the rated inlet air temperatures, rated condenser inlet
  56681        \note water temperature, rated air flow rate, and rated water flow rate.
  56682        \note Can optionally include condenser pump heat.
  56683   N13, \field Rated Water Heating COP at Speed 1
  56684        \type real
  56685        \units W/W
  56686        \minimum> 0
  56687        \default 3.2
  56688        \note Heating coefficient of performance at the rated inlet air and water temperatures,
  56689        \note rated condenser inlet water temperature, rated air flow rate, and rated water flow rate.
  56690        \note Can optionally include condenser pump power and evaporator fan power (see fields below).
  56691   N14, \field Rated Sensible Heat Ratio at Speed 1
  56692        \type real
  56693        \minimum 0.5
  56694        \maximum 1
  56695        \default 0.85
  56696        \note Gross air-side sensible heat ratio at the rated inlet air temperatures,
  56697        \note rated condenser inlet water temperature, rated air flow rate, and rated water flow rate.
  56698        \note Sensible heat ratio equals gross sensible cooling capacity divided by gross total cooling
  56699        \note capacity. Rated SHR (gross) should not include evaporator fan heat, only sensible cooling
  56700        \note and dehumidification by the coil alone.

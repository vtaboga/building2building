  17082 SurfaceConvectionAlgorithm:Inside:AdaptiveModelSelections,
  17083        \unique-object
  17084        \memo Options to change the individual convection model equations for dynamic selection when using AdaptiveConvectiongAlgorithm
  17085        \memo This object is only needed to make changes to the default model selections for any or all of the surface categories.
  17086        \memo This object is for the inside face, the side of the surface facing a thermal zone.
  17087        \min-fields 91
  17088   A1 , \field Name
  17089        \type alpha
  17090   A2 , \field Simple Buoyancy Vertical Wall Equation Source
  17091        \note Applies to zone with no HVAC or when HVAC is off
  17092        \note This is for vertical walls
  17093        \type choice
  17094        \default FohannoPolidoriVerticalWall
  17095        \key ASHRAEVerticalWall
  17096        \key AlamdariHammondVerticalWall
  17097        \key KhalifaEq3WallAwayFromHeat
  17098        \key KhalifaEq6NonHeatedWalls
  17099        \key FohannoPolidoriVerticalWall
  17100        \key ISO15099Windows
  17101        \key UserCurve
  17102   A3 , \field Simple Buoyancy Vertical Wall User Curve Name
  17103        \note The SurfaceConvectionAlgorithm:Inside:UserCurve named in this field is used when the previous field is set to UserCurve
  17104        \type object-list
  17105        \object-list UserConvectionInsideModels
  17106   A4 , \field Simple Buoyancy Stable Horizontal Equation Source
  17107        \note Applies to zone with no HVAC or when HVAC is off
  17108        \note This is for horizontal surfaces with heat flow directed for stable thermal stratification
  17109        \type choice
  17110        \default AlamdariHammondStableHorizontal
  17111        \key WaltonStableHorizontalOrTilt
  17112        \key AlamdariHammondStableHorizontal
  17113        \key UserCurve
  17114   A5 , \field Simple Buoyancy Stable Horizontal Equation User Curve Name
  17115        \note The SurfaceConvectionAlgorithm:Inside:UserCurve named in this field is used when the previous field is set to UserCurve
  17116        \type object-list
  17117        \object-list UserConvectionInsideModels
  17118   A6 , \field Simple Buoyancy Unstable Horizontal Equation Source
  17119        \note Applies to zone with no HVAC or when HVAC is off
  17120         \note This is for passive horizontal surfaces with heat flow for unstable thermal stratification
  17121        \type choice
  17122        \default AlamdariHammondUnstableHorizontal
  17123        \key WaltonUnstableHorizontalOrTilt
  17124        \key AlamdariHammondUnstableHorizontal
  17125        \key UserCurve
  17126   A7 , \field Simple Buoyancy Unstable Horizontal Equation User Curve Name
  17127        \note The SurfaceConvectionAlgorithm:Inside:UserCurve named in this field is used when the previous field is set to UserCurve
  17128        \type object-list
  17129        \object-list UserConvectionInsideModels
  17130   A8 , \field Simple Buoyancy Stable Tilted Equation Source
  17131        \note Applies to zone with no HVAC or when HVAC is off
  17132        \note This is for tilted surfaces with heat flow for stable thermal stratification
  17133        \type choice
  17134        \default WaltonStableHorizontalOrTilt
  17135        \key WaltonStableHorizontalOrTilt
  17136        \key AlamdariHammondStableHorizontal
  17137        \key UserCurve
  17138   A9 , \field Simple Buoyancy Stable Tilted Equation User Curve Name
  17139        \note The SurfaceConvectionAlgorithm:Inside:UserCurve named in this field is used when the previous field is set to UserCurve
  17140        \type object-list
  17141        \object-list UserConvectionInsideModels
  17142   A10 , \field Simple Buoyancy Unstable Tilted Equation Source
  17143        \note Applies to zone with no HVAC or when HVAC is off
  17144        \note This is for tilted surfaces with heat flow for unstable thermal stratification
  17145        \type choice
  17146        \default WaltonUnstableHorizontalOrTilt
  17147        \key WaltonUnstableHorizontalOrTilt
  17148        \key AlamdariHammondUnstableHorizontal
  17149        \key UserCurve

  82131   A1 , \field Name
  82132        \required-field
  82133   A2 , \field Control Variable
  82134        \type choice
  82135        \key Temperature
  82136        \default Temperature
  82137   N1 , \field Minimum Supply Air Temperature
  82138        \units C
  82139        \default -99
  82140   N2 , \field Maximum Supply Air Temperature
  82141        \units C
  82142        \default 99
  82143   A3 , \field Control Zone Name
  82144        \type object-list
  82145        \object-list ZoneNames
  82146        \required-field
  82147   A4 , \field Zone Node Name
  82148        \required-field
  82149        \type node
  82150   A5 , \field Zone Inlet Node Name
  82151        \required-field
  82152        \type node
  82153   A6 ; \field Setpoint Node or NodeList Name
  82154        \note Node(s) at which the temperature will be set
  82155        \required-field
  82156        \type node
  82157 
  82158 SetpointManager:SingleZone:Cooling,
  82159        \memo This setpoint manager detects the control zone load to meet the current cooling
  82160        \memo setpoint, zone inlet node flow rate, and zone node temperature, and calculates a
  82161        \memo setpoint temperature for the supply air that will satisfy the zone cooling load for
  82162        \memo the control zone.
  82163        \min-fields 8
  82164   A1 , \field Name
  82165        \required-field
  82166   A2 , \field Control Variable
  82167        \type choice
  82168        \key Temperature
  82169        \default Temperature
  82170   N1 , \field Minimum Supply Air Temperature
  82171        \units C
  82172        \default -99
  82173   N2 , \field Maximum Supply Air Temperature
  82174        \units C
  82175        \default 99
  82176   A3 , \field Control Zone Name
  82177        \type object-list
  82178        \object-list ZoneNames
  82179        \required-field
  82180   A4 , \field Zone Node Name
  82181        \required-field
  82182        \type node
  82183   A5 , \field Zone Inlet Node Name
  82184        \required-field
  82185        \type node
  82186   A6 ; \field Setpoint Node or NodeList Name
  82187        \note Node(s) at which the temperature will be set
  82188        \required-field
  82189        \type node

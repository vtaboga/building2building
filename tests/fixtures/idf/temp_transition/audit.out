  21050 Lights,
  21051    \memo Sets internal gains for lights in the zone.
  21052    \memo If you use a ZoneList in the Zone or ZoneList name field then this definition applies
  21053    \memo to all the zones in the ZoneList.
  21054        \min-fields 11
  21055   A1 , \field Name
  21056        \required-field
  21057        \type alpha
  21058        \reference LightsNames
  21059   A2 , \field Zone or ZoneList Name
  21060        \required-field
  21061        \type object-list
  21062        \object-list ZoneAndZoneListNames
  21063   A3 , \field Schedule Name
  21064        \required-field
  21065        \type object-list
  21066        \object-list ScheduleNames
  21067        \note units in schedule should be fraction applied to design level of lights, generally (0.0 - 1.0)
  21068   A4 , \field Design Level Calculation Method
  21069        \note The entered calculation method is used to create the maximum amount of lights
  21070        \note for this set of attributes
  21071        \note Choices: LightingLevel => Lighting Level -- simply enter watts of lights
  21072        \note Watts/Area => Watts per Zone Floor Area -- enter the number to apply.  Value * Floor Area = Lights
  21073        \note Watts/Person => Watts per Person -- enter the number to apply.  Value * Occupants = Lights
  21074        \type choice
  21075        \key LightingLevel
  21076        \key Watts/Area
  21077        \key Watts/Person
  21078        \default LightingLevel
  21079   N1 , \field Lighting Level
  21080        \units W
  21081        \type real
  21082        \minimum 0
  21083        \ip-units W
  21084   N2 , \field Watts per Zone Floor Area
  21085        \type real
  21086        \minimum 0
  21087        \units W/m2
  21088        \ip-units W/ft2
  21089   N3 , \field Watts per Person
  21090        \type real
  21091        \minimum 0
  21092        \units W/person
  21093        \ip-units W/person
  21094   N4 , \field Return Air Fraction
  21095        \note Used only for sizing calculation if return-air-fraction
  21096        \note coefficients are specified.
  21097        \type real
  21098        \minimum 0.0
  21099        \maximum 1.0
  21100        \default 0
  21101   N5 , \field Fraction Radiant
  21102        \type real
  21103        \minimum 0.0
  21104        \maximum 1.0
  21105        \default 0
  21106   N6 , \field Fraction Visible
  21107        \type real
  21108        \minimum 0.0
  21109        \maximum 1.0
  21110        \default 0
  21111   N7 , \field Fraction Replaceable
  21112        \note For Daylighting:Controls must be 0 or 1:  0 = no dimming control, 1 = full dimming control
  21113        \type real
  21114        \minimum 0.0
  21115        \maximum 1.0
  21116        \default 1.0
  21117   A5 , \field End-Use Subcategory
  21118        \note Any text may be used here to categorize the end-uses in the ABUPS End Uses by Subcategory table.
  21119        \type alpha
  21120        \retaincase
  21121        \default General
  21122   A6 , \field Return Air Fraction Calculated from Plenum Temperature
  21123        \type choice
  21124        \key Yes
  21125        \key No
  21126        \default No
  21127   N8 , \field Return Air Fraction Function of Plenum Temperature Coefficient 1
  21128        \note Used only if Return Air Fraction Is Calculated from Plenum Temperature = Yes
  21129        \note Equation is Return Air Fraction = Coefficient#1 - Coefficient#2 X PlenumTemp(degC)
  21130        \type real
  21131        \minimum 0.0
  21132        \default 0.0
  21133   N9 , \field Return Air Fraction Function of Plenum Temperature Coefficient 2
  21134        \note Used only if Return Air Fraction Is Calculated from Plenum Temperature = Yes
  21135        \note Equation is Return Air Fraction = Coefficient#1 - Coefficient#2 X PlenumTemp(degC)
  21136        \type real
  21137        \units 1/K
  21138        \minimum 0.0
  21139        \default 0.0
  21140   A7 ; \field Return Air Heat Gain Node Name
  21141        \note Name of the return air node for this heat gain.
  21142        \note If left blank, defaults to the first return air node for the zone.
  21143        \note Leave this field blank when using a ZoneList name.
  21144        \type node

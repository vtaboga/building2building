  28296       \note TemperatureDifference = use the value from Zone Heating Design Supply Air Temperature Difference
  28297       \type choice
  28298       \key SupplyAirTemperature
  28299       \key TemperatureDifference
  28300       \default SupplyAirTemperature
  28301  N11, \field Zone Heating Design Supply Air Temperature
  28302       \type real
  28303       \units C
  28304       \default 50.0
  28305       \note Zone Heating Design Supply Air Temperature is only used when Zone Heating Design
  28306       \note Supply Air Temperature Input Method = SupplyAirTemperature
  28307  N12; \field Zone Heating Design Supply Air Temperature Difference
  28308       \type real
  28309       \units deltaC
  28310       \default 30.0
  28311       \note Zone Heating Design Supply Air Temperature is only used when Zone Heating Design
  28312       \note Supply Air Temperature Input Method = TemperatureDifference
  28313       \note The absolute value of this field will be added to the zone temperature
  28314       \note at peak load to calculate the Zone Heating Design Supply Air Temperature
  28315 
  28316 HVACTemplate:Zone:DualDuct,
  28317       \min-fields 26
  28318       \memo Zone terminal unit, dual-duct, constant or variable volume.
  28319   A1, \field Zone Name
  28320       \required-field
  28321       \note Zone name must match a building zone name
  28322       \type object-list
  28323       \object-list ZoneNames
  28324   A2, \field Template Dual Duct System Name
  28325       \required-field
  28326       \note Name of a HVACTemplate:System:DualDuct object serving this zone
  28327       \type object-list
  28328       \object-list CompactHVACSystemDualDuct
  28329   A3, \field Template Thermostat Name
  28330       \note Enter the name of a HVACTemplate:Thermostat object.
  28331       \note If blank, then it is assumed that standard thermostat objects
  28332       \note have been defined for this zone.
  28333       \type object-list
  28334       \object-list CompactHVACThermostats
  28335   N1, \field Supply Air Maximum Flow Rate
  28336       \note This field may be set to "autosize".  If a value is entered, it will be
  28337       \note multiplied by the Supply Air Sizing Factor and by zone multipliers.
  28338       \autosizable
  28339       \default autosize
  28340       \units m3/s
  28341   N2, \field Zone Heating Sizing Factor
  28342       \note If blank, value from Sizing:Parameters will be used.
  28343       \minimum 0
  28344   N3, \field Zone Cooling Sizing Factor
  28345       \note If blank, value from Sizing:Parameters will be used.
  28346       \minimum 0
  28347   N4 ,\field Zone Minimum Air Flow Fraction
  28348       \note This field is the Zone Minimum Air Flow Fraction specified as a fraction of the
  28349       \note maximum air flow rate. This field is ignored if the system serving this zone is
  28350       \note constant volume.
  28351       \minimum 0.0
  28352       \maximum 1.0
  28353       \default 0.2
  28354   A4, \field Outdoor Air Method
  28355       \note Flow/Person, Flow/Zone, Flow/Area, Sum, and Maximum use the values in the next three
  28356       \note fields: Outdoor Air Flow Rate per Person, Outdoor Air Flow Rate per Zone Floor Area,
  28357       \note and Outdoor Air Flow Rate per Zone.
  28358       \note DetailedSpecification ignores these three Outdoor Air Flow Rate fields and instead
  28359       \note references design specification objects named in the fields
  28360       \note Design Specification Outdoor Air Object Name and Design Specification Zone Air
  28361       \note Distribution Object Name.
  28362       \type choice
  28363       \key Flow/Person
  28364       \key Flow/Zone
  28365       \key Flow/Area
  28366       \key Sum
  28367       \key Maximum
  28368       \key DetailedSpecification
  28369       \default Flow/Person
  28370   N5, \field Outdoor Air Flow Rate per Person
  28371       \units m3/s
  28372       \note Default 0.00944 is 20 cfm per person
  28373       \note This input is used if the field Outdoor Air Method is
  28374       \note Flow/Person, Sum, or Maximum
  28375       \default 0.00944
  28376   N6, \field Outdoor Air Flow Rate per Zone Floor Area
  28377       \units m3/s-m2
  28378       \default 0.0
  28379       \note This input is used if the field Outdoor Air Method is
  28380       \note Flow/Area, Sum, or Maximum
  28381   N7, \field Outdoor Air Flow Rate per Zone
  28382       \type real
  28383       \units m3/s
  28384       \default 0.0
  28385       \note This input is used if the field Outdoor Air Method is
  28386       \note Flow/Zone, Sum, or Maximum
  28387   A5, \field Design Specification Outdoor Air Object Name for Sizing
  28388       \note This field is used only when Outdoor Air Method=DetailedSpecification.
  28389       \note Note that this field is used only for specifying the design outdoor air flow rate used
  28390       \note for sizing. The field Design Specification Outdoor Air Object Name for Control
  28391       \note (see above) is used to actively control the VAV terminal air flow rate.
  28392       \type object-list
  28393       \object-list DesignSpecificationOutdoorAirNames
  28394   A6, \field Design Specification Zone Air Distribution Object Name
  28395       \note This field is used only when Outdoor Air Method=DetailedSpecification.
  28396       \type object-list
  28397       \object-list DesignSpecificationZoneAirDistributionNames
  28398   A7, \field Design Specification Outdoor Air Object Name for Control
  28399       \type object-list
  28400       \object-list DesignSpecificationOutdoorAirNames
  28401       \note When the name of a DesignSpecification:OutdoorAir object is entered, the terminal
  28402       \note unit will increase flow as needed to meet this outdoor air requirement.
  28403       \note If Outdoor Air Flow per Person is non-zero, then the outdoor air requirement will
  28404       \note be computed based on the current number of occupants in the zone.
  28405       \note At no time will the supply air flow rate exceed the value for Maximum Air Flow Rate.
  28406       \note If this field is blank, then the terminal unit will not be controlled for outdoor air flow.
  28407       \note Note that this field is used only for specifying the design outdoor air flow rate used
  28408       \note for control. The field Design Specification Outdoor Air Object Name for Sizing
  28409       \note (see below) is used to specify the design outdoor air flow rate.
  28410   A8, \field Cold Supply Plenum Name
  28411       \note Plenum zone name.  Cold supply plenum that serves only this zone.
  28412       \note Blank if none.
  28413       \type object-list
  28414       \object-list ZoneNames
  28415   A9, \field Hot Supply Plenum Name
  28416       \note Plenum zone name.  Hot supply plenum that serves only this zone.
  28417       \note Blank if none.
  28418       \type object-list
  28419       \object-list ZoneNames
  28420  A10, \field Return Plenum Name
  28421       \note Plenum zone name.  Return plenum that serves only this zone.
  28422       \note Blank if none.
  28423       \type object-list
  28424       \object-list ZoneNames
  28425  A11, \field Baseboard Heating Type
  28426       \type choice
  28427       \key  HotWater
  28428       \key  Electric
  28429       \key  None
  28430       \default None
  28431  A12, \field Baseboard Heating Availability Schedule Name
  28432       \note If blank, always on
  28433       \type object-list
  28434       \object-list ScheduleNames
  28435   N8, \field Baseboard Heating Capacity
  28436       \autosizable
  28437       \default autosize
  28438       \units W
  28439  A13, \field Zone Cooling Design Supply Air Temperature Input Method
  28440       \note SupplyAirTemperature = use the value from Zone Cooling Design Supply Air Temperature
  28441       \note TemperatureDifference = use the value from Zone Cooling Design Supply Air Temperature Difference
  28442       \note SystemSupplyAirTemperature = use the value from HVACTemplate:System:DualDuct Cooling Coil Design Setpoint
  28443       \type choice
  28444       \key SupplyAirTemperature
  28445       \key TemperatureDifference
  28446       \key SystemSupplyAirTemperature
  28447       \default SystemSupplyAirTemperature
  28448   N9, \field Zone Cooling Design Supply Air Temperature
  28449       \type real
  28450       \units C
  28451       \default 12.8
  28452       \note Zone Cooling Design Supply Air Temperature is only used when Zone Cooling Design
  28453       \note Supply Air Temperature Input Method = SupplyAirTemperature
  28454  N10, \field Zone Cooling Design Supply Air Temperature Difference
  28455       \type real
  28456       \units deltaC
  28457       \default 11.11
  28458       \note Zone Cooling Design Supply Air Temperature is only used when Zone Cooling Design
  28459       \note Supply Air Temperature Input Method = TemperatureDifference
  28460       \note The absolute value of this field will be subtracted from the zone temperature
  28461       \note at peak load to calculate the Zone Cooling Design Supply Air Temperature.
  28462  A14, \field Zone Heating Design Supply Air Temperature Input Method
  28463       \note SupplyAirTemperature = use the value from Zone Heating Design Supply Air Temperature
  28464       \note TemperatureDifference = use the value from Zone Heating Design Supply Air Temperature Difference
  28465       \note SystemSupplyAirTemperature = use the value from HVACTemplate:System:DualDuct Heating Coil Design Setpoint
  28466       \type choice
  28467       \key SupplyAirTemperature
  28468       \key TemperatureDifference
  28469       \key SystemSupplyAirTemperature
  28470       \default SystemSupplyAirTemperature
  28471  N11, \field Zone Heating Design Supply Air Temperature
  28472       \type real
  28473       \units C
  28474       \default 50.0
  28475       \note Zone Heating Design Supply Air Temperature is only used when Zone Heating Design
  28476       \note Supply Air Temperature Input Method = SupplyAirTemperature
  28477  N12; \field Zone Heating Design Supply Air Temperature Difference
  28478       \type real
  28479       \units deltaC
  28480       \default 30.0
  28481       \note Zone Heating Design Supply Air Temperature is only used when Zone Heating Design
  28482       \note Supply Air Temperature Input Method = TemperatureDifference
  28483       \note The absolute value of this field will be added to the zone temperature
  28484       \note at peak load to calculate the Zone Heating Design Supply Air Temperature.
  28485 
  28486 HVACTemplate:System:VRF,
  28487       \memo Variable refrigerant flow (VRF) heat pump condensing unit. Serves one or more VRF zone
  28488       \memo terminal units (HVACTemplate:Zone:VRF).
  28489       \min-fields 39
  28490   A1, \field Name
  28491       \required-field
  28492       \reference CompactHVACSystemVRF
  28493       \reference HVACTemplateSystems
  28494   A2, \field System Availability Schedule Name
  28495       \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  28496       \note If this field is blank, the system is always available.
  28497       \type object-list
  28498       \object-list ScheduleNames
  28499   N1, \field Gross Rated Total Cooling Capacity
  28500       \type real
  28501       \units W
  28502       \minimum> 0.0
  28503       \autosizable
  28504       \default autosize
  28505       \note Enter the total cooling capacity in watts at rated conditions or set to autosize.
  28506       \note Total cooling capacity not accounting for the effect of supply air fan heat
  28507   N2, \field Gross Rated Cooling COP
  28508       \type real
  28509       \units W/W
  28510       \minimum> 0.0
  28511       \default 3.3
  28512       \note Enter the coefficient of performance at rated conditions or leave blank to use default.
  28513       \note COP includes compressor and condenser fan electrical energy input
  28514       \note COP does not include supply fan heat or supply fan electric power input
  28515   N3, \field Minimum Outdoor Temperature in Cooling Mode
  28516       \type real
  28517       \units C
  28518       \default -6.0
  28519       \note Enter the minimum outdoor temperature allowed for cooling operation.
  28520       \note Cooling is disabled below this temperature.
  28521   N4, \field Maximum Outdoor Temperature in Cooling Mode
  28522       \type real
  28523       \units C
  28524       \default 43.0
  28525       \note Enter the maximum outdoor temperature allowed for cooling operation.
  28526       \note Cooling is disabled above this temperature.
  28527   N5, \field Gross Rated Heating Capacity
  28528       \type real
  28529       \units W
  28530       \autosizable
  28531       \default autosize
  28532       \note Enter the heating capacity in watts at rated conditions or set to autosize.
  28533       \note Heating capacity not accounting for the effect of supply air fan heat
  28534   N6, \field Rated Heating Capacity Sizing Ratio
  28535       \type real
  28536       \units W/W
  28537       \minimum 1.0
  28538       \default 1.0
  28539       \note If the Gross Rated Heating Capacity is autosized, the heating capacity is sized
  28540       \note to be equal to the cooling capacity multiplied by this sizing ratio. The zone
  28541       \note terminal unit heating coils are also sized using this ratio unless the sizing
  28542       \note ratio input in the ZoneHVAC:TerminalUnit:VariableRefrigerantFlow object is entered.
  28543   N7, \field Gross Rated Heating COP
  28544       \type real
  28545       \units W/W
  28546       \minimum> 0.0
  28547       \note COP includes compressor and condenser fan electrical energy input
  28548       \note COP does not include supply fan heat or supply fan electrical energy input
  28549       \default 3.4
  28550   N8, \field Minimum Outdoor Temperature in Heating Mode
  28551       \type real
  28552       \units C
  28553       \default -20.0
  28554       \note Enter the minimum outdoor temperature allowed for heating operation.
  28555   N9, \field Maximum Outdoor Temperature in Heating Mode
  28556       \type real
  28557       \units C
  28558       \default 16.0
  28559       \note Enter the maximum outdoor temperature allowed for heating operation.
  28560  N10, \field Minimum Heat Pump Part-Load Ratio
  28561       \type real
  28562       \units dimensionless
  28563       \note Enter the minimum heat pump part-load ratio (PLR). When the cooling or heating PLR is
  28564       \note below this value, the heat pump compressor will cycle to meet the cooling or heating
  28565       \note demand.
  28566       \default 0.15
  28567   A3, \field Zone Name for Master Thermostat Location
  28568       \type object-list
  28569       \object-list ZoneNames
  28570       \note Enter the name of the zone where the master thermostat is located.
  28571   A4, \field Master Thermostat Priority Control Type
  28572       \type choice
  28573       \key LoadPriority
  28574       \key ZonePriority
  28575       \key ThermostatOffsetPriority
  28576       \key MasterThermostatPriority
  28577       \key Scheduled
  28578       \default MasterThermostatPriority
  28579       \note Choose a thermostat control logic scheme. If these control types fail to control zone
  28580       \note temperature within a reasonable limit, consider using multiple VRF systems
  28581   A5, \field Thermostat Priority Schedule Name
  28582       \type object-list
  28583       \object-list ScheduleNames
  28584       \note this field is required if Master Thermostat Priority Control Type is Scheduled.
  28585       \note Schedule values of 0 denote cooling, 1 for heating, and all other values disable the system.
  28586   A6, \field Heat Pump Waste Heat Recovery
  28587       \type choice
  28588       \key No
  28589       \key Yes
  28590       \default No
  28591       \note This field is reserved for future use. The only valid choice is No.
  28592  N11, \field Equivalent Piping Length used for Piping Correction Factor in Cooling Mode
  28593       \type real
  28594       \units m
  28595       \default 30.0
  28596       \note Enter the equivalent length of the farthest terminal unit from the condenser
  28597  N12, \field Vertical Height used for Piping Correction Factor
  28598       \type real
  28599       \units m
  28600       \default 10.0
  28601       \note Enter the height difference between the highest and lowest terminal unit
  28602  N13, \field Equivalent Piping Length used for Piping Correction Factor in Heating Mode
  28603       \type real
  28604       \units m
  28605       \default 30.0
  28606       \note Enter the equivalent length of the farthest terminal unit from the condenser
  28607  N14, \field Crankcase Heater Power per Compressor
  28608       \type real
  28609       \units W
  28610       \default 33.0
  28611       \note Enter the value of the resistive heater located in the compressor(s). This heater
  28612       \note is used to warm the refrigerant and oil when the compressor is off.
  28613  N15, \field Number of Compressors
  28614       \type integer
  28615       \units dimensionless
  28616       \default 2
  28617       \note Enter the total number of compressor. This input is used only for crankcase
  28618       \note heater calculations.
  28619  N16, \field Ratio of Compressor Size to Total Compressor Capacity
  28620       \type real
  28621       \units W/W
  28622       \default 0.5
  28623       \note Enter the ratio of the first stage compressor to total compressor capacity.
  28624       \note All other compressors are assumed to be equally sized. This inputs is used
  28625       \note only for crankcase heater calculations.
  28626  N17, \field Maximum Outdoor Dry-bulb Temperature for Crankcase Heater
  28627       \type real
  28628       \units C
  28629       \default 5.0
  28630       \note Enter the maximum outdoor temperature above which the crankcase heaters are disabled.
  28631   A7, \field Defrost Strategy
  28632       \type choice
  28633       \key ReverseCycle
  28634       \key Resistive
  28635       \default Resistive
  28636       \note Select a defrost strategy. Reverse cycle reverses the operating mode from heating to cooling
  28637       \note to melt frost formation on the condenser coil. The resistive strategy uses a resistive heater
  28638       \note to melt the frost.
  28639   A8, \field Defrost Control
  28640       \type choice
  28641       \key Timed
  28642       \key OnDemand
  28643       \default Timed
  28644       \note Choose a defrost control type. Either use a fixed Timed defrost period or select
  28645       \note OnDemand to defrost only when necessary.
  28646  N18, \field Defrost Time Period Fraction
  28647       \type real
  28648       \units dimensionless
  28649       \minimum 0.0
  28650       \default 0.058333
  28651       \note Fraction of time in defrost mode.
  28652       \note Only applicable if timed defrost control is specified.
  28653  N19, \field Resistive Defrost Heater Capacity
  28654       \type real
  28655       \units W
  28656       \minimum 0.0
  28657       \default autosize
  28658       \autosizable
  28659       \note Enter the size of the resistive defrost heating element.
  28660       \note Only applicable if resistive defrost strategy is specified
  28661       \ip-units W
  28662  N20, \field Maximum Outdoor Dry-bulb Temperature for Defrost Operation
  28663       \type real
  28664       \units C
  28665       \default 5.0
  28666       \note Enter the maximum outdoor temperature above which defrost operation is disabled.
  28667   A9, \field Condenser Type
  28668       \type choice
  28669       \key AirCooled
  28670       \key EvaporativelyCooled
  28671       \key WaterCooled
  28672       \default AirCooled
  28673       \note Select either an air cooled or evaporatively cooled condenser.
  28674  N21, \field Water Condenser Volume Flow Rate
  28675       \type real
  28676       \units m3/s
  28677       \autosizable
  28678       \default autosize
  28679       \note Only used when Condenser Type = WaterCooled.
  28680  N22, \field Evaporative Condenser Effectiveness
  28681       \type real
  28682       \units dimensionless
  28683       \minimum 0.0
  28684       \maximum 1.0
  28685       \default 0.9
  28686       \note Enter the effectiveness of the evaporatively cooled condenser.
  28687       \note This field is only used when the Condenser Type = EvaporativelyCooled.
  28688  N23, \field Evaporative Condenser Air Flow Rate
  28689       \type real
  28690       \units m3/s
  28691       \minimum> 0.0
  28692       \autosizable
  28693       \default autosize
  28694       \note Used to calculate evaporative condenser water use.
  28695       \note This field is only used when the Condenser Type = EvaporativelyCooled.
  28696  N24, \field Evaporative Condenser Pump Rated Power Consumption
  28697       \type real
  28698       \units W
  28699       \minimum 0.0
  28700       \default 0.0
  28701       \autosizable
  28702       \note Rated power consumed by the evaporative condenser's water pump.
  28703       \note This field is only used when the Condenser Type = EvaporativelyCooled.
  28704  N25, \field Basin Heater Capacity
  28705       \type real
  28706       \units W/K
  28707       \minimum 0.0
  28708       \default 0.0
  28709       \note This field is only used for Condenser Type = EvaporativelyCooled and for periods
  28710       \note when the basin heater is available (field Basin Heater Operating Schedule Name).
  28711       \note For this situation, the heater maintains the basin water temperature at the basin heater
  28712       \note setpoint temperature when the outdoor air temperature falls below the setpoint temperature.
  28713       \note The basin heater only operates when the DX coil is off.
  28714  N26, \field Basin Heater Setpoint Temperature
  28715       \type real
  28716       \units C
  28717       \minimum 2.0
  28718       \default 2.0
  28719       \note This field is only used for Condenser Type = EvaporativelyCooled.
  28720       \note Enter the outdoor dry-bulb temperature when the basin heater turns on.
  28721  A10, \field Basin Heater Operating Schedule Name
  28722       \type object-list
  28723       \object-list ScheduleNames
  28724       \note This field is only used for Condenser Type = EvaporativelyCooled.
  28725       \note Schedule values greater than 0 allow the basin heater to operate whenever the outdoor
  28726       \note air dry-bulb temperature is below the basin heater setpoint temperature.
  28727       \note If a schedule name is not entered, the basin heater is allowed to operate
  28728       \note throughout the entire simulation.
  28729  A11, \field Fuel Type
  28730       \type choice
  28731       \key Electricity
  28732       \key NaturalGas
  28733       \key Propane
  28734       \key Diesel
  28735       \key Gasoline
  28736       \key FuelOilNo1
  28737       \key FuelOilNo2
  28738       \key OtherFuel1
  28739       \key OtherFuel2
  28740       \default Electricity
  28741  N27, \field Minimum Outdoor Temperature in Heat Recovery Mode
  28742       \type real
  28743       \units C
  28744       \note The minimum outdoor temperature below which heat
  28745       \note recovery mode will not operate.
  28746       \default -15
  28747  N28; \field Maximum Outdoor Temperature in Heat Recovery Mode
  28748       \type real
  28749       \units C
  28750       \note The maximum outdoor temperature above which heat
  28751       \note recovery mode will not operate.
  28752       \default 45
  28753 
  28754 HVACTemplate:System:Unitary,
  28755       \min-fields 51
  28756       \memo Unitary furnace with air conditioner
  28757   A1, \field Name
  28758       \required-field
  28759       \reference CompactHVACSystemUnitary
  28760       \reference HVACTemplateSystems
  28761   A2, \field System Availability Schedule Name
  28762       \note If blank, always on; Unitary System always on.  Schedule is used in availability manager
  28763       \note and fan scheduling.
  28764       \note Also see "Night Cycle Control" field.
  28765       \type object-list
  28766       \object-list ScheduleNames
  28767   A3, \field Control Zone or Thermostat Location Name
  28768       \required-field
  28769       \type object-list
  28770       \object-list ZoneNames
  28771   N1, \field Supply Fan Maximum Flow Rate
  28772       \note This field may be set to "autosize".  If a value is entered, it will *not* be
  28773       \note multiplied by any sizing factor or by zone multipliers.  If using zone multipliers
  28774       \note a value entered here must be large enough to serve the multiplied zones.
  28775       \autosizable
  28776       \default autosize
  28777       \units m3/s
  28778       \minimum> 0.0
  28779   A4, \field Supply Fan Operating Mode Schedule Name
  28780       \note Refers to a schedule to specify unitary supply fan operating mode.
  28781       \note Schedule values of 0 indicate cycling fan (auto)
  28782       \note Schedule values of 1 indicate continuous fan (on)
  28783       \note If this field is left blank, a schedule of always zero (cycling fan) will be used.
  28784       \type object-list
  28785       \object-list ScheduleNames
  28786   N2, \field Supply Fan Total Efficiency
  28787       \minimum> 0.0
  28788       \maximum 1.0
  28789       \default 0.7
  28790   N3, \field Supply Fan Delta Pressure
  28791       \units Pa
  28792       \ip-units inH2O
  28793       \minimum 0
  28794       \default 600
  28795   N4, \field Supply Fan Motor Efficiency
  28796       \minimum> 0.0
  28797       \maximum 1.0
  28798       \default 0.9
  28799   N5, \field Supply Fan Motor in Air Stream Fraction
  28800       \minimum 0.0
  28801       \maximum 1.0
  28802       \default 1.0
  28803   A5, \field Cooling Coil Type
  28804       \type choice
  28805       \key  SingleSpeedDX
  28806       \key  None
  28807       \default SingleSpeedDX
  28808   A6, \field Cooling Coil Availability Schedule Name
  28809       \note If blank, always on
  28810       \type object-list
  28811       \object-list ScheduleNames
  28812   N6, \field Cooling Design Supply Air Temperature
  28813       \note Used for sizing.
  28814       \default 12.8
  28815       \units C
  28816   N7, \field Cooling Coil Gross Rated Total Capacity
  28817       \note Total cooling capacity not accounting for the effect of supply air fan heat
  28818       \autosizable
  28819       \default autosize
  28820       \units W
  28821   N8, \field Cooling Coil Gross Rated Sensible Heat Ratio
  28822       \note Gross SHR
  28823       \autosizable
  28824       \minimum 0.5
  28825       \maximum 1.0
  28826       \default autosize
  28827   N9, \field Cooling Coil Gross Rated COP
  28828       \note Gross cooling capacity divided by power input to the compressor and outdoor fan,
  28829       \note does not include supply air fan heat or supply air fan electric power
  28830       \units W/W
  28831       \minimum> 0.0
  28832       \default 3.0
  28833   A7, \field Heating Coil Type
  28834       \required-field
  28835       \type choice

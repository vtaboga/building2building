  24487       \note Used only when the fan is off.
  24488  N2 , \field Air Mass Flow Exponent When the Zone Exhaust Fan is Off
  24489       \units dimensionless
  24490       \type real
  24491       \minimum 0.5
  24492       \maximum 1.0
  24493       \default 0.65
  24494       \note Enter the exponent used in the following equation:
  24495       \note Mass Flow Rate = Air Mass Flow Coefficient * (dP)^Air Mass Flow Exponent.
  24496       \note Used only when the fan is off.
  24497  A2 ; \field Reference Crack Conditions
  24498       \type object-list
  24499       \object-list ReferenceCrackConditions
  24500       \note Select a AirflowNetwork:MultiZone:ReferenceCrackConditions name associated with
  24501       \note the air mass flow coefficient entered above.
  24502 
  24503 AirflowNetwork:MultiZone:ExternalNode,
  24504       \min-fields 3
  24505       \memo This object defines outdoor environmental conditions outside of the building.

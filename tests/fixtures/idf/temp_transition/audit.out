  45662 ZoneHVAC:VentilatedSlab,
  45663        \memo Ventilated slab system where outdoor air flows through hollow cores in a building
  45664        \memo surface (wall, ceiling, or floor).
  45665        \min-fields 32
  45666    A1, \field Name
  45667        \required-field
  45668        \reference ZoneEquipmentNames
  45669    A2, \field Availability Schedule Name
  45670        \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  45671        \note If this field is blank, the system is always available.
  45672        \type object-list
  45673        \object-list ScheduleNames
  45674    A3, \field Zone Name
  45675        \required-field
  45676        \note (name of zone system is serving)
  45677        \type object-list
  45678        \object-list ZoneNames
  45679    A4 ,\field Surface Name or Radiant Surface Group Name
  45680        \note (name of surface system is embedded in) or list of surfaces
  45681        \type object-list
  45682        \object-list RadiantSurfaceNames
  45683        \object-list VentSlabGroupNames
  45684    N1, \field Maximum Air Flow Rate
  45685        \required-field
  45686        \units m3/s
  45687        \minimum> 0
  45688        \autosizable
  45689    A5, \field Outdoor Air Control Type
  45690        \required-field
  45691        \type choice
  45692        \key VariablePercent
  45693        \key FixedTemperature
  45694        \key FixedAmount
  45695    N2, \field Minimum Outdoor Air Flow Rate
  45696        \required-field
  45697        \units m3/s
  45698        \autosizable
  45699        \minimum 0.0
  45700    A6, \field Minimum Outdoor Air Schedule Name
  45701        \required-field
  45702        \type object-list
  45703        \object-list ScheduleNames
  45704    N3, \field Maximum Outdoor Air Flow Rate
  45705        \required-field
  45706        \units m3/s
  45707        \autosizable
  45708        \minimum 0.0
  45709        \note schedule values multiply the minimum outdoor air flow rate
  45710    A7, \field Maximum Outdoor Air Fraction or Temperature Schedule Name
  45711        \note Note that this depends on the control type as to whether schedule values are a fraction or temperature
  45712        \required-field
  45713        \type object-list
  45714        \object-list ScheduleNames
  45715    A8, \field System Configuration Type
  45716        \type choice
  45717        \key SlabOnly
  45718        \key SlabAndZone
  45719        \key SeriesSlabs
  45720        \default SlabOnly
  45721    N4, \field Hollow Core Inside Diameter
  45722        \units m
  45723        \minimum 0
  45724        \default 0.05
  45725        \ip-units in
  45726    N5, \field Hollow Core Length
  45727        \note (length of core cavity embedded in surface)
  45728        \units m
  45729        \minimum 0
  45730    N6, \field Number of Cores
  45731        \note flow will be divided evenly among the cores
  45732        \minimum 0
  45733    A9, \field Temperature Control Type
  45734        \note (temperature on which unit is controlled)
  45735        \type choice
  45736        \key MeanAirTemperature
  45737        \key MeanRadiantTemperature
  45738        \key OperativeTemperature
  45739        \key OutdoorDryBulbTemperature
  45740        \key OutdoorWetBulbTemperature
  45741        \key SurfaceTemperature
  45742        \key ZoneAirDewPointTemperature
  45743        \default OutdoorDryBulbTemperature
  45744    A10, \field Heating High Air Temperature Schedule Name
  45745        \required-field
  45746        \note Air and control temperatures for heating work together to provide
  45747        \note a linear function that determines the air temperature sent to the
  45748        \note radiant system. The current control temperature (see A14) is
  45749        \note compared to the high and low control temperatures at the current time.
  45750        \note If the control temperature is above the high temperature, then the
  45751        \note inlet air temperature is set to the low air temperature. If the
  45752        \note control temperature is below the low temperature, then the inlet
  45753        \note air temperature is set to the high air temperature. If the control
  45754        \note temperature is between the high and low value, then the inlet air
  45755        \note temperature is linearly interpolated between the low and high air
  45756        \note temperature values.
  45757        \type object-list
  45758        \object-list ScheduleNames
  45759   A11, \field Heating Low Air Temperature Schedule Name
  45760        \required-field
  45761        \type object-list
  45762        \object-list ScheduleNames
  45763   A12, \field Heating High Control Temperature Schedule Name
  45764        \required-field
  45765        \type object-list
  45766        \object-list ScheduleNames
  45767   A13, \field Heating Low Control Temperature Schedule Name
  45768        \required-field
  45769        \type object-list
  45770        \object-list ScheduleNames
  45771   A14, \field Cooling High Air Temperature Schedule Name
  45772        \required-field
  45773        \note See note for heating high air temperature schedule above for
  45774        \note interpretation information (or see the Input/Output Reference).
  45775        \type object-list
  45776        \object-list ScheduleNames
  45777   A15, \field Cooling Low Air Temperature Schedule Name
  45778        \required-field
  45779        \type object-list
  45780        \object-list ScheduleNames
  45781   A16, \field Cooling High Control Temperature Schedule Name
  45782        \required-field
  45783        \type object-list
  45784        \object-list ScheduleNames
  45785   A17, \field Cooling Low Control Temperature Schedule Name
  45786        \required-field
  45787        \type object-list
  45788        \object-list ScheduleNames
  45789   A18, \field Return Air Node Name
  45790        \note This is the zone return air inlet to the ventilated slab system outdoor air mixer.
  45791        \note This node is typically a zone exhaust node (do not connect to "Zone Return Air Node").
  45792        \required-field
  45793        \type node
  45794   A19, \field Slab In Node Name
  45795        \note This is the node entering the slab or series of slabs after the fan and coil(s).
  45796        \required-field
  45797        \type node
  45798   A20, \field Zone Supply Air Node Name
  45799        \note This is the node name exiting the slab.
  45800        \note This node is typically a zone inlet node.
  45801        \note Leave blank when the system configuration is SlabOnly or SeriesSlabs.
  45802        \type node
  45803   A21, \field Outdoor Air Node Name
  45804        \note This node is the outdoor air inlet to the ventilated slab oa mixer.
  45805        \note This node should also be specified in an OutdoorAir:Node or OutdoorAir:NodeList object.
  45806        \required-field
  45807        \type node
  45808   A22, \field Relief Air Node Name
  45809        \note This node is the relief air node from the ventilated slab outdoor air mixer.
  45810        \required-field
  45811        \type node
  45812   A23, \field Outdoor Air Mixer Outlet Node Name
  45813        \note This is the node name leaving the outdoor air mixer and entering the fan and coil(s).
  45814        \required-field
  45815        \type node
  45816   A24, \field Fan Outlet Node Name
  45817        \note This is the node name of the fan outlet.
  45818        \required-field
  45819        \type node
  45820   A25, \field Fan Name
  45821        \required-field
  45822        \note Allowable fan types are Fan:SystemModel and Fan:ConstantVolume
  45823        \type object-list
  45824        \object-list FansCV
  45825        \object-list FansSystemModel
  45826   A26, \field Coil Option Type
  45827        \required-field
  45828        \type choice
  45829        \key None
  45830        \key Heating
  45831        \key Cooling
  45832        \key HeatingAndCooling
  45833   A27, \field Heating Coil Object Type
  45834        \type choice
  45835        \key Coil:Heating:Water
  45836        \key Coil:Heating:Electric
  45837        \key Coil:Heating:Fuel
  45838        \key Coil:Heating:Steam
  45839   A28, \field Heating Coil Name
  45840        \type object-list
  45841        \object-list HeatingCoilName
  45842   A29, \field Hot Water or Steam Inlet Node Name
  45843        \type node
  45844   A30, \field Cooling Coil Object Type
  45845        \type choice
  45846        \key Coil:Cooling:Water
  45847        \key Coil:Cooling:Water:DetailedGeometry
  45848        \key CoilSystem:Cooling:Water:HeatExchangerAssisted
  45849   A31, \field Cooling Coil Name
  45850        \type object-list
  45851        \object-list CoolingCoilsWater
  45852   A32, \field Cold Water Inlet Node Name
  45853        \type node
  45854   A33, \field Availability Manager List Name
  45855        \note Enter the name of an AvailabilityManagerAssignmentList object.
  45856        \type object-list
  45857        \object-list SystemAvailabilityManagerLists
  45858   A34; \field Design Specification ZoneHVAC Sizing Object Name
  45859        \note Enter the name of a DesignSpecificationZoneHVACSizing object.
  45860        \type object-list
  45861        \object-list DesignSpecificationZoneHVACSizingName
  45862 
  45863 ZoneHVAC:VentilatedSlab:SlabGroup,
  45864         \memo This is used to allow the coordinate control of several ventilated slab system
  45865         \memo surfaces. Note that the flow fractions must sum up to 1.0.
  45866         \memo The number of surfaces can be expanded beyond 10, if necessary, by adding more
  45867         \memo groups to the end of the list
  45868         \extensible:7 - repeat last seven fields, remembering to remove ; from "inner" fields.
  45869    A1 , \field Name
  45870          \required-field
  45871          \type alpha
  45872          \reference VentSlabGroupNames
  45873    A2  , \field Zone 1 Name
  45874          \begin-extensible

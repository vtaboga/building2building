  26842 HVACTemplate:Zone:WaterToAirHeatPump,
  26843       \min-fields 44
  26844       \memo Water to Air Heat Pump to be used with HVACTemplate:Plant:MixedWaterLoop
  26845   A1, \field Zone Name
  26846       \required-field
  26847       \note Zone name must match a building zone name
  26848       \type object-list
  26849       \object-list ZoneNames
  26850   A2, \field Template Thermostat Name
  26851       \note Enter the name of a HVACTemplate:Thermostat object.
  26852       \note If blank, then it is assumed that standard thermostat objects
  26853       \note have been defined for this zone.
  26854       \type object-list
  26855       \object-list CompactHVACThermostats
  26856   N1, \field Cooling Supply Air Flow Rate
  26857       \note Supply air flow rate during cooling operation
  26858       \note This field may be set to "autosize".  If a value is entered, it will be
  26859       \note multiplied by the Supply Air Sizing Factor and by zone multipliers.
  26860       \type real
  26861       \minimum> 0.0
  26862       \autosizable
  26863       \default autosize
  26864       \units m3/s
  26865   N2, \field Heating Supply Air Flow Rate
  26866       \note Supply air flow rate during heating operation
  26867       \note This field may be set to "autosize".  If a value is entered, it will be
  26868       \note multiplied by the Supply Air Sizing Factor and by zone multipliers.
  26869       \type real
  26870       \minimum> 0.0
  26871       \autosizable
  26872       \default autosize
  26873       \units m3/s
  26874   N3, \field No Load Supply Air Flow Rate
  26875       \note Supply air flow rate when no cooling or heating is needed
  26876       \note Only used when heat pump fan operating mode is continuous. This air flow rate
  26877       \note is used when no heating or cooling is required.
  26878       \note If this field is left blank or zero, the supply air flow rate from the previous on cycle
  26879       \note (either cooling or heating) is used.
  26880       \note A value entered in this field will *not* be multiplied by the sizing factor or
  26881       \note by zone multipliers.  It is best to autosize or leave blank when using zone multipliers.
  26882       \type real
  26883       \minimum 0
  26884       \autosizable
  26885       \units m3/s
  26886   N4, \field Zone Heating Sizing Factor
  26887       \note If blank, value from Sizing:Parameters will be used.
  26888       \minimum 0
  26889   N5, \field Zone Cooling Sizing Factor
  26890       \note If blank, value from Sizing:Parameters will be used.
  26891       \minimum 0
  26892   A3, \field Outdoor Air Method
  26893       \note Flow/Person, Flow/Zone, Flow/Area, Sum, and Maximum use the values in the next three
  26894       \note fields: Outdoor Air Flow Rate per Person, Outdoor Air Flow Rate per Zone Floor Area,
  26895       \note and Outdoor Air Flow Rate per Zone.
  26896       \note DetailedSpecification ignores these three Outdoor Air Flow Rate fields and instead
  26897       \note references design specification objects named in the fields
  26898       \note Design Specification Outdoor Air Object Name and Design Specification Zone Air
  26899       \note Distribution Object Name.
  26900       \type choice
  26901       \key Flow/Person
  26902       \key Flow/Zone
  26903       \key Flow/Area
  26904       \key Sum
  26905       \key Maximum
  26906       \key DetailedSpecification
  26907       \default Flow/Person
  26908   N6, \field Outdoor Air Flow Rate per Person
  26909       \units m3/s
  26910       \note Default 0.00944 is 20 cfm per person
  26911       \note This input is used if the field Outdoor Air Method is
  26912       \note Flow/Person, Sum, or Maximum
  26913       \default 0.00944
  26914   N7, \field Outdoor Air Flow Rate per Zone Floor Area
  26915       \units m3/s-m2
  26916       \default 0.0
  26917       \note This input is used if the field Outdoor Air Method is
  26918       \note Flow/Area, Sum, or Maximum
  26919   N8, \field Outdoor Air Flow Rate per Zone
  26920       \type real
  26921       \units m3/s
  26922       \default 0.0
  26923       \note This input is used if the field Outdoor Air Method is
  26924       \note Flow/Zone, Sum, or Maximum
  26925   A4, \field System Availability Schedule Name
  26926       \note If blank, always on
  26927       \type object-list
  26928       \object-list ScheduleNames
  26929   A5, \field Supply Fan Operating Mode Schedule Name
  26930       \note Refers to a schedule to specify unitary supply fan operating mode.
  26931       \note Schedule values of 0 indicate cycling fan (auto)
  26932       \note Schedule values of 1 indicate continuous fan (on)
  26933       \note If this field is left blank, a schedule of always zero (cycling fan) will be used.
  26934       \type object-list
  26935       \object-list ScheduleNames
  26936   A6, \field Supply Fan Placement
  26937       \type choice
  26938       \key BlowThrough
  26939       \key DrawThrough
  26940       \default DrawThrough
  26941   N9, \field Supply Fan Total Efficiency
  26942       \minimum> 0.0
  26943       \maximum 1.0
  26944       \default 0.7
  26945  N10, \field Supply Fan Delta Pressure
  26946       \units Pa
  26947       \ip-units inH2O
  26948       \minimum 0
  26949       \default 75
  26950  N11, \field Supply Fan Motor Efficiency
  26951       \minimum> 0.0
  26952       \maximum 1.0
  26953       \default 0.9
  26954   A7, \field Cooling Coil Type
  26955       \type choice
  26956       \key  Coil:Cooling:WaterToAirHeatPump:EquationFit
  26957       \default Coil:Cooling:WaterToAirHeatPump:EquationFit
  26958  N12, \field Cooling Coil Gross Rated Total Capacity
  26959       \note Total cooling capacity not accounting for the effect of supply air fan heat
  26960       \type real
  26961       \minimum> 0.0
  26962       \autosizable
  26963       \default autosize
  26964       \units W
  26965  N13, \field Cooling Coil Gross Rated Sensible Heat Ratio
  26966       \note Rated sensible heat ratio (gross sensible capacity/gross total capacity)
  26967       \note Sensible and total capacities do not include effect of supply fan heat
  26968       \type real
  26969       \autosizable
  26970       \minimum 0.5
  26971       \maximum 1.0
  26972       \default autosize
  26973  N14, \field Cooling Coil Gross Rated COP
  26974       \note Gross cooling capacity divided by power input to the compressor and outdoor fan,
  26975       \note does not include supply fan heat or supply fan electric power input
  26976       \type real
  26977       \units W/W
  26978       \minimum> 0.0
  26979       \default 3.5
  26980   A8, \field Heat Pump Heating Coil Type
  26981       \type choice
  26982       \key  Coil:Heating:WaterToAirHeatPump:EquationFit
  26983       \default Coil:Heating:WaterToAirHeatPump:EquationFit
  26984  N15, \field Heat Pump Heating Coil Gross Rated Capacity
  26985       \note Capacity excluding supply air fan heat
  26986       \type real
  26987       \units W
  26988       \minimum> 0.0
  26989       \autosizable
  26990       \default autosize
  26991       \units W
  26992  N16, \field Heat Pump Heating Coil Gross Rated COP
  26993       \note Heat Pump Heating Coil Rated Capacity divided by power input to the compressor and outdoor fan,
  26994       \note does not include supply air fan heat or supply air fan electric power input
  26995       \units W/W
  26996       \minimum> 0.0
  26997       \default 4.2
  26998   A9, \field Supplemental Heating Coil Availability Schedule Name
  26999       \note If blank, always on
  27000       \type object-list
  27001       \object-list ScheduleNames
  27002  N17, \field Supplemental Heating Coil Capacity
  27003       \autosizable
  27004       \default autosize
  27005       \units W
  27006  N18, \field Maximum Cycling Rate
  27007       \type real
  27008       \units cycles/hr
  27009       \minimum 0.0
  27010       \maximum 5.0
  27011       \default 2.5
  27012       \note The maximum on-off cycling rate for the compressor
  27013       \note Suggested value is 2.5 for a typical heat pump
  27014  N19, \field Heat Pump Time Constant
  27015       \type real
  27016       \units s
  27017       \minimum 0.0
  27018       \maximum 500.0
  27019       \default 60.0
  27020       \note Time constant for the cooling coil's capacity to reach steady state after startup
  27021       \note Suggested value is 60 for a typical heat pump
  27022  N20, \field Fraction of On-Cycle Power Use
  27023       \minimum 0.0
  27024       \maximum 0.05
  27025       \default 0.01
  27026       \note The fraction of on-cycle power use to adjust the part load fraction based on
  27027       \note the off-cycle power consumption due to crankcase heaters, controls, fans, and etc.
  27028       \note Suggested value is 0.01 for a typical heat pump
  27029  N21, \field Heat Pump Fan Delay Time
  27030       \units s
  27031       \minimum 0.0
  27032       \default 60
  27033       \note Programmed time delay for heat pump fan to shut off after compressor cycle off.
  27034       \note Only required when fan operating mode is cycling
  27035       \note Enter 0 when fan operating mode is continuous
  27036  A10, \field Dedicated Outdoor Air System Name
  27037       \note Enter the name of an HVACTemplate:System:DedicatedOutdoorAir object if this
  27038       \note zone is served by a separate dedicated outdoor air system (DOAS).
  27039       \note Leave field blank if no DOAS serves this zone.
  27040       \type object-list
  27041       \object-list HVACTemplateDOASSystems
  27042  A11, \field Supplemental Heating Coil Type
  27043       \type choice
  27044       \key  Electric
  27045       \key  HotWater
  27046       \default Electric
  27047  A12, \field Zone Cooling Design Supply Air Temperature Input Method
  27048       \note SupplyAirTemperature = use the value from Zone Cooling Design Supply Air Temperature
  27049       \note TemperatureDifference = use the value from Zone Cooling Design Supply Air Temperature Difference
  27050       \type choice
  27051       \key SupplyAirTemperature
  27052       \key TemperatureDifference
  27053       \default SupplyAirTemperature
  27054  N22, \field Zone Cooling Design Supply Air Temperature
  27055       \type real
  27056       \units C
  27057       \default 14.0
  27058       \note Zone Cooling Design Supply Air Temperature is only used when Zone Cooling Design
  27059       \note Supply Air Temperature Input Method = SupplyAirTemperature
  27060  N23, \field Zone Cooling Design Supply Air Temperature Difference
  27061       \type real
  27062       \units deltaC
  27063       \default 11.11
  27064       \note Zone Cooling Design Supply Air Temperature is only used when Zone Cooling Design
  27065       \note Supply Air Temperature Input Method = TemperatureDifference
  27066       \note The absolute value of this field will be subtracted from the zone temperature
  27067       \note at peak load to calculate the Zone Cooling Design Supply Air Temperature.
  27068  A13, \field Zone Heating Design Supply Air Temperature Input Method
  27069       \note SupplyAirTemperature = use the value from Zone Heating Design Supply Air Temperature
  27070       \note TemperatureDifference = use the value from Zone Heating Design Supply Air Temperature Difference
  27071       \type choice
  27072       \key SupplyAirTemperature
  27073       \key TemperatureDifference
  27074       \default SupplyAirTemperature
  27075  N24, \field Zone Heating Design Supply Air Temperature
  27076       \type real
  27077       \units C
  27078       \default 50.0
  27079       \note Zone Heating Design Supply Air Temperature is only used when Zone Heating Design
  27080       \note Supply Air Temperature Input Method = SupplyAirTemperature
  27081  N25, \field Zone Heating Design Supply Air Temperature Difference
  27082       \type real
  27083       \units deltaC
  27084       \default 30.0
  27085       \note Zone Heating Design Supply Air Temperature is only used when Zone Heating Design
  27086       \note Supply Air Temperature Input Method = TemperatureDifference
  27087       \note The absolute value of this field will be added to the zone temperature
  27088       \note at peak load to calculate the Zone Heating Design Supply Air Temperature.
  27089  A14, \field Heat Pump Coil Water Flow Mode
  27090       \type choice
  27091       \key Constant
  27092       \key Cycling
  27093       \key ConstantOnDemand
  27094       \default Cycling
  27095       \note used only when the heat pump coils are of the type WaterToAirHeatPump:EquationFit
  27096       \note Constant results in 100% water flow regardless of compressor PLR
  27097       \note Cycling results in water flow that matches compressor PLR
  27098       \note ConstantOnDemand results in 100% water flow whenever the coil is on, but is 0% whenever the coil has no load
  27099  A15, \field Design Specification Outdoor Air Object Name
  27100       \note This field is used only when Outdoor Air Method=DetailedSpecification.
  27101       \type object-list
  27102       \object-list DesignSpecificationOutdoorAirNames
  27103  A16, \field Design Specification Zone Air Distribution Object Name
  27104       \note This field is used only when Outdoor Air Method=DetailedSpecification.
  27105       \type object-list
  27106       \object-list DesignSpecificationZoneAirDistributionNames
  27107  A17, \field Baseboard Heating Type
  27108       \type choice
  27109       \key  HotWater
  27110       \key  Electric
  27111       \key  None
  27112       \default None
  27113  A18, \field Baseboard Heating Availability Schedule Name
  27114       \note If blank, always on
  27115       \type object-list
  27116       \object-list ScheduleNames
  27117  N26; \field Baseboard Heating Capacity
  27118       \autosizable
  27119       \default autosize
  27120       \units W

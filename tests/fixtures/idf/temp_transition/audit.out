  34566         \key Coil:Heating:Fuel
  34567         \key Coil:Heating:Electric
  34568         \key Coil:Heating:Water
  34569         \key Coil:Heating:Steam
  34570         \note works with gas, electric, hot water and steam heating coil.
  34571    A14, \field Supplemental Heating Coil Name
  34572         \required-field

  12740 WindowProperty:AirflowControl,
  12741     \memo Used to control forced airflow through a gap between glass layers
  12742     \min-fields 7
  12743   A1 , \field Name
  12744        \required-field
  12745        \type object-list
  12746        \object-list SubSurfNames
  12747        \note Name must be that of an exterior window with two or three glass layers.
  12748   A2 , \field Airflow Source
  12749        \type choice
  12750        \key IndoorAir
  12751        \key OutdoorAir
  12752        \default IndoorAir
  12753   A3 , \field Airflow Destination
  12754        \note If ReturnAir is selected, the name of the Return Air Node may be specified below.
  12755        \type choice
  12756        \key IndoorAir
  12757        \key OutdoorAir
  12758        \key ReturnAir
  12759        \default OutdoorAir
  12760   N1 , \field Maximum Flow Rate
  12761        \units m3/s-m
  12762        \note Above is m3/s per m of glazing width
  12763        \ip-units ft3/min-ft
  12764        \default 0.0
  12765        \minimum 0.0
  12766   A4 , \field Airflow Control Type
  12767        \type choice
  12768        \key AlwaysOnAtMaximumFlow
  12769        \key AlwaysOff
  12770        \key ScheduledOnly
  12771        \note ScheduledOnly requires that Airflow Has Multiplier Schedule Name = Yes
  12772        \note  and that Airflow Multiplier Schedule Name is specified.
  12773        \default AlwaysOnAtMaximumFlow
  12774   A5 , \field Airflow Is Scheduled
  12775        \type choice
  12776        \key Yes
  12777        \key No
  12778        \default No
  12779        \note If Yes, then Airflow Multiplier Schedule Name must be specified
  12780   A6 , \field Airflow Multiplier Schedule Name
  12781        \type object-list
  12782        \object-list ScheduleNames
  12783        \note Required if Airflow Is Scheduled = Yes.
  12784        \note Schedule values are 0.0 or 1.0 and multiply Maximum Air Flow.
  12785   A7 ; \field Airflow Return Air Node Name
  12786        \note Name of the return air node for this airflow window if the Airflow Destination is ReturnAir.
  12787        \note If left blank, defaults to the first return air node for the zone of the window surface.
  12788        \type node
  12789 
  12790 WindowProperty:StormWindow,
  12791        \min-fields 7
  12792        \memo This is a movable exterior glass layer that is usually applied in the winter
  12793        \memo and removed in the summer.
  12794   A1,  \field Window Name
  12795        \note Must be the name of a FenestrationSurface:Detailed object with Surface Type = WINDOW.
  12796        \note The WindowProperty:StormWindow object can only be used with exterior windows.
  12797        \required-field
  12798        \type object-list
  12799        \object-list SubSurfNames
  12800   A2,  \field Storm Glass Layer Name
  12801        \note Must be a WindowMaterial:Glazing or WindowMaterial:Glazing:RefractionExtinctionMethod
  12802        \note Gap between storm glass layer and adjacent glass layer is assumed to be filled
  12803        \note with Air
  12804        \required-field
  12805        \type object-list
  12806        \object-list GlazingMaterialName
  12807   N1,  \field Distance Between Storm Glass Layer and Adjacent Glass
  12808        \type real
  12809        \units m
  12810        \minimum> 0.0
  12811        \maximum 0.5
  12812        \default 0.050
  12813   N2,  \field Month that Storm Glass Layer is Put On
  12814        \required-field
  12815        \minimum 1
  12816        \maximum 12
  12817        \type integer
  12818   N3,  \field Day of Month that Storm Glass Layer is Put On
  12819        \required-field
  12820        \minimum 1
  12821        \maximum 31
  12822        \type integer
  12823   N4,  \field Month that Storm Glass Layer is Taken Off
  12824        \required-field
  12825        \minimum 1
  12826        \maximum 12
  12827        \type integer
  12828   N5;  \field Day of Month that Storm Glass Layer is Taken Off
  12829        \required-field
  12830        \minimum 1
  12831        \maximum 31
  12832        \type integer
  12833 
  12834 InternalMass,
  12835        \memo Used to describe internal zone surface area that does not need to be part of geometric
  12836        \memo representation. This should be the total surface area exposed to the zone air.
  12837        \memo If you use a ZoneList in the Zone or ZoneList name field then this definition applies
  12838        \memo to all the zones in the ZoneList.
  12839   A1 , \field Name
  12840        \required-field
  12841        \type alpha
  12842        \reference AllHeatTranSurfNames
  12843        \reference AllHeatTranAngFacNames
  12844        \reference RadiantSurfaceNames
  12845   A2 , \field Construction Name
  12846        \required-field
  12847        \note To be matched with a construction in this input file
  12848        \type object-list
  12849        \object-list ConstructionNames
  12850   A3 , \field Zone or ZoneList Name
  12851        \required-field
  12852        \type object-list
  12853        \object-list ZoneAndZoneListNames
  12854        \note Zone the surface is a part of
  12855        \note used to be Interior Environment
  12856   N1 ; \field Surface Area
  12857        \required-field
  12858        \units m2
  12859        \minimum> 0
  12860 

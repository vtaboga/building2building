  24514       \units m
  24515       \default 0.0
  24516       \note Designates the reference height used to calculate relative pressure.
  24517  A2 , \field Wind Pressure Coefficient Curve Name
  24518       \required-field
  24519       \type object-list
  24520       \object-list WPCValueNames
  24521       \object-list UnivariateFunctions
  24522       \note The name of the AirflowNetwork:MultiZone:WindPressureCoefficientValues, curve, or table object specifying the wind pressure coefficient.
  24523  A3 , \field Symmetric Wind Pressure Coefficient Curve
  24524       \type choice
  24525       \key Yes
  24526       \key No
  24527       \default No
  24528       \note Specify whether the pressure curve is symmetric or not.

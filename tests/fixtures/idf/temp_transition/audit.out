   4756 Schedule:Constant,
   4757    \memo Constant hourly value for entire year.
   4758    \format singleLine
   4759   A1 , \field Name
   4760        \required-field
   4761        \type alpha
   4762        \reference ScheduleNames
   4763   A2 , \field Schedule Type Limits Name
   4764        \type object-list
   4765        \object-list ScheduleTypeLimitsNames
   4766   N1 ; \field Hourly Value
   4767        \type real
   4768        \default 0
   4769 
   4770 Schedule:File:Shading,
   4771        \min-fields 1
   4772        \memo A Schedule:File:Shading points to a CSV file that has 8760-8784
   4773        \memo hours of sunlit fraction data for all or some of the exterior surfaces.
   4774        \unique-object
   4775   A1 ; \field File Name
   4776        \note The name of the file that writes all shading data.
   4777        \required-field
   4778        \retaincase
   4779 
   4780 Schedule:File,
   4781  \min-fields 5
   4782        \memo A Schedule:File points to a text computer file that has 8760-8784 hours of data.
   4783   A1 , \field Name
   4784        \required-field
   4785        \type alpha
   4786        \reference ScheduleNames
   4787   A2 , \field Schedule Type Limits Name
   4788        \type object-list
   4789        \object-list ScheduleTypeLimitsNames
   4790   A3 , \field File Name
   4791        \required-field
   4792        \retaincase
   4793   N1 , \field Column Number
   4794        \required-field
   4795        \type integer
   4796        \minimum 1
   4797   N2 , \field Rows to Skip at Top
   4798        \required-field
   4799        \type integer
   4800        \minimum 0
   4801   N3 , \field Number of Hours of Data
   4802        \note 8760 hours does not account for leap years, 8784 does.
   4803        \note should be either 8760 or 8784
   4804        \default 8760
   4805        \minimum 8760
   4806        \maximum 8784
   4807   A4 , \field Column Separator
   4808        \type choice
   4809        \key Comma
   4810        \key Tab
   4811        \key Space
   4812        \key Semicolon
   4813        \default Comma
   4814   A5 , \field Interpolate to Timestep
   4815        \note when the interval does not match the user specified timestep a "Yes" choice will average between the intervals request (to
   4816        \note timestep resolution.  a "No" choice will use the interval value at the simulation timestep without regard to if it matches
   4817        \note the boundary or not.
   4818        \type choice
   4819        \key Yes
   4820        \key No
   4821        \default No
   4822   N4 ; \field Minutes per Item
   4823        \note Must be evenly divisible into 60
   4824        \type integer
   4825        \minimum 1
   4826        \maximum 60
   4827 
   4828 \group Surface Construction Elements
   4829 
   4830 Material,
   4831     \memo Regular materials described with full set of thermal properties
   4832     \min-fields 6
   4833   A1 , \field Name
   4834        \required-field
   4835        \type alpha
   4836        \reference MaterialName
   4837   A2 , \field Roughness
   4838        \required-field
   4839        \type choice
   4840        \key VeryRough
   4841        \key Rough
   4842        \key MediumRough
   4843        \key MediumSmooth
   4844        \key Smooth
   4845        \key VerySmooth
   4846   N1 , \field Thickness
   4847        \required-field
   4848        \units m
   4849        \type real
   4850        \minimum> 0
   4851        \ip-units in
   4852   N2 , \field Conductivity
   4853        \required-field
   4854        \units W/m-K
   4855        \type real
   4856        \minimum> 0
   4857   N3 , \field Density
   4858        \required-field
   4859        \units kg/m3
   4860        \type real
   4861        \minimum> 0
   4862   N4 , \field Specific Heat
   4863        \required-field
   4864        \units J/kg-K
   4865        \type real
   4866        \minimum 100
   4867   N5 , \field Thermal Absorptance
   4868        \type real
   4869        \minimum> 0
   4870        \default .9
   4871        \maximum 0.99999
   4872   N6 , \field Solar Absorptance
   4873        \type real
   4874        \default .7
   4875        \minimum 0
   4876        \maximum 1
   4877   N7 ; \field Visible Absorptance
   4878        \type real
   4879        \minimum 0
   4880        \default .7
   4881        \maximum 1
   4882 
   4883 Material:NoMass,
   4884     \memo Regular materials properties described whose principal description is R (Thermal Resistance)
   4885      \min-fields 3
   4886   A1 , \field Name
   4887        \required-field
   4888        \type alpha
   4889        \reference MaterialName
   4890   A2 , \field Roughness
   4891        \required-field
   4892        \type choice
   4893        \key VeryRough
   4894        \key Rough
   4895        \key MediumRough
   4896        \key MediumSmooth
   4897        \key Smooth
   4898        \key VerySmooth
   4899   N1 , \field Thermal Resistance
   4900        \required-field
   4901        \units m2-K/W
   4902        \type real
   4903        \minimum .001
   4904   N2 , \field Thermal Absorptance
   4905        \type real
   4906        \minimum> 0
   4907        \default .9
   4908        \maximum 0.99999
   4909   N3 , \field Solar Absorptance
   4910        \type real
   4911        \minimum 0
   4912        \default .7
   4913        \maximum 1
   4914   N4 ; \field Visible Absorptance
   4915        \type real
   4916        \minimum 0
   4917        \default .7
   4918        \maximum 1
   4919 
   4920 Material:InfraredTransparent,
   4921        \memo Special infrared transparent material.  Similar to a Material:Nomass with low thermal resistance.
   4922        \memo  High absorptance in both wavelengths.
   4923        \memo  Area will be doubled internally to make internal radiant exchange accurate.
   4924        \memo  Should be only material in single layer surface construction.
   4925        \memo  All thermal properties are set internally. User needs only to supply name.
   4926        \memo Cannot be used with ConductionFiniteDifference solution algorithms
   4927        \min-fields 1
   4928   A1 ; \field Name
   4929        \required-field
   4930        \type alpha
   4931        \reference MaterialName
   4932 
   4933 Material:AirGap,
   4934        \min-fields 2
   4935        \memo Air Space in Opaque Construction
   4936   A1 , \field Name
   4937        \required-field
   4938        \type alpha
   4939        \reference MaterialName
   4940   N1 ; \field Thermal Resistance
   4941        \required-field
   4942        \units m2-K/W
   4943        \type real
   4944        \minimum> 0
   4945 
   4946 Material:RoofVegetation,
   4947   \memo EcoRoof model, plant layer plus soil layer
   4948   \memo Implemented by Portland State University
   4949   \memo (Sailor et al., January, 2007)
   4950   \memo only one material must be referenced per simulation though the same EcoRoof material could be
   4951   \memo used in multiple constructions. New moisture redistribution scheme (2010) requires higher
   4952   \memo number of timesteps per hour (minimum 12 recommended).
   4953   \min-fields 19
   4954   A1 ,\field Name
   4955       \required-field
   4956       \type alpha
   4957       \reference MaterialName
   4958   N1 ,\field Height of Plants
   4959       \type real
   4960       \note The ecoroof module is designed for short plants and shrubs.
   4961       \minimum> 0.005
   4962       \maximum  1.0
   4963       \units m
   4964       \default .2
   4965   N2 ,\field Leaf Area Index
   4966       \units dimensionless
   4967       \note Entire surface is assumed covered, so decrease LAI accordingly.
   4968       \minimum> 0.001
   4969       \maximum 5.0
   4970       \default 1.0
   4971       \type real
   4972   N3 ,\field Leaf Reflectivity
   4973       \type real
   4974       \units dimensionless
   4975       \note Leaf reflectivity (albedo) is typically 0.18-0.25
   4976       \maximum 0.5
   4977       \minimum 0.05
   4978       \default 0.22
   4979   N4 ,\field Leaf Emissivity
   4980       \type real
   4981       \minimum 0.8
   4982       \maximum 1.0
   4983       \default 0.95
   4984   N5 ,\field Minimum Stomatal Resistance
   4985       \units s/m
   4986       \default 180.0
   4987       \note This depends upon plant type
   4988       \minimum 50.0
   4989       \maximum 300.
   4990       \type real
   4991   A2 ,\field Soil Layer Name
   4992       \type alpha
   4993       \default Green Roof Soil
   4994   A3 ,\field Roughness
   4995       \type choice
   4996       \key VeryRough
   4997       \key MediumRough
   4998       \key Rough
   4999       \key Smooth
   5000       \key MediumSmooth
   5001       \key VerySmooth
   5002       \default MediumRough
   5003   N6 ,\field Thickness
   5004       \note thickness of the soil layer of the EcoRoof
   5005       \units m
   5006       \type real
   5007       \note Soil depths of 0.15m (6in) and 0.30m (12in) are common.
   5008       \default 0.1
   5009       \minimum> 0.05
   5010       \maximum 0.7
   5011       \ip-units in
   5012   N7 ,\field Conductivity of Dry Soil
   5013       \units W/m-K
   5014       \type real
   5015       \note Thermal conductivity of dry soil.
   5016       \note Typical ecoroof soils range from 0.3 to 0.5
   5017       \default 0.35
   5018       \minimum  0.2
   5019       \maximum 1.5
   5020   N8 ,\field Density of Dry Soil
   5021       \units kg/m3
   5022       \note Density of dry soil (the code modifies this as the soil becomes moist)
   5023       \note Typical ecoroof soils range from 400 to 1000 (dry to wet)
   5024       \type real
   5025       \minimum 300
   5026       \maximum 2000
   5027       \default 1100
   5028   N9 ,\field Specific Heat of Dry Soil
   5029       \units J/kg-K
   5030       \type real
   5031       \note Specific heat of dry soil
   5032       \minimum> 500
   5033       \maximum 2000
   5034       \default 1200
   5035   N10,\field Thermal Absorptance
   5036       \type real
   5037       \note Soil emissivity is typically in range of 0.90 to 0.98
   5038       \minimum> 0.8
   5039       \default .9
   5040       \maximum 1.0
   5041   N11,\field Solar Absorptance
   5042       \type real
   5043       \note Solar absorptance of dry soil (1-albedo) is typically 0.60 to 0.85
   5044       \note corresponding to a dry albedo of 0.15 to 0.40
   5045       \default .70
   5046       \minimum 0.40
   5047       \maximum 0.9
   5048   N12,\field Visible Absorptance
   5049       \type real
   5050       \minimum> 0.5
   5051       \default .75
   5052       \maximum 1.0
   5053   N13,\field Saturation Volumetric Moisture Content of the Soil Layer
   5054       \type real
   5055       \note Maximum moisture content is typically less than 0.5
   5056       \minimum> 0.1
   5057       \maximum 0.5
   5058       \default 0.3
   5059   N14,\field Residual Volumetric Moisture Content of the Soil Layer
   5060       \type real
   5061       \minimum  0.01
   5062       \maximum  0.1
   5063       \default 0.01
   5064   N15,\field Initial Volumetric Moisture Content of the Soil Layer
   5065       \type real
   5066       \minimum> 0.05
   5067       \maximum  0.5
   5068       \default 0.1
   5069   A4; \field Moisture Diffusion Calculation Method
   5070       \note Advanced calculation requires increased number of timesteps (recommended >20).
   5071       \type choice
   5072       \key Simple
   5073       \key Advanced
   5074       \default Advanced
   5075 

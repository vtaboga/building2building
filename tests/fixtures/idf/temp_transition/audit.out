  16761        \minimum 0.0
  16762        \default 0.0
  16763   A5,  \field Exterior Vertical Insulation Material Name
  16764        \type object-list
  16765        \object-list MaterialName
  16766   N7,  \field Exterior Vertical Insulation Depth
  16767        \note Extent of insulation as measured from the wall top to the bottom
  16768        \note edge of the exterior vertical insulation
  16769        \units m
  16770        \type real
  16771        \minimum> 0.0
  16772   N8,  \field Wall Height Above Grade
  16773        \note Distance from the exterior grade to the wall top
  16774        \units m
  16775        \type real
  16776        \minimum 0.0
  16777        \default 0.2
  16778   N9,  \field Wall Depth Below Slab
  16779        \note Distance from the slab bottom to the bottom of the foundation wall
  16780        \units m
  16781        \type real
  16782        \minimum 0.0
  16783        \default 0.0
  16784   A6,  \field Footing Wall Construction Name
  16785        \note Defines the below-grade surface construction for slabs. Required
  16786        \note if foundation wall is not exposed to the zone.
  16787        \type object-list
  16788        \object-list ConstructionNames
  16789   A7,  \field Footing Material Name
  16790        \type object-list
  16791        \object-list MaterialName
  16792   N10,  \field Footing Depth
  16793        \note Top-to-bottom dimension of the footing (not to be confused with its
  16794        \note depth in the ground). The width of the footing is defined by the
  16795        \note material's thickness.
  16796        \units m
  16797        \type real
  16798        \minimum> 0.0
  16799        \default 0.3
  16800   A8,  \field Custom Block 1 Material Name
  16801        \begin-extensible
  16802        \type object-list

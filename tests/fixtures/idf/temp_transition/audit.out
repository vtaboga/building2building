  57434   N70, \field Speed 10 Reference Unit Rated Water Flow Rate
  57435        \units m3/s
  57436        \ip-units gal/min
  57437        \type real
  57438        \minimum 0
  57439   N71, \field Speed 10 Reference Unit Water Pump Input Power At Rated Conditions
  57440        \units dimensionless
  57441        \type real
  57442        \minimum 0
  57443   A65, \field Speed 10 Total WH Capacity Function of Temperature Curve Name
  57444        \type object-list
  57445        \object-list BivariateFunctions
  57446        \note Table:Lookup object can also be used
  57447        \note curve = a + b*wb + c*wb**2 + d*ewt + e*ewt**2 + f*wb*ewt
  57448        \note wb = entering wet-bulb temperature or dry bulb temperature upon selection (C)
  57449        \note ewt = water entering temperature seen by the condenser (C)
  57450   A66, \field Speed 10 Total WH Capacity Function of Air Flow Fraction Curve Name
  57451        \type object-list
  57452        \object-list UnivariateFunctions
  57453        \note Table:Lookup object can also be used
  57454        \note quadratic curve = a + b*ffa + c*ffa**2
  57455        \note cubic curve = a + b*ffa + c*ffa**2 + d*ffa**3
  57456        \note ffa = Fraction of the full load Air Flow
  57457   A67, \field Speed 10 Total WH Capacity Function of Water Flow Fraction Curve Name
  57458        \type object-list
  57459        \object-list UnivariateFunctions
  57460        \note Table:Lookup object can also be used
  57461        \note quadratic curve = a + b*ffw + c*ffw**2
  57462        \note cubic curve = a + b*ffw + c*ffw**2 + d*ffw**3
  57463        \note ffw = Fraction of the full load Water Flow

  26390       \key BlowThrough
  26391       \key DrawThrough
  26392       \default DrawThrough
  26393   N9, \field Supply Fan Total Efficiency
  26394       \minimum> 0.0
  26395       \maximum 1.0
  26396       \default 0.7
  26397  N10, \field Supply Fan Delta Pressure
  26398       \units Pa
  26399       \ip-units inH2O
  26400       \minimum 0
  26401       \default 75
  26402  N11, \field Supply Fan Motor Efficiency
  26403       \minimum> 0.0
  26404       \maximum 1.0
  26405       \default 0.9
  26406   A7, \field Cooling Coil Type
  26407       \type choice
  26408       \key  SingleSpeedDX
  26409       \default SingleSpeedDX
  26410   A8, \field Cooling Coil Availability Schedule Name
  26411       \note If blank, always on
  26412       \type object-list
  26413       \object-list ScheduleNames

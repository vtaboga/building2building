  57942        \reference AFNCoilNames
  57943        \reference-class-name validBranchEquipmentTypes
  57944        \reference validBranchEquipmentNames
  57945   A2 , \field Availability Schedule Name
  57946        \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  57947        \note If this field is blank, the system is always available.
  57948        \type object-list
  57949        \object-list ScheduleNames
  57950   A3 , \field Operating Mode Control Method
  57951        \required-field
  57952        \type choice
  57953        \key ScheduledModes
  57954        \key EMSControlled
  57955   A4 , \field Operation Mode Control Schedule Name
  57956        \note This field is used if the control method is set to ScheduledModes
  57957        \note Schedule values control operating mode: 0=off, 1=cooling only, 2= cooling and charge,
  57958        \note 3= cooling and discharge, 4= charge only, and 5= discharge only
  57959        \type object-list
  57960        \object-list ScheduleNames
  57961   A5 , \field Storage Type
  57962        \type choice
  57963        \key Water
  57964        \key UserDefinedFluidType
  57965        \key Ice
  57966        \required-field
  57967   A6 , \field User Defined Fluid Type
  57968        \type object-list
  57969        \object-list FluidAndGlycolNames
  57970        \note This field is required when Storage Type is UserDefinedFluidType
  57971   N1 , \field Fluid Storage Volume
  57972        \units m3
  57973        \ip-units gal
  57974        \type real
  57975        \minimum> 0
  57976        \note required field if Storage Type is Water or UserDefinedFluidType
  57977        \autocalculatable
  57978   N2 , \field Ice Storage Capacity
  57979        \units GJ
  57980        \type real
  57981        \minimum> 0
  57982        \note required field if Storage Type is Ice
  57983        \autocalculatable
  57984   N3 , \field Storage Capacity Sizing Factor
  57985        \type real
  57986        \units hr
  57987        \note If one of the previous two fields is set to autocalculate, this determines the storage capacity
  57988        \note as a function of Cooling Only Mode Rated Total Evaporator Cooling Capacity
  57989   A7 , \field Storage Tank Ambient Temperature Node Name
  57990        \type node
  57991        \required-field
  57992   N4 , \field Storage Tank to Ambient U-value Times Area Heat Transfer Coefficient
  57993        \type real
  57994        \units W/K
  57995        \minimum> 0
  57996        \required-field
  57997   N5,  \field Fluid Storage Tank Rating Temperature
  57998        \type real
  57999        \units C
  58000        \note required field if Storage Type is Water or UserDefinedFluidType
  58001   N6 , \field Rated Evaporator Air Flow Rate
  58002        \required-field
  58003        \type real
  58004        \units m3/s
  58005        \minimum> 0
  58006        \autosizable
  58007        \note Flow rate corresponding to rated total cooling capacity, Rated SHR and Rated COP
  58008   A8 , \field Evaporator Air Inlet Node Name
  58009        \required-field
  58010        \type node
  58011   A9 , \field Evaporator Air Outlet Node Name
  58012        \required-field
  58013        \type node
  58014   A10 , \field Cooling Only Mode Available
  58015        \required-field
  58016        \type choice
  58017        \key Yes
  58018        \key No
  58019   N7 , \field Cooling Only Mode Rated Total Evaporator Cooling Capacity
  58020        \note required field if Cooling Only Mode is available or if autocalculating sizes
  58021        \type real
  58022        \units W
  58023        \minimum 0.0
  58024        \autosizable
  58025        \note gross capacity excluding supply air fan heat
  58026        \note rating point: air entering the cooling coil at 26.7 C dry-bulb/19.4 C wet-bulb, and
  58027        \note air entering the outdoor condenser coil at 35 C dry-bulb/23.9 C wet-bulb
  58028   N8 , \field Cooling Only Mode Rated Sensible Heat Ratio
  58029        \note required field if Cooling Only Mode is available
  58030        \type real
  58031        \minimum 0.0
  58032        \maximum 1.0
  58033        \default 0.7
  58034        \note Rated sensible heat ratio (gross sensible capacity/gross total capacity)
  58035        \note sensible and total capacities do not include supply fan heat
  58036   N9 , \field Cooling Only Mode Rated COP
  58037        \note Gross cooling capacity divided by power input to the compressor and outdoor fan,
  58038        \note does not include supply fan heat or supply fan electrical energy input
  58039        \type real
  58040        \units W/W
  58041        \minimum> 0.0
  58042        \default 3.0
  58043        \note required field if Cooling Only Mode is available
  58044   A11, \field Cooling Only Mode Total Evaporator Cooling Capacity Function of Temperature Curve Name
  58045        \note required field if Cooling Only Mode is available
  58046        \type object-list
  58047        \object-list BivariateFunctions
  58048        \note Any curve or table with two independent variables can be used
  58049        \note biquadratic curve = a + b*ewb + c*ewb**2 + d*db + e*db**2 + f*ewb*db
  58050        \note x = ewb = evaporator entering wet-bulb temperature (C)
  58051        \note y = db = dry-bulb temperature seen by the condenser (C)
  58052   A12, \field Cooling Only Mode Total Evaporator Cooling Capacity Function of Flow Fraction Curve Name
  58053        \note required field if Cooling Only Mode is available
  58054        \type object-list
  58055        \object-list UnivariateFunctions
  58056        \note Any curve or table with one independent variable can be used
  58057        \note quadratic curve = a + b*ff + c*ff**2
  58058        \note cubic curve = a + b*ff + c*ff**2 + d*ff**3
  58059        \note x = ff = Fraction of the full load evaporator air flow rate
  58060   A13, \field Cooling Only Mode Energy Input Ratio Function of Temperature Curve Name
  58061        \note required field if Cooling Only Mode is available
  58062        \type object-list
  58063        \object-list BivariateFunctions
  58064        \note Any curve or table with two independent variables can be used
  58065        \note curve = a + b*ewb + c*ewb**2 + d*db + e*db**2 + f*ewb*db
  58066        \note x = ewb = evaporator entering wet-bulb temperature (C)
  58067        \note y = db = dry-bulb temperature seen by the condenser (C)
  58068   A14, \field Cooling Only Mode Energy Input Ratio Function of Flow Fraction Curve Name
  58069        \note required field if Cooling Only Mode is available
  58070        \type object-list
  58071        \object-list UnivariateFunctions
  58072        \note Any curve or table with one independent variable can be used
  58073        \note quadratic curve = a + b*ff + c*ff**2
  58074        \note cubic curve = a + b*ff + c*ff**2 + d*ff**3
  58075        \note x = ff = Fraction of the full load evaporator air flow
  58076   A15, \field Cooling Only Mode Part Load Fraction Correlation Curve Name
  58077        \note required field if Cooling Only Mode is available
  58078        \type object-list
  58079        \object-list UnivariateFunctions
  58080        \note Any curve or table with one independent variable can be used
  58081        \note quadratic curve = a + b*PLR + c*PLR**2
  58082        \note cubic curve = a + b*PLR + c*PLR**2 + d*PLR**3
  58083        \note x = PLR = part load ratio (evaporator cooling load/steady state capacity)
  58084   A16, \field Cooling Only Mode Sensible Heat Ratio Function of Temperature Curve Name
  58085        \note required field if Cooling Only Mode is available
  58086        \type object-list
  58087        \object-list BivariateFunctions
  58088        \note Any curve or table with two independent variables can be used
  58089        \note curve = a + b*ewb + c*ewb**2 + d*edb + e*edb**2 + f*ewb*edb
  58090        \note x = ewb = evaporator entering wet-bulb temperature seen by the cooling coil (C)
  58091        \note y = edb = evaporator entering dry-bulb temperature seen by the cooling coil (C)
  58092   A17, \field Cooling Only Mode Sensible Heat Ratio Function of Flow Fraction Curve Name
  58093        \note required field if Cooling Only Mode is available
  58094        \type object-list
  58095        \object-list UnivariateFunctions
  58096        \note Any curve or table with one independent variable can be used

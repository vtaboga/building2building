   2008         \type choice
   2009         \key InGrade
   2010         \key OnGrade
   2011         \note This field specifies whether the slab is located "in-grade" or "on-grade"
   2012    A6,  \field Slab Material Name
   2013         \type object-list
   2014         \object-list MaterialName
   2015         \note Only applicable for the in-grade case
   2016    A7,  \field Horizontal Insulation
   2017         \type choice
   2018         \key Yes
   2019         \key No
   2020         \default No
   2021         \note This field specifies the presence of insulation beneath the slab.
   2022         \note Only required for in-grade case.
   2023    A8,  \field Horizontal Insulation Material Name
   2024         \type object-list
   2025         \object-list MaterialName
   2026         \note This field specifies the horizontal insulation material.
   2027    A9,  \field Horizontal Insulation Extents
   2028         \type choice
   2029         \key Full
   2030         \key Perimeter
   2031         \default Full
   2032         \note This field specifies whether the horizontal insulation fully insulates
   2033         \note the surface or is perimeter only insulation
   2034    N10, \field Perimeter Insulation Width
   2035         \type real
   2036         \units m
   2037         \minimum> 0.0
   2038         \note This field specifies the width of the underfloor perimeter insulation
   2039    A10, \field Vertical Insulation
   2040         \type choice
   2041         \key Yes
   2042         \key No
   2043         \default No
   2044         \note This field specifies the presence of vertical insulation at the slab edge.
   2045    A11, \field Vertical Insulation Material Name
   2046         \type object-list
   2047         \object-list MaterialName
   2048         \note This field specifies the vertical insulation material.
   2049    N11, \field Vertical Insulation Depth
   2050         \type real
   2051         \units m
   2052         \minimum> 0.0
   2053         \note Only used when including vertical insulation
   2054         \note This field specifies the depth of the vertical insulation
   2055    A12, \field Simulation Timestep
   2056         \type choice
   2057         \key Timestep
   2058         \key Hourly
   2059         \default Hourly
   2060         \note This field specifies the ground domain simulation timestep.
   2061    N12, \field Geometric Mesh Coefficient
   2062         \type real
   2063         \minimum 1.0
   2064         \maximum 2.0
   2065         \default 1.6
   2066    N13; \field Mesh Density Parameter
   2067         \type integer
   2068         \minimum 4
   2069         \default 6
   2070 
   2071 Site:GroundDomain:Basement,
   2072         \memo Ground-coupled basement model for simulating basements
   2073         \memo or other underground zones.
   2074    A1,  \field Name
   2075         \required-field
   2076    N1,  \field Ground Domain Depth
   2077         \type real
   2078         \default 10
   2079         \units m
   2080         \minimum> 0.0
   2081         \note The depth from ground surface to the deep ground boundary of the domain.
   2082    N2,  \field Aspect Ratio
   2083         \type real
   2084         \default 1
   2085         \note This defines the height to width ratio of the basement zone.
   2086    N3,  \field Perimeter Offset
   2087         \type real
   2088         \default 5
   2089         \units m
   2090         \minimum> 0.0
   2091         \note The distance from the basement wall edge to the edge of the ground domain
   2092    N4,  \field Soil Thermal Conductivity
   2093         \type real
   2094         \default 1.5
   2095         \units W/m-K
   2096         \minimum> 0.0
   2097    N5,  \field Soil Density
   2098         \type real
   2099         \default 2800
   2100         \units kg/m3
   2101         \minimum> 0.0
   2102    N6,  \field Soil Specific Heat
   2103         \type real
   2104         \default 850
   2105         \units J/kg-K
   2106         \minimum> 0.0
   2107    N7, \field Soil Moisture Content Volume Fraction
   2108         \type real
   2109         \units percent
   2110         \minimum 0
   2111         \maximum 100
   2112         \default 30
   2113    N8, \field Soil Moisture Content Volume Fraction at Saturation
   2114         \type real
   2115         \units percent
   2116         \minimum 0
   2117         \maximum 100
   2118         \default 50
   2119    A2,  \field Undisturbed Ground Temperature Model Type
   2120         \required-field
   2121         \type choice
   2122         \key Site:GroundTemperature:Undisturbed:FiniteDifference
   2123         \key Site:GroundTemperature:Undisturbed:KusudaAchenbach
   2124         \key Site:GroundTemperature:Undisturbed:Xing
   2125    A3,  \field Undisturbed Ground Temperature Model Name
   2126         \required-field
   2127         \type object-list
   2128         \object-list UndisturbedGroundTempModels
   2129    N9,  \field Evapotranspiration Ground Cover Parameter
   2130         \type real
   2131         \minimum 0
   2132         \maximum 1.5
   2133         \default 0.4
   2134         \note This specifies the ground cover effects during evapotranspiration
   2135         \note  calculations.  The value roughly represents the following cases:
   2136         \note  = 0   : concrete or other solid, non-permeable ground surface material
   2137         \note  = 0.5 : short grass, much like a manicured lawn
   2138         \note  = 1   : standard reference state (12 cm grass)
   2139         \note  = 1.5 : wild growth
   2140    A4,  \field Basement Floor Boundary Condition Model Name
   2141         \required-field
   2142         \type object-list
   2143         \object-list OSCMNames
   2144    A5,  \field Horizontal Insulation
   2145         \type choice
   2146         \key Yes
   2147         \key No
   2148         \default No
   2149         \note This field specifies the presence of insulation beneath the basement floor.
   2150    A6,  \field Horizontal Insulation Material Name
   2151         \type object-list
   2152         \object-list MaterialName
   2153    A7,  \field Horizontal Insulation Extents
   2154         \type choice
   2155         \key Perimeter
   2156         \key Full
   2157         \default Full
   2158         \note This field specifies whether the horizontal insulation fully insulates
   2159         \note the surface or is perimeter only insulation
   2160    N10, \field Perimeter Horizontal Insulation Width
   2161         \type real
   2162         \units m
   2163         \minimum> 0.0
   2164         \note Width of horizontal perimeter insulation measured from
   2165         \note foundation wall inside surface.
   2166    N11, \field Basement Wall Depth
   2167         \type real
   2168         \units m
   2169         \minimum> 0.0
   2170         \note Depth measured from ground surface.
   2171    A8,  \field Basement Wall Boundary Condition Model Name
   2172         \required-field
   2173         \type object-list
   2174         \object-list OSCMNames
   2175    A9,  \field Vertical Insulation
   2176         \type choice
   2177         \key Yes
   2178         \key No
   2179         \default No
   2180    A10, \field Basement Wall Vertical Insulation Material Name
   2181         \type object-list
   2182         \object-list MaterialName
   2183    N12, \field Vertical Insulation Depth
   2184         \type real
   2185         \units m
   2186         \minimum> 0.0
   2187         \note Depth measured from the ground surface.
   2188    A11, \field Simulation Timestep
   2189         \type choice
   2190         \key Timestep
   2191         \key Hourly
   2192         \default Hourly
   2193         \note This field specifies the basement domain simulation interval.
   2194    N13; \field Mesh Density Parameter
   2195         \type integer
   2196         \default 4
   2197         \minimum 2

  64292  !*****************AIR LOOP SPECIFICATION*********************
  64293  ! Air system heating and cooling loops are specified in the following configuration statements.
  64294  ! The AirLoopHVAC input objects connect return and supply air paths from
  64295  ! the zone equipment to supply components on an air loop.
  64296  ! There can only be one return air path per air loop
  64297  ! and only up to 3 supply air streams (assuming a 3-deck multizone is the
  64298  ! most complex supply air configuration) per air system.
  64299 
  64300 \group Air Distribution
  64301 
  64302 AirLoopHVAC,
  64303        \min-fields 10
  64304        \memo Defines a central forced air system.
  64305    A1, \field Name
  64306        \required-field
  64307        \type alpha
  64308        \reference AirPrimaryLoops
  64309    A2, \field Controller List Name
  64310        \note Enter the name of an AirLoopHVAC:ControllerList object.
  64311        \type object-list
  64312        \object-list ControllerLists
  64313    A3, \field Availability Manager List Name
  64314        \note Enter the name of an AvailabilityManagerAssignmentList object.
  64315        \type object-list
  64316        \object-list SystemAvailabilityManagerLists
  64317    N1, \field Design Supply Air Flow Rate
  64318        \default 0
  64319        \units m3/s
  64320        \autosizable
  64321    A4, \field Branch List Name
  64322        \note Name of a BranchList containing all the branches in this air loop
  64323        \required-field
  64324        \type object-list
  64325        \object-list BranchLists
  64326    A5, \field Connector List Name
  64327        \note Name of a ConnectorList containing all the splitters and mixers in the loop
  64328        \type object-list
  64329        \object-list ConnectorLists
  64330    A6, \field Supply Side Inlet Node Name
  64331        \note Name of inlet node where air enters the supply side of the air loop.
  64332        \note If this air loop has a return path, then this node is where return air enters the supply side.
  64333        \note If this air loop has no return path, then this node is where outdoor air or other air enters the supply side.
  64334        \required-field
  64335        \type node
  64336    A7, \field Demand Side Outlet Node Name
  64337        \note Name of outlet node where return air leaves the demand side and enters the supply side.
  64338        \note Required if this air loop has a return path. Leave this field blank if there is no return.
  64339        \type node
  64340    A8, \field Demand Side Inlet Node Names
  64341        \note Name of a Node or NodeList containing the inlet node(s) supplying air to zone equipment.
  64342        \required-field
  64343        \type node
  64344    A9, \field Supply Side Outlet Node Names
  64345        \note Name of a Node or NodeList containing the outlet node(s) supplying air to the demand side.
  64346        \required-field
  64347        \type node
  64348    N2; \field Design Return Air Flow Fraction of Supply Air Flow
  64349        \note The design return air flow rate as a fraction of supply air flow rate with no exhaust.
  64350        \note This can be used to model a pressurized system or set to zero to model a DOAS with no return flow.
  64351        \note Use ZoneAirMassFlowConservation to balance zone infiltration and mixing flows.
  64352        \minimum 0.0
  64353        \default 1.0
  64354 

  25753 !****************************************************************************************
  25754 !*                   BUILDING/SYSTEM LOOP SPECIFICATIONS                                *
  25755 !*                                                                                      *
  25756 !*        The following syntax specifies the Loops, and equipment associated            *
  25757 !*        with HVAC and Building Systems.  Specifications include Plant Loops,          *
  25758 !*        Condenser Loops, Air Loops and Zone Equipment.  The following conventions     *
  25759 !*        are followed:                                                                 *
  25760 !*          1.  The word 'KEY' followed by a description indicates that the alpha       *
  25761 !*              string must be selected from the list indicated by the key description. *
  25762 !*          2.  The syntax is organized in the following major blocks:                  *
  25763 !*               --PLANT LOOP SPECIFICATION                                             *
  25764 !*               --CONDENSER LOOP SPECIFICATION
  25765 !*               --AIR LOOP SPECIFICATION
  25766 !*               --ZONE EQUIPMENT SPECIFICATION
  25767 !*               --FLOW CONTROL
  25768 !*               --PLANT LOOP CONNECTORS
  25769 !*               --PLANT EQUIPMENT
  25770 !*               --CONDENSING EQUIPMENT
  25771 !*               --PUMPS
  25772 !*               --COILS
  25773 !*               --AIR LOOP COMPONENTS
  25774 !*               --AIR DISTRIBUTION UNITS
  25775 !*               --LOCAL CONVECTIVE EQUIPMENT
  25776 !*               --HIGH TEMPERATURE RADIANT CONVECTIVE UNITS
  25777 !*               --LOW TEMPERATURE RADIANT CONVECTIVE UNITS
  25778 !*               --AIR LOOP CONNECTORS
  25779 !*               --System Control and Controllers
  25780 !************************************************************************************
  25781 
  25782 \group HVAC Templates
  25783 
  25784 HVACTemplate:Thermostat,
  25785       \min-fields 5
  25786       \memo Zone thermostat control.  Referenced schedules must be
  25787       \memo defined elsewhere in the idf.  Thermostat control type is
  25788       \memo dual setpoint with deadband.  It is not necessary to create
  25789       \memo a thermostat object for every zone, only for each unique
  25790       \memo set of setpoint schedules.  For example, an office building
  25791       \memo may have two thermostat objects, one for "Office" and one
  25792       \memo for "Storage".
  25793   A1, \field Name
  25794       \required-field
  25795       \note This name is referenced by HVACTemplate:Zone:* objects
  25796       \reference CompactHVACThermostats
  25797   A2, \field Heating Setpoint Schedule Name
  25798       \note  Leave blank if constant setpoint specified below, must enter schedule or constant setpoint
  25799       \type object-list
  25800       \object-list ScheduleNames
  25801   N1, \field Constant Heating Setpoint
  25802       \note  Ignored if schedule specified above, must enter schedule or constant setpoint
  25803       \units C
  25804   A3, \field Cooling Setpoint Schedule Name
  25805       \note  Leave blank if constant setpoint specified below, must enter schedule or constant setpoint
  25806       \type object-list
  25807       \object-list ScheduleNames
  25808   N2; \field Constant Cooling Setpoint
  25809       \note  Ignored if schedule specified above, must enter schedule or constant setpoint
  25810       \units C
  25811 
  25812 HVACTemplate:Zone:IdealLoadsAirSystem,
  25813        \min-fields 26
  25814        \memo Zone with ideal air system that meets heating or cooling loads
  25815   A1,  \field Zone Name
  25816        \required-field
  25817        \note Zone name must match a building zone name
  25818        \type object-list
  25819        \object-list ZoneNames
  25820   A2,  \field Template Thermostat Name
  25821        \note Enter the name of a HVACTemplate:Thermostat object.
  25822        \note If blank, then it is assumed that standard thermostat objects
  25823        \note have been defined for this zone.
  25824        \type object-list
  25825        \object-list CompactHVACThermostats
  25826   A3, \field System Availability Schedule Name
  25827       \note If blank, always on
  25828       \type object-list
  25829       \object-list ScheduleNames
  25830   N1,  \field Maximum Heating Supply Air Temperature
  25831        \units C
  25832        \minimum> 0
  25833        \maximum< 100
  25834        \default 50
  25835   N2,  \field Minimum Cooling Supply Air Temperature
  25836        \units C
  25837        \minimum> -100
  25838        \maximum< 50
  25839        \default 13
  25840   N3,  \field Maximum Heating Supply Air Humidity Ratio
  25841        \units kgWater/kgDryAir
  25842        \minimum> 0
  25843        \default 0.0156
  25844   N4,  \field Minimum Cooling Supply Air Humidity Ratio
  25845        \units kgWater/kgDryAir
  25846        \minimum> 0
  25847        \default 0.0077
  25848   A4,  \field Heating Limit
  25849        \type choice
  25850        \key NoLimit
  25851        \key LimitFlowRate
  25852        \key LimitCapacity
  25853        \key LimitFlowRateAndCapacity
  25854        \default NoLimit
  25855   N5,  \field Maximum Heating Air Flow Rate
  25856        \note This field is ignored if Heating Limit = NoLimit
  25857        \note If this field is blank, there is no limit.
  25858        \units m3/s
  25859        \minimum 0.0
  25860        \autosizable
  25861   N6,  \field Maximum Sensible Heating Capacity
  25862        \note This field is ignored if Heating Limit = NoLimit
  25863        \note If this field is blank, there is no limit.
  25864        \units W
  25865        \minimum 0.0
  25866        \autosizable
  25867   A5,  \field Cooling Limit
  25868        \type choice
  25869        \key NoLimit
  25870        \key LimitFlowRate
  25871        \key LimitCapacity
  25872        \key LimitFlowRateAndCapacity
  25873        \default NoLimit
  25874   N7,  \field Maximum Cooling Air Flow Rate
  25875        \note This field is ignored if Cooling Limit = NoLimit
  25876        \note This field is required if Outdoor Air Economizer Type is anything other than NoEconomizer.
  25877        \units m3/s
  25878        \minimum 0.0
  25879        \autosizable
  25880   N8,  \field Maximum Total Cooling Capacity
  25881        \note This field is ignored if Cooling Limit = NoLimit
  25882        \units W
  25883        \minimum 0.0
  25884        \autosizable
  25885   A6,  \field Heating Availability Schedule Name
  25886        \note If blank, heating is always available.
  25887        \type object-list
  25888        \object-list ScheduleNames
  25889   A7,  \field Cooling Availability Schedule Name
  25890        \note If blank, cooling is always available.
  25891        \type object-list
  25892        \object-list ScheduleNames
  25893   A8,  \field Dehumidification Control Type
  25894        \note ConstantSensibleHeatRatio means that the ideal loads system
  25895        \note will be controlled to meet the sensible cooling load, and the
  25896        \note latent cooling rate will be computed using a constant
  25897        \note sensible heat ratio (SHR)
  25898        \note Humidistat means that there is a ZoneControl:Humidistat for this
  25899        \note zone and the ideal loads system will attempt to satisfy the humidistat.
  25900        \note None means that there is no dehumidification.
  25901        \note ConstantSupplyHumidityRatio means that during cooling the supply air
  25902        \note will always be at the Minimum Cooling Supply Humidity Ratio.
  25903        \type choice
  25904        \key ConstantSensibleHeatRatio
  25905        \key Humidistat
  25906        \key None
  25907        \key ConstantSupplyHumidityRatio
  25908        \default ConstantSensibleHeatRatio
  25909   N9,  \field Cooling Sensible Heat Ratio
  25910        \note This field is applicable only when Dehumidification Control Type is ConstantSensibleHeatRatio
  25911        \units dimensionless
  25912        \minimum> 0.0
  25913        \maximum 1.0
  25914        \default 0.7
  25915   N10, \field Dehumidification Setpoint
  25916        \note Zone relative humidity setpoint in percent (0 to 100)
  25917        \type real
  25918        \minimum 0.0
  25919        \maximum 100.0
  25920        \default 60.0
  25921        \units percent
  25922   A9,  \field Humidification Control Type
  25923        \note None means that there is no humidification.
  25924        \note Humidistat means that there is a ZoneControl:Humidistat for this
  25925        \note zone and the ideal loads system will attempt to satisfy the humidistat.
  25926        \note ConstantSupplyHumidityRatio means that during heating the supply air
  25927        \note will always be at the Maximum Heating Supply Humidity Ratio.
  25928        \type choice
  25929        \key None
  25930        \key Humidistat
  25931        \key ConstantSupplyHumidityRatio
  25932        \default None
  25933   N11, \field Humidification Setpoint
  25934        \note Zone relative humidity setpoint in percent (0 to 100)
  25935        \type real
  25936        \minimum 0.0
  25937        \maximum 100.0
  25938        \default 30.0
  25939        \units percent
  25940   A10, \field Outdoor Air Method
  25941        \note None means there is no outdoor air and all related fields will be ignored
  25942        \note Flow/Person, Flow/Zone, Flow/Area, Sum, and Maximum use the values in the next three
  25943        \note fields: Outdoor Air Flow Rate per Person, Outdoor Air Flow Rate per Zone Floor Area,
  25944        \note and Outdoor Air Flow Rate per Zone.
  25945        \note DetailedSpecification ignores these three Outdoor Air Flow Rate fields and instead
  25946        \note references design specification objects named in the fields
  25947        \note Design Specification Outdoor Air Object Name and Design Specification Zone Air
  25948        \note Distribution Object Name.
  25949        \type choice
  25950        \key None
  25951        \key Flow/Person
  25952        \key Flow/Zone
  25953        \key Flow/Area
  25954        \key Sum
  25955        \key Maximum
  25956        \key DetailedSpecification
  25957        \default None
  25958   N12, \field Outdoor Air Flow Rate per Person
  25959        \units m3/s
  25960        \note Default 0.00944 is 20 cfm per person
  25961        \note This input is used if the field Outdoor Air Method is
  25962        \note Flow/Person, Sum, or Maximum
  25963        \default 0.00944
  25964   N13, \field Outdoor Air Flow Rate per Zone Floor Area
  25965        \units m3/s-m2
  25966        \default 0.0
  25967        \note This input is used if the field Outdoor Air Method is
  25968        \note Flow/Area, Sum, or Maximum
  25969   N14, \field Outdoor Air Flow Rate per Zone
  25970        \type real
  25971        \units m3/s
  25972        \default 0.0
  25973        \note This input is used if the field Outdoor Air Method is
  25974        \note Flow/Zone, Sum, or Maximum
  25975   A11, \field Design Specification Outdoor Air Object Name
  25976        \type object-list
  25977        \object-list DesignSpecificationOutdoorAirNames
  25978        \note When the name of a DesignSpecification:OutdoorAir object is entered, the minimum
  25979        \note outdoor air flow rate will be computed using these specifications. The outdoor air
  25980        \note flow rate will also be affected by the next two fields.
  25981        \note If this field is blank, there will be no outdoor air and the remaining fields will
  25982        \note be ignored.
  25983   A12, \field Demand Controlled Ventilation Type
  25984        \note This field controls how the minimum outdoor air flow rate is calculated.
  25985        \note None means that design occupancy will be used to compute the minimum outdoor air flow rate
  25986        \note OccupancySchedule means that current occupancy level will be used.
  25987        \note CO2Setpoint means that the design occupancy will be used to compute the minimum outdoor air flow
  25988        \note rate and the outdoor air flow rate may be increased if necessary to maintain the indoor air carbon
  25989        \note dioxide setpoint defined in a ZoneControl:ContaminantController object.
  25990        \type choice
  25991        \key None
  25992        \key OccupancySchedule
  25993        \key CO2Setpoint
  25994        \default None
  25995   A13, \field Outdoor Air Economizer Type
  25996        \note DifferentialDryBulb and DifferentialEnthalpy will increase the outdoor air flow rate
  25997        \note when there is a cooling load and the outdoor air temperature or enthalpy
  25998        \note is below the zone exhaust air temperature or enthalpy.
  25999        \type choice
  26000        \key NoEconomizer
  26001        \key DifferentialDryBulb
  26002        \key DifferentialEnthalpy
  26003        \default NoEconomizer
  26004   A14, \field Heat Recovery Type
  26005        \type choice
  26006        \key None
  26007        \key Sensible
  26008        \key Enthalpy
  26009        \default None
  26010   N15, \field Sensible Heat Recovery Effectiveness
  26011        \units dimensionless
  26012        \minimum 0.0
  26013        \maximum 1.0
  26014        \default 0.70
  26015   N16; \field Latent Heat Recovery Effectiveness
  26016        \note Applicable only if Heat Recovery Type is Enthalpy.
  26017        \units dimensionless
  26018        \minimum 0.0
  26019        \maximum 1.0
  26020        \default 0.65
  26021 

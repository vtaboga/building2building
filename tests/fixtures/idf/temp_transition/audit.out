  65888        \type object-list
  65889        \object-list validBranchEquipmentNames
  65890   A3 , \field Availability Schedule Name
  65891        \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  65892        \note If this field is blank, the system is always available.
  65893        \type object-list
  65894        \object-list ScheduleNames

  76621        \type real
  76622        \units m
  76623        \minimum 0.0
  76624        \default 0.0
  76625        \note Defaults to bottom of tank
  76626   N25, \field Use Side Outlet Height
  76627        \type real
  76628        \units m
  76629        \minimum 0.0
  76630        \autocalculatable
  76631        \default Autocalculate
  76632        \note Defaults to top of tank
  76633   A18, \field Source Side Inlet Node Name
  76634        \type node
  76635   A19, \field Source Side Outlet Node Name
  76636        \type node
  76637   N26, \field Source Side Effectiveness
  76638        \type real
  76639        \minimum> 0.0
  76640        \maximum 1.0
  76641        \default 1.0
  76642        \note The source side effectiveness in the stratified tank model is a simplified analogy of
  76643        \note a heat exchanger's effectiveness. This effectiveness is equal to the fraction of
  76644        \note source mass flow rate that directly mixes with the tank fluid. And one minus the
  76645        \note effectiveness is the fraction that bypasses the tank. The source side mass flow rate
  76646        \note that bypasses the tank is mixed with the fluid or water leaving the stratified tank.
  76647   N27, \field Source Side Inlet Height
  76648        \type real
  76649        \units m
  76650        \minimum 0.0
  76651        \autocalculatable
  76652        \default Autocalculate
  76653        \note Defaults to top of tank
  76654   N28, \field Source Side Outlet Height
  76655        \type real
  76656        \units m
  76657        \minimum 0.0
  76658        \default 0.0
  76659        \note Defaults to bottom of tank
  76660   A20, \field Inlet Mode
  76661        \type choice
  76662        \key Fixed
  76663        \key Seeking
  76664        \default Fixed
  76665   N29, \field Use Side Design Flow Rate
  76666        \type real
  76667        \autosizable
  76668        \default autosize
  76669        \units m3/s
  76670        \ip-units gal/min

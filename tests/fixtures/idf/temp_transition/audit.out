  24533       \key Absolute
  24534       \key Relative
  24535       \default Absolute
  24536       \note Specify whether the angle used to compute the wind pressure coefficient is absolute or relative
  24537       \note Specify Relative to compute the angle between the wind direction and the surface azimuth
  24538       \note Specify Absolute to use the wind direction angle directly

  81503        \required-field
  81504        \type object-list
  81505        \object-list ScheduleNames
  81506   A4 , \field Control Type
  81507        \type choice
  81508        \key StayOff
  81509       \key ControlZone
  81510        \key MaximumofZoneList
  81511        \default ControlZone
  81512   A5 , \field Control Zone Name
  81513        \type object-list
  81514        \object-list ZoneNames
  81515   A6 , \field Zone List Name
  81516        \type object-list
  81517        \object-list ZoneListNames
  81518   N1 , \field Maximum Value for Optimum Start Time
  81519        \default 6

  81564        \type object-list
  81565        \object-list ScheduleNames
  81566   A3 , \field Fan Schedule Name
  81567        \required-field
  81568        \type object-list
  81569        \object-list ScheduleNames
  81570   A4 , \field Control Type
  81571        \type choice
  81572        \key StayOff
  81573        \key CycleOnAny
  81574        \key CycleOnControlZone
  81575        \key CycleOnAnyZoneFansOnly
  81576        \key CycleOnAnyCoolingOrHeatingZone
  81577        \key CycleOnAnyCoolingZone
  81578        \key CycleOnAnyHeatingZone

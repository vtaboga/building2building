  62439        \note Cooling Capacity Time Constant
  62440   N32, \field Heat Recovery Cooling Capacity Time Constant
  62441        \type real
  62442        \units hr
  62443        \default 0.15
  62444        \note Enter the time constant used to model the transition
  62445        \note from cooling only mode to heat recovery mode
  62446   A41, \field Heat Recovery Cooling Energy Modifier Curve Name
  62447        \type object-list
  62448        \object-list BivariateFunctions
  62449        \note Enter the name of a performance curve which represents
  62450        \note the change in cooling energy when heat recovery is active
  62451        \note A default constant of 1.1 is used if this input is blank
  62452   N33, \field Initial Heat Recovery Cooling Energy Fraction
  62453        \type real
  62454        \units W/W
  62455        \default 1.0
  62456        \note Enter the fractional electric consumption rate at the start
  62457        \note of heat recovery mode. The electric consumption rate exponentially
  62458        \note approaches the steady-state value according to the inputs for
  62459        \note Heat Recovery Cooling Energy Modifier and Heat Recovery
  62460        \note Cooling Energy Time Constant
  62461   N34, \field Heat Recovery Cooling Energy Time Constant
  62462        \type real
  62463        \units hr
  62464        \default 0
  62465        \note Enter the time constant used to model the transition
  62466        \note from cooling only mode to heat recovery mode
  62467   A42, \field Heat Recovery Heating Capacity Modifier Curve Name
  62468        \type object-list
  62469        \object-list BivariateFunctions
  62470        \note Enter the name of a performance curve which represents
  62471        \note the change in heating capacity when heat recovery is active
  62472        \note A default constant of 1.1 is used if this input is blank
  62473   N35, \field Initial Heat Recovery Heating Capacity Fraction
  62474        \type real
  62475        \units W/W
  62476        \default 1
  62477        \note Enter the fractional capacity available at the start
  62478        \note of heat recovery mode. The capacity exponentially approaches
  62479        \note the steady-state value according to the inputs for
  62480        \note Heat Recovery Heating Capacity Modifier and Heat Recovery
  62481        \note Heating Capacity Time Constant
  62482   N36, \field Heat Recovery Heating Capacity Time Constant
  62483        \type real
  62484        \units hr
  62485        \default 0.15
  62486        \note Enter the time constant used to model the transition
  62487        \note from cooling only mode to heat recovery mode
  62488   A43, \field Heat Recovery Heating Energy Modifier Curve Name
  62489        \type object-list
  62490        \object-list BivariateFunctions
  62491        \note Enter the name of a performance curve which represents
  62492        \note the change in heating electric consumption rate when heat recovery is active
  62493        \note A default constant of 1.1 is used if this input is blank
  62494   N37, \field Initial Heat Recovery Heating Energy Fraction
  62495        \type real
  62496        \units W/W
  62497        \default 1
  62498        \note Enter the fractional electric consumption rate at the start
  62499        \note of heat recovery mode. The electric consumption rate exponentially
  62500        \note approaches the steady-state value according to the inputs for
  62501        \note Heat Recovery Cooling Energy Modifier and Heat Recovery
  62502        \note Cooling Energy Time Constant
  62503   N38; \field Heat Recovery Heating Energy Time Constant
  62504        \type real
  62505        \units hr
  62506        \default 0
  62507        \note Enter the time constant used to model the transition
  62508        \note from cooling only mode to heat recovery mode

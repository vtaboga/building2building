  70075 Chiller:Electric:ReformulatedEIR,
  70076 \min-fields 22
  70077    \memo This chiller model is an empirical model, a reformulated version of Chiller:Electric:EIR
  70078    \memo where the performance is a function of condenser leaving fluid Temperature instead of
  70079    \memo condenser entering fluid Temperature. Chiller performance at off-reference conditions is
  70080    \memo modeled using three polynomial equations. Three curve objects are required.
  70081   A1 , \field Name
  70082        \type alpha
  70083        \reference Chillers
  70084        \required-field
  70085        \reference-class-name validPlantEquipmentTypes
  70086        \reference validPlantEquipmentNames
  70087        \reference-class-name validBranchEquipmentTypes
  70088        \reference validBranchEquipmentNames
  70089    N1 , \field Reference Capacity
  70090        \type real
  70091        \units W
  70092        \required-field
  70093        \minimum> 0.0
  70094        \autosizable
  70095   N2 , \field Reference COP
  70096        \note Efficiency of the chiller compressor (cooling output/compressor energy input).
  70097        \note Condenser fan power should not be included here.
  70098        \type real
  70099        \units W/W
  70100        \required-field
  70101        \minimum> 0.0
  70102   N3 , \field Reference Leaving Chilled Water Temperature
  70103        \type real
  70104        \default 6.67
  70105        \units C
  70106   N4 , \field Reference Leaving Condenser Water Temperature
  70107        \type real
  70108        \default 35.0
  70109        \units C
  70110   N5 , \field Reference Chilled Water Flow Rate
  70111        \type real
  70112        \units m3/s
  70113        \minimum> 0
  70114        \autosizable
  70115        \ip-units gal/min
  70116   N6 , \field Reference Condenser Water Flow Rate
  70117        \type real
  70118        \units m3/s
  70119        \autosizable
  70120        \minimum> 0.0
  70121        \ip-units gal/min
  70122   A2 , \field Cooling Capacity Function of Temperature Curve Name
  70123        \note Cooling capacity as a function of supply (leaving) chilled water temperature
  70124        \note and leaving condenser fluid temperature
  70125        \required-field
  70126        \type object-list
  70127        \object-list BivariateFunctions
  70128        \note curve = a + b*CWS + c*CWS**2 + d*LCT + e*LCT**2 + f*CWS*LCT
  70129        \note CWS = supply (leaving) chilled water temperature(C)
  70130        \note LCT = leaving condenser fluid temperature(C)
  70131   A3 , \field Electric Input to Cooling Output Ratio Function of Temperature Curve Name
  70132        \note Electric Input Ratio (EIR) as a function of supply (leaving) chilled water temperature
  70133        \note and leaving condenser fluid temperature.   EIR = 1/COP.
  70134        \required-field
  70135        \type object-list
  70136        \object-list BivariateFunctions
  70137        \note curve = a + b*CWS + c*CWS**2 + d*LCT + e*LCT**2 + f*CWS*LCT
  70138        \note CWS = supply (leaving) chilled water temperature(C)
  70139        \note LCT = leaving condenser fluid temperature(C)
  70140   A4 , \field Electric Input to Cooling Output Ratio Function of Part Load Ratio Curve Type
  70141        \note Two curve types are available:
  70142        \note Type LeavingCondenserWaterTemperature: based on the leaving condenser water temperature.
  70143        \note Type Lift: based on the normalized lift, which is the temperature difference between the
  70144        \note leaving condenser water temperature and the leaving evaporator water temperature.
  70145        \type choice
  70146        \key LeavingCondenserWaterTemperature
  70147        \key Lift
  70148        \default LeavingCondenserWaterTemperature
  70149   A5 , \field Electric Input to Cooling Output Ratio Function of Part Load Ratio Curve Name
  70150        \note Electric Input Ratio (EIR) as a function of Part Load Ratio (PLR)
  70151        \note EIR = 1/COP
  70152        \required-field
  70153        \type object-list
  70154        \object-list BivariateFunctions
  70155        \object-list TrivariateFunctions
  70156        \note The form of this curve is based on the input for
  70157        \note Electric Input to Cooling Output RatioFunction of Part Load Ratio Curve Type
  70158        \note Type=LeavingCondenserWaterTemperature: Calculated based on LCT and PLR
  70159        \note Curve object type should be Curve:Bicubic or Table:Lookup
  70160        \note Bicubic curve = a + b*LCT + c*LCT**2 + d*PLR + e*PLR**2 + f*LCT*PLR + g*0 + h*PLR**3
  70161        \note + i*0 + j*0
  70162        \note PLR = part load ratio (cooling load/steady state capacity)
  70163        \note LCT = leaving condenser fluid temperature(C)
  70164        \note Type=Lift: Calculated based on dT*, Tdev* and PLR
  70165        \note Curve object type should be Curve:ChillerPartLoadWithLiftCurves or Table:Lookup
  70166        \note ChillerPartLoadWithLiftCurves curve = a + b*(dT*) + c*(dT*)**2 + d*PLR + e*PLR**2 + f*(dT*)*PLR + g*(dT*)**3
  70167        \note + h*PLR**3 + i*(dT*)**2*PLR + j*(dT*)*PLR**2 + k*(dT*)**2*PLR**2 + l*(Tdev*)*PLR**3
  70168        \note x = dT* = normalized fractional Lift = dT / dTref
  70169        \note y = PLR = part load ratio (cooling load/steady state capacity)
  70170        \note z = Tdev* = normalized Tdev = Tdev / dTref
  70171        \note Where:
  70172        \note dT = Lift = Leaving Condenser Water Temperature - Leaving Chilled Water Temperature
  70173        \note dTref = dT at the reference condition
  70174        \note Tdev = Leaving Chilled Water Temperature - Reference Chilled Water Temperature
  70175   N7 , \field Minimum Part Load Ratio
  70176        \type real
  70177        \note Part load ratio below which the chiller starts cycling on/off to meet the load.
  70178        \note Must be less than or equal to Maximum Part Load Ratio.
  70179        \minimum 0.0
  70180        \default 0.1
  70181   N8 , \field Maximum Part Load Ratio
  70182        \type real
  70183        \note Maximum allowable part load ratio. Must be greater than or equal to Minimum Part Load Ratio.
  70184        \minimum> 0.0
  70185        \default 1.0
  70186   N9 , \field Optimum Part Load Ratio
  70187        \type real
  70188        \note Optimum part load ratio where the chiller is most efficient.
  70189        \note Must be greater than or equal to the Minimum Part Load Ratio
  70190        \note and less than or equal to the Maximum Part Load Ratio.
  70191        \minimum> 0.0
  70192        \default 1.0
  70193   N10, \field Minimum Unloading Ratio
  70194        \type real
  70195        \note Part load ratio where the chiller can no longer unload and false loading begins.
  70196        \note Minimum unloading ratio must be greater than or equal to the Minimum Part Load Ratio
  70197        \note and less than or equal to the Maximum Part Load Ratio.
  70198        \minimum 0.0
  70199        \default 0.2
  70200   A6 , \field Chilled Water Inlet Node Name
  70201        \type node
  70202        \required-field
  70203   A7 , \field Chilled Water Outlet Node Name
  70204        \type node
  70205        \required-field
  70206   A8 , \field Condenser Inlet Node Name
  70207        \type node
  70208        \required-field
  70209   A9 , \field Condenser Outlet Node Name
  70210        \type node
  70211        \required-field
  70212   N11, \field Fraction of Compressor Electric Consumption Rejected by Condenser

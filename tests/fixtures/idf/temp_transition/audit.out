  40262 ZoneHVAC:OutdoorAirUnit,
  40263        \memo The zone outdoor air unit models a single-zone dedicated outdoor air system (DOAS).
  40264        \memo Forced-convection 100% outdoor air unit with supply fan and optional equipment
  40265        \memo including exhaust fan, heating coil, cooling coil, and heat recovery.
  40266        \min-fields 18
  40267    A1, \field Name
  40268        \required-field
  40269        \reference ZoneEquipmentNames
  40270    A2, \field Availability Schedule Name
  40271        \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  40272        \note If this field is blank, the system is always available.
  40273        \type object-list
  40274        \object-list ScheduleNames
  40275    A3, \field Zone Name
  40276        \required-field
  40277        \note (name of zone system is serving)
  40278        \type object-list
  40279        \object-list ZoneNames
  40280    N1, \field Outdoor Air Flow Rate
  40281        \required-field
  40282        \units m3/s
  40283        \minimum> 0
  40284        \autosizable
  40285    A4, \field Outdoor Air Schedule Name
  40286        \required-field
  40287        \type object-list
  40288        \object-list ScheduleNames
  40289    A5, \field Supply Fan Name
  40290        \required-field
  40291        \note Allowable fan types are Fan:SystemModel and Fan:ConstantVolume and Fan:VariableVolume
  40292        \type object-list
  40293        \object-list FansCVandVAV
  40294        \object-list FansSystemModel
  40295   A6, \field Supply Fan Placement
  40296       \type choice
  40297       \key BlowThrough
  40298       \key DrawThrough
  40299       \default DrawThrough
  40300    A7, \field Exhaust Fan Name
  40301        \note Allowable fan types are Fan:SystemModel and Fan:ConstantVolume and Fan:VariableVolume
  40302        \note Fan:VariableVolume
  40303        \type object-list
  40304        \object-list FansCVandVAV
  40305        \object-list FansSystemModel
  40306    N2, \field Exhaust Air Flow Rate
  40307        \units m3/s
  40308        \autosizable
  40309    A8, \field Exhaust Air Schedule Name
  40310        \type object-list
  40311        \object-list ScheduleNames
  40312    A9, \field Unit Control Type
  40313        \type choice
  40314        \key NeutralControl
  40315        \key TemperatureControl
  40316        \default NeutralControl
  40317    A10, \field High Air Control Temperature Schedule Name
  40318        \note Air and control temperatures for cooling. If outdoor air temperature
  40319        \note is above the high air control temperature, then the zone inlet air temperature
  40320        \note is set to the high air control temperature. If the outdoor air is between high and low
  40321        \note air control temperature, then there is no cooling/heating requirements.
  40322        \type object-list
  40323        \object-list ScheduleNames
  40324    A11, \field Low Air Control Temperature Schedule Name
  40325        \note Air and control temperatures for Heating. If outdoor air temperature
  40326        \note is below the low air control temperature, then the zone inlet air temperature
  40327        \note is set to the low air control temperature. If the outdoor air is between high and low
  40328        \note air control temperature, then there is no cooling/heating requirements.
  40329        \type object-list
  40330        \object-list ScheduleNames
  40331   A12, \field Outdoor Air Node Name
  40332        \required-field
  40333        \type node
  40334   A13, \field AirOutlet Node Name
  40335        \required-field
  40336        \type node
  40337   A14, \field AirInlet Node Name
  40338        \type node
  40339        \note air leaves zone
  40340   A15, \field Supply FanOutlet Node Name
  40341        \type node
  40342        \required-field
  40343   A16, \field Outdoor Air Unit List Name
  40344        \note Enter the name of an ZoneHVAC:OutdoorAirUnit:EquipmentList object.
  40345        \required-field
  40346        \type object-list
  40347        \object-list OutdoorAirUnitEquipmentLists
  40348   A17; \field Availability Manager List Name
  40349         \note Enter the name of an AvailabilityManagerAssignmentList object.
  40350         \type object-list
  40351         \object-list SystemAvailabilityManagerLists
  40352 

  23728 \group Natural Ventilation and Duct Leakage
  23729 
  23730 ! Basic parameters
  23731 AirflowNetwork:SimulationControl,
  23732       \min-fields 12
  23733       \unique-object
  23734       \memo This object defines the global parameters used in an Airflow Network simulation.
  23735  A1 , \field Name
  23736       \required-field
  23737       \note Enter a unique name for this object.
  23738  A2 , \field AirflowNetwork Control
  23739       \type choice
  23740       \key MultizoneWithDistribution
  23741       \key MultizoneWithoutDistribution
  23742       \key MultizoneWithDistributionOnlyDuringFanOperation
  23743       \key NoMultizoneOrDistribution
  23744       \default NoMultizoneOrDistribution
  23745       \note NoMultizoneOrDistribution: Only perform Simple calculations (objects ZoneInfiltration:*,
  23746       \note ZoneVentilation:*, ZoneMixing, ZoneCrossMixing, ZoneRefrigerationDoorMixing,
  23747       \note ZoneAirBalance:OutdoorAir, ZoneEarthtube, ZoneThermalChimney, and ZoneCoolTower:Shower);
  23748       \note MultizoneWithoutDistribution: Use AirflowNetwork objects to simulate multizone
  23749       \note Airflows driven by wind during simulation time,
  23750       \note and objects of ZoneInfiltration:*, ZoneVentilation:*, ZoneMixing, ZoneCrossMixing
  23751       \note ZoneRefrigerationDoorMixing, ZoneAirBalance:OutdoorAir, ZoneEarthtube,
  23752       \note ZoneThermalChimney, and ZoneCoolTower:Shower are ignored;
  23753       \note MultizoneWithDistributionOnlyDuringFanOperation: Perform distribution system
  23754       \note calculations during system fan on time
  23755       \note and Simple calculations during system Fan off time;
  23756       \note MultizoneWithDistribution: Perform distribution system calculations during system
  23757       \note fan on time and multizone Airflow driven by wind during system fan off time.
  23758  A3 , \field Wind Pressure Coefficient Type
  23759       \type choice
  23760       \key Input
  23761       \key SurfaceAverageCalculation
  23762       \default SurfaceAverageCalculation
  23763       \note Input: User must enter AirflowNetwork:MultiZone:WindPressureCoefficientArray,
  23764       \note AirflowNetwork:MultiZone:ExternalNode, and
  23765       \note AirflowNetwork:MultiZone:WindPressureCoefficientValues objects.
  23766       \note SurfaceAverageCalculation: used only for rectangular buildings.
  23767       \note If SurfaceAverageCalculation is selected,
  23768       \note AirflowNetwork:MultiZone:WindPressureCoefficientArray, AirflowNetwork:MultiZone:ExternalNode,
  23769       \note and AirflowNetwork:MultiZone:WindPressureCoefficientValues objects are not used.
  23770  A4 , \field Height Selection for Local Wind Pressure Calculation
  23771       \type choice
  23772       \key ExternalNode
  23773       \key OpeningHeight
  23774       \default OpeningHeight
  23775       \note If ExternalNode is selected, the height given in the
  23776       \note AirflowNetwork:MultiZone:ExternalNode object will be used.
  23777       \note If OpeningHeight is selected, the surface opening height (centroid) will be used to
  23778       \note calculate local wind pressure
  23779       \note This field is ignored when the choice of the Wind Pressure Coefficient Type field is
  23780       \note SurfaceAverageCalculation.
  23781  A5 , \field Building Type
  23782       \note Used only if Wind Pressure Coefficient Type = SurfaceAverageCalculation,
  23783       \note otherwise this field may be left blank.
  23784       \type choice
  23785       \key LowRise
  23786       \key HighRise
  23787       \default LowRise
  23788  N1 , \field Maximum Number of Iterations
  23789       \type integer
  23790       \units dimensionless
  23791       \default 500
  23792       \minimum> 10
  23793       \maximum 30000
  23794       \note Determines the maximum number of iterations used to converge on a solution. If this limit
  23795       \note is exceeded, the program terminates.
  23796  A6 , \field Initialization Type
  23797       \type choice
  23798       \key LinearInitializationMethod
  23799       \key ZeroNodePressures
  23800       \default ZeroNodePressures
  23801  N2 , \field Relative Airflow Convergence Tolerance
  23802       \type real
  23803       \units dimensionless
  23804       \default 1.E-4
  23805       \minimum> 0
  23806       \note This tolerance is defined as the absolute value of the sum of the mass Flow Rates
  23807       \note divided by the sum of the absolute value of the mass Flow Rates. The mass Flow Rates
  23808       \note described here refer to the mass Flow Rates at all Nodes in the AirflowNetwork model.
  23809       \note The solution converges when both this tolerance and the tolerance in the next field
  23810       \note (Absolute Airflow Convergence Tolerance) are satisfied.
  23811  N3 , \field Absolute Airflow Convergence Tolerance
  23812       \type real
  23813       \units kg/s
  23814       \default 1.E-6
  23815       \minimum> 0
  23816       \note This tolerance is defined as the absolute value of the sum of the mass flow rates. The mass
  23817       \note flow rates described here refer to the mass flow rates at all nodes in the AirflowNetwork
  23818       \note model. The solution converges when both this tolerance and the tolerance in the previous
  23819       \note field (Relative Airflow Convergence Tolerance) are satisfied.
  23820  N4 , \field Convergence Acceleration Limit
  23821       \type real
  23822       \units dimensionless
  23823       \note Used only for AirflowNetwork:SimulationControl
  23824       \minimum -1
  23825       \maximum 1
  23826       \default -0.5
  23827  N5 , \field Azimuth Angle of Long Axis of Building
  23828       \type real
  23829       \units deg
  23830       \minimum 0.0
  23831       \maximum 180.0
  23832       \default 0.0
  23833       \note Degrees clockwise from true North.
  23834       \note Used only if Wind Pressure Coefficient Type = SurfaceAverageCalculation.
  23835  N6 , \field Ratio of Building Width Along Short Axis to Width Along Long Axis
  23836       \type real
  23837       \minimum> 0.0
  23838       \maximum 1.0
  23839       \default 1.0
  23840       \note Used only if Wind Pressure Coefficient Type = SurfaceAverageCalculation.
  23841  A7 , \field Height Dependence of External Node Temperature
  23842       \note If Yes, external node temperature is height dependent.
  23843       \note If No, external node temperature is based on zero height.
  23844       \type choice
  23845       \key Yes
  23846       \key No
  23847       \default No
  23848  A8 ; \field Solver
  23849       \note Select the solver to use for the pressure network solution
  23850       \type choice
  23851       \key SkylineLU
  23852       \key ConjugateGradient
  23853       \default SkylineLU
  23854 
  23855 AirflowNetwork:MultiZone:Zone,
  23856       \min-fields 8
  23857       \memo This object is used to simultaneously control a thermal zone's window and door openings,
  23858       \memo both exterior and interior.
  23859   A1, \field Zone Name
  23860       \required-field
  23861       \reference AirFlowNetworkMultizoneZones
  23862       \type object-list
  23863       \object-list ZoneNames
  23864       \note Enter the zone name where ventilation control is required.
  23865   A2, \field Ventilation Control Mode
  23866       \type choice
  23867       \key Temperature
  23868       \key Enthalpy
  23869       \key Constant
  23870       \key ASHRAE55Adaptive
  23871       \key CEN15251Adaptive
  23872       \key NoVent
  23873       \default NoVent
  23874       \note When Ventilation Control Mode = Temperature or Enthalpy, the following
  23875       \note fields are used to modulate the Ventilation Open Factor for all
  23876       \note window and door openings in the zone according to the zone's
  23877       \note indoor-outdoor temperature or enthalpy difference.
  23878       \note Constant: controlled by field Venting Schedule Name.
  23879       \note NoVent: control will not open window or door during simulation (Ventilation Open Factor = 0).
  23880   A3, \field Ventilation Control Zone Temperature Setpoint Schedule Name
  23881       \type object-list
  23882       \object-list ScheduleNames
  23883       \note Used only if Ventilation Control Mode = Temperature or Enthalpy.
  23884   N1, \field Minimum Venting Open Factor
  23885       \type real
  23886       \units dimensionless
  23887       \minimum 0.0
  23888       \maximum 1.0
  23889       \default 0.0
  23890       \note Used only if Ventilation Control Mode = Temperature or Enthalpy.
  23891   N2, \field Indoor and Outdoor Temperature Difference Lower Limit For Maximum Venting Open Factor
  23892       \type real
  23893       \units deltaC
  23894       \minimum 0.0
  23895       \maximum< 100.0
  23896       \default 0.0
  23897       \note Applicable only if Ventilation Control Mode = Temperature.
  23898       \note This value must be less than the corresponding upper value (next field).
  23899   N3, \field Indoor and Outdoor Temperature Difference Upper Limit for Minimum Venting Open Factor
  23900       \type real
  23901       \units deltaC
  23902       \minimum> 0.0
  23903       \default 100.0
  23904       \note Applicable only if Ventilation Control Mode = Temperature.
  23905       \note This value must be greater than the corresponding lower value (previous field).
  23906   N4, \field Indoor and Outdoor Enthalpy Difference Lower Limit For Maximum Venting Open Factor
  23907       \type real
  23908       \units deltaJ/kg
  23909       \minimum 0.0
  23910       \maximum< 300000.0
  23911       \default 0.0
  23912       \note Applicable only if Ventilation Control Mode = Enthalpy.
  23913       \note This value must be less than the corresponding upper value (next field).
  23914   N5, \field Indoor and Outdoor Enthalpy Difference Upper Limit for Minimum Venting Open Factor
  23915       \type real
  23916       \units deltaJ/kg
  23917       \minimum> 0.0
  23918       \default 300000.0
  23919       \note Applicable only if Ventilation Control Mode = Enthalpy.
  23920       \note This value must be greater than the corresponding lower value (previous field).
  23921   A4, \field Venting Availability Schedule Name
  23922       \type object-list
  23923       \object-list ScheduleNames
  23924       \note Non-zero Schedule value means venting is allowed if other venting control conditions are
  23925       \note satisfied. A zero (or negative) Schedule value means venting is not allowed under any
  23926       \note The Schedule values should be greater than or equal to 0 and less than or equal to 1.
  23927       \note circumstances. If this Schedule is not specified then venting is allowed if
  23928       \note other venting control conditions are satisfied.
  23929       \note Not used if Ventilation Control Mode = NoVent.
  23930   A5, \field Single Sided Wind Pressure Coefficient Algorithm
  23931       \type choice
  23932       \key Advanced
  23933       \key Standard
  23934       \default Standard
  23935       \note Selecting Advanced results in EnergyPlus calculating modified Wind Pressure Coefficients
  23936       \note to account for wind direction and turbulence effects on single sided ventilation rates.
  23937       \note Model is only valid for zones with 2 openings, both of which are on a single facade.
  23938   N6, \field Facade Width
  23939       \type real
  23940       \units m
  23941       \minimum 0.0
  23942       \default 10.0
  23943       \note This is the whole building width along the direction of the facade of this zone.
  23944   A6; \field Occupant Ventilation Control Name
  23945       \type object-list
  23946       \object-list AirflowNetworkOccupantVentilationControlNames
  23947       \note Enter the name where Occupancy Ventilation Control is required.
  23948 
  23949 AirflowNetwork:MultiZone:Surface,
  23950       \min-fields 4
  23951       \memo This object specifies the properties of a surface linkage through which air flows.
  23952       \memo Airflow Report: Node 1 as an inside face zone;
  23953       \memo Node 2 as an outside face zone or external node.
  23954   A1, \field Surface Name
  23955       \required-field
  23956       \type object-list
  23957       \object-list SurfAndSubSurfNames
  23958       \note Enter the name of a heat transfer surface.
  23959   A2, \field Leakage Component Name
  23960       \required-field
  23961       \type object-list
  23962       \object-list SurfaceAirflowLeakageNames
  23963       \note Enter the name of an Airflow Network leakage component. A leakage component is
  23964       \note one of the following AirflowNetwork:Multizone objects:
  23965       \note AirflowNetwork:MultiZone:Component:DetailedOpening,
  23966       \note AirflowNetwork:MultiZone:Component:SimpleOpening,
  23967       \note AirflowNetwork:MultiZone:Surface:Crack,
  23968       \note AirflowNetwork:MultiZone:Surface:EffectiveLeakageArea,
  23969       \note AirflowNetwork:MultiZone:Component:HorizontalOpening, or
  23970       \note AirflowNetwork:MultiZone:Component:ZoneExhaustFan.
  23971       \note When the zone exhaust fan name is entered, any surface control fields below A3 are
  23972       \note ignored when the zone exhaust fan turns on.
  23973   A3, \field External Node Name
  23974       \type object-list
  23975       \object-list ExternalNodeNames
  23976       \object-list OutdoorAirNodeNames
  23977       \note Used if Wind Pressure Coefficient Type = Input in the AirflowNetwork:SimulationControl object,
  23978       \note otherwise this field may be left blank.
  23979   N1, \field Window/Door Opening Factor, or Crack Factor
  23980       \type real
  23981       \units dimensionless
  23982       \minimum> 0.0
  23983       \maximum 1.0
  23984       \default 1.0
  23985       \note This field specifies a multiplier for a crack, window, or door.
  23986   A4, \field Ventilation Control Mode
  23987       \type choice
  23988       \key Temperature
  23989       \key Enthalpy
  23990       \key Constant
  23991       \key ASHRAE55Adaptive
  23992       \key CEN15251Adaptive
  23993       \key NoVent
  23994       \key ZoneLevel
  23995       \key AdjacentTemperature
  23996       \key AdjacentEnthalpy
  23997       \default ZoneLevel
  23998       \note When Ventilation Control Mode = Temperature or Enthalpy, the following
  23999       \note fields are used to modulate the Ventilation Open Factor for a
  24000       \note window or door opening according to the parent zone's
  24001       \note indoor-outdoor temperature or enthalpy difference.
  24002       \note When Ventilation Control Mode = AdjacentTemperature or AdjacentEnthalpy, the following
  24003       \note fields are used to modulate the Ventilation Open Factor for an interior
  24004       \note window or door opening according to temperature or enthalpy difference
  24005       \note between the parent zone and the adjacent zone.
  24006       \note Constant: controlled by field Venting Schedule Name.
  24007       \note NoVent: control will not open window or door during simulation (Ventilation Open Factor = 0).
  24008       \note ZoneLevel: control will be controlled by AirflowNetwork:MultiZone:Zone
  24009       \note Mode.
  24010   A5, \field Ventilation Control Zone Temperature Setpoint Schedule Name
  24011       \type object-list
  24012       \object-list ScheduleNames
  24013       \note Used only if Ventilation Control Mode = Temperature or Enthalpy.
  24014   N2, \field Minimum Venting Open Factor
  24015       \type real
  24016       \units dimensionless
  24017       \minimum 0.0
  24018       \maximum 1.0
  24019       \default 0.0
  24020       \note Used only if Ventilation Control Mode = Temperature or Enthalpy.
  24021   N3, \field Indoor and Outdoor Temperature Difference Lower Limit For Maximum Venting Open Factor
  24022       \note Applicable only if Ventilation Control Mode = Temperature
  24023       \type real
  24024       \units deltaC
  24025       \minimum 0.0
  24026       \maximum< 100
  24027       \default 0.0
  24028   N4, \field Indoor and Outdoor Temperature Difference Upper Limit for Minimum Venting Open Factor
  24029       \type real
  24030       \units deltaC
  24031       \minimum> 0.0
  24032       \default 100.0
  24033       \note Applicable only if Ventilation Control Mode = Temperature.
  24034       \note This value must be greater than the corresponding lower value (previous field).
  24035   N5, \field Indoor and Outdoor Enthalpy Difference Lower Limit For Maximum Venting Open Factor
  24036       \type real
  24037       \units deltaJ/kg
  24038       \minimum 0.0
  24039       \maximum< 300000.0
  24040       \default 0.0
  24041       \note Applicable only if Ventilation Control Mode = Enthalpy.
  24042       \note This value must be less than the corresponding upper value (next field).
  24043   N6, \field Indoor and Outdoor Enthalpy Difference Upper Limit for Minimum Venting Open Factor
  24044       \type real
  24045       \units deltaJ/kg
  24046       \minimum> 0.0
  24047       \default 300000.0
  24048       \note Applicable only if Ventilation Control Mode = Enthalpy.
  24049       \note This value must be greater than the corresponding lower value (previous field).
  24050   A6, \field Venting Availability Schedule Name
  24051       \type object-list
  24052       \object-list ScheduleNames
  24053       \note Non-zero schedule value means venting is allowed if other venting control conditions are
  24054       \note satisfied. A zero (or negative) schedule value means venting is not allowed under any
  24055       \note circumstances. The schedule values should be greater than or equal to 0 and less than or
  24056       \note equal to 1. If this schedule is not specified then venting is allowed if
  24057       \note other venting control conditions are satisfied.
  24058       \note Not used if Ventilation Control Mode = NoVent or ZoneLevel.
  24059   A7, \field Occupant Ventilation Control Name
  24060       \type object-list
  24061       \object-list AirflowNetworkOccupantVentilationControlNames
  24062       \note Enter the name where Occupancy Ventilation Control is required.
  24063   A8, \field Equivalent Rectangle Method
  24064       \type choice
  24065       \key PolygonHeight
  24066       \key BaseSurfaceAspectRatio
  24067       \key UserDefinedAspectRatio
  24068       \default PolygonHeight
  24069       \note This field is applied to a non-rectangular window or door. The equivalent shape has
  24070       \note the same area as a polygonal window or door.
  24071   N7; \field Equivalent Rectangle Aspect Ratio
  24072       \note This field is used when UserDefinedAspectRatio is entered in the Equivalent
  24073       \note Rectangle Method field.
  24074       \units dimensionless
  24075       \type real
  24076       \minimum> 0.0
  24077       \default 1.0
  24078 
  24079 AirflowNetwork:MultiZone:ReferenceCrackConditions,
  24080       \min-fields 4
  24081       \memo This object specifies the conditions under which the air mass flow coefficient was measured.
  24082  A1 , \field Name
  24083       \required-field
  24084       \type alpha
  24085       \reference ReferenceCrackConditions
  24086       \note Enter a unique name for this object.
  24087  N1 , \field Reference Temperature
  24088       \type real
  24089       \units C
  24090       \default 20
  24091       \note Enter the reference temperature under which the surface crack data were obtained.
  24092  N2 , \field Reference Barometric Pressure
  24093       \type real
  24094       \units Pa
  24095       \default 101325
  24096       \minimum 31000
  24097       \maximum 120000
  24098       \ip-units inHg
  24099       \note Enter the reference barometric pressure under which the surface crack data were obtained.
  24100  N3 ; \field Reference Humidity Ratio
  24101       \type real
  24102       \units kgWater/kgDryAir
  24103       \default 0
  24104       \note Enter the reference humidity ratio under which the surface crack data were obtained.
  24105 
  24106 AirflowNetwork:MultiZone:Surface:Crack,
  24107       \min-fields 3
  24108       \memo This object specifies the properties of airflow through a crack.
  24109  A1 , \field Name
  24110       \required-field
  24111       \type alpha
  24112       \reference SurfaceAirflowLeakageNames
  24113       \note Enter a unique name for this object.
  24114  N1 , \field Air Mass Flow Coefficient at Reference Conditions
  24115       \type real
  24116       \required-field
  24117       \units kg/s
  24118       \minimum> 0
  24119       \note Enter the air mass flow coefficient at the conditions defined
  24120       \note in the Reference Crack Conditions object.

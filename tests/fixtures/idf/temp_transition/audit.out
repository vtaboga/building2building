  29033 HVACTemplate:System:UnitaryHeatPump:AirToAir,
  29034       \min-fields 61
  29035       \memo Unitary furnace with electric air-to-air heat pump
  29036   A1, \field Name
  29037       \required-field
  29038       \reference CompactHVACSystemUnitary
  29039       \reference HVACTemplateSystems
  29040   A2, \field System Availability Schedule Name
  29041       \note If blank, always on; Unitary System always on.  Schedule is used in availability manager
  29042       \note and fan scheduling.
  29043       \note Also see "Night Cycle Control" field.
  29044       \type object-list
  29045       \object-list ScheduleNames
  29046   A3, \field Control Zone or Thermostat Location Name
  29047       \required-field
  29048       \type object-list
  29049       \object-list ZoneNames
  29050   N1, \field Cooling Supply Air Flow Rate
  29051       \note Supply air flow rate during cooling operation
  29052       \note This field may be set to "autosize".  If a value is entered, it will *not* be
  29053       \note multiplied by any sizing factor or by zone multipliers.  If using zone multipliers
  29054       \note a value entered here must be large enough to serve the multiplied zones.
  29055       \type real
  29056       \minimum> 0.0
  29057       \autosizable
  29058       \default autosize
  29059       \units m3/s
  29060   N2, \field Heating Supply Air Flow Rate
  29061       \note Supply air flow rate during heating operation
  29062       \note This field may be set to "autosize".  If a value is entered, it will *not* be
  29063       \note multiplied by any sizing factor or by zone multipliers.  If using zone multipliers
  29064       \note a value entered here must be large enough to serve the multiplied zones.
  29065       \type real
  29066       \minimum> 0.0
  29067       \autosizable
  29068       \default autosize
  29069       \units m3/s
  29070   N3, \field No Load Supply Air Flow Rate
  29071       \note Supply air flow rate when no cooling or heating is needed
  29072       \note Only used when heat pump fan operating mode is Continuous. This air flow rate
  29073       \note is used when no heating or cooling is required and the DX coil compressor is off.
  29074       \note If this field is left blank or zero, the supply air flow rate from the previous on cycle
  29075       \note (either cooling or heating) is used.
  29076       \note This field may be set to "autosize".  If a value is entered, it will *not* be
  29077       \note multiplied by any sizing factor or by zone multipliers.  If using zone multipliers
  29078       \note a value entered here must be large enough to serve the multiplied zones.
  29079       \type real
  29080       \minimum 0
  29081       \default autosize
  29082       \autosizable
  29083       \units m3/s
  29084   A4, \field Supply Fan Operating Mode Schedule Name
  29085       \note Refers to a schedule to specify unitary supply fan operating mode.
  29086       \note Schedule values of 0 indicate cycling fan (auto)
  29087       \note Schedule values of 1 indicate continuous fan (on)
  29088       \note If this field is left blank, a schedule of always zero (cycling fan) will be used.
  29089       \type object-list
  29090       \object-list ScheduleNames
  29091   A5, \field Supply Fan Placement
  29092       \type choice
  29093       \key BlowThrough
  29094       \key DrawThrough
  29095       \default BlowThrough
  29096   N4, \field Supply Fan Total Efficiency
  29097       \minimum> 0.0
  29098       \maximum 1.0
  29099       \default 0.7
  29100   N5, \field Supply Fan Delta Pressure
  29101       \units Pa
  29102       \ip-units inH2O
  29103       \minimum 0
  29104       \default 600
  29105   N6, \field Supply Fan Motor Efficiency
  29106       \minimum> 0.0
  29107       \maximum 1.0
  29108       \default 0.9
  29109   N7, \field Supply Fan Motor in Air Stream Fraction
  29110       \minimum 0.0
  29111       \maximum 1.0
  29112       \default 1.0
  29113   A6, \field Cooling Coil Type
  29114       \type choice
  29115       \key  SingleSpeedDX
  29116       \default SingleSpeedDX
  29117   A7, \field Cooling Coil Availability Schedule Name
  29118       \note If blank, always on
  29119       \type object-list
  29120       \object-list ScheduleNames
  29121   N8, \field Cooling Design Supply Air Temperature
  29122       \note Used for sizing.
  29123       \default 12.8
  29124       \units C
  29125   N9, \field Cooling Coil Gross Rated Total Capacity
  29126       \note Total cooling capacity not accounting for the effect of supply air fan heat
  29127       \note Rating point: air entering the cooling coil at 26.7 C dry-bulb/19.4 C wet-bulb, and
  29128       \note air entering the outdoor condenser coil at 35 C dry-bulb/23.9 C wet-bulb
  29129       \autosizable
  29130       \default autosize
  29131       \units W
  29132  N10, \field Cooling Coil Gross Rated Sensible Heat Ratio
  29133       \note Rated sensible heat ratio (gross sensible capacity/gross total capacity)
  29134       \note Sensible and total capacities do not include effect of supply fan heat
  29135       \autosizable
  29136       \minimum 0.5
  29137       \maximum 1.0
  29138       \default autosize
  29139  N11, \field Cooling Coil Gross Rated COP
  29140       \note Gross cooling capacity divided by power input to the compressor and outdoor fan,
  29141       \note does not include supply fan heat or supply fan electric power input
  29142       \units W/W
  29143       \minimum> 0.0
  29144       \default 3.0
  29145   A8, \field Heat Pump Heating Coil Type
  29146       \type choice
  29147       \key  SingleSpeedDXHeatPump
  29148       \default SingleSpeedDXHeatPump

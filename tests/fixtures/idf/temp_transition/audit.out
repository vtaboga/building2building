  16588       \object-list ScheduleNames
  16589 
  16590 SurfaceProperty:OtherSideCoefficients,
  16591       \memo This object sets the other side conditions for a surface in a variety of ways.
  16592       \min-fields 8
  16593   A1, \field Name
  16594       \required-field
  16595       \reference OutFaceEnvNames
  16596   N1, \field Combined Convective/Radiative Film Coefficient
  16597       \units W/m2-K
  16598       \required-field
  16599       \type real
  16600       \note if>0, this field becomes the exterior convective/radiative film coefficient
  16601       \note and the other fields are used to calculate the outdoor air temperature
  16602       \note then exterior surface temperature based on outdoor air and specified coefficient
  16603       \note if<=0, then remaining fields calculate the outside surface temperature
  16604       \note The following fields are used in the equation:
  16605       \note OtherSideTemp=N2*N3 + N4*OutdoorDry-bulb + N5*GroundTemp + N6*WindSpeed*OutdoorDry-bulb + N7*TempZone + N9*TempPrev
  16606   N2, \field Constant Temperature
  16607       \units C
  16608       \type real
  16609       \default 0
  16610       \note This parameter will be overwritten by the values from the Constant Temperature Schedule Name (below) if one is present
  16611   N3, \field Constant Temperature Coefficient
  16612       \note This coefficient is used even with a Schedule.  It should normally be 1.0 in that case.
  16613       \note This field is ignored if Sinusoidal Variation of Constant Temperature Coefficient = Yes.
  16614       \default 1
  16615   N4, \field External Dry-Bulb Temperature Coefficient
  16616       \type real
  16617       \default 0
  16618   N5, \field Ground Temperature Coefficient
  16619       \type real
  16620       \default 0
  16621   N6, \field Wind Speed Coefficient
  16622       \type real
  16623       \default 0
  16624   N7, \field Zone Air Temperature Coefficient
  16625       \type real
  16626       \default 0
  16627   A2, \field Constant Temperature Schedule Name
  16628       \note Name of schedule for values of constant temperature.
  16629       \note Schedule values replace any value specified in the field Constant Temperature.
  16630       \type object-list
  16631       \object-list ScheduleNames
  16632   A3, \field Sinusoidal Variation of Constant Temperature Coefficient
  16633       \note Optionally used to vary Constant Temperature Coefficient with unitary sine wave
  16634       \type choice
  16635       \key Yes
  16636       \key No
  16637       \default No
  16638   N8, \field Period of Sinusoidal Variation
  16639       \note Use with sinusoidal variation to define the time period
  16640       \type real
  16641       \units hr
  16642       \default 24
  16643       \minimum> 0
  16644   N9, \field Previous Other Side Temperature Coefficient
  16645       \note This coefficient multiplies the other side temperature result from the
  16646       \note previous zone timestep
  16647       \type real
  16648       \default 0
  16649  N10, \field Minimum Other Side Temperature Limit
  16650       \note This field specifies a lower limit for the other side temperature result.
  16651       \note Blank indicates no limit
  16652       \type real
  16653       \units C
  16654  N11; \field Maximum Other Side Temperature Limit
  16655       \note This field specifies an upper limit for the other side temperature result.
  16656       \note Blank indicates no limit
  16657       \type real
  16658       \units C
  16659 
  16660 SurfaceProperty:OtherSideConditionsModel,
  16661       \memo This object sets up modifying the other side conditions for a surface from other model results.
  16662   A1, \field Name
  16663       \required-field
  16664       \reference OSCMNames
  16665       \reference OutFaceEnvNames
  16666   A2; \field Type of Modeling
  16667       \type choice
  16668       \key GapConvectionRadiation
  16669       \key UndergroundPipingSystemSurface
  16670       \key GroundCoupledSurface
  16671       \key ConvectiveUnderwater
  16672       \note GapConvectionRadiation provides boundary conditions for convection
  16673       \note  and linearized thermal radiation across a gap or cavity
  16674       \note  on the other side of the surface that are modeled separately.
  16675       \note UndergroundPipingSystemSurface provides boundary conditions for
  16676       \note  surfaces in contact with PipingSystem:Underground domains
  16677       \note GroundCoupledSurface provides boundary conditions for surfaces
  16678       \note  in contact with GroundDomain objects
  16679       \note ConvectiveUnderwater provides a connection between a surface and
  16680       \note  an underwater boundary condition defined using a
  16681       \note  SurfaceProperty:Underwater object
  16682       \default GapConvectionRadiation
  16683 
  16684 SurfaceProperty:Underwater,
  16685        \memo This object sets up a convective water boundary condition for a surface
  16686        \memo The free stream temperature and velocity are scheduled. If the free stream
  16687        \memo velocity is zero, the surface will naturally convect with the surrounding water.
  16688        \min-fields 3
  16689   A1,  \field Name
  16690        \required-field
  16691        \reference SurfacePropUnderWaterNames
  16692        \type alpha
  16693   N1,  \field Distance from Surface Centroid to Leading Edge of Boundary Layer
  16694        \note This is the distance from the leading edge of the boundary layer development
  16695        \note to the centroid of the surface of interest.  The value of this field is used
  16696        \note as the distance in the Reynolds number for evaluating the local convection coefficient.
  16697        \type real
  16698        \units m
  16699        \required-field
  16700   A2,  \field Free Stream Water Temperature Schedule
  16701        \required-field
  16702        \type object-list
  16703        \object-list ScheduleNames
  16704        \units C
  16705   A3;  \field Free Stream Water Velocity Schedule
  16706        \type object-list
  16707        \object-list ScheduleNames
  16708        \units m/s
  16709 
  16710 Foundation:Kiva,
  16711        \memo Refined definition of the foundation surface construction used to
  16712        \memo inform two-dimensional heat transfer calculated using the Kiva
  16713        \memo ground heat transfer methodology.
  16714        \extensible:4
  16715   A1,  \field Name
  16716        \required-field
  16717        \type alpha
  16718        \reference OutFaceEnvNames
  16719   N1,  \field Initial Indoor Air Temperature
  16720        \note Indoor air temperature used for Kiva initialization (prior to warmup period)
  16721        \note If left blank, indoor air temperature will be determined based on zone setpoints
  16722        \units C
  16723        \type real

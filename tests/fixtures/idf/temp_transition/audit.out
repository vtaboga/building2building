  32281 HVACTemplate:Plant:MixedWaterLoop,
  32282       \min-fields 11
  32283       \memo Central plant loop portion of a water source heat pump system.
  32284       \unique-object
  32285   A1, \field Name
  32286       \required-field
  32287   A2, \field Pump Schedule Name
  32288       \note If blank, always available
  32289       \note Applies to both chilled water and condenser loop pumps
  32290       \type object-list
  32291       \object-list ScheduleNames
  32292   A3, \field Pump Control Type
  32293       \note Applies to both chilled water and condenser loop pumps
  32294       \type choice
  32295       \key Intermittent
  32296       \key Continuous
  32297       \default Intermittent
  32298   A4, \field Operation Scheme Type
  32299       \note Default operation type makes all equipment available
  32300       \note at all times operating in order of Priority specified
  32301       \note in HVACTemplate:Plant:Boiler and HVACTemplate:Plant:Tower objects.
  32302       \type choice
  32303       \key Default
  32304       \key UserDefined
  32305       \default Default
  32306   A5, \field Equipment Operation Schemes Name
  32307       \type object-list
  32308       \object-list PlantOperationSchemes
  32309       \note Name of a PlantEquipmentOperationSchemes object
  32310       \note Ignored if Plant Operation Scheme Type = Default
  32311   A6, \field High Temperature Setpoint Schedule Name
  32312       \note Leave blank if constant setpoint
  32313       \type object-list
  32314       \object-list ScheduleNames
  32315   N1, \field High Temperature Design Setpoint
  32316       \note  Used for sizing and as constant setpoint if no Setpoint Schedule Name is specified.
  32317       \default 33.0
  32318       \units C
  32319   A7, \field Low Temperature Setpoint Schedule Name
  32320       \note  Leave blank if constant setpoint
  32321       \note  May be left blank if not serving any water cooled chillers
  32322       \type object-list
  32323       \object-list ScheduleNames
  32324   N2, \field Low Temperature Design Setpoint
  32325       \note  Used for sizing and as constant setpoint if no Condenser Water Setpoint Schedule Name is specified.
  32326       \note  May be left blank if not serving any water cooled chillers
  32327       \default 20.0
  32328       \units C
  32329   A8, \field Water Pump Configuration
  32330       \note VariableFlow - variable flow to boilers and coils, excess bypassed
  32331       \note ConstantFlow - constant flow to boilers and coils, excess bypassed
  32332       \type choice
  32333       \key VariableFlow
  32334       \key ConstantFlow
  32335       \default ConstantFlow
  32336   N3, \field Water Pump Rated Head
  32337       \note  May be left blank if not serving any water cooled chillers
  32338       \units Pa
  32339       \minimum 0.0
  32340       \default 179352
  32341       \note default head is 60 feet H2O
  32342       \ip-units ftH2O
  32343   A9, \field Water Pump Type
  32344       \note Describes the type of pump configuration used for the mixed water loop.
  32345       \type choice
  32346       \key SinglePump
  32347       \key PumpPerTowerOrBoiler
  32348       \key TwoHeaderedPumps
  32349       \key ThreeHeaderedPumps
  32350       \key FourHeaderedPumps
  32351       \key FiveHeaderedPumps
  32352       \default SinglePump
  32353   A10,\field Supply Side Bypass Pipe
  32354       \note Determines if a supply side bypass pipe is present in the hot water loop.
  32355       \type choice
  32356       \key Yes
  32357       \key No
  32358       \default Yes
  32359   A11,\field Demand Side Bypass Pipe
  32360       \note Determines if a demand side bypass pipe is present in the hot water loop.
  32361       \type choice
  32362       \key Yes
  32363       \key No
  32364       \default Yes
  32365   A12,\field Fluid Type
  32366       \type choice
  32367       \key Water
  32368       \key EthyleneGlycol30
  32369       \key EthyleneGlycol40
  32370       \key EthyleneGlycol50
  32371       \key EthyleneGlycol60
  32372       \key PropyleneGlycol30
  32373       \key PropyleneGlycol40
  32374       \key PropyleneGlycol50
  32375       \key PropyleneGlycol60
  32376       \default Water
  32377   N4, \field Loop Design Delta Temperature
  32378       \note The temperature difference used in sizing the loop flow rate.
  32379       \units deltaC
  32380       \default 5.6
  32381   A13;\field Load Distribution Scheme
  32382       \type choice
  32383       \key Optimal
  32384       \key SequentialLoad
  32385       \key UniformLoad
  32386       \key UniformPLR
  32387       \key SequentialUniformPLR
  32388       \default SequentialLoad
  32389 
  32390 \group HVAC Design Objects
  32391 
  32392 DesignSpecification:OutdoorAir,
  32393   \min-fields 1
  32394   \memo This object is used to describe general outdoor air requirements which
  32395   \memo are referenced by other objects.
  32396   A1, \field Name
  32397       \required-field
  32398       \type alpha
  32399       \reference DesignSpecificationOutdoorAirNames
  32400   A2, \field Outdoor Air Method
  32401       \type choice
  32402       \key Flow/Person
  32403       \key Flow/Area
  32404       \key Flow/Zone
  32405       \key AirChanges/Hour
  32406       \key Sum
  32407       \key Maximum
  32408       \key IndoorAirQualityProcedure
  32409       \key ProportionalControlBasedOnDesignOccupancy
  32410       \key ProportionalControlBasedonOccupancySchedule
  32411       \default Flow/Person
  32412       \note Flow/Person => Outdoor Air Flow per Person * Occupancy = Design Flow Rate,
  32413       \note Flow/Area => Outdoor Air Flow per Zone Floor Area * Zone Floor Area = Design Flow Rate,
  32414       \note Flow/Zone => Outdoor Air Flow per Zone = Design Flow Rate,
  32415       \note AirChanges/Hour => Outdoor Air Flow Air Changes per Hour * Zone Volume adjusted for m3/s = Design Flow Rate
  32416   N1, \field Outdoor Air Flow per Person
  32417       \type real
  32418       \units m3/s-person
  32419       \default 0.00944
  32420       \minimum 0
  32421       \note 0.00944 m3/s is equivalent to 20 cfm per person
  32422       \note This input is only used if the field Outdoor Air Method is Flow/Person, Sum, or Maximum
  32423       \note For sizing, the design number of occupants is used. For outdoor air flow control, the use
  32424       \note of design occupants or current occupants depends on the component and DCV options.
  32425       \note AirTerminal:SingleDuct:VAV:NoReheat, AirTerminal:SingleDuct:VAV:Reheat use the DCV flag specified in Controller:MechanicalVentilation
  32426       \note AirTerminal:DualDuct:VAV:OutdoorAir and ZoneHVAC:IdealLoadsAirSystem have their own DCV control input.
  32427       \note ZoneHVAC:FourPipeFanCoil always uses current occupants.
  32428   N2, \field Outdoor Air Flow per Zone Floor Area
  32429       \units m3/s-m2
  32430       \default 0.0
  32431       \minimum 0
  32432       \note This input is only used if the field Outdoor Air Method is Flow/Area, Sum, or Maximum
  32433   N3, \field Outdoor Air Flow per Zone
  32434       \type real
  32435       \units m3/s
  32436       \default 0.0
  32437       \minimum 0
  32438       \note This input is only used if the field Outdoor Air Method is Flow/Zone, Sum, or Maximum
  32439   N4, \field Outdoor Air Flow Air Changes per Hour
  32440       \units 1/hr
  32441       \type real
  32442       \default 0.0
  32443       \minimum 0
  32444       \note This input is only used if the field Outdoor Air Method is AirChanges/Hour, Sum, or Maximum
  32445   A3, \field Outdoor Air Schedule Name
  32446       \type object-list
  32447       \object-list ScheduleNames
  32448       \note Schedule values are multiplied by the Outdoor Air Flow rate calculated using
  32449       \note the previous four inputs. Schedule values are limited to 0 to 1. If left blank, the schedule defaults to 1.0.
  32450       \note This schedule is ignored during sizing.  All other components which reference this design specification
  32451       \note use the current schedule value to calculate the current outdoor air requirement. This includes
  32452       \note AirTerminal:SingleDuct:VAV:NoReheat, AirTerminal:SingleDuct:VAV:Reheat, AirTerminal:DualDuct:VAV:OutdoorAir,
  32453       \note ZoneHVAC:FourPipeFanCoil, and ZoneHVAC:IdealLoadsAirSystem.
  32454       \note This schedule will also be applied by Controller:MechanicalVentilation for all System Outdoor Air Methods.
  32455   A4; \field Proportional Control Minimum Outdoor Air Flow Rate Schedule Name
  32456       \type object-list
  32457       \object-list ScheduleNames
  32458       \note This input is only used to calculate the minimum outdoor air flow rate when the field
  32459       \note System Outdoor Air Method = ProportionalControlBasedOnDesignOARate in Controller:MechanicalVentilation.
  32460 
  32461 DesignSpecification:ZoneAirDistribution,
  32462   \min-fields 1
  32463   \memo This object is used to describe zone air distribution in terms of air distribution
  32464   \memo effectiveness and secondary recirculation fraction. It is referenced by Sizing:Zone
  32465   \memo and Controller:MechanicalVentilation objects
  32466    A1,  \field Name
  32467         \required-field
  32468         \type alpha
  32469         \reference DesignSpecificationZoneAirDistributionNames
  32470    N1,  \field Zone Air Distribution Effectiveness in Cooling Mode
  32471         \type real
  32472         \default 1.0
  32473         \minimum> 0.0
  32474         \units dimensionless
  32475    N2,  \field Zone Air Distribution Effectiveness in Heating Mode
  32476         \type real
  32477         \default 1.0
  32478         \minimum> 0.0
  32479         \units dimensionless
  32480    A2,  \field Zone Air Distribution Effectiveness Schedule Name
  32481         \type object-list
  32482         \object-list ScheduleNames
  32483         \note optionally used to replace Zone Air Distribution Effectiveness in Cooling and
  32484         \note Heating Mode
  32485    N3,  \field Zone Secondary Recirculation Fraction
  32486         \type real
  32487         \default 0.0
  32488         \minimum 0.0
  32489         \units dimensionless
  32490    N4;  \field Minimum Zone Ventilation Efficiency
  32491         \type real
  32492         \default 0.0
  32493         \minimum 0.0
  32494         \maximum 1.0
  32495         \units dimensionless
  32496 
  32497 Sizing:Parameters,
  32498   \unique-object
  32499       \memo Specifies global heating and cooling sizing factors/ratios.
  32500       \memo These ratios are applied at the zone level to all of the zone heating and cooling loads
  32501       \memo and air flow rates. Then these new loads and air flow rates are used to calculate the
  32502       \memo system level flow rates and capacities and are used in all component sizing calculations.
  32503       \memo Specifies the width (in load timesteps) of a moving average window
  32504       \memo which is used to smooth the peak load across more than one timestep.
  32505   \min-fields 1
  32506   N1, \field Heating Sizing Factor
  32507       \type real
  32508       \minimum> 0.0
  32509       \default 1.0
  32510   N2, \field Cooling Sizing Factor
  32511       \type real
  32512       \minimum> 0.0
  32513       \default 1.0
  32514   N3; \field Timesteps in Averaging Window
  32515       \note blank => set the timesteps in averaging window to
  32516       \note Number of Timesteps per Hour resulting in a 1 hour averaging window
  32517       \note default is number of timesteps for 1 hour averaging window
  32518       \type integer
  32519       \minimum 1
  32520 
  32521 Sizing:Zone,
  32522       \memo Specifies the data needed to perform a zone design air flow calculation.
  32523       \memo The calculation is done for every sizing period included in the input. The maximum
  32524       \memo cooling and heating load and cooling, heating, and ventilation air flows are then saved
  32525       \memo for system level and zone component design calculations.
  32526   \min-fields 27
  32527   A1, \field Zone or ZoneList Name
  32528       \required-field
  32529       \type object-list
  32530       \object-list ZoneAndZoneListNames
  32531   A2, \field Zone Cooling Design Supply Air Temperature Input Method
  32532       \type choice
  32533       \key SupplyAirTemperature
  32534       \key TemperatureDifference
  32535       \default SupplyAirTemperature
  32536   N1, \field Zone Cooling Design Supply Air Temperature
  32537       \type real
  32538       \units C
  32539       \note Zone Cooling Design Supply Air Temperature is only used when Zone Cooling Design
  32540       \note Supply Air Temperature Input Method = SupplyAirTemperature
  32541   N2, \field Zone Cooling Design Supply Air Temperature Difference
  32542       \type real
  32543       \units deltaC
  32544       \note Zone Cooling Design Supply Air Temperature is only used when Zone Cooling Design
  32545       \note Supply Air Temperature Input Method = TemperatureDifference
  32546       \note The absolute value of this field will be subtracted from the zone temperature
  32547       \note at peak load to calculate the Zone Cooling Design Supply Air Temperature.
  32548   A3, \field Zone Heating Design Supply Air Temperature Input Method
  32549       \type choice
  32550       \key SupplyAirTemperature
  32551       \key TemperatureDifference
  32552       \default SupplyAirTemperature
  32553   N3, \field Zone Heating Design Supply Air Temperature
  32554       \type real
  32555       \units C
  32556       \note Zone Heating Design Supply Air Temperature is only used when Zone Heating Design
  32557       \note Supply Air Temperature Input Method = SupplyAirTemperature
  32558   N4, \field Zone Heating Design Supply Air Temperature Difference
  32559       \type real
  32560       \units deltaC
  32561       \note Zone Heating Design Supply Air Temperature is only used when Zone Heating Design
  32562       \note Supply Air Temperature Input Method = TemperatureDifference
  32563       \note The absolute value of this field will be added to the zone temperature
  32564       \note at peak load to calculate the Zone Heating Design Supply Air Temperature.
  32565   N5, \field Zone Cooling Design Supply Air Humidity Ratio
  32566       \required-field
  32567       \minimum 0.0
  32568       \type real
  32569       \units kgWater/kgDryAir
  32570   N6, \field Zone Heating Design Supply Air Humidity Ratio
  32571       \required-field
  32572       \minimum 0.0
  32573       \type real
  32574       \units kgWater/kgDryAir
  32575   A4, \field Design Specification Outdoor Air Object Name
  32576       \type object-list
  32577       \object-list DesignSpecificationOutdoorAirNames
  32578   N7, \field Zone Heating Sizing Factor
  32579       \note if blank or zero, global heating sizing factor from Sizing:Parameters is used.
  32580       \minimum 0
  32581   N8, \field Zone Cooling Sizing Factor
  32582       \note if blank or zero, global cooling sizing factor from Sizing:Parameters is used.
  32583       \minimum 0
  32584   A5, \field Cooling Design Air Flow Method
  32585       \type choice
  32586       \key Flow/Zone
  32587       \key DesignDay
  32588       \key DesignDayWithLimit
  32589       \default DesignDay
  32590   N9, \field Cooling Design Air Flow Rate
  32591       \type real
  32592       \units m3/s
  32593       \minimum 0
  32594       \default 0
  32595       \note This input is used if Cooling Design Air Flow Method is Flow/Zone
  32596       \note This value will be multiplied by the global or zone sizing factor and
  32597       \note by zone multipliers.
  32598   N10,\field Cooling Minimum Air Flow per Zone Floor Area
  32599       \type real
  32600       \units m3/s-m2
  32601       \minimum 0
  32602       \default .000762
  32603       \note default is .15 cfm/ft2
  32604       \note This input is used if Cooling Design Air Flow Method is DesignDayWithLimit
  32605   N11,\field Cooling Minimum Air Flow
  32606       \type real
  32607       \units m3/s
  32608       \minimum 0
  32609       \default 0
  32610       \note This input is used if Cooling Design Air Flow Method is DesignDayWithLimit
  32611   N12,\field Cooling Minimum Air Flow Fraction
  32612       \note fraction of the Cooling design Air Flow Rate
  32613       \type real
  32614       \minimum 0
  32615       \default 0.2
  32616       \note This input is currently used in sizing the VAV air terminal unit and fan minimum flow rate
  32617       \note It does not currently affect other component autosizing.
  32618   A6, \field Heating Design Air Flow Method
  32619       \type choice
  32620       \key Flow/Zone
  32621       \key DesignDay
  32622       \key DesignDayWithLimit
  32623       \default DesignDay
  32624   N13,\field Heating Design Air Flow Rate
  32625       \type real
  32626       \units m3/s
  32627       \minimum 0
  32628       \default 0
  32629       \note This input is used if Heating Design Air Flow Method is Flow/Zone.
  32630       \note This value will be multiplied by the global or zone sizing factor and
  32631       \note by zone multipliers.
  32632   N14,\field Heating Maximum Air Flow per Zone Floor Area
  32633       \type real
  32634       \units m3/s-m2
  32635       \minimum 0
  32636       \default .002032
  32637       \note default is .40 cfm/ft2
  32638       \note This field is used to size the heating design flow rate when Heating Design Air Flow Method = Flow/Zone.
  32639       \note This input is used for autosizing components when Heating Design Air Flow Method = DesignDayWithLimit.
  32640   N15,\field Heating Maximum Air Flow
  32641       \type real
  32642       \units m3/s
  32643       \minimum 0
  32644       \default .1415762
  32645       \note default is 300 cfm
  32646       \note This input is used for autosizing components when Heating Design Air Flow Method = DesignDayWithLimit.
  32647   N16,\field Heating Maximum Air Flow Fraction
  32648       \note fraction of the Heating Design Air Flow Rate
  32649       \type real
  32650       \minimum 0
  32651       \default 0.3
  32652       \note This input is used for autosizing components when Heating Design Air Flow Method = DesignDayWithLimit.
  32653   A7, \field Design Specification Zone Air Distribution Object Name
  32654       \type object-list
  32655       \object-list DesignSpecificationZoneAirDistributionNames
  32656   A8, \field Account for Dedicated Outdoor Air System
  32657       \note account for effect of dedicated outdoor air system supplying air directly to the zone
  32658       \type choice
  32659       \key Yes
  32660       \key No
  32661       \default No
  32662   A9, \field Dedicated Outdoor Air System Control Strategy
  32663       \note 1)supply neutral ventilation air; 2)supply neutral dehumidified and reheated
  32664       \note ventilation air; 3)supply cold ventilation air
  32665       \type choice
  32666       \key NeutralSupplyAir
  32667       \key NeutralDehumidifiedSupplyAir
  32668       \key ColdSupplyAir
  32669       \default NeutralSupplyAir
  32670   N17,\field Dedicated Outdoor Air Low Setpoint Temperature for Design
  32671       \type real
  32672       \units C
  32673       \autosizable
  32674       \default autosize
  32675   N18;\field Dedicated Outdoor Air High Setpoint Temperature for Design
  32676       \type real
  32677       \units C
  32678       \autosizable
  32679       \default autosize
  32680 
  32681 DesignSpecification:ZoneHVAC:Sizing,
  32682   \min-fields 1
  32683   \memo This object is used to describe general scalable zone HVAC equipment sizing which
  32684   \memo are referenced by other objects.
  32685   A1, \field Name
  32686       \required-field
  32687       \type alpha
  32688       \reference DesignSpecificationZoneHVACSizingName
  32689   A2, \field Cooling Supply Air Flow Rate Method
  32690       \type choice
  32691       \key None
  32692       \key SupplyAirFlowRate
  32693       \key FlowPerFloorArea
  32694       \key FractionOfAutosizedCoolingAirflow
  32695       \key FlowPerCoolingCapacity
  32696       \default SupplyAirFlowRate
  32697       \note Enter the method used to determine the cooling supply air volume flow rate.
  32698       \note None is used when a cooling coil is not included in the Zone HVAC Equip or this field
  32699       \note may be blank. SupplyAirFlowRate => selected when the magnitude of the supply air volume
  32700       \note flow rate is specified. FlowPerFloorArea => selected when the supply air volume flow rate
  32701       \note is determined from total floor area served by the Zone HVAC unit and Flow Per Floor Area
  32702       \note value specified. FractionOfAutosizedCoolingAirflow => is selected when the supply air volume
  32703       \note is determined from a user specified fraction and the autosized cooling supply air flow rate
  32704       \note value determined by the simulation. FlowPerCoolingCapacity => is selected when the supply
  32705       \note air volume is determined from user specified flow per Cooling Capacity and Cooling Capacity
  32706       \note determined by the simulation.
  32707   N1, \field Cooling Supply Air Flow Rate
  32708       \type real
  32709       \units m3/s
  32710       \minimum 0.0
  32711       \autosizable
  32712       \note Enter the magnitude of supply air volume flow rate during cooling operation.
  32713       \note Required field when Cooling Supply Air Flow Rate Method is SupplyAirFlowRate.
  32714       \note This field may be blank if a cooling coil is not included in the Zone HVAC equipment.
  32715   N2, \field Cooling Supply Air Flow Rate Per Floor Area
  32716       \type real
  32717       \units m3/s-m2
  32718       \minimum 0.0
  32719       \note Enter the cooling supply air volume flow rate per total conditioned floor area.
  32720       \note Required field when Cooling Supply Air Flow Rate Method is FlowPerFloorArea.
  32721       \note This field may be blank if a cooling coil is not included in the Zone HVAC equipment.
  32722   N3, \field Cooling Fraction of Autosized Cooling Supply Air Flow Rate
  32723       \type real
  32724       \minimum 0.0
  32725       \note Enter the supply air volume flow rate as a fraction of the cooling supply air flow rate.
  32726       \note Required field when Cooling Supply Air Flow Rate Method is
  32727       \note FractionOfAutosizedCoolingAirflow.
  32728       \note This field may be blank if a cooling coil is not included in the Zone HVAC equipment.
  32729   N4, \field Cooling Supply Air Flow Rate Per Unit Cooling Capacity
  32730       \type real
  32731       \units m3/s-W
  32732       \minimum 0.0
  32733       \note Enter the cooling supply air volume flow rate unit cooling capacity.
  32734       \note Required field when Cooling Supply Air Flow Rate Method is
  32735       \note FlowPerCoolingCapacity. This field may be blank if a cooling coil is not
  32736       \note included in the Zone HVAC equipment.
  32737   A3, \field No Load Supply Air Flow Rate Method
  32738       \type choice
  32739       \key None
  32740       \key SupplyAirFlowRate
  32741       \key FlowPerFloorArea
  32742       \key FractionOfAutosizedCoolingAirflow
  32743       \key FractionOfAutosizedHeatingAirflow
  32744       \default SupplyAirFlowRate
  32745       \note Enter the method used to determine the supply air volume flow rate When No Cooling or Heating
  32746       \note is Required. None is used when a cooling or heating coil is not included in the Zone HVAC
  32747       \note Equipment or this field may be blank. SupplyAirFlowRate => selected when the magnitude of the
  32748       \note supply air volume flow rate is specified. FlowPerFloorArea => selected when the supply air
  32749       \note volume flow rate is determined from total floor area served by the Zone HVAC unit and Flow Per
  32750       \note Floor Area is specified. FractionOfAutosizedCoolingAirflow => is selected when the supply
  32751       \note air volume is determined from a user specified fraction and the Autosized cooling supply
  32752       \note air flow rate value determined by the simulation. FractionOfAutosizedHeatingAirflow => is
  32753       \note selected when the supply air volume is determined from a user specified fraction and the
  32754       \note Autosized heating supply air flow rate value determined by the simulation.
  32755   N5, \field No Load Supply Air Flow Rate
  32756       \type real
  32757       \units m3/s
  32758       \minimum 0.0
  32759       \autosizable
  32760       \note Enter the magnitude of the supply air volume flow rate during when no cooling or heating
  32761       \note is required. Required field when No Load Supply Air Flow Rate Method
  32762       \note is SupplyAirFlowRate.
  32763   N6, \field No Load Supply Air Flow Rate Per Floor Area
  32764       \type real
  32765       \units m3/s-m2
  32766       \minimum 0.0
  32767       \note Enter the supply air volume flow rate per total floor area.
  32768       \note Required field when No Load Supply Air Flow Rate Method
  32769       \note is FlowPerFloorArea.
  32770   N7, \field No Load Fraction of Cooling Supply Air Flow Rate
  32771       \type real
  32772       \minimum 0.0
  32773       \note Enter the supply air volume flow rate as a fraction of the cooling supply air flow rate.
  32774       \note Required field when No Load Supply Air Flow Rate Method
  32775       \note is FractionOfAutosizedCoolingAirflow.
  32776   N8, \field No Load Fraction of Heating Supply Air Flow Rate
  32777       \type real
  32778       \minimum 0.0
  32779       \note Enter the supply air volume flow rate as a fraction of the heating supply air flow rate.
  32780       \note Required field when No Load Supply Air Flow Rate Method
  32781       \note is FractionOfAutosizedHeatingAirflow.
  32782   A4, \field Heating Supply Air Flow Rate Method
  32783       \type choice
  32784       \key None
  32785       \key SupplyAirFlowRate
  32786       \key FlowPerFloorArea
  32787       \key FractionOfAutosizedHeatingAirflow
  32788       \key FlowPerHeatingCapacity
  32789       \default SupplyAirFlowRate
  32790       \note Enter the method used to determine the heating supply air volume flow rate.
  32791       \note None is used when a heating coil is not included in the Zone HVAC Equipment or this field may
  32792       \note be blank. SupplyAirFlowRate => selected when the magnitude of the heating supply air volume
  32793       \note flow rate is specified.  FlowPerFloorArea => selected when the supply air volume flow rate is
  32794       \note determined from total floor area served by a Zone HVAC unit and user specified value of Flow
  32795       \note Per Floor Area. FractionOfAutosizedHeatingAirflow => is selected when the supply air volume
  32796       \note is determined from a user specified fraction and the Autosized heating supply air flow rate
  32797       \note value determined by the simulation. FlowPerHeatingCapacity => is selected when the supply
  32798       \note air volume is determined from user specified flow per Heating Capacity and Heating Capacity
  32799       \note determined by the simulation.
  32800   N9, \field Heating Supply Air Flow Rate
  32801       \type real
  32802       \units m3/s
  32803       \minimum 0.0
  32804       \autosizable
  32805       \note Enter the magnitude of the supply air volume flow rate during heating operation.

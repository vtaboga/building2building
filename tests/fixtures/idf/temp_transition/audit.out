  43874 ZoneHVAC:Baseboard:Convective:Water,
  43875        \memo Hot water baseboard heater, convection-only. Natural convection hydronic heating unit.
  43876        \min-fields 10
  43877   A1 , \field Name
  43878        \required-field
  43879        \reference-class-name validBranchEquipmentTypes
  43880        \reference validBranchEquipmentNames
  43881        \reference ZoneEquipmentNames
  43882   A2 , \field Availability Schedule Name
  43883        \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  43884        \note If this field is blank, the system is always available.
  43885        \type object-list
  43886        \object-list ScheduleNames
  43887   A3 , \field Inlet Node Name
  43888        \required-field
  43889        \type node
  43890   A4 , \field Outlet Node Name
  43891        \required-field
  43892        \type node
  43893   A5 , \field Heating Design Capacity Method
  43894        \type choice
  43895        \key HeatingDesignCapacity
  43896        \key CapacityPerFloorArea
  43897        \key FractionOfAutosizedHeatingCapacity
  43898        \default HeatingDesignCapacity
  43899        \note Enter the method used to determine the heating design capacity.
  43900        \note HeatingDesignCapacity = > selected when the design heating capacity value or autosize
  43901        \note is specified. CapacityPerFloorArea = > selected when the design heating capacity is
  43902        \note determine from user specified heating capacity per floor area and zone floor area.
  43903        \note FractionOfAutosizedHeatingCapacity = > is selected when the design heating capacity is
  43904        \note determined from a user specified fraction and the auto-sized design heating capacity.
  43905   N1 , \field Heating Design Capacity
  43906        \type real
  43907        \units W
  43908        \minimum 0.0
  43909        \autosizable
  43910        \ip-units W
  43911        \default autosize
  43912        \note Enter the design heating capacity.Required field when the heating design capacity method
  43913        \note HeatingDesignCapacity.
  43914   N2 , \field Heating Design Capacity Per Floor Area
  43915        \type real
  43916        \units W/m2
  43917        \minimum 0.0
  43918        \note Enter the heating design capacity per zone floor area.Required field when the heating design
  43919        \note capacity method field is CapacityPerFloorArea.
  43920   N3 , \field Fraction of Autosized Heating Design Capacity
  43921        \type real
  43922        \minimum 0.0
  43923        \default 1.0
  43924        \note Enter the fraction of auto - sized heating design capacity.Required field when capacity the
  43925        \note heating design capacity method field is FractionOfAutosizedHeatingCapacity.
  43926   N4 , \field U-Factor Times Area Value
  43927        \required-field
  43928        \autosizable
  43929        \units W/K
  43930   N5 , \field Maximum Water Flow Rate
  43931        \required-field
  43932        \units m3/s
  43933        \autosizable
  43934        \ip-units gal/min
  43935   N6 ; \field Convergence Tolerance
  43936        \type real
  43937        \minimum> 0.0
  43938        \default 0.001
  43939 

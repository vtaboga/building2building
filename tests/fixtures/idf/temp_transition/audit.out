  24932 AirflowNetwork:ZoneControl:PressureController,
  24933       \memo This object is used to control a zone to a specified indoor pressure
  24934       \memo using the AirflowNetwork model. The specified pressure setpoint is used
  24935       \memo to control the zone exhaust fan flow rate in a controlled zone or
  24936       \memo the relief air flow rate in an air loop.
  24937       \unique-object
  24938  A1 , \field Name
  24939       \required-field
  24940       \reference AirflowNetworkZoneControlPressureControllerNames
  24941  A2 , \field Control Zone Name
  24942       \required-field
  24943       \type object-list
  24944       \object-list ZoneNames
  24945  A3 , \field Control Object Type
  24946       \required-field
  24947       \type choice
  24948       \key AirflowNetwork:MultiZone:Component:ZoneExhaustFan
  24949       \key AirflowNetwork:Distribution:Component:ReliefAirFlow
  24950       \note The current selection is AirflowNetwork:MultiZone:Component:ZoneExhaustFan
  24951       \note or AirflowNetwork:Distribution:Component:ReliefAirFlow.
  24952  A4 , \field Control Object Name
  24953       \note Control names are names of individual control objects
  24954       \required-field
  24955       \type object-list
  24956       \object-list AFNReliefAirFlowNames
  24957       \object-list FansZoneExhaust
  24958  A5 , \field Pressure Control Availability Schedule Name
  24959       \note Availability schedule name for pressure controller. Schedule value > 0 means the
  24960       \note pressure controller is enabled. If this field is blank, then pressure controller is
  24961       \note always enabled.
  24962       \type object-list
  24963       \object-list ScheduleNames
  24964  A6 ; \field Pressure Setpoint Schedule Name
  24965       \required-field
  24966       \type object-list
  24967       \object-list ScheduleNames
  24968 
  24969 AirflowNetwork:Distribution:Node,
  24970       \min-fields 4
  24971       \memo This object represents an air distribution node in the AirflowNetwork model.
  24972  A1 , \field Name
  24973       \required-field
  24974       \type alpha
  24975       \reference AirflowNetworkNodeAndZoneNames
  24976       \note Enter a unique name for this object.
  24977  A2 , \field Component Name or Node Name
  24978       \type alpha
  24979       \note Designates node names defined in another object. The node name may occur in air branches.
  24980       \note Enter a node name to represent a node already defined in an air loop.
  24981       \note Leave this field blank if the Node or Object Type field below is entered as
  24982       \note AirLoopHVAC:ZoneMixer, AirLoopHVAC:ZoneSplitter, AirLoopHVAC:OutdoorAirSystem, or Other.
  24983  A3 , \field Component Object Type or Node Type
  24984       \type choice
  24985       \key AirLoopHVAC:ZoneMixer
  24986       \key AirLoopHVAC:ZoneSplitter
  24987       \key AirLoopHVAC:OutdoorAirSystem
  24988       \key OAMixerOutdoorAirStreamNode
  24989       \key OutdoorAir:NodeList
  24990       \key OutdoorAir:Node
  24991       \key Other
  24992       \default Other
  24993       \note Designates Node type for the Node or Component Name defined in the field above.
  24994       \note AirLoopHVAC:ZoneMixer -- Represents a AirLoopHVAC:ZoneMixer object.
  24995       \note AirLoopHVAC:ZoneSplitter -- Represents a AirLoopHVAC:ZoneSplitter object.
  24996       \note AirLoopHVAC:OutdoorAirSystem -- Represents an AirLoopHVAC:OutdoorAirSystem object.
  24997       \note OAMixerOutdoorAirStreamNode -- Represents an external node used in the OutdoorAir:Mixer
  24998       \note OutdoorAir:NodeList -- Represents an external node when a heat exchanger is used before
  24999       \note the OutdoorAir:Mixer
  25000       \note OutdoorAir:Node -- Represents an external node when a heat exchanger is used before
  25001       \note the OutdoorAir:Mixer
  25002       \note Other -- none of the above, the Node name already defined in the previous field is part
  25003       \note of an air loop.
  25004  N1 ; \field Node Height
  25005       \type real
  25006       \units m
  25007       \default 0.0
  25008       \note Enter the reference height used to calculate the relative pressure.
  25009 
  25010 AirflowNetwork:Distribution:Component:Leak,
  25011       \min-fields 3
  25012       \memo This object defines the characteristics of a supply or return air leak.
  25013  A1 , \field Name
  25014       \required-field
  25015       \type alpha
  25016       \reference AirflowNetworkComponentNames
  25017       \note Enter a unique name for this object.
  25018  N1 , \field Air Mass Flow Coefficient
  25019       \required-field
  25020       \type real
  25021       \units kg/s
  25022       \minimum> 0
  25023       \note Defined at 1 Pa pressure difference across this component.
  25024       \note Enter the coefficient used in the following equation:
  25025       \note Mass Flow Rate = Air Mass Flow Coefficient * (dP)^Air Mass Flow Exponent
  25026  N2 ; \field Air Mass Flow Exponent
  25027       \type real
  25028       \units dimensionless
  25029       \minimum 0.5
  25030       \maximum 1.0
  25031       \default 0.65
  25032       \note Enter the exponent used in the following equation:
  25033       \note Mass Flow Rate = Air Mass Flow Coefficient * (dP)^Air Mass Flow Exponent
  25034 
  25035 AirflowNetwork:Distribution:Component:LeakageRatio,
  25036       \min-fields 5
  25037       \memo This object is used to define supply and return air leaks with respect to the fan's maximum
  25038       \memo air flow rate.
  25039  A1 , \field Name
  25040       \required-field
  25041       \type alpha
  25042       \reference AirflowNetworkComponentNames
  25043       \note Enter a unique name for this object.
  25044  N1 , \field Effective Leakage Ratio
  25045       \type real
  25046       \units dimensionless
  25047       \minimum> 0.0
  25048       \maximum 1.0
  25049       \note Defined as a ratio of leak flow rate to the maximum flow rate.
  25050  N2 , \field Maximum Flow Rate
  25051       \required-field
  25052       \units m3/s
  25053       \type real
  25054       \minimum> 0.0
  25055       \note Enter the maximum air flow rate in this air loop.
  25056  N3 , \field Reference Pressure Difference
  25057       \required-field
  25058       \units Pa
  25059       \type real
  25060       \minimum> 0.0
  25061       \note Enter the pressure corresponding to the Effective leakage ratio entered above.
  25062  N4 ; \field Air Mass Flow Exponent
  25063       \units dimensionless
  25064       \type real
  25065       \default 0.65
  25066       \minimum 0.5
  25067       \maximum 1.0
  25068       \note Enter the exponent used in the air mass flow equation.
  25069 
  25070 AirflowNetwork:Distribution:Component:Duct,
  25071       \min-fields 8
  25072       \memo This object defines the relationship between pressure and air flow through the duct.
  25073  A1 , \field Name
  25074       \required-field
  25075       \type alpha
  25076       \reference AirflowNetworkComponentNames
  25077       \note Enter a unique name for this object.
  25078  N1 , \field Duct Length
  25079       \required-field
  25080       \type real
  25081       \units m
  25082       \minimum> 0.0
  25083       \note Enter the length of the duct.
  25084  N2 , \field Hydraulic Diameter
  25085       \required-field
  25086       \type real
  25087       \units m
  25088       \minimum> 0.0
  25089       \note Enter the hydraulic diameter of the duct.
  25090       \note Hydraulic diameter is defined as 4 multiplied by cross section area divided by perimeter
  25091  N3 , \field Cross Section Area
  25092       \required-field
  25093       \type real
  25094       \units m2
  25095       \minimum> 0.0
  25096       \note Enter the cross section area of the duct.
  25097  N4 , \field Surface Roughness
  25098       \type real
  25099       \units m
  25100       \default 0.0009
  25101       \minimum> 0.0
  25102       \note Enter the inside surface roughness of the duct.
  25103  N5 , \field Coefficient for Local Dynamic Loss Due to Fitting
  25104       \type real
  25105       \units dimensionless
  25106       \default 0.0
  25107       \minimum 0.0
  25108       \note Enter the coefficient used to calculate dynamic losses of fittings (e.g. elbows).
  25109  N6 , \field Heat Transmittance Coefficient (U-Factor) for Duct Wall Construction
  25110       \note conduction only
  25111       \type real
  25112       \units W/m2-K
  25113       \minimum> 0.0
  25114       \default 0.943
  25115       \note Default value of 0.943 is equivalent to 1.06 m2-K/W (R6) duct insulation.
  25116  N7 , \field Overall Moisture Transmittance Coefficient from Air to Air
  25117       \type real
  25118       \units kg/m2
  25119       \minimum> 0.0
  25120       \default 0.001
  25121       \note Enter the overall moisture transmittance coefficient
  25122       \note including moisture film coefficients at both surfaces.
  25123  N8 , \field Outside Convection Coefficient
  25124       \note optional. convection coefficient calculated automatically, unless specified
  25125       \type real
  25126       \units W/m2-K
  25127       \minimum> 0.0
  25128  N9 ; \field Inside Convection Coefficient
  25129       \note optional. convection coefficient calculated automatically, unless specified
  25130       \type real
  25131       \units W/m2-K
  25132       \minimum> 0.0
  25133 

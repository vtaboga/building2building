  23285       \key HeavyAndSaturated
  23286       \key HeavyAndDamp
  23287       \key HeavyAndDry
  23288       \key LightAndDry
  23289       \default HeavyAndDamp
  23290  N12, \field Average Soil Surface Temperature
  23291       \required-field
  23292       \units C
  23293       \type real
  23294  N13, \field Amplitude of Soil Surface Temperature
  23295       \required-field
  23296       \units deltaC
  23297       \type real
  23298       \minimum 0
  23299  N14, \field Phase Constant of Soil Surface Temperature
  23300       \required-field
  23301       \units days
  23302       \type real
  23303       \minimum 0

  34244    A1,  \field Name
  34245         \required-field
  34246         \type alpha
  34247         \reference DOAToZonalUnit
  34248         \reference ZoneEquipmentNames
  34249         \note Unique name for this packaged terminal air conditioner object.
  34250    A2,  \field Availability Schedule Name

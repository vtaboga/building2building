  62617        \note This field is used if Refrigerant Temperature Control Algorithm
  62618        \note is VariableTemp
  62619        \note Evaporating temperature is the refrigerant temperature, not air temperature
  62620        \type real
  62621        \units C
  62622        \default 13.0

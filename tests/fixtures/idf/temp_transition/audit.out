  17796 SurfaceConvectionAlgorithm:Inside:UserCurve,
  17797        \memo Used to describe a custom model equation for surface convection heat transfer coefficient
  17798        \memo If more than one curve is referenced they are all used and added together.
  17799   A1 , \field Name
  17800        \reference UserConvectionInsideModels
  17801        \reference UserConvectionModels
  17802   A2 , \field Reference Temperature for Convection Heat Transfer
  17803        \note Controls which temperature is differenced from surface temperature when using the Hc value
  17804        \type choice
  17805        \key MeanAirTemperature
  17806        \key AdjacentAirTemperature
  17807        \key SupplyAirTemperature
  17808   A3 , \field Hc Function of Temperature Difference Curve Name
  17809        \note  Curve's "x" is absolute value of delta-T (Surface temperature minus reference temperature, (C))
  17810        \type object-list
  17811        \object-list UnivariateFunctions
  17812   A4 , \field Hc Function of Temperature Difference Divided by Height Curve Name
  17813        \note Curve's "x" is absolute value of delta-T/Height (Surface temp minus Air temp)/(vertical length scale), (C/m)
  17814        \note when used for an inside face the vertical length scale is the zone's interior height
  17815        \type object-list
  17816        \object-list UnivariateFunctions
  17817   A5 , \field Hc Function of Air Change Rate Curve Name
  17818        \note Curve's "x" is mechanical ACH (Air Changes per hour from mechanical air system), (1/hr)
  17819        \type object-list
  17820        \object-list UnivariateFunctions
  17821   A6 ; \field Hc Function of Air System Volume Flow Rate Divided by Zone Perimeter Length Curve Name
  17822        \note Curve's "x" is mechanical system air flow rate (m3/s) divided by zone's length along
  17823        \note exterior walls (m).
  17824        \type object-list
  17825        \object-list UnivariateFunctions
  17826 
  17827 SurfaceConvectionAlgorithm:Outside:UserCurve,
  17828        \memo Used to describe a custom model equation for surface convection heat transfer coefficient
  17829        \memo If more than one curve is referenced they are all used and added together.
  17830   A1 , \field Name
  17831        \reference UserConvectionOutsideModels
  17832        \reference UserConvectionModels
  17833   A2 , \field Wind Speed Type for Curve
  17834        \type choice
  17835        \key WeatherFile
  17836        \key HeightAdjust
  17837        \key ParallelComponent
  17838        \key ParallelComponentHeightAdjust
  17839        \default HeightAdjust
  17840   A3 , \field Hf Function of Wind Speed Curve Name
  17841        \note Curve's "x" is wind speed of the type determined in the previous field (m/s)

  22802 ZoneVentilation:WindandStackOpenArea,
  22803   \min-fields 8
  22804        \memo This object is specified as natural ventilation driven by wind and stack effect only:
  22805        \memo Ventilation Wind = Cw * Opening Area * Schedule * WindSpd
  22806        \memo Ventilation Stack = Cd * Opening Area * Schedule * SQRT(2*g*DH*(|(Tzone-Todb)|/Tzone))
  22807        \memo Total Ventilation = SQRT((Ventilation Wind)^2 + (Ventilation Stack)^2)
  22808   A1 , \field Name
  22809        \required-field
  22810        \type alpha
  22811        \reference VentilationNames
  22812   A2 , \field Zone Name
  22813        \required-field
  22814        \type object-list
  22815        \object-list ZoneNames
  22816   N1 , \field Opening Area
  22817        \note This is the opening area used to calculate stack effect and wind driven ventilation.
  22818        \units m2
  22819        \type real
  22820        \minimum 0
  22821        \default 0
  22822   A3 , \field Opening Area Fraction Schedule Name
  22823        \type object-list
  22824        \object-list ScheduleNames
  22825        \note This schedule contains the fraction values applied to the opening area given in the previous
  22826        \note input field (0.0 - 1.0).
  22827   N2 , \field Opening Effectiveness
  22828        \note This field is used to calculate wind driven ventilation.
  22829        \note  "Cw" in the wind-driven equation and the maximum value is 1.0.
  22830        \note When the input is Autocalculate, the program calculates Cw based on an angle between
  22831        \note wind direction and effective angle
  22832        \note Cw = 0.55 at angle = 0, and Cw = 0.3 at angle=180
  22833        \note Linear interpolation is used to calculate Cw based on the above two values.
  22834        \units dimensionless
  22835        \autocalculatable
  22836        \type real
  22837        \minimum 0
  22838        \maximum 1
  22839        \default Autocalculate
  22840   N3 , \field Effective Angle
  22841        \note This field is defined as normal angle of the opening area and is used when input
  22842        \note field Opening Effectiveness = Autocalculate.
  22843        \type real
  22844        \units deg
  22845        \minimum 0.0
  22846        \maximum< 360.0
  22847        \default 0
  22848   N4 , \field Height Difference
  22849        \note This is the height difference between the midpoint of an opening and
  22850        \note the neutral pressure level.
  22851        \units m
  22852        \type real
  22853        \minimum 0
  22854        \default 0
  22855        \note  "DH" in the stack equation.
  22856   N5 , \field Discharge Coefficient for Opening
  22857        \note This is the discharge coefficient used to calculate stack effect.
  22858        \note  "Cd" in the stack equation and the maximum value is 1.0.
  22859        \note When the input is Autocalculate, the following equation is used to calculate the
  22860        \note coefficient:
  22861        \note Cd = 0.4 + 0.0045*|(Tzone-Todb)|
  22862        \autocalculatable
  22863        \minimum 0.0
  22864        \maximum 1.0
  22865        \default Autocalculate
  22866   N6 , \field Minimum Indoor Temperature
  22867        \note This is the indoor temperature below which ventilation is shutoff.
  22868        \units C
  22869        \type real
  22870        \minimum -100
  22871        \maximum 100
  22872        \default -100
  22873   A4 , \field Minimum Indoor Temperature Schedule Name
  22874        \type object-list
  22875        \object-list ScheduleNames
  22876        \note This schedule contains the indoor temperature versus time below which
  22877        \note ventilation is shutoff.
  22878   N7 , \field Maximum Indoor Temperature
  22879        \note This is the indoor temperature above which ventilation is shutoff.
  22880        \units C
  22881        \type real
  22882        \minimum -100
  22883        \maximum 100
  22884        \default 100
  22885   A5 , \field Maximum Indoor Temperature Schedule Name

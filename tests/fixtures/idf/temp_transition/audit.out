  48996        \minimum 1.0
  48997        \default 1.0
  48998        \note Applied to specified or autosized max fan airflow
  48999   N4 , \field Fan Wheel Diameter
  49000        \required-field
  49001        \type real
  49002        \units m
  49003        \minimum> 0.0
  49004        \note Diameter of wheel outer circumference
  49005   N5 , \field Fan Outlet Area
  49006        \required-field
  49007        \type real
  49008        \units m2
  49009        \minimum> 0.0
  49010        \note Area at fan outlet plane for determining discharge velocity pressure
  49011   N6 , \field Maximum Fan Static Efficiency
  49012        \required-field
  49013        \type real
  49014        \minimum> 0.0
  49015        \maximum 1.0
  49016        \note Maximum ratio between power delivered to air and fan shaft input power
  49017        \note Determined from fan performance data
  49018   N7 , \field Euler Number at Maximum Fan Static Efficiency
  49019        \required-field
  49020        \type real
  49021        \minimum> 0.0
  49022        \note Euler number (Eu) determined from fan performance data
  49023   N8 , \field Maximum Dimensionless Fan Airflow
  49024        \required-field
  49025        \type real
  49026        \minimum> 0.0
  49027        \note Corresponds to maximum ratio between fan airflow and
  49028        \note fan shaft rotational speed for specified fan wheel diameter
  49029        \note Determined from fan performance data
  49030   N9 , \field Motor Fan Pulley Ratio
  49031        \type real
  49032        \minimum> 0.0
  49033        \default 1.0
  49034        \autosizable
  49035        \note Ratio of motor pulley diameter to fan pulley diameter
  49036   N10 , \field Belt Maximum Torque
  49037         \required-field
  49038         \type real
  49039         \units N-m
  49040         \minimum> 0.0
  49041         \autosizable
  49042         \note Maximum torque transmitted by belt
  49043   N11 , \field Belt Sizing Factor
  49044         \type real
  49045         \minimum 1.0
  49046         \default 1.0
  49047         \note Applied to specified or autosized max torque transmitted by belt
  49048   N12 , \field Belt Fractional Torque Transition
  49049         \type real
  49050         \minimum 0.0
  49051         \maximum 1.0
  49052         \default 0.167
  49053         \note Region 1 to 2 curve transition for belt normalized efficiency
  49054   N13 , \field Motor Maximum Speed
  49055         \required-field
  49056         \type real
  49057         \units rev/min
  49058         \minimum> 0.0
  49059         \note Maximum rotational speed of fan motor shaft
  49060   N14 , \field Maximum Motor Output Power
  49061         \required-field
  49062         \type real
  49063         \units W
  49064         \minimum> 0.0
  49065         \autosizable
  49066         \note Maximum power input to drive belt by motor
  49067   N15 , \field Motor Sizing Factor
  49068         \type real
  49069         \minimum 1.0
  49070         \default 1.0
  49071         \note Applied to specified or autosized motor output power
  49072   N16 , \field Motor In Airstream Fraction
  49073         \type real
  49074         \minimum 0.0
  49075         \maximum 1.0
  49076         \default 1.0
  49077         \note 0.0 means motor outside air stream
  49078         \note 1.0 means motor inside air stream
  49079   A5 , \field VFD Efficiency Type
  49080        \type choice
  49081        \key Speed
  49082        \key Power
  49083        \note Efficiency depends on fraction of full-load motor speed
  49084        \note Efficiency depends on  fraction of full-load motor input power
  49085        \note If field blank, then assumes constant VFD efficiency (0.97)
  49086   N17 , \field Maximum VFD Output Power
  49087         \required-field
  49088         \type real
  49089         \units W
  49090         \minimum> 0.0
  49091         \autosizable
  49092         \note Maximum power input to motor by VFD
  49093   N18 , \field VFD Sizing Factor
  49094         \type real
  49095         \minimum 1.0
  49096         \default 1.0
  49097         \note Applied to specified or autosized VFD output power
  49098   A6 , \field Fan Pressure Rise Curve Name
  49099        \required-field
  49100        \type object-list
  49101        \object-list BivariateFunctions
  49102        \note Pressure rise depends on volumetric flow, system resistances,
  49103        \note system leakage, and duct static pressure set point
  49104   A7 , \field Duct Static Pressure Reset Curve Name
  49105        \required-field
  49106        \type object-list
  49107        \object-list UnivariateFunctions
  49108        \note Function of fan volumetric flow
  49109        \note Minimum and maximum fan airflows correspond respectively to
  49110        \note minimum and maximum duct static pressure set points
  49111   A8 , \field Normalized Fan Static Efficiency Curve Name-Non-Stall Region
  49112        \required-field
  49113        \type object-list
  49114        \object-list UnivariateFunctions
  49115        \note xfan <= 0
  49116        \note Curve should have maximum of 1.0
  49117   A9 , \field Normalized Fan Static Efficiency Curve Name-Stall Region
  49118        \required-field
  49119        \type object-list
  49120        \object-list UnivariateFunctions
  49121        \note xfan > 0
  49122        \note Curve should have maximum of 1.0
  49123   A10 , \field Normalized Dimensionless Airflow Curve Name-Non-Stall Region
  49124         \required-field
  49125         \type object-list
  49126         \object-list UnivariateFunctions
  49127         \note xspd <= 0
  49128         \note Curve should have maximum of 1.0
  49129   A11 , \field Normalized Dimensionless Airflow Curve Name-Stall Region
  49130         \required-field
  49131         \type object-list
  49132         \object-list UnivariateFunctions
  49133         \note xspd > 0
  49134         \note Curve should have maximum of 1.0
  49135   A12 , \field Maximum Belt Efficiency Curve Name
  49136         \type object-list
  49137         \object-list UnivariateFunctions
  49138         \note Determines maximum fan drive belt efficiency in log space
  49139         \note as function of xbelt,max
  49140         \note Curve should have minimum of -4.6 and maximum of 0.0
  49141         \note If field blank, assumes output of curve is always 1.0
  49142   A13 , \field Normalized Belt Efficiency Curve Name - Region 1
  49143         \type object-list
  49144         \object-list UnivariateFunctions
  49145         \note Region 1 (0 <= xbelt < xbelt,trans)
  49146         \note Curve should have minimum > 0.0 and maximum of 1.0
  49147         \note If field blank, assumes output of curve is always 1.0 in Region 1
  49148   A14 , \field Normalized Belt Efficiency Curve Name - Region 2
  49149         \type object-list
  49150         \object-list UnivariateFunctions
  49151         \note Region 2 (xbelt,trans <= xbelt <= 1)
  49152         \note Curve should have minimum > 0.0 and maximum of 1.0
  49153         \note If field blank, assumes output of curve is always 1.0 in Region 2
  49154   A15 , \field Normalized Belt Efficiency Curve Name - Region 3
  49155         \type object-list
  49156         \object-list UnivariateFunctions
  49157         \note Determines normalized drive belt efficiency Region 3 (xbelt > 1)
  49158         \note Curve should have minimum > 0.0 and maximum of 1.0
  49159         \note If field blank, assumes output of curve is always 1.0 in Region 3
  49160   A16 , \field Maximum Motor Efficiency Curve Name
  49161         \type object-list
  49162         \object-list UnivariateFunctions
  49163         \note Curve should have minimum > 0.0 and maximum of 1.0
  49164         \note If field blank, assumes output of curve is always 1.0
  49165   A17 , \field Normalized Motor Efficiency Curve Name
  49166         \type object-list
  49167         \object-list UnivariateFunctions
  49168         \note Curve should have minimum > 0.0 and maximum of 1.0
  49169         \note If field blank, assumes output of curve is always 1.0
  49170   A18 , \field VFD Efficiency Curve Name
  49171         \type object-list
  49172         \object-list UnivariateFunctions
  49173         \note Determines VFD efficiency as function of motor load or speed fraction
  49174         \note Curve should have minimum > 0.0 and maximum of 1.0
  49175         \note If field blank, assumes constant VFD efficiency (0.97)
  49176   A19 ; \field End-Use Subcategory
  49177         \note Any text may be used here to categorize the end-uses in the ABUPS End Uses by Subcategory table.
  49178         \type alpha
  49179         \retaincase
  49180         \default General
  49181 
  49182 \group Coils

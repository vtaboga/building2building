  31954 HVACTemplate:Plant:Tower,
  31955       \min-fields 9
  31956       \memo This object adds a cooling tower to an HVACTemplate:Plant:ChilledWaterLoop or MixedWaterLoop.
  31957   A1, \field Name
  31958       \required-field
  31959   A2, \field Tower Type
  31960       \required-field
  31961       \type choice
  31962       \key SingleSpeed
  31963       \key TwoSpeed
  31964   N1, \field High Speed Nominal Capacity
  31965       \note Applicable for tower type SingleSpeed and TwoSpeed
  31966       \note Nominal tower capacity with entering water at 35C (95F), leaving water at
  31967       \note 29.44C (85F), entering air at 25.56C (78F) wet-bulb temperature and 35C (95F)
  31968       \note dry-bulb temperature, with the tower fan operating at high speed. Design water
  31969       \note flow rate assumed to be 5.382E-8 m3/s per watt(3 gpm/ton). Nominal tower capacity
  31970       \note times (1.25) gives the actual tower heat rejection at these operating conditions.
  31971       \autosizable
  31972       \default autosize
  31973       \units W
  31974       \minimum> 0.0
  31975   N2, \field High Speed Fan Power
  31976       \note Applicable for tower type SingleSpeed and TwoSpeed
  31977       \autosizable
  31978       \default autosize
  31979       \units W
  31980       \ip-units W
  31981       \minimum> 0.0
  31982   N3, \field Low Speed Nominal Capacity
  31983       \note Applicable only for Tower Type TwoSpeed
  31984       \note Nominal tower capacity with entering water at 35C (95F), leaving water at
  31985       \note 29.44C (85F), entering air at 25.56C (78F) wet-bulb temperature and 35C (95F)
  31986       \note dry-bulb temperature, with the tower fan operating at low speed. Design water flow
  31987       \note rate assumed to be 5.382E-8 m3/s per watt of tower high-speed nominal capacity
  31988       \note (3 gpm/ton). Nominal tower capacity times (1.25) gives the actual tower heat
  31989       \note rejection at these operating conditions.
  31990       \autosizable
  31991       \default autosize
  31992       \units W
  31993       \minimum> 0.0
  31994   N4, \field Low Speed Fan Power
  31995       \note Applicable only for Tower Type TwoSpeed
  31996       \autosizable
  31997       \default autosize
  31998       \units W
  31999       \ip-units W
  32000       \minimum> 0.0
  32001   N5, \field Free Convection Capacity
  32002       \note Applicable for Tower Type SingleSpeed and TwoSpeed
  32003       \note Tower capacity in free convection regime with entering water at 35C (95F),
  32004       \note leaving water at 29.44C (85F), entering air at 25.56C (78F) wet-bulb temperature
  32005       \note and 35C (95F) dry-bulb temperature. Design water flow rate assumed to be
  32006       \note 5.382E-8 m3/s per watt of tower high-speed nominal capacity (3 gpm/ton). Tower
  32007       \note free convection capacity times (1.25) gives the actual tower heat rejection at
  32008       \note these operating conditions.
  32009       \autosizable
  32010       \default autosize
  32011       \units W
  32012       \minimum 0.0
  32013   A3, \field Priority
  32014       \note Applicable for all Tower Types
  32015       \note If Condenser Plant Operation Scheme Type=Default
  32016       \note in HVACTemplate:Plant:ChilledWaterLoop, then equipment
  32017       \note operates in Priority order, 1, 2, 3, etc.
  32018   N6, \field Sizing Factor
  32019       \note Multiplies the autosized capacity and flow rates
  32020       \type real
  32021       \minimum> 0.0
  32022       \default 1.0
  32023   A4; \field Template Plant Loop Type
  32024       \note Specifies if this tower serves a template chilled water loop or mixed water loop
  32025       \note If left blank, will serve a chilled water loop if present, or a mixed water loop (if
  32026       \note no chilled water loop is present).
  32027       \type choice
  32028       \key ChilledWater
  32029       \key MixedWater
  32030 

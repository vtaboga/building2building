  32980   N5, \field Precool Design Temperature
  32981       \required-field
  32982       \type real
  32983       \units C
  32984   N6, \field Precool Design Humidity Ratio
  32985       \required-field
  32986       \type real
  32987       \units kgWater/kgDryAir
  32988   N7, \field Central Cooling Design Supply Air Temperature
  32989       \required-field
  32990       \type real
  32991       \units C
  32992   N8, \field Central Heating Design Supply Air Temperature
  32993       \required-field
  32994       \type real
  32995       \units C
  32996   A3, \field Type of Zone Sum to Use
  32997       \type choice
  32998       \key Coincident
  32999       \key NonCoincident
  33000       \default NonCoincident
  33001   A4, \field 100% Outdoor Air in Cooling

  48518 \group Fans
  48519 !*****************AIR LOOP COMPONENTS*********************
  48520 Fan:SystemModel,
  48521        \memo Versatile simple fan that can be used in variable air volume, constant volume, on-off cycling, two-speed or multi-speed applications.
  48522        \memo Performance at different flow rates, or speed levels, is determined using separate performance curve or table
  48523        \memo or prescribed power fractions at discrete speed levels for two-speed or multi-speed fans.
  48524        \min-fields 14
  48525        \extensible:2
  48526   A1 , \field Name
  48527        \required-field
  48528        \reference Fans
  48529        \reference FansSystemModel
  48530        \reference-class-name validBranchEquipmentTypes
  48531        \reference validBranchEquipmentNames
  48532        \reference-class-name validOASysEquipmentTypes
  48533        \reference validOASysEquipmentNames
  48534   A2 , \field Availability Schedule Name
  48535        \note Availability schedule name for this fan. Schedule value > 0 means the fan is available.
  48536        \note If this field is blank, the fan is always available.
  48537        \type object-list
  48538        \object-list ScheduleNames
  48539   A3 , \field Air Inlet Node Name
  48540        \type node
  48541        \required-field
  48542   A4 , \field Air Outlet Node Name
  48543        \type node
  48544        \required-field
  48545   N1 , \field Design Maximum Air Flow Rate
  48546        \required-field
  48547        \type real
  48548        \units m3/s
  48549        \minimum> 0.0
  48550        \autosizable
  48551   A5 , \field Speed Control Method
  48552        \type choice
  48553        \key Continuous
  48554        \key Discrete
  48555        \default Discrete
  48556   N2 , \field Electric Power Minimum Flow Rate Fraction
  48557        \type real
  48558        \default 0.2
  48559        \minimum 0.0
  48560        \maximum 1.0
  48561   N3 , \field Design Pressure Rise
  48562        \type real
  48563        \minimum> 0.0
  48564        \units Pa
  48565        \ip-units inH2O
  48566        \required-field
  48567   N4 , \field Motor Efficiency
  48568        \type real
  48569        \default 0.9
  48570        \minimum> 0.0
  48571        \maximum 1.0
  48572   N5 , \field Motor In Air Stream Fraction
  48573        \note 0.0 means fan motor outside of air stream, 1.0 means motor inside of air stream
  48574        \type real
  48575        \default 1.0
  48576        \minimum 0.0
  48577        \maximum 1.0
  48578   N6 , \field Design Electric Power Consumption
  48579        \type real
  48580        \units W
  48581        \autosizable
  48582        \default autosize
  48583        \note Fan power consumption at maximum air flow rate.
  48584        \note If autosized the method used to scale power is chosen in the following field
  48585   A6 , \field Design Power Sizing Method
  48586        \type choice
  48587        \key PowerPerFlow
  48588        \key PowerPerFlowPerPressure
  48589        \key TotalEfficiencyAndPressure
  48590        \default PowerPerFlowPerPressure
  48591   N7 , \field Electric Power Per Unit Flow Rate
  48592        \type real
  48593        \units W/(m3/s)
  48594        \ip-units W/(ft3/min)
  48595   N8 , \field Electric Power Per Unit Flow Rate Per Unit Pressure
  48596        \type real
  48597        \units W/((m3/s)-Pa)
  48598        \ip-units W/((ft3/min)-inH2O)
  48599        \default 1.66667
  48600   N9,  \field Fan Total Efficiency
  48601        \type real
  48602        \default 0.7
  48603        \minimum> 0.0
  48604        \maximum 1.0
  48605   A7 , \field Electric Power Function of Flow Fraction Curve Name
  48606        \note independent variable is normalized flow rate, current flow divided by Design Maximum Air Flow Rate.
  48607        \note dependent variable is modification factor multiplied by Design Power Consumption.
  48608        \note This field is required if Speed Control Method is set to Continuous or if the Number of Speeds is greater than 1 and Speed Electric Power Fraction fields are not used.
  48609        \type object-list
  48610        \object-list UnivariateFunctions
  48611   N10, \field Night Ventilation Mode Pressure Rise
  48612        \note Total system fan pressure rise at the fan when in night mode using AvailabilityManager:NightVentilation
  48613        \type real
  48614        \units Pa
  48615        \ip-units inH2O
  48616   N11, \field Night Ventilation Mode Flow Fraction
  48617        \note Fraction of Design Maximum Air Flow Rate to use when in night mode using AvailabilityManager:NightVentilation
  48618        \type real
  48619        \minimum 0.0
  48620        \maximum 1.0
  48621   A8 , \field Motor Loss Zone Name
  48622         \note optional, if used fan motor heat losses that not added to air stream are transferred to zone as internal gains
  48623         \type object-list
  48624         \object-list ZoneNames
  48625   N12, \field Motor Loss Radiative Fraction
  48626         \note optional. If zone identified in previous field then this determines
  48627         \note the split between convection and radiation for the fan motor's skin losses
  48628         \type real
  48629         \minimum 0.0
  48630         \maximum 1.0
  48631   A9 , \field End-Use Subcategory
  48632        \note Any text may be used here to categorize the end-uses in the ABUPS End Uses by Subcategory table.
  48633        \type alpha
  48634        \retaincase
  48635        \default General
  48636   N13, \field Number of Speeds
  48637        \note number of different speed levels available when Speed Control Method is set to Discrete
  48638        \note Speed need to be arranged in increasing order in remaining field sets.
  48639        \note If set to 1, or omitted, and Speed Control Method is Discrete then constant fan speed is the design maximum.
  48640        \type integer
  48641        \default 1

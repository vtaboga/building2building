  26296       \memo Packaged Terminal Air Conditioner
  26297   A1, \field Zone Name
  26298       \required-field
  26299       \note Zone name must match a building zone name
  26300       \type object-list
  26301       \object-list ZoneNames
  26302   A2, \field Template Thermostat Name
  26303       \note Enter the name of a HVACTemplate:Thermostat object.
  26304       \note If blank, then it is assumed that standard thermostat objects
  26305       \note have been defined for this zone.
  26306       \type object-list
  26307       \object-list CompactHVACThermostats
  26308   N1, \field Cooling Supply Air Flow Rate
  26309       \note Supply air flow rate during cooling operation
  26310       \note This field may be set to "autosize".  If a value is entered, it will be
  26311       \note multiplied by the Supply Air Sizing Factor and by zone multipliers.
  26312       \type real
  26313       \minimum> 0.0
  26314       \autosizable
  26315       \default autosize
  26316       \units m3/s
  26317   N2, \field Heating Supply Air Flow Rate
  26318       \note Supply air flow rate during heating operation
  26319       \note This field may be set to "autosize".  If a value is entered, it will be
  26320       \note multiplied by the Supply Air Sizing Factor and by zone multipliers.
  26321       \type real
  26322       \minimum> 0.0
  26323       \autosizable
  26324       \default autosize
  26325       \units m3/s
  26326   N3, \field No Load Supply Air Flow Rate
  26327       \note Supply air flow rate when no cooling or heating is needed
  26328       \note Only used when heat pump fan operating mode is continuous. This air flow rate
  26329       \note is used when no heating or cooling is required and the DX coil compressor is off.
  26330       \note If this field is left blank or zero, the supply air flow rate from the previous on cycle
  26331       \note (either cooling or heating) is used.
  26332       \note A value entered in this field will *not* be multiplied by the sizing factor or
  26333       \note by zone multipliers.  It is best to autosize or leave blank when using zone multipliers.
  26334       \type real
  26335       \minimum 0
  26336       \autosizable
  26337       \units m3/s
  26338   N4, \field Zone Heating Sizing Factor
  26339       \note If blank, value from Sizing:Parameters will be used.
  26340       \minimum 0
  26341   N5, \field Zone Cooling Sizing Factor
  26342       \note If blank, value from Sizing:Parameters will be used.
  26343       \minimum 0
  26344   A3, \field Outdoor Air Method
  26345       \note Flow/Person, Flow/Zone, Flow/Area, Sum, and Maximum use the values in the next three
  26346       \note fields: Outdoor Air Flow Rate per Person, Outdoor Air Flow Rate per Zone Floor Area,
  26347       \note and Outdoor Air Flow Rate per Zone.
  26348       \note DetailedSpecification ignores these three Outdoor Air Flow Rate fields and instead
  26349       \note references design specification objects named in the fields
  26350       \note Design Specification Outdoor Air Object Name and Design Specification Zone Air
  26351       \note Distribution Object Name.
  26352       \type choice
  26353       \key Flow/Person
  26354       \key Flow/Zone
  26355       \key Flow/Area
  26356       \key Sum
  26357       \key Maximum
  26358       \key DetailedSpecification
  26359       \default Flow/Person
  26360   N6, \field Outdoor Air Flow Rate per Person
  26361       \units m3/s
  26362       \note Default 0.00944 is 20 cfm per person
  26363       \note This input is used if the field Outdoor Air Method is
  26364       \note Flow/Person, Sum, or Maximum
  26365       \default 0.00944
  26366   N7, \field Outdoor Air Flow Rate per Zone Floor Area
  26367       \units m3/s-m2
  26368       \default 0.0
  26369       \note This input is used if the field Outdoor Air Method is
  26370       \note Flow/Area, Sum, or Maximum
  26371   N8, \field Outdoor Air Flow Rate per Zone
  26372       \type real
  26373       \units m3/s
  26374       \default 0.0
  26375       \note This input is used if the field Outdoor Air Method is
  26376       \note Flow/Zone, Sum, or Maximum

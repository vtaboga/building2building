  10914 
  10915 Wall:Detailed,
  10916   \memo Allows for detailed entry of wall heat transfer surfaces.
  10917   \extensible:3 -- duplicate last set of x,y,z coordinates (last 3 fields), remembering to remove ; from "inner" fields.
  10918   \format vertices
  10919   \min-fields 18
  10920   A1 , \field Name
  10921        \required-field
  10922        \type alpha
  10923        \reference SurfaceNames
  10924        \reference SurfAndSubSurfNames
  10925        \reference AllHeatTranSurfNames
  10926        \reference OutFaceEnvNames
  10927        \reference AllHeatTranAngFacNames
  10928        \reference RadiantSurfaceNames
  10929        \reference AllShadingAndHTSurfNames
  10930   A2 , \field Construction Name
  10931        \required-field
  10932        \note To be matched with a construction in this input file
  10933        \type object-list
  10934        \object-list ConstructionNames
  10935   A3 , \field Zone Name
  10936        \required-field
  10937        \note Zone the surface is a part of
  10938        \type object-list
  10939        \object-list ZoneNames
  10940   A4 , \field Outside Boundary Condition
  10941        \required-field
  10942        \type choice
  10943        \key Adiabatic
  10944        \key Surface
  10945        \key Zone
  10946        \key Outdoors
  10947        \key Foundation
  10948        \key Ground
  10949        \key GroundFCfactorMethod
  10950        \key OtherSideCoefficients
  10951        \key OtherSideConditionsModel
  10952        \key GroundSlabPreprocessorAverage
  10953        \key GroundSlabPreprocessorCore
  10954        \key GroundSlabPreprocessorPerimeter
  10955        \key GroundBasementPreprocessorAverageWall
  10956        \key GroundBasementPreprocessorAverageFloor
  10957        \key GroundBasementPreprocessorUpperWall
  10958        \key GroundBasementPreprocessorLowerWall
  10959   A5,  \field Outside Boundary Condition Object
  10960        \type object-list
  10961        \object-list OutFaceEnvNames
  10962        \note Non-blank only if the field Outside Boundary Condition is Surface,
  10963        \note Zone, OtherSideCoefficients or OtherSideConditionsModel
  10964        \note If Surface, specify name of corresponding surface in adjacent zone or
  10965        \note specify current surface name for internal partition separating like zones
  10966        \note If Zone, specify the name of the corresponding zone and
  10967        \note the program will generate the corresponding interzone surface
  10968        \note If Foundation, specify the name of the corresponding Foundation object and
  10969        \note If OtherSideCoefficients, specify name of SurfaceProperty:OtherSideCoefficients
  10970        \note If OtherSideConditionsModel, specify name of SurfaceProperty:OtherSideConditionsModel
  10971   A6 , \field Sun Exposure
  10972        \type choice
  10973        \key SunExposed
  10974        \key NoSun
  10975        \default SunExposed
  10976   A7,  \field Wind Exposure
  10977        \type choice
  10978        \key WindExposed
  10979        \key NoWind
  10980        \default WindExposed
  10981   N1,  \field View Factor to Ground
  10982        \type real
  10983        \note From the exterior of the surface
  10984        \note Unused if one uses the "reflections" options in Solar Distribution in Building input
  10985        \note unless a DaylightingDevice:Shelf or DaylightingDevice:Tubular object has been specified.
  10986        \note autocalculate will automatically calculate this value from the tilt of the surface
  10987        \autocalculatable
  10988        \minimum 0.0
  10989        \maximum 1.0
  10990        \default autocalculate

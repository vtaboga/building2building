  24128       \note Enter the air mass flow exponent for the surface crack.
  24129  A2 ; \field Reference Crack Conditions
  24130       \type object-list
  24131       \object-list ReferenceCrackConditions
  24132       \note Select a AirflowNetwork:MultiZone:ReferenceCrackConditions name associated with
  24133       \note the air mass flow coefficient entered above.
  24134 
  24135 AirflowNetwork:MultiZone:Surface:EffectiveLeakageArea,
  24136       \min-fields 5
  24137       \memo This object is used to define surface air leakage.
  24138  A1 , \field Name
  24139       \required-field
  24140       \type alpha
  24141       \reference SurfaceAirflowLeakageNames
  24142       \note Enter a unique name for this object.
  24143  N1 , \field Effective Leakage Area
  24144       \required-field
  24145       \type real
  24146       \units m2
  24147       \minimum> 0
  24148       \note Enter the effective leakage area.
  24149  N2 , \field Discharge Coefficient
  24150       \type real
  24151       \units dimensionless
  24152       \minimum> 0
  24153       \default 1.0
  24154       \note Enter the coefficient used in the air mass flow equation.
  24155  N3 , \field Reference Pressure Difference
  24156       \type real
  24157       \units Pa
  24158       \minimum> 0
  24159       \default 4.0
  24160       \note Enter the pressure difference used to define the air mass flow coefficient and exponent.
  24161  N4 ; \field Air Mass Flow Exponent
  24162       \units dimensionless

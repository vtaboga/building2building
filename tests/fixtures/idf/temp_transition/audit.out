  25611  A3 , \field Zone Name
  25612       \required-field
  25613       \type object-list
  25614       \object-list AirFlowNetworkMultizoneZones
  25615       \note Enter the name of a zone object defined in a AirflowNetwork:MultiZone:Zone
  25616       \note object.
  25617  N1 ; \field Node Height
  25618       \type real
  25619       \units m
  25620       \default 0.0
  25621       \note Enter the reference height used to calculate the relative pressure
  25622 
  25623 AirflowNetwork:IntraZone:Linkage,
  25624       \min-fields 4
  25625       \memo This object defines the connection between two nodes and a component used
  25626       \memo in the combination of RoomAir and AirflowNetwork model.
  25627  A1 , \field Name
  25628       \required-field
  25629       \type alpha
  25630       \note Enter a unique name for this object.
  25631       \reference AirflowNetwork LinkageNames
  25632  A2 , \field Node 1 Name
  25633       \required-field
  25634       \type alpha
  25635       \object-list AirflowNetworkNodeNames
  25636       \object-list ZoneNames
  25637       \note Enter the name of zone or AirflowNetwork Node.
  25638  A3 , \field Node 2 Name
  25639       \required-field
  25640       \type alpha
  25641       \object-list AirflowNetworkNodeNames
  25642       \object-list ZoneNames
  25643       \note Enter the name of zone or AirflowNetwork Node.
  25644  A4 , \field Component Name
  25645       \type object-list
  25646       \object-list AirflowNetworkComponentNames
  25647       \note Enter the name of an AirflowNetwork component. A component is one of the
  25648       \note following AirflowNetwork:Multizone:Component objects:
  25649       \note AirflowNetwork:MultiZone:Surface:Crack,
  25650       \note AirflowNetwork:MultiZone:Surface:EffectiveLeakageArea,
  25651       \note If the next field is specified, this field can be either blank or ignored.
  25652  A5 ; \field AirflowNetwork:MultiZone:Surface Name
  25653       \type object-list
  25654       \object-list SurfAndSubSurfNames
  25655       \note Only used when one of two nodes defined above are not located in the same zone, and
  25656       \note the input of the Component Name field in this object is ignored
  25657 
  25658 \group Exterior Equipment

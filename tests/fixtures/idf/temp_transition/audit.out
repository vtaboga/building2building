  77787 \group Plant-Condenser Loops
  77788 !*****************PLANT AND CONDENSER LOOP SPECIFICATION*********************
  77789 !Plant and condenser loops are specified as follows:
  77790 
  77791 PlantLoop,
  77792        \memo Defines a central plant loop.
  77793        \min-fields 18
  77794   A1 , \field Name
  77795         \required-field
  77796        \reference PlantLoops
  77797   A2 , \field Fluid Type
  77798         \type choice
  77799         \key Water
  77800         \key Steam
  77801         \key UserDefinedFluidType
  77802         \default Water
  77803   A3 , \field User Defined Fluid Type
  77804        \type object-list
  77805        \object-list FluidAndGlycolNames
  77806        \note This field is only required when Fluid Type is UserDefinedFluidType
  77807   A4 , \field Plant Equipment Operation Scheme Name
  77808         \required-field
  77809         \type object-list
  77810         \object-list PlantOperationSchemes
  77811   A5 , \field Loop Temperature Setpoint Node Name
  77812         \required-field
  77813        \type node
  77814   N1 , \field Maximum Loop Temperature
  77815         \required-field
  77816         \units C
  77817   N2 , \field Minimum Loop Temperature
  77818         \required-field
  77819         \units C
  77820   N3 , \field Maximum Loop Flow Rate
  77821         \required-field
  77822         \type real
  77823         \units m3/s
  77824         \autosizable
  77825         \minimum 0
  77826         \ip-units gal/min
  77827   N4 , \field Minimum Loop Flow Rate
  77828         \type real
  77829         \units m3/s
  77830         \default 0.0
  77831         \ip-units gal/min
  77832   N5 , \field Plant Loop Volume
  77833         \type real
  77834         \units m3
  77835         \autocalculatable
  77836         \minimum 0.0
  77837         \default Autocalculate
  77838         \ip-units gal
  77839   A6,  \field Plant Side Inlet Node Name
  77840         \required-field
  77841         \type node
  77842   A7,  \field Plant Side Outlet Node Name
  77843         \required-field
  77844         \type node
  77845   A8,  \field Plant Side Branch List Name
  77846         \required-field
  77847         \type object-list
  77848         \object-list BranchLists
  77849   A9,  \field Plant Side Connector List Name
  77850         \type object-list
  77851         \object-list ConnectorLists
  77852   A10, \field Demand Side Inlet Node Name
  77853         \required-field
  77854         \type node
  77855   A11, \field Demand Side Outlet Node Name
  77856         \required-field
  77857         \type node
  77858   A12, \field Demand Side Branch List Name
  77859         \required-field
  77860         \type object-list
  77861         \object-list BranchLists
  77862   A13, \field Demand Side Connector List Name
  77863         \type object-list
  77864         \object-list ConnectorLists
  77865   A14, \field Load Distribution Scheme
  77866         \type choice
  77867         \key Optimal
  77868         \key SequentialLoad
  77869         \key UniformLoad
  77870         \key UniformPLR
  77871         \key SequentialUniformPLR
  77872         \default SequentialLoad
  77873   A15, \field Availability Manager List Name
  77874         \type object-list
  77875         \object-list SystemAvailabilityManagerLists
  77876   A16, \field Plant Loop Demand Calculation Scheme
  77877         \type choice
  77878         \key SingleSetpoint
  77879         \key DualSetpointDeadband
  77880         \default SingleSetpoint
  77881   A17,  \field Common Pipe Simulation
  77882         \note Specifies a primary-secondary loop configuration. The plant side is the
  77883         \note primary loop, and the demand side is the secondary loop.
  77884         \note A secondary supply pump is required on the demand side.
  77885         \note None = Primary-only, no secondary simulation
  77886         \note CommonPipe = Primary-secondary with no temperature control at primary-secondary interface
  77887         \note TwoWayCommonPipe = Primary-secondary with control of secondary supply temperature or
  77888         \note primary return temperature (requires a setpoint be placed on the
  77889         \note plant side or demand side inlet node).
  77890         \type choice
  77891         \key CommonPipe
  77892         \key TwoWayCommonPipe
  77893         \key None
  77894         \default None
  77895   A18,  \field Pressure Simulation Type
  77896         \type choice
  77897         \key PumpPowerCorrection
  77898         \key LoopFlowCorrection
  77899         \key None
  77900         \default None
  77901    N6;  \field Loop Circulation Time
  77902         \note This field is only used to autocalulate the Plant Loop Volume.
  77903         \note Loop Volume = Loop Circulation Time * Maximum Loop Flow Rate
  77904         \type real
  77905         \units minutes
  77906         \minimum 0.0
  77907         \default 2.0
  77908 
  77909 CondenserLoop,
  77910        \memo Defines a central plant condenser loop. CondenserLoop and PlantLoop are nearly
  77911        \memo identical except some components and operation schemes are applicable to only one
  77912        \memo loop type or the other.
  77913        \min-fields 18
  77914   A1 , \field Name
  77915         \required-field
  77916         \reference PlantLoops
  77917   A2 , \field Fluid Type
  77918         \type choice
  77919         \key Water
  77920         \key UserDefinedFluidType
  77921         \default Water
  77922   A3 , \field User Defined Fluid Type
  77923        \type object-list
  77924        \object-list FluidAndGlycolNames
  77925        \note This field is only required when Fluid Type is UserDefinedFluidType
  77926   A4 , \field Condenser Equipment Operation Scheme Name
  77927         \required-field
  77928         \type object-list
  77929         \object-list CondenserOperationSchemes
  77930   A5 , \field Condenser Loop Temperature Setpoint Node Name
  77931         \required-field
  77932         \type node
  77933   N1 , \field Maximum Loop Temperature
  77934         \required-field
  77935         \units C
  77936   N2 , \field Minimum Loop Temperature
  77937         \required-field
  77938         \units C
  77939   N3 , \field Maximum Loop Flow Rate
  77940         \type real
  77941         \required-field
  77942         \units m3/s
  77943         \autosizable
  77944         \minimum> 0.0
  77945         \ip-units gal/min
  77946   N4 , \field Minimum Loop Flow Rate
  77947         \type real
  77948         \units m3/s
  77949         \default 0.0
  77950         \ip-units gal/min
  77951   N5,  \field Condenser Loop Volume
  77952         \type real
  77953         \units m3
  77954         \autocalculatable
  77955         \default Autocalculate
  77956         \minimum 0.0
  77957         \ip-units gal
  77958   A6,  \field Condenser Side Inlet Node Name
  77959         \required-field
  77960         \type node
  77961   A7,  \field Condenser Side Outlet Node Name
  77962         \required-field
  77963         \type node
  77964   A8,  \field Condenser Side Branch List Name
  77965         \required-field
  77966         \type object-list
  77967         \object-list BranchLists
  77968   A9,  \field Condenser Side Connector List Name
  77969         \required-field
  77970         \type object-list
  77971         \object-list ConnectorLists
  77972   A10, \field Demand Side Inlet Node Name
  77973         \required-field
  77974         \type node
  77975   A11, \field Demand Side Outlet Node Name
  77976         \required-field
  77977         \type node
  77978   A12, \field Condenser Demand Side Branch List Name
  77979         \required-field
  77980         \type object-list
  77981         \object-list BranchLists
  77982   A13, \field Condenser Demand Side Connector List Name
  77983         \required-field
  77984         \type object-list
  77985         \object-list ConnectorLists
  77986   A14, \field Load Distribution Scheme
  77987         \type choice
  77988         \key Optimal
  77989         \key SequentialLoad
  77990         \key UniformLoad
  77991         \key UniformPLR
  77992         \key SequentialUniformPLR
  77993         \default SequentialLoad
  77994   A15, \field Pressure Simulation Type
  77995         \type choice
  77996         \key PumpPowerCorrection
  77997         \key LoopFlowCorrection
  77998         \key None
  77999         \default None
  78000    N6;  \field Loop Circulation Time
  78001         \note This field is only used to autocalulate the Condenser Loop Volume.
  78002         \note Loop Volume = Loop Circulation Time * Maximum Loop Flow Rate
  78003         \type real
  78004         \units minutes
  78005         \minimum 0.0
  78006         \default 2.0

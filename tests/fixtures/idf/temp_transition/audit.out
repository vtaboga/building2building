  29161       \type real
  29162       \units W
  29163       \minimum> 0.0
  29164       \autosizable
  29165       \default autosize
  29166  N14, \field Heat Pump Heating Coil Rated COP
  29167       \note Heat Pump Heating Coil Rated Capacity divided by power input to the compressor and outdoor fan,
  29168       \note does not include supply air fan heat or supply air fan electrical energy.
  29169       \note Rating point outdoor dry-bulb temp 8.33 C, outdoor wet-bulb temp 6.11 C
  29170       \note Rating point heating coil entering air dry-bulb 21.11 C, coil entering wet-bulb 15.55 C
  29171       \units W/W
  29172       \minimum> 0.0
  29173       \default 2.75

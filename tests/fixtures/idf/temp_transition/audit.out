  22338        \required-field
  22339        \units m
  22340        \type real
  22341        \minimum> 0
  22342   N3 , \field Effective Thermal Resistance
  22343        \note R value between TubularDaylightDome and TubularDaylightDiffuser
  22344        \units m2-K/W
  22345        \type real
  22346        \minimum> 0
  22347        \default 0.28

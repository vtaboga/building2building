   2384       \key Default
   2385       \key UserDefined
   2386       \default Default
   2387   A3, \field Solar Spectrum Data Object Name
   2388       \type object-list
   2389       \object-list SpectrumDataNames
   2390   A4; \field Visible Spectrum Data Object Name
   2391       \type object-list
   2392       \object-list SpectrumDataNames
   2393 

  69675 !*****************PLANT EQUIPMENT*********************
  69676 !KEY--Plant Equipment:  The following types are used to specify
  69677 !                  equipment connected to the supply side of
  69678 !                  the supply side of the plant loop.  Note
  69679 !                  that at least one inlet and outlet node
  69680 !                  must be specified for each node
  69681 !  CLASS of the following comes first (naming convention) separated further by :
  69682 
  69683 \group Plant Heating and Cooling Equipment
  69684 
  69685 Boiler:HotWater,
  69686     \min-fields 12
  69687        \memo This boiler model is an adaptation of the empirical model from the Building
  69688        \memo Loads and System Thermodynamics (BLAST) program.  Boiler performance
  69689        \memo curves are generated by fitting catalog data to polynomial equations.
  69690        \memo A constant efficiency boiler may be modeled by leaving the normalized
  69691        \memo boiler efficiency curve name input blank.
  69692   A1 , \field Name
  69693        \required-field
  69694        \type alpha
  69695        \reference Boilers
  69696        \reference-class-name validPlantEquipmentTypes
  69697        \reference validPlantEquipmentNames
  69698        \reference-class-name validBranchEquipmentTypes
  69699        \reference validBranchEquipmentNames
  69700   A2 , \field Fuel Type
  69701        \required-field
  69702        \type choice
  69703        \key Electricity
  69704        \key NaturalGas
  69705        \key Propane
  69706        \key FuelOilNo1
  69707        \key FuelOilNo2
  69708        \key Coal
  69709        \key Diesel
  69710        \key Gasoline
  69711        \key OtherFuel1
  69712        \key OtherFuel2
  69713   N1 , \field Nominal Capacity
  69714        \type real
  69715        \units W
  69716        \autosizable
  69717        \minimum 0.0
  69718   N2 , \field Nominal Thermal Efficiency
  69719        \required-field
  69720        \type real
  69721        \minimum> 0.0
  69722        \maximum 1.0
  69723        \note Based on the higher heating value of fuel.
  69724   A3 , \field Efficiency Curve Temperature Evaluation Variable
  69725        \type choice
  69726        \key EnteringBoiler
  69727        \key LeavingBoiler
  69728   A4 , \field Normalized Boiler Efficiency Curve Name
  69729        \type object-list
  69730        \object-list UnivariateFunctions
  69731        \object-list BivariateFunctions
  69732        \note Linear, Quadratic and Cubic efficiency curves are solely a function of PLR.
  69733        \note All other efficiency curve types are a function of PLR and boiler water temperature.
  69734        \note Linear = C1 + C2*PLR
  69735        \note Quadratic = C1 + C2*PLR + C3*PLR^2
  69736        \note Cubic = C1 + C2*PLR + C3*PLR^2 + C4*PLR^3
  69737        \note Biquadratic = C1 + C2*PLR + C3*PLR^2 + C4*T + C5*T^2 + C6*PLR*T
  69738        \note QuadraticLinear = C1 + C2*PLR + C3*PLR^2 + (C4 + C5*PLR + C6*PLR^2)*T
  69739        \note BiCubic = C1+C2*PLR+C3*PLR^2+C4*T+C5*T^2+C6*PLR*T+C7*PLR^3+C8*T^3+C9*PLR^2*T+C10*PLR*T^2
  69740        \note TriQuadratic curves are not allowed.
  69741        \note PLR = part-load ratio
  69742        \note T = boiler water temperature (either entering or leaving).
  69743   N3 , \field Design Water Flow Rate
  69744        \type real
  69745        \units m3/s
  69746        \autosizable
  69747        \ip-units gal/min
  69748        \minimum 0.0
  69749        \default autosize
  69750   N4 , \field Minimum Part Load Ratio
  69751        \type real
  69752        \minimum 0.0
  69753        \default 0.0
  69754   N5 , \field Maximum Part Load Ratio
  69755        \type real
  69756        \minimum 0.0
  69757        \default 1.0
  69758   N6 , \field Optimum Part Load Ratio
  69759        \type real
  69760        \minimum 0.0
  69761        \default 1.0
  69762   A5 , \field Boiler Water Inlet Node Name
  69763        \required-field
  69764        \type node
  69765   A6 , \field Boiler Water Outlet Node Name
  69766        \required-field
  69767        \type node
  69768   N7 , \field Water Outlet Upper Temperature Limit
  69769        \type real
  69770        \units C
  69771        \default 99.9
  69772   A7 , \field Boiler Flow Mode
  69773        \note Select operating mode for fluid flow through the boiler. "NotModulated" is for
  69774        \note either variable or constant pumping with flow controlled by the external plant system.
  69775        \note "ConstantFlow" is for constant pumping with flow controlled by boiler to operate at
  69776        \note full design flow rate.  "LeavingSetpointModulated" is for variable pumping with flow
  69777        \note controlled by boiler to vary flow to target a leaving temperature setpoint.
  69778        \type choice
  69779        \key ConstantFlow
  69780        \key LeavingSetpointModulated
  69781        \key NotModulated
  69782        \default NotModulated
  69783   N8 , \field Parasitic Electric Load
  69784        \type real
  69785        \units W
  69786        \minimum 0.0
  69787        \default 0.0
  69788   N9, \field Sizing Factor
  69789        \note Multiplies the autosized capacity and flow rates
  69790        \type real
  69791        \minimum> 0.0
  69792        \default 1.0
  69793   A8 ; \field End-Use Subcategory
  69794        \note Any text may be used here to categorize the end-uses in the ABUPS End Uses by Subcategory table.
  69795        \type alpha
  69796        \retaincase
  69797        \default General
  69798 
  69799 Boiler:Steam,
  69800        \memo This boiler model is an adaptation of the empirical model from the Building
  69801        \memo Loads and System Thermodynamics (BLAST) program.  Boiler performance
  69802        \memo curves are generated by fitting catalog data to third order
  69803        \memo polynomial equations.  A constant efficiency boiler is modeled by setting
  69804        \memo the fuel use coefficients as follows: N9=1, N10=0, N11=0
  69805   A1 , \field Name
  69806        \required-field
  69807        \reference-class-name validPlantEquipmentTypes
  69808        \reference validPlantEquipmentNames
  69809        \reference-class-name validBranchEquipmentTypes
  69810        \reference validBranchEquipmentNames
  69811   A2 , \field Fuel Type
  69812        \required-field
  69813        \type choice
  69814        \key Electricity
  69815        \key NaturalGas
  69816        \key Propane
  69817        \key FuelOilNo1
  69818        \key FuelOilNo2
  69819        \key Coal
  69820        \key Diesel
  69821        \key Gasoline
  69822        \key OtherFuel1
  69823        \key OtherFuel2
  69824   N1 , \field Maximum Operating Pressure
  69825        \required-field
  69826        \units Pa
  69827        \default 160000
  69828   N2 , \field Theoretical Efficiency
  69829        \required-field
  69830        \type real
  69831        \minimum> 0.0
  69832        \maximum 1.0
  69833        \default 0.8
  69834   N3 , \field Design Outlet Steam Temperature
  69835        \required-field
  69836        \units C
  69837        \default 100
  69838   N4 , \field Nominal Capacity
  69839        \units W
  69840        \autosizable
  69841   N5 , \field Minimum Part Load Ratio
  69842        \minimum 0.0
  69843   N6 , \field Maximum Part Load Ratio
  69844        \minimum 0.0
  69845   N7 , \field Optimum Part Load Ratio
  69846        \minimum 0.0
  69847   N8 , \field Coefficient 1 of Fuel Use Function of Part Load Ratio Curve
  69848   N9 , \field Coefficient 2 of Fuel Use Function of Part Load Ratio Curve
  69849   N10, \field Coefficient 3 of Fuel Use Function of Part Load Ratio Curve
  69850   A3 , \field Water Inlet Node Name
  69851        \type node
  69852   A4 , \field Steam Outlet Node Name
  69853        \type node
  69854   N11, \field Sizing Factor
  69855        \note Multiplies the autosized capacity and flow rates
  69856        \type real
  69857        \minimum> 0.0
  69858        \default 1.0
  69859   A5 ; \field End-Use Subcategory
  69860        \note Any text may be used here to categorize the end-uses in the ABUPS End Uses by Subcategory table.
  69861        \type alpha
  69862        \retaincase
  69863        \default General
  69864 
  69865 Chiller:Electric:EIR,
  69866 \min-fields 23
  69867    \memo This chiller model is the empirical model from the DOE-2 building Energy
  69868    \memo simulation program. Chiller performance at off-reference conditions is modeled
  69869    \memo using three polynomial equations. Three curves objects are required.
  69870   A1 , \field Name
  69871        \type alpha
  69872        \reference Chillers
  69873        \required-field
  69874        \reference-class-name validPlantEquipmentTypes
  69875        \reference validPlantEquipmentNames
  69876        \reference-class-name validBranchEquipmentTypes
  69877        \reference validBranchEquipmentNames
  69878   N1 , \field Reference Capacity
  69879        \type real
  69880        \units W
  69881        \required-field
  69882        \minimum> 0.0
  69883        \autosizable
  69884   N2 , \field Reference COP
  69885        \note Efficiency of the chiller compressor (cooling output/compressor energy input).
  69886        \note Condenser fan power should not be included here.
  69887        \type real
  69888        \units W/W
  69889        \required-field
  69890        \minimum> 0.0
  69891   N3 , \field Reference Leaving Chilled Water Temperature
  69892        \type real
  69893        \default 6.67
  69894        \units C
  69895   N4 , \field Reference Entering Condenser Fluid Temperature
  69896        \type real
  69897        \default 29.4
  69898        \units C
  69899   N5 , \field Reference Chilled Water Flow Rate
  69900        \type real
  69901        \units m3/s
  69902        \minimum> 0
  69903        \autosizable
  69904        \ip-units gal/min
  69905   N6 , \field Reference Condenser Fluid Flow Rate
  69906        \type real
  69907        \units m3/s
  69908        \autosizable
  69909        \minimum 0.0
  69910        \ip-units gal/min
  69911        \note This field is only used for Condenser Type = AirCooled or EvaporativelyCooled
  69912        \note when Heat Recovery is specified
  69913   A2 , \field Cooling Capacity Function of Temperature Curve Name
  69914        \note Cooling capacity as a function of CW supply temp and entering condenser temp
  69915        \required-field
  69916        \type object-list
  69917        \object-list BivariateFunctions
  69918        \note curve = a + b*CWS + c*CWS**2 + d*ECT + e*ECT**2 + f*CWS*ECT
  69919        \note CWS = supply (leaving) chilled water temperature(C)
  69920        \note ECT = entering condenser fluid temperature(C)
  69921   A3 , \field Electric Input to Cooling Output Ratio Function of Temperature Curve Name
  69922        \note Electric Input Ratio (EIR) as a function of temperature
  69923        \note EIR = 1/COP
  69924        \required-field
  69925        \type object-list
  69926        \object-list BivariateFunctions
  69927        \note curve = a + b*CWS + c*CWS**2 + d*ECT + e*ECT**2 + f*CWS*ECT
  69928        \note CWS = supply (leaving) chilled water temperature(C)
  69929        \note ECT = entering condenser fluid temperature(C)
  69930   A4 , \field Electric Input to Cooling Output Ratio Function of Part Load Ratio Curve Name
  69931        \note Electric Input Ratio (EIR) as a function of Part Load Ratio (PLR)
  69932        \note EIR = 1/COP
  69933        \required-field
  69934        \type object-list
  69935        \object-list UnivariateFunctions
  69936        \note quadratic curve = a + b*PLR + c*PLR**2 is typical, other univariate curves may be used
  69937        \note PLR = part load ratio (cooling load/steady state capacity)
  69938   N7 , \field Minimum Part Load Ratio
  69939        \type real
  69940        \note Part load ratio below which the chiller starts cycling on/off to meet the load.
  69941        \note Must be less than or equal to Maximum Part Load Ratio.
  69942        \minimum 0.0
  69943        \default 0.1
  69944   N8 , \field Maximum Part Load Ratio
  69945        \type real
  69946        \note Maximum allowable part load ratio. Must be greater than or equal to Minimum Part Load Ratio.
  69947        \minimum> 0.0
  69948        \default 1.0
  69949   N9 , \field Optimum Part Load Ratio
  69950        \type real
  69951        \note Optimum part load ratio where the chiller is most efficient.
  69952        \note Must be greater than or equal to the Minimum Part Load Ratio
  69953        \note and less than or equal to the Maximum Part Load Ratio.
  69954        \minimum> 0.0
  69955        \default 1.0
  69956   N10, \field Minimum Unloading Ratio
  69957        \type real
  69958        \note Part load ratio where the chiller can no longer unload and false loading begins.
  69959        \note Minimum unloading ratio must be greater than or equal to the Minimum Part Load Ratio
  69960        \note and less than or equal to the Maximum Part Load Ratio.
  69961        \minimum 0.0
  69962        \default 0.2
  69963   A5 , \field Chilled Water Inlet Node Name
  69964        \type node
  69965        \required-field
  69966   A6 , \field Chilled Water Outlet Node Name
  69967        \type node
  69968        \required-field
  69969   A7 , \field Condenser Inlet Node Name
  69970        \type node
  69971        \note Not required if air-cooled or evaporatively-cooled
  69972   A8 , \field Condenser Outlet Node Name
  69973        \type node
  69974        \note Not required if air-cooled or evaporatively-cooled
  69975   A9 , \field Condenser Type
  69976        \type choice
  69977        \key AirCooled
  69978        \key WaterCooled
  69979        \key EvaporativelyCooled
  69980        \default WaterCooled
  69981   N11, \field Condenser Fan Power Ratio
  69982        \type real
  69983        \units W/W
  69984        \minimum 0.0
  69985        \default 0.0
  69986        \note Use for air-cooled or evaporatively-cooled condensers.
  69987        \note Ratio of condenser fan power to reference chiller capacity
  69988   N12, \field Fraction of Compressor Electric Consumption Rejected by Condenser
  69989        \type real
  69990        \note Fraction of compressor electrical energy that must be rejected by the condenser.
  69991        \note Enter a value of 1.0 when modeling hermetic chillers.
  69992        \note For open chillers, enter the compressor motor efficiency.
  69993        \note This value should be greater than 0.6 for practical applications.
  69994        \minimum> 0.0
  69995        \maximum 1.0
  69996        \default 1.0
  69997   N13, \field Leaving Chilled Water Lower Temperature Limit
  69998        \type real
  69999        \default 2.0
  70000        \units C
  70001   A10, \field Chiller Flow Mode
  70002        \note Select operating mode for fluid flow through the chiller. "NotModulated" is for
  70003        \note either variable or constant pumping with flow controlled by the external plant system.
  70004        \note "ConstantFlow" is for constant pumping with flow controlled by chiller to operate at
  70005        \note full design flow rate.  "LeavingSetpointModulated" is for variable pumping with flow
  70006        \note controlled by chiller to vary flow to target a leaving temperature setpoint.
  70007        \type choice
  70008        \key ConstantFlow
  70009        \key LeavingSetpointModulated
  70010        \key NotModulated
  70011        \default NotModulated
  70012   N14, \field Design Heat Recovery Water Flow Rate
  70013        \type real
  70014        \note If non-zero, then the heat recovery inlet and outlet node names must be entered.
  70015        \note Heat recovery is only available with Condenser Type = WaterCooled.
  70016        \units m3/s
  70017        \minimum 0.0
  70018        \default 0.0
  70019        \autosizable
  70020        \ip-units gal/min
  70021   A11, \field Heat Recovery Inlet Node Name
  70022        \type node
  70023   A12, \field Heat Recovery Outlet Node Name
  70024        \type node

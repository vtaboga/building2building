  62624        \note This field is used if Refrigerant Temperature Control Algorithm
  62625        \note is VariableTemp
  62626        \note Condensing temperature is the refrigerant temperature, not air temperature
  62627        \type real
  62628        \units C
  62629        \default 42.0

  81097    A3 , \field Model Setup and Sizing Program Calling Manager Name
  81098         \type object-list
  81099         \object-list ProgramNames
  81100    A4 , \field Primary Air Inlet Node Name
  81101         \required-field
  81102         \type node
  81103         \note Air inlet node for the unit must be a zone air exhaust Node.
  81104    A5 , \field Primary Air Outlet Node Name

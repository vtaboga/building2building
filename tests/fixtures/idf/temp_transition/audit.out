   6598        \maximum< 1
   6599        \minimum 0
   6600        \default 0
   6601   N6 , \field Back Side Slat Beam-Diffuse Solar Transmittance
   6602        \note The back side beam-diffuse solar transmittance of the slat at normal
   6603        \note incidence averaged over the entire spectrum of solar radiation.
   6604        \type real
   6605        \units dimensionless
   6606        \maximum< 1
   6607        \minimum 0
   6608        \default 0
   6609   N7,  \field Front Side Slat Beam-Diffuse Solar Reflectance
   6610        \note The front side beam-diffuse solar reflectance of the slat at normal
   6611        \note incidence averaged over the entire spectrum of solar radiation.
   6612        \required-field
   6613        \type real
   6614        \units dimensionless
   6615        \maximum< 1
   6616        \minimum 0
   6617   N8,  \field Back Side Slat Beam-Diffuse Solar Reflectance
   6618        \note The back side beam-diffuse solar reflectance of the slat at normal
   6619        \note incidence averaged over the entire spectrum of solar radiation.
   6620        \required-field
   6621        \type real
   6622        \units dimensionless
   6623        \maximum< 1
   6624        \minimum 0
   6625   N9 , \field Front Side Slat Beam-Diffuse Visible Transmittance
   6626        \note The front side beam-diffuse visible transmittance of the slat
   6627        \note at normal incidence averaged over the visible spectrum range
   6628        \note of solar radiation.
   6629        \type real
   6630        \units dimensionless
   6631        \maximum< 1
   6632        \minimum 0
   6633        \default 0
   6634   N10, \field Back Side Slat Beam-Diffuse Visible Transmittance
   6635        \note The back side beam-diffuse visible transmittance of the slat
   6636        \note at normal incidence averaged over the visible spectrum range
   6637        \note of solar radiation.
   6638        \type real
   6639        \units dimensionless
   6640        \maximum< 1
   6641        \minimum 0
   6642        \default 0
   6643   N11, \field Front Side Slat Beam-Diffuse Visible Reflectance
   6644        \note The front side beam-diffuse visible reflectance of the slat
   6645        \note at normal incidence averaged over the visible spectrum range
   6646        \note of solar radiation.
   6647        \type real
   6648        \units dimensionless
   6649        \maximum< 1
   6650        \minimum 0
   6651   N12, \field Back Side Slat Beam-Diffuse Visible Reflectance
   6652        \note The back side beam-diffuse visible reflectance of the slat
   6653        \note at normal incidence averaged over the visible spectrum range
   6654        \note of solar radiation.
   6655        \type real
   6656        \units dimensionless
   6657        \maximum< 1
   6658        \minimum 0

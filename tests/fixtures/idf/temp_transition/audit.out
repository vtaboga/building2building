  82287   N4 , \field Maximum Setpoint Humidity Ratio
  82288        \units kgWater/kgDryAir
  82289        \maximum 1.0
  82290        \default 1.0
  82291        \note Applicable only if Control variable is
  82292        \note MaximumHumidityRatio, MinimumHumidityRatio, or HumidityRatio - then minimum is 0.00001
  82293   A3 , \field Reference Setpoint Node Name
  82294        \type node
  82295        \note The current setpoint at this node is the
  82296        \note desired condition for the Mixed Air Node
  82297        \note This node must have a valid setpoint
  82298        \note which has been set by another setpoint manager
  82299   A4 , \field Mixed Air Stream Node Name
  82300        \type node
  82301        \note Name of Mixed Air Node
  82302        \required-field
  82303   A5 , \field Outdoor Air Stream Node Name
  82304        \type node
  82305        \note Name of Outdoor Air Stream Node
  82306        \required-field
  82307   A6 , \field Return Air Stream Node Name
  82308        \type node
  82309        \note Name of Return Air Stream Node
  82310        \required-field
  82311   A7 ; \field Setpoint Node or NodeList Name
  82312        \type node
  82313        \required-field
  82314        \note Node(s) at which the temperature or humidity
  82315        \note ratio will be set

  24478       \required-field
  24479       \type real
  24480       \units kg/s
  24481       \minimum> 0
  24482       \note Enter the air mass flow coefficient at the conditions defined
  24483       \note in the Reference Crack Conditions object.
  24484       \note Defined at 1 Pa pressure difference. Enter the coefficient used in the following
  24485       \note equation:

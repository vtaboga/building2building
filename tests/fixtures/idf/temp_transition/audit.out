  34254         \object-list ScheduleNames
  34255         \note Schedule values of 0 denote the unit is off.
  34256    A3 , \field Air Inlet Node Name
  34257         \required-field
  34258         \type node
  34259         \note Air inlet node for the PTAC must be a zone air exhaust Node.
  34260    A4 , \field Air Outlet Node Name
  34261         \required-field
  34262         \type node
  34263         \note Air outlet node for the PTAC must be a zone air inlet node.
  34264    A5,  \field Outdoor Air Mixer Object Type

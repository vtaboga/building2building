  71648         \default 1.0
  71649    A8,  \field Capacity Modifier Function of Temperature Curve Name
  71650         \note Cooling capacity modifier as a function of CW supply temp and entering condenser temp
  71651         \required-field
  71652         \type object-list
  71653         \object-list BivariateFunctions
  71654         \note curve = a + b*CWS + c*CWS**2 + d*ECT + e*ECT**2 + f*CWS*ECT
  71655         \note CWS = supply (leaving) chilled water temperature(C)
  71656         \note ECT = entering condenser fluid temperature(C)
  71657    A9,  \field Electric Input to Output Ratio Modifier Function of Temperature Curve Name
  71658         \note Electric Input Ratio (EIR) modifier as a function of temperature
  71659         \note EIR = 1/COP
  71660         \required-field
  71661         \type object-list
  71662         \object-list BivariateFunctions
  71663         \note curve = a + b*CWS + c*CWS**2 + d*ECT + e*ECT**2 + f*CWS*ECT
  71664         \note CWS = supply (leaving) chilled water temperature(C)
  71665         \note ECT = entering condenser fluid temperature(C)

  20068 
  20069 RoomAirSettings:ThreeNodeDisplacementVentilation,
  20070        \memo The UCSD model for Displacement Ventilation
  20071        \min-fields 6
  20072   A1 , \field Zone Name
  20073        \note Name of Zone being described. Any existing zone name
  20074        \required-field
  20075        \type object-list
  20076        \object-list ZoneNames
  20077   A2 , \field Gain Distribution Schedule Name
  20078        \note Distribution of the convective heat gains between the occupied and mixed zones.
  20079        \note 0<= Accepted Value <= 1.
  20080        \note In the DV model 1 means all convective gains in the lower layer.
  20081        \required-field
  20082        \type object-list
  20083        \object-list ScheduleNames
  20084   N1 , \field Number of Plumes per Occupant
  20085        \note Used only in the UCSD displacement ventilation model.
  20086        \note Effective number of separate plumes per occupant in the occupied zone.
  20087        \note Plumes that merge together in the occupied zone count as one.
  20088        \type real
  20089        \minimum> 0.0
  20090        \default 1.0
  20091   N2 , \field Thermostat Height
  20092        \note Height of thermostat/temperature control sensor above floor
  20093        \units m
  20094        \type real
  20095        \minimum> 0.0
  20096        \default 1.1
  20097   N3 , \field Comfort Height
  20098        \note Height at which air temperature is calculated for comfort purposes
  20099        \units m
  20100        \type real
  20101        \minimum> 0.0
  20102        \default 1.1
  20103   N4 ; \field Temperature Difference Threshold for Reporting
  20104        \note Minimum temperature difference between predicted upper and lower layer
  20105        \note temperatures above which DV auxiliary outputs are calculated.
  20106        \note These outputs are 'DV Transition Height', 'DV Fraction Min Recommended Flow Rate'
  20107        \note 'DV Average Temp Gradient' and 'DV Maximum Temp Gradient'.  They
  20108        \note are set to negative values when the temperature difference is less than the
  20109        \note threshold and the output 'DV Zone Is Mixed' is set to 1
  20110        \units deltaC
  20111        \type real
  20112        \minimum 0.0
  20113        \default 0.4
  20114 
  20115 RoomAirSettings:CrossVentilation,
  20116        \memo This UCSD Cross Ventilation Room Air Model provides a simple model for heat transfer
  20117        \memo and vertical temperature profile prediction in cross ventilated rooms. The model
  20118        \memo distinguishes two regions in the room, the main jet region and the recirculations,
  20119        \memo and predicts characteristic airflow velocities and average air temperatures.
  20120        \memo Used with RoomAirModelType = CrossVentilation.
  20121   A1 , \field Zone Name
  20122        \note Name of Zone being described. Any existing zone name
  20123        \required-field
  20124        \type object-list
  20125        \object-list ZoneNames
  20126   A2 , \field Gain Distribution Schedule Name
  20127        \note Distribution of the convective heat gains between the jet and recirculation zones.
  20128        \note 0<= Accepted Value <= 1.
  20129        \note In the CV model 1 means all convective gains in the jet region.
  20130        \required-field
  20131        \type object-list
  20132        \object-list ScheduleNames
  20133   A3 ; \field Airflow Region Used for Thermal Comfort Evaluation
  20134        \note Required field whenever thermal comfort is predicted
  20135        \note defines Air temperature and Airflow velocity that will be used in the Fanger model
  20136        \note conditions must refer to one of the two regions: jet or recirculation
  20137        \type choice
  20138        \key Jet
  20139        \key Recirculation
  20140 
  20141 RoomAirSettings:UnderFloorAirDistributionInterior,
  20142        \memo This Room Air Model is applicable to interior spaces that are served by an underfloor
  20143        \memo air distribution system. The dominant sources of heat gain should be from people,
  20144        \memo equipment, and other localized sources located in the occupied part of the room.
  20145        \memo The model should be used with caution in zones which have large heat gains or losses
  20146        \memo through exterior walls or windows or which have considerable direct solar gain.
  20147        \memo Used with RoomAirModelType = UnderFloorAirDistributionInterior.
  20148        \min-fields 15
  20149   A1 , \field Zone Name
  20150        \note Name of Zone with underfloor air distribution
  20151        \required-field
  20152        \type object-list
  20153        \object-list ZoneNames
  20154   N1 , \field Number of Diffusers
  20155        \note Total number of diffusers in this zone
  20156        \type real
  20157        \minimum> 0.0
  20158        \autocalculatable
  20159        \default autocalculate
  20160   N2 , \field Power per Plume
  20161        \type real
  20162        \minimum 0.0
  20163        \units W
  20164        \autocalculatable
  20165        \default autocalculate
  20166   N3 , \field Design Effective Area of Diffuser
  20167        \type real
  20168        \units m2
  20169        \minimum> 0.0
  20170        \autocalculatable
  20171        \default Autocalculate
  20172   N4 , \field Diffuser Slot Angle from Vertical
  20173        \type real
  20174        \units deg
  20175        \minimum 0.0
  20176        \maximum 90.
  20177        \autocalculatable
  20178        \default Autocalculate
  20179   N5 , \field Thermostat Height
  20180        \note Height of thermostat/temperature control sensor above floor
  20181        \units m
  20182        \type real
  20183        \minimum> 0.0
  20184        \default 1.2
  20185   N6 , \field Comfort Height
  20186        \note Height at which air temperature is calculated for comfort purposes
  20187        \units m
  20188        \type real
  20189        \minimum> 0.0
  20190        \default 1.1
  20191   N7 , \field Temperature Difference Threshold for Reporting
  20192        \note Minimum temperature difference between predicted upper and lower layer
  20193        \note temperatures above which UFAD auxiliary outputs are calculated.
  20194        \note These outputs are 'UF Transition Height' and 'UF Average Temp Gradient'.  They
  20195        \note are set to zero values when the temperature difference is less than the
  20196        \note threshold and the output 'UF Zone Is Mixed' is set to 1
  20197        \units deltaC
  20198        \type real
  20199        \minimum 0.0
  20200        \default 0.4
  20201   A2 , \field Floor Diffuser Type
  20202        \type choice
  20203        \key Custom
  20204        \key Swirl
  20205        \key VariableArea
  20206        \key HorizontalSwirl
  20207        \key LinearBarGrille
  20208        \default Swirl
  20209   N8 , \field Transition Height
  20210        \note user-specified height above floor of boundary between occupied and upper subzones
  20211        \type real
  20212        \units m
  20213        \minimum> 0.0
  20214        \autocalculatable
  20215        \default 1.7
  20216   N9,  \field Coefficient A
  20217        \note Coefficient A in Formula Kc = A*Gamma**B + C + D*Gamma + E*Gamma**2
  20218        \note Kc is the fraction of the total zone load attributable to the lower subzone
  20219        \type real
  20220        \autocalculatable
  20221        \default Autocalculate
  20222   N10, \field Coefficient B
  20223        \note Coefficient B in Formula Kc = A*Gamma**B + C + D*Gamma + E*Gamma**2
  20224        \note Kc is the fraction of the total zone load attributable to the lower subzone
  20225        \type real
  20226        \autocalculatable
  20227        \default Autocalculate
  20228   N11, \field Coefficient C
  20229        \note Coefficient C in Formula Kc = A*Gamma**B + C + D*Gamma + E*Gamma**2
  20230        \note Kc is the fraction of the total zone load attributable to the lower subzone
  20231        \type real
  20232        \autocalculatable
  20233        \default Autocalculate
  20234   N12, \field Coefficient D
  20235        \note Coefficient D in Formula Kc = A*Gamma**B + C + D*Gamma + E*Gamma**2
  20236        \note Kc is the fraction of the total zone load attributable to the lower subzone
  20237        \type real
  20238        \autocalculatable
  20239        \default Autocalculate
  20240   N13; \field Coefficient E
  20241        \note Coefficient E in Formula Kc = A*Gamma**B + C + D*Gamma + E*Gamma**2
  20242        \note Kc is the fraction of the total zone load attributable to the lower subzone
  20243        \type real
  20244        \autocalculatable
  20245        \default Autocalculate

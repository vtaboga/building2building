  71667         \note Electric Input Ratio (EIR) modifier as a function of Part Load Ratio (PLR)
  71668         \note EIR = 1/COP
  71669         \required-field
  71670         \type object-list
  71671         \object-list UniVariateFunctions
  71672         \note quadratic curve = a + b*PLR + c*PLR**2 is typical, other univariate curves may be used
  71673         \note PLR = part load ratio (cooling load/steady state capacity)
  71674 

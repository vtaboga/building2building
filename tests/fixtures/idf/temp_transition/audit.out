  44960 
  44961 ZoneHVAC:HighTemperatureRadiant,
  44962         \extensible:2 - repeat last two fields, remembering to remove ; from "inner" fields.
  44963         \memo The number of surfaces can be expanded beyond 100, if necessary, by adding more
  44964         \memo groups to the end of the list
  44965         \min-fields 14
  44966    A1,  \field Name
  44967         \required-field
  44968         \reference ZoneEquipmentNames
  44969    A2 , \field Availability Schedule Name
  44970         \note Availability schedule name for this system. Schedule value > 0 means the system is available.
  44971         \note If this field is blank, the system is always available.
  44972         \type object-list
  44973         \object-list ScheduleNames
  44974    A3 , \field Zone Name
  44975         \note Name of zone system is serving
  44976         \required-field
  44977         \type object-list
  44978         \object-list ZoneNames
  44979    A4 , \field Heating Design Capacity Method
  44980         \type choice
  44981         \key HeatingDesignCapacity
  44982         \key CapacityPerFloorArea
  44983         \key FractionOfAutosizedHeatingCapacity
  44984         \default HeatingDesignCapacity
  44985         \note Enter the method used to determine the maximum heating power input capacity.
  44986         \note HeatingDesignCapacity = > selected when the design heating capacity value or autosize
  44987         \note is specified. CapacityPerFloorArea = > selected when the design heating capacity is
  44988         \note determine from user specified heating capacity per floor area and zone floor area.
  44989         \note FractionOfAutosizedHeatingCapacity = > is selected when the design heating capacity is
  44990         \note determined from a user specified fraction and the auto-sized design heating capacity.
  44991    N1 , \field Heating Design Capacity
  44992         \type real
  44993         \units W
  44994         \minimum 0.0
  44995         \autosizable
  44996         \default autosize
  44997         \note Enter the design heating capacity.Required field when the heating design capacity method
  44998         \note HeatingDesignCapacity.
  44999    N2 , \field Heating Design Capacity Per Floor Area
  45000         \type real
  45001         \units W/m2
  45002         \minimum 0.0
  45003         \note Enter the heating design capacity per zone floor area.Required field when the heating design
  45004         \note capacity method field is CapacityPerFloorArea.
  45005    N3 , \field Fraction of Autosized Heating Design Capacity
  45006         \type real
  45007         \minimum 0.0
  45008         \default 1.0
  45009         \note Enter the fraction of auto - sized heating design capacity.Required field when capacity the
  45010         \note heating design capacity method field is FractionOfAutosizedHeatingCapacity.
  45011    A5 , \field Fuel Type
  45012         \note Natural gas or electricity
  45013         \required-field
  45014         \type choice
  45015         \key NaturalGas
  45016         \key Electricity
  45017    N4 , \field Combustion Efficiency
  45018         \note Not used for non-gas radiant heaters
  45019         \minimum 0
  45020         \maximum 1
  45021         \default 0.9
  45022    N5 , \field Fraction of Input Converted to Radiant Energy
  45023         \note Radiant+latent+lost fractions must sum to 1 or less, remainder is considered convective heat
  45024         \minimum 0
  45025         \maximum 1
  45026         \default 0.7
  45027    N6 , \field Fraction of Input Converted to Latent Energy
  45028         \minimum 0
  45029         \maximum 1
  45030         \default 0.0
  45031    N7 , \field Fraction of Input that Is Lost
  45032         \note Fraction of input vented to outdoor environment
  45033         \minimum 0
  45034         \maximum 1
  45035         \default 0.0
  45036    A6 , \field Temperature Control Type
  45037         \note Temperature type used to control unit
  45038         \type choice
  45039         \key MeanAirTemperature
  45040         \key MeanRadiantTemperature
  45041         \key OperativeTemperature
  45042         \key MeanAirTemperatureSetpoint
  45043         \key MeanRadiantTemperatureSetpoint
  45044         \key OperativeTemperatureSetpoint
  45045         \default OperativeTemperature
  45046    N8 , \field Heating Throttling Range
  45047         \units deltaC
  45048         \minimum 0
  45049         \default 2.0
  45050    A7 , \field Heating Setpoint Temperature Schedule Name
  45051         \note This setpoint is an "operative temperature" setpoint
  45052         \type object-list
  45053         \object-list ScheduleNames
  45054    N9,  \field Fraction of Radiant Energy Incident on People
  45055         \note This will affect thermal comfort but from an energy balance standpoint this value
  45056         \note gets added to the convective gains from the radiant heater
  45057         \minimum 0
  45058         \maximum 1

  SET ECOEff = ECOEff+(0.182915713033586*OAwbF), !- Program Line 29
  SET ECOEff = ECOEff+(0-0.00382838660261133*(OAwbF^2)), !- Program Line 30
  SET ECOEff = ECOEff+(0.0000255567460240583*(OAwbF^3)), !- Program Line 31
  SET SYS1ZonePVAVTimestepEconEff = ECOEff, !- Program Line 32
  ENDIF,                                  !- Program Line 33
  ELSE,                                   !- Program Line 34
  SET ECOEff = 2.36337942464462,          !- Program Line 35
  SET ECOEff = ECOEff+(0-0.409939515512619*CoolLoad), !- Program Line 36
  SET ECOEff = ECOEff+(0-0.0565205596792225*OAwbF), !- Program Line 37
  SET ECOEff = ECOEff+(0-0.0000632612294169389*(OATF^2)), !- Program Line 38
  SET SYS1ZonePVAVTimestepEconEff = ECOEff+(0.000571724868775081*(OAwbF^2)), !- Program Line 39
  ENDIF,                                  !- Program Line 40
  IF SYS1ZonePVAVTimestepEconEff > MaxE,  !- Program Line 41
  SET SYS1ZonePVAVTimestepEconEff = MaxE, !- Program Line 42
  ELSEIF SYS1ZonePVAVTimestepEconEff < (SYS1ZonePVAVOADesignMass*SYS1ZonePVAVOASch), !- Program Line 43
  SET SYS1ZonePVAVTimestepEconEff = (SYS1ZonePVAVOADesignMass*SYS1ZonePVAVOASch), !- Program Line 44
  ENDIF,                                  !- Program Line 45
  ENDIF;                                  !- Program Line 46

EnergyManagementSystem:Program,
  SYS1ZonePVAVFanControl,                 !- Name
  IF SYS1ZonePVAVNumberofStages == 1,     !- Program Line 1
  Return,                                 !- Program Line 2
  ENDIF,                                  !- Program Line 3
  IF SYS1ZonePVAVHeatingRTF > 0,          !- Program Line 4
  SET Heating = SYS1ZonePVAVHeatingRTF,   !- Program Line 5
  SET Ven = 1-SYS1ZonePVAVHeatingRTF,     !- Program Line 6
  SET Eco = 0,                            !- Program Line 7
  SET Stage1 = 0,                         !- Program Line 8
  SET Stage2 = 0,                         !- Program Line 9
  ELSE,                                   !- Program Line 10
  SET Heating = 0,                        !- Program Line 11
  SET EcoSpeed = SYS1ZonePVAVVenSpeed,    !- Program Line 12
  IF SYS1ZonePVAVSpeedRatio == 0,         !- Program Line 13
  IF SYS1ZonePVAVRTF > 0,                 !- Program Line 14
  SET Stage1 = SYS1ZonePVAVRTF,           !- Program Line 15
  SET Stage2 = 0,                         !- Program Line 16
  SET Ven = 1-SYS1ZonePVAVRTF,            !- Program Line 17
  SET Eco = 0,                            !- Program Line 18
  IF SYS1ZonePVAVOAFlowMass > (SYS1ZonePVAVOADesignMass*SYS1ZonePVAVOASch), !- Program Line 19
  SET SYS1ZonePVAVStg1Spd = 1.0,          !- Program Line 20
  ENDIF,                                  !- Program Line 21
  ELSE,                                   !- Program Line 22
  SET Stage1 = 0,                         !- Program Line 23
  SET Stage2 = 0,                         !- Program Line 24
  IF SYS1ZonePVAVOAFlowMass > (SYS1ZonePVAVOADesignMass*SYS1ZonePVAVOASch), !- Program Line 25
  SET Eco = 1.0,                          !- Program Line 26
  SET Ven = 0,                            !- Program Line 27
  SET ExpDAT = SYS1ZonePVAVDATRqd-(1-SYS1ZonePVAVVenSpeed)*Space_3_ZNTemp, !- Program Line 28
  SET ExpDAT = ExpDAT/SYS1ZonePVAVVenSpeed, !- Program Line 29
  IF OATF > ExpDAT,                       !- Program Line 30
  SET EcoSpeed = SYS1ZonePVAVStg2Spd,     !- Program Line 31
  ENDIF,                                  !- Program Line 32
  ELSE,                                   !- Program Line 33
  SET Eco = 0,                            !- Program Line 34
  SET Ven = 1.0,                          !- Program Line 35
  ENDIF,                                  !- Program Line 36
  ENDIF,                                  !- Program Line 37
  ELSE,                                   !- Program Line 38
  SET Stage1 = 1-SYS1ZonePVAVSpeedRatio,  !- Program Line 39
  SET Stage2 = SYS1ZonePVAVSpeedRatio,    !- Program Line 40
  SET Ven = 0,                            !- Program Line 41
  SET Eco = 0,                            !- Program Line 42
  IF SYS1ZonePVAVOAFlowMass > (SYS1ZonePVAVOADesignMass*SYS1ZonePVAVOASch), !- Program Line 43
  SET SYS1ZonePVAVStg1Spd = 1.0,          !- Program Line 44
  ENDIF,                                  !- Program Line 45
  ENDIF,                                  !- Program Line 46
  ENDIF,                                  !- Program Line 47
  SET FPR = Ven*(SYS1ZonePVAVVenSpeed ^ SYS1ZonePVAVFanPwrExp), !- Program Line 48
  SET FPR = FPR+Eco*(EcoSpeed^SYS1ZonePVAVFanPwrExp), !- Program Line 49
  SET FPR1 = Stage1*(SYS1ZonePVAVStg1Spd^SYS1ZonePVAVFanPwrExp), !- Program Line 50
  SET FPR = FPR+FPR1,                     !- Program Line 51
  SET FPR2 = Stage2*(SYS1ZonePVAVStg2Spd^SYS1ZonePVAVFanPwrExp), !- Program Line 52
  SET FPR = FPR+FPR2,                     !- Program Line 53
  SET FPR3 = Heating*(SYS1ZonePVAVHeatSpeed^SYS1ZonePVAVFanPwrExp), !- Program Line 54
  SET FanPwrRatio = FPR+ FPR3,            !- Program Line 55
  SET SYS1ZonePVAVFanPressure = SYS1ZonePVAVFanDesignPressure*FanPwrRatio; !- Program Line 56

EnergyManagementSystem:Program,
  SYS1ZonePVAVSetFanPar,                  !- Name
  IF SYS1ZonePVAVNumberofStages == 1,     !- Program Line 1
  Return,                                 !- Program Line 2
  ENDIF,                                  !- Program Line 3
  SET SYS1ZonePVAVFanPwrExp = 2.2,        !- Program Line 4
  SET OAFrac = SYS1ZonePVAVOAFlowMass/SYS1ZonePVAVDesignFlowMass, !- Program Line 5
  IF  OAFrac < 0.66,                      !- Program Line 6
  SET SYS1ZonePVAVVenSpeed = 0.66,        !- Program Line 7
  SET SYS1ZonePVAVStg1Spd = 0.66,         !- Program Line 8
  ELSE,                                   !- Program Line 9
  SET SYS1ZonePVAVVenSpeed = OAFrac,      !- Program Line 10
  SET SYS1ZonePVAVStg1Spd = OAFrac,       !- Program Line 11
  ENDIF,                                  !- Program Line 12
  SET SYS1ZonePVAVStg2Spd = 1.0,          !- Program Line 13
  SET SYS1ZonePVAVHeatSpeed = 1.0;        !- Program Line 14

EnergyManagementSystem:Program,
  SYS1ZonePVAVSetNumberofStages,          !- Name
  SET SYS1ZonePVAVNumberofStages = 1;     !- Program Line 1


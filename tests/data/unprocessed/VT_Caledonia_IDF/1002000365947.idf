EnergyManagementSystem:Program,
  SYS1ZonePVAV1EconomizerCTRLProg,        !- Name
  SET SYS1ZonePVAV1TimestepEconEff = 0.7, !- Program Line 1
  SET MaxE = 0.7,                         !- Program Line 2
  SET SYS1ZonePVAV1DATRqd = (SYS1ZonePVAV1DATRqd*1.8)+32, !- Program Line 3
  SET OATF = (OATF_1*1.8)+32,             !- Program Line 4
  SET OAwbF = (OAWBC_1*1.8)+32,           !- Program Line 5
  IF SYS1ZonePVAV1OAFlowMass > (SYS1ZonePVAV1OADesignMass*SYS1ZonePVAV1OASch), !- Program Line 6
  SET EconoActive = 1,                    !- Program Line 7
  ELSE,                                   !- Program Line 8
  SET EconoActive = 0,                    !- Program Line 9
  ENDIF,                                  !- Program Line 10
  SET dTNeeded = 75-SYS1ZonePVAV1DATRqd,  !- Program Line 11
  SET CoolDesdT = ((98*0.15)+(75*(1-0.15)))-55, !- Program Line 12
  SET CoolLoad = dTNeeded/ CoolDesdT,     !- Program Line 13
  IF CoolLoad > 1,                        !- Program Line 14
  SET CoolLoad = 1,                       !- Program Line 15
  ELSEIF CoolLoad < 0,                    !- Program Line 16
  SET CoolLoad = 0,                       !- Program Line 17
  ENDIF,                                  !- Program Line 18
  IF EconoActive == 1,                    !- Program Line 19
  SET Stage = SYS1ZonePVAV1NumberofStages, !- Program Line 20
  IF Stage == 2,                          !- Program Line 21
  IF CoolLoad < 0.6,                      !- Program Line 22
  SET SYS1ZonePVAV1TimestepEconEff = MaxE, !- Program Line 23
  ELSE,                                   !- Program Line 24
  SET ECOEff = 0-2.18919863612305,        !- Program Line 25
  SET ECOEff = ECOEff+(0-0.674461284910428*CoolLoad), !- Program Line 26
  SET ECOEff = ECOEff+(0.000459106275872404*(OATF^2)), !- Program Line 27
  SET ECOEff = ECOEff+(0-0.00000484778537945252*(OATF^3)), !- Program Line 28
  SET ECOEff = ECOEff+(0.182915713033586*OAwbF), !- Program Line 29
  SET ECOEff = ECOEff+(0-0.00382838660261133*(OAwbF^2)), !- Program Line 30
  SET ECOEff = ECOEff+(0.0000255567460240583*(OAwbF^3)), !- Program Line 31
  SET SYS1ZonePVAV1TimestepEconEff = ECOEff, !- Program Line 32
  ENDIF,                                  !- Program Line 33
  ELSE,                                   !- Program Line 34
  SET ECOEff = 2.36337942464462,          !- Program Line 35
  SET ECOEff = ECOEff+(0-0.409939515512619*CoolLoad), !- Program Line 36
  SET ECOEff = ECOEff+(0-0.0565205596792225*OAwbF), !- Program Line 37
  SET ECOEff = ECOEff+(0-0.0000632612294169389*(OATF^2)), !- Program Line 38
  SET SYS1ZonePVAV1TimestepEconEff = ECOEff+(0.000571724868775081*(OAwbF^2)), !- Program Line 39
  ENDIF,                                  !- Program Line 40

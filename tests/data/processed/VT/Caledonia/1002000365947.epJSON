    "EnergyManagementSystem:Program": {
        "SYS1ZonePVAV1EconomizerCTRLProg": {
            "lines": [
                {
                    "program_line": "SET SYS1ZonePVAV1TimestepEconEff = 0.7"
                },
                {
                    "program_line": "SET MaxE = 0.7"
                },
                {
                    "program_line": "SET SYS1ZonePVAV1DATRqd = (SYS1ZonePVAV1DATRqd*1.8)+32"
                },
                {
                    "program_line": "SET OATF = (OATF_1*1.8)+32"
                },
                {
                    "program_line": "SET OAwbF = (OAWBC_1*1.8)+32"
                },
                {
                    "program_line": "IF SYS1ZonePVAV1OAFlowMass > (SYS1ZonePVAV1OADesignMass*SYS1ZonePVAV1OASch)"
                },
                {
                    "program_line": "SET EconoActive = 1"
                },
                {
                    "program_line": "ELSE"
                },
                {
                    "program_line": "SET EconoActive = 0"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "SET dTNeeded = 75-SYS1ZonePVAV1DATRqd"
                },
                {
                    "program_line": "SET CoolDesdT = ((98*0.15)+(75*(1-0.15)))-55"
                },
                {
                    "program_line": "SET CoolLoad = dTNeeded/ CoolDesdT"
                },
                {
                    "program_line": "IF CoolLoad > 1"
                },
                {
                    "program_line": "SET CoolLoad = 1"
                },
                {
                    "program_line": "ELSEIF CoolLoad < 0"
                },
                {
                    "program_line": "SET CoolLoad = 0"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "IF EconoActive == 1"
                },
                {
                    "program_line": "SET Stage = SYS1ZonePVAV1NumberofStages"
                },
                {
                    "program_line": "IF Stage == 2"
                },
                {
                    "program_line": "IF CoolLoad < 0.6"
                },
                {
                    "program_line": "SET SYS1ZonePVAV1TimestepEconEff = MaxE"
                },
                {
                    "program_line": "ELSE"
                },
                {
                    "program_line": "SET ECOEff = 0-2.18919863612305"
                },
                {
                    "program_line": "SET ECOEff = ECOEff+(0-0.674461284910428*CoolLoad)"
                },
                {
                    "program_line": "SET ECOEff = ECOEff+(0.000459106275872404*(OATF^2))"
                },
                {
                    "program_line": "SET ECOEff = ECOEff+(0-0.00000484778537945252*(OATF^3))"
                },
                {
                    "program_line": "SET ECOEff = ECOEff+(0.182915713033586*OAwbF)"
                },
                {
                    "program_line": "SET ECOEff = ECOEff+(0-0.00382838660261133*(OAwbF^2))"
                },
                {
                    "program_line": "SET ECOEff = ECOEff+(0.0000255567460240583*(OAwbF^3))"
                },
                {
                    "program_line": "SET SYS1ZonePVAV1TimestepEconEff = ECOEff"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "ELSE"
                },
                {
                    "program_line": "SET ECOEff = 2.36337942464462"
                },
                {
                    "program_line": "SET ECOEff = ECOEff+(0-0.409939515512619*CoolLoad)"
                },
                {
                    "program_line": "SET ECOEff = ECOEff+(0-0.0565205596792225*OAwbF)"
                },
                {
                    "program_line": "SET ECOEff = ECOEff+(0-0.0000632612294169389*(OATF^2))"
                },
                {
                    "program_line": "SET SYS1ZonePVAV1TimestepEconEff = ECOEff+(0.000571724868775081*(OAwbF^2))"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "IF SYS1ZonePVAV1TimestepEconEff > MaxE"
                },
                {
                    "program_line": "SET SYS1ZonePVAV1TimestepEconEff = MaxE"
                },
                {
                    "program_line": "ELSEIF SYS1ZonePVAV1TimestepEconEff < (SYS1ZonePVAV1OADesignMass*SYS1ZonePVAV1OASch)"
                },
                {
                    "program_line": "SET SYS1ZonePVAV1TimestepEconEff = (SYS1ZonePVAV1OADesignMass*SYS1ZonePVAV1OASch)"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "ENDIF"
                }
            ]
        },
        "SYS1ZonePVAV1FanControl": {
            "lines": [
                {
                    "program_line": "IF SYS1ZonePVAV1NumberofStages == 1"
                },
                {
                    "program_line": "Return"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "IF SYS1ZonePVAV1HeatingRTF > 0"
                },
                {
                    "program_line": "SET Heating = SYS1ZonePVAV1HeatingRTF"
                },
                {
                    "program_line": "SET Ven = 1-SYS1ZonePVAV1HeatingRTF"
                },
                {
                    "program_line": "SET Eco = 0"
                },
                {
                    "program_line": "SET Stage1 = 0"
                },
                {
                    "program_line": "SET Stage2 = 0"
                },
                {
                    "program_line": "ELSE"
                },
                {
                    "program_line": "SET Heating = 0"
                },
                {
                    "program_line": "SET EcoSpeed = SYS1ZonePVAV1VenSpeed"
                },
                {
                    "program_line": "IF SYS1ZonePVAV1SpeedRatio == 0"
                },
                {
                    "program_line": "IF SYS1ZonePVAV1RTF > 0"
                },
                {
                    "program_line": "SET Stage1 = SYS1ZonePVAV1RTF"
                },
                {
                    "program_line": "SET Stage2 = 0"
                },
                {
                    "program_line": "SET Ven = 1-SYS1ZonePVAV1RTF"
                },
                {
                    "program_line": "SET Eco = 0"
                },
                {
                    "program_line": "IF SYS1ZonePVAV1OAFlowMass > (SYS1ZonePVAV1OADesignMass*SYS1ZonePVAV1OASch)"
                },
                {
                    "program_line": "SET SYS1ZonePVAV1Stg1Spd = 1.0"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "ELSE"
                },
                {
                    "program_line": "SET Stage1 = 0"
                },
                {
                    "program_line": "SET Stage2 = 0"
                },
                {
                    "program_line": "IF SYS1ZonePVAV1OAFlowMass > (SYS1ZonePVAV1OADesignMass*SYS1ZonePVAV1OASch)"
                },
                {
                    "program_line": "SET Eco = 1.0"
                },
                {
                    "program_line": "SET Ven = 0"
                },
                {
                    "program_line": "SET ExpDAT = SYS1ZonePVAV1DATRqd-(1-SYS1ZonePVAV1VenSpeed)*Space_3_ZNTemp_1"
                },
                {
                    "program_line": "SET ExpDAT = ExpDAT/SYS1ZonePVAV1VenSpeed"
                },
                {
                    "program_line": "IF OATF_1 > ExpDAT"
                },
                {
                    "program_line": "SET EcoSpeed = SYS1ZonePVAV1Stg2Spd"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "ELSE"
                },
                {
                    "program_line": "SET Eco = 0"
                },
                {
                    "program_line": "SET Ven = 1.0"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "ELSE"
                },
                {
                    "program_line": "SET Stage1 = 1-SYS1ZonePVAV1SpeedRatio"
                },
                {
                    "program_line": "SET Stage2 = SYS1ZonePVAV1SpeedRatio"
                },
                {
                    "program_line": "SET Ven = 0"
                },
                {
                    "program_line": "SET Eco = 0"
                },
                {
                    "program_line": "IF SYS1ZonePVAV1OAFlowMass > (SYS1ZonePVAV1OADesignMass*SYS1ZonePVAV1OASch)"
                },
                {
                    "program_line": "SET SYS1ZonePVAV1Stg1Spd = 1.0"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "ENDIF"
                },
                {
                    "program_line": "SET FPR = Ven*(SYS1ZonePVAV1VenSpeed ^ SYS1ZonePVAV1FanPwrExp)"
                },
                {
                    "program_line": "SET FPR = FPR+Eco*(EcoSpeed^SYS1ZonePVAV1FanPwrExp)"
                },
                {
                    "program_line": "SET FPR1 = Stage1*(SYS1ZonePVAV1Stg1Spd^SYS1ZonePVAV1FanPwrExp)"
                },
                {
                    "program_line": "SET FPR = FPR+FPR1"
                },
                {
                    "program_line": "SET FPR2 = Stage2*(SYS1ZonePVAV1Stg2Spd^SYS1ZonePVAV1FanPwrExp)"
                },
                {
                    "program_line": "SET FPR = FPR+FPR2"
                },
                {
                    "program_line": "SET FPR3 = Heating*(SYS1ZonePVAV1HeatSpeed^SYS1ZonePVAV1FanPwrExp)"
                },
                {
                    "program_line": "SET FanPwrRatio = FPR+ FPR3"
                },
                {
                    "program_line": "SET SYS1ZonePVAV1FanPressure = SYS1ZonePVAV1FanDesignPressure*FanPwrRatio"
                }
            ]
        },
        "SYS1ZonePVAV1SetFanPar": {
            "lines": [

BootStrap: debootstrap
OSVersion: focal
MirrorURL: http://us.archive.ubuntu.com/ubuntu/

%files
    # The installer should be in the same directory as this def file
    energyplus/EnergyPlus-24.1.0-9d7789a3ac-Linux-Ubuntu20.04-x86_64.sh /opt/

%post
    sed -i 's/$/ universe/' /etc/apt/sources.list
    apt-get update
    apt-get -y install vim
    apt-get clean
    apt-get update && apt-get install -y wget build-essential
    apt install -y git

    # Install EnergyPlus
    cd /opt
    chmod +x EnergyPlus-24.1.0-9d7789a3ac-Linux-Ubuntu20.04-x86_64.sh
    echo "y" | ./EnergyPlus-24.1.0-9d7789a3ac-Linux-Ubuntu20.04-x86_64.sh
    rm EnergyPlus-24.1.0-9d7789a3ac-Linux-Ubuntu20.04-x86_64.sh

    # Create directories for mounting
    mkdir -p /input /output

%environment
    export PATH="/usr/local/EnergyPlus-24-1-0:$PATH"
